---
// src/components/Footer.astro
import { siteConfig } from '../config/site.js';

const currentYear = new Date().getFullYear();
---

<footer class="mt-24 border-t border-slate-200 bg-white text-slate-600 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#C2610A] p-0.5 shadow-md shadow-amber-950/20">
            <div class="w-full h-full bg-white rounded-[6px] flex items-center justify-center">
              <span class="text-[#C2610A] font-extrabold text-sm tracking-tight">CS</span>
            </div>
          </div>
          <span class="text-lg font-bold tracking-tight text-slate-900 font-heading">
            {siteConfig.name}
          </span>
          <span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded bg-amber-50 text-[#C2610A] border border-amber-200 shadow-2xs">
            Anime Live
          </span>
        </div>
        
        <p class="text-sm text-slate-600 leading-relaxed max-w-lg font-normal">
          {siteConfig.tagline}
        </p>

        <p class="text-xs text-slate-500 leading-relaxed max-w-lg border-l-2 border-[#C2610A] pl-3 py-0.5 font-normal">
          {siteConfig.footer.editorialPledge}
        </p>
      </div>

      <!-- Quick Navigation & Hub Roadmap -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-900 mb-4 font-heading">
          Entertainment Hub
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/anime" class="text-slate-600 hover:text-[#C2610A] flex items-center justify-between group transition-colors">
              <span class="group-hover:translate-x-1 transition-transform font-medium">Anime List</span>
              <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-amber-50 text-[#C2610A] border border-amber-200">Live</span>
            </a>
          </li>
          <li>
            <a href="/about" class="text-slate-600 hover:text-[#C2610A] transition-colors">
              About & Why I Built This
            </a>
          </li>
          <li>
            <a href="/about#suggestions" class="text-slate-600 hover:text-[#C2610A] transition-colors">
              Suggest an Anime
            </a>
          </li>
          <li>
            <div class="flex items-center justify-between text-slate-400">
              <span>Movies (Coming Later)</span>
              <span class="text-[10px] uppercase font-semibold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Planned</span>
            </div>
          </li>
          <li>
            <div class="flex items-center justify-between text-slate-400">
              <span>TV Shows (Coming Later)</span>
              <span class="text-[10px] uppercase font-semibold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Planned</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Discovery & Vibes -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-900 mb-4 font-heading">
          Quick Links
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/anime#vibes" class="text-slate-600 hover:text-[#C2610A] transition-colors">
              Browse by Vibe
            </a>
          </li>
          <li>
            <a href="/anime/catalog?filter=zero" class="text-slate-600 hover:text-[#C2610A] transition-colors">
              Zero-Filler Anime Guide
            </a>
          </li>
          <li>
            <a href="/anime/catalog" class="text-slate-600 hover:text-[#C2610A] transition-colors">
              Watched vs. Watchlist
            </a>
          </li>
          <li>
            <a href="/about" class="text-slate-600 hover:text-[#C2610A] transition-colors">
              The Story Behind This
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Friendly Viewer Wellness Note -->
    <div class="mt-14 pt-8 border-t border-slate-200">
      <div class="p-5 sm:p-6 rounded-2xl bg-amber-50/80 border border-amber-200/80 flex flex-col sm:flex-row items-start sm:items-center gap-4 text-slate-700 shadow-xs">
        <div class="w-10 h-10 rounded-xl bg-amber-100 border border-amber-200 flex items-center justify-center shrink-0 text-amber-700">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-normal">
          We know how good it feels to lose yourself in a great story — that's kind of the whole point of anime, movies, and shows like these. They're a genuine escape, and there's real magic in that. Just remember to take a short break every now and then during long watch sessions — rest your eyes, stretch a little, grab some water. Your favorite series will still be there when you get back. Enjoy the journey!
        </p>
      </div>
    </div>

    <!-- TMDB Legal & Copyright Disclaimers (Required) -->
    <div class="mt-8 pt-6 border-t border-slate-200 space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-500">
        <div class="flex items-center gap-3">
          <!-- TMDB Logo Icon representation -->
          <div class="px-2 py-1 rounded bg-[#0d253f] text-[#01b4e4] font-extrabold text-[11px] tracking-wider border border-[#01b4e4]/30">
            TMDB
          </div>
          <p class="leading-relaxed font-normal">
            {siteConfig.footer.tmdbAttribution}
          </p>
        </div>
      </div>

      <div class="text-xs text-slate-500 leading-relaxed font-normal">
        <p>
          {siteConfig.footer.copyrightNotice}
        </p>
        <p class="mt-2 text-[11px] text-slate-400">
          © {currentYear} {siteConfig.name}. Designed for real viewers who want to spend more time enjoying stories and zero time navigating filler or fake hype.
        </p>
      </div>
    </div>

  </div>
</footer>
