---
// src/components/Footer.astro
import { siteConfig } from '../config/site.js';
import { theme } from '../config/theme.js';

const currentYear = new Date().getFullYear();
---

<footer class="mt-12 border-t border-slate-200 bg-white text-slate-600 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#6366F1] p-0.5 shadow-md shadow-indigo-500/20">
            <div class="w-full h-full bg-white rounded-[6px] flex items-center justify-center">
              <span class="text-[#6366F1] font-extrabold text-sm tracking-tight">CS</span>
            </div>
          </div>
          <span class="text-lg font-bold tracking-tight text-[#0F172A] font-heading">
            {siteConfig.name}
          </span>
          <span class="text-[10px] uppercase font-bold tracking-widest px-2 py-0.5 rounded bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] shadow-2xs">
            Anime Live
          </span>
        </div>
        
        <p class="text-sm text-slate-600 leading-relaxed max-w-lg font-normal">
          {siteConfig.tagline}
        </p>

        <p class="text-xs text-slate-500 leading-relaxed max-w-lg border-l-2 border-[#6366F1] pl-3 py-0.5 font-normal">
          {siteConfig.footer.editorialPledge}
        </p>
      </div>

      <!-- Quick Navigation & Hub Roadmap -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-[#0F172A] mb-4 font-heading">
          Entertainment Hub
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/anime" class="text-slate-600 hover:text-[#6366F1] flex items-center justify-between group transition-colors">
              <span class="group-hover:translate-x-1 transition-transform font-medium">Anime List</span>
              <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE]">Live</span>
            </a>
          </li>
          <li>
            <a href="/blog" class="text-slate-600 hover:text-[#6366F1] flex items-center justify-between group transition-colors">
              <span class="group-hover:translate-x-1 transition-transform font-medium">Blog & Articles</span>
              <span class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE]">Live</span>
            </a>
          </li>
          <li>
            <a href="/about" class="text-slate-600 hover:text-[#6366F1] transition-colors">
              About & Why I Built This
            </a>
          </li>
          <li>
            <a href="/about#suggestions" class="text-slate-600 hover:text-[#6366F1] transition-colors">
              Suggest an Anime
            </a>
          </li>
          <li>
            <div class="flex items-center justify-between text-slate-400">
              <span>Movies (Coming Later)</span>
              <span class="text-[10px] uppercase font-semibold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Planned</span>
            </div>
          </li>
          <li>
            <div class="flex items-center justify-between text-slate-400">
              <span>TV Shows (Coming Later)</span>
              <span class="text-[10px] uppercase font-semibold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">Planned</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Discovery & Vibes -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-[#0F172A] mb-4 font-heading">
          Quick Links
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="/anime#vibes" class="text-slate-600 hover:text-[#6366F1] transition-colors">
              Browse by Vibe
            </a>
          </li>
          <li>
            <a href="/anime/catalog?filter=zero" class="text-slate-600 hover:text-[#6366F1] transition-colors">
              Zero-Filler Anime Guide
            </a>
          </li>
          <li>
            <a href="/anime/catalog" class="text-slate-600 hover:text-[#6366F1] transition-colors">
              Full Anime Catalog
            </a>
          </li>
          <li>
            <a href="/contact" class="text-slate-600 hover:text-[#6366F1] transition-colors">
              Contact & Feedback
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Policy & Legal Navigation Links -->
    <div class="mt-12 pt-8 border-t border-slate-200">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 font-heading">
          Policies & Guidance
        </span>
        <ul class="flex items-center gap-x-6 gap-y-2 text-xs text-slate-600 flex-wrap font-medium">
          <li>
            <a href="/privacy" class="hover:text-[#6366F1] transition-colors">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="hover:text-[#6366F1] transition-colors">
              Terms of Use
            </a>
          </li>
          <li>
            <a href="/dmca" class="hover:text-[#6366F1] transition-colors">
              Copyright & DMCA
            </a>
          </li>
          <li>
            <a href="/disclaimer" class="hover:text-[#6366F1] transition-colors">
              Content & Ratings Disclaimer
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-[#6366F1] transition-colors">
              Contact
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- TMDB Legal & Copyright Disclaimers (Required) -->
    <div class="mt-12 pt-8 border-t border-slate-200 space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-500">
        <div class="flex items-center gap-3">
          <!-- TMDB Logo Icon representation -->
          <div class="px-2 py-1 rounded bg-[#0d253f] text-[#01b4e4] font-extrabold text-[11px] tracking-wider border border-[#01b4e4]/30">
            TMDB
          </div>
          <p class="leading-relaxed font-normal">
            {siteConfig.footer.tmdbAttribution}
          </p>
        </div>
      </div>

      <div class="text-xs text-slate-500 leading-relaxed font-normal">
        <p>
          {siteConfig.footer.copyrightNotice}
        </p>
        <p class="mt-2 text-[11px] text-slate-400">
          © {currentYear} {siteConfig.name}. Designed for real viewers who want to spend more time enjoying stories and zero time navigating filler or fake hype.
        </p>
      </div>
    </div>

  </div>
</footer>
