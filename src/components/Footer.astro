---
// src/components/Footer.astro
import { siteConfig } from '../config/site.js';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const currentYear = new Date().getFullYear();

const isAnimeActive = currentPath === '/anime';
const isBlogActive = currentPath.startsWith('/blog');
const isAboutActive = currentPath === '/about';
const isZeroFillerActive = currentPath === '/anime/catalog' && Astro.url.searchParams.get('filter') === 'zero';
const isCatalogActive = currentPath === '/anime/catalog' && !Astro.url.searchParams.get('filter');
const isContactActive = currentPath === '/contact';

const isPrivacyActive = currentPath === '/privacy';
const isTermsActive = currentPath === '/terms';
const isDmcaActive = currentPath === '/dmca';
const isDisclaimerActive = currentPath === '/disclaimer';
---

<footer class="mt-12 border-t border-slate-200 bg-white text-slate-600 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/cs.webp"
            alt="Chitra Sampada Logo"
            width="32"
            height="32"
            class="w-8 h-8 rounded-lg object-contain shadow-sm shrink-0 aspect-square"
          />
          <span class="text-lg font-bold tracking-tight text-[#0F172A] font-heading">
            {siteConfig.name}
          </span>
        </div>
        
        <p class="text-sm text-slate-600 leading-relaxed max-w-lg font-normal">
          {siteConfig.tagline}
        </p>

        <p class="text-xs text-slate-500 leading-relaxed max-w-lg border-l-2 border-[#6366F1] pl-3 py-0.5 font-normal">
          {siteConfig.footer.editorialPledge}
        </p>

        <!-- Social Media Links -->
        <div class="pt-2">
          <div class="flex items-center gap-2.5">
            <a
              href={siteConfig.socialLinks.youtube}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Chitra Sampada on YouTube"
              class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 hover:bg-[#EEF2FF] text-slate-500 hover:text-[#4F46E5] border border-slate-200/80 hover:border-[#C7D2FE] transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-2xs"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <a
              href={siteConfig.socialLinks.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Chitra Sampada on Instagram"
              class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 hover:bg-[#EEF2FF] text-slate-500 hover:text-[#4F46E5] border border-slate-200/80 hover:border-[#C7D2FE] transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-2xs"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <a
              href={siteConfig.socialLinks.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Chitra Sampada on Facebook"
              class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 hover:bg-[#EEF2FF] text-slate-500 hover:text-[#4F46E5] border border-slate-200/80 hover:border-[#C7D2FE] transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-2xs"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>

            <a
              href={siteConfig.socialLinks.pinterest}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Chitra Sampada on Pinterest"
              class="w-9 h-9 rounded-xl flex items-center justify-center bg-slate-100 hover:bg-[#EEF2FF] text-slate-500 hover:text-[#4F46E5] border border-slate-200/80 hover:border-[#C7D2FE] transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 shadow-2xs"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.39 18.592.026 11.985.026L12.017 0z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Navigation & Hub Roadmap -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-[#0F172A] mb-4 font-heading">
          Entertainment Hub
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="/anime"
              class:list={[
                'inline-flex items-center px-2 py-1 -ml-2 rounded-lg transition-colors',
                isAnimeActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1] font-medium'
              ]}
            >
              Anime List
            </a>
          </li>
          <li>
            <a
              href="/blog"
              class:list={[
                'inline-flex items-center px-2 py-1 -ml-2 rounded-lg transition-colors',
                isBlogActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1] font-medium'
              ]}
            >
              Blog & Articles
            </a>
          </li>
          <li>
            <a
              href="/about"
              class:list={[
                'inline-flex items-center px-2 py-1 -ml-2 rounded-lg transition-colors',
                isAboutActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1] font-medium'
              ]}
            >
              About & Why I Built This
            </a>
          </li>
          <li>
            <a
              href="/about#suggestions"
              class="inline-flex items-center px-2 py-1 -ml-2 rounded-lg text-slate-600 hover:text-[#6366F1] font-medium transition-colors"
            >
              Suggest an Anime
            </a>
          </li>
        </ul>
      </div>

      <!-- Discovery & Vibes -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-[#0F172A] mb-4 font-heading">
          Quick Links
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="/anime#vibes"
              class="inline-flex items-center px-2 py-1 -ml-2 rounded-lg text-slate-600 hover:text-[#6366F1] font-medium transition-colors"
            >
              Browse by Vibe
            </a>
          </li>
          <li>
            <a
              href="/anime/catalog?filter=zero"
              class:list={[
                'inline-flex items-center px-2 py-1 -ml-2 rounded-lg transition-colors',
                isZeroFillerActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1] font-medium'
              ]}
            >
              Zero-Filler Anime Guide
            </a>
          </li>
          <li>
            <a
              href="/anime/catalog"
              class:list={[
                'inline-flex items-center px-2 py-1 -ml-2 rounded-lg transition-colors',
                isCatalogActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1] font-medium'
              ]}
            >
              Full Anime Catalog
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class:list={[
                'inline-flex items-center px-2 py-1 -ml-2 rounded-lg transition-colors',
                isContactActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1] font-medium'
              ]}
            >
              Contact & Feedback
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Policy & Legal Navigation Links -->
    <div class="mt-12 pt-8 border-t border-slate-200">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 font-heading">
          Policies & Guidance
        </span>
        <ul class="flex items-center gap-x-2 gap-y-2 text-xs flex-wrap font-medium">
          <li>
            <a
              href="/privacy"
              class:list={[
                'px-2.5 py-1 rounded-md transition-colors',
                isPrivacyActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1]'
              ]}
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class:list={[
                'px-2.5 py-1 rounded-md transition-colors',
                isTermsActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1]'
              ]}
            >
              Terms of Use
            </a>
          </li>
          <li>
            <a
              href="/dmca"
              class:list={[
                'px-2.5 py-1 rounded-md transition-colors',
                isDmcaActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1]'
              ]}
            >
              Copyright & DMCA
            </a>
          </li>
          <li>
            <a
              href="/disclaimer"
              class:list={[
                'px-2.5 py-1 rounded-md transition-colors',
                isDisclaimerActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1]'
              ]}
            >
              Content & Ratings Disclaimer
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class:list={[
                'px-2.5 py-1 rounded-md transition-colors',
                isContactActive
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] font-bold shadow-2xs'
                  : 'text-slate-600 hover:text-[#6366F1]'
              ]}
            >
              Contact
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- TMDB Legal & Copyright Disclaimers (Required) -->
    <div class="mt-12 pt-8 border-t border-slate-200 space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-slate-500">
        <div class="flex items-center gap-3">
          <!-- TMDB Logo Icon representation -->
          <div class="px-2 py-1 rounded bg-[#0d253f] text-[#01b4e4] font-extrabold text-[11px] tracking-wider border border-[#01b4e4]/30">
            TMDB
          </div>
          <p class="leading-relaxed font-normal">
            {siteConfig.footer.tmdbAttribution}
          </p>
        </div>
      </div>

      <div class="text-xs text-slate-500 leading-relaxed font-normal">
        <p>
          {siteConfig.footer.copyrightNotice}
        </p>
        <p class="mt-2 text-[11px] text-slate-400">
          © {currentYear} {siteConfig.name}. Designed for real viewers who want to spend more time enjoying stories and zero time navigating filler or fake hype.
        </p>
      </div>
    </div>

  </div>
</footer>
