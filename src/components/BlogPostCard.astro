---
// src/components/BlogPostCard.astro
// Clean, text-only blog post card. No images.

interface Props {
  post: {
    id: string;
    slug: string;
    title: string;
    excerpt: string;
    coverImage?: string | null;
    publishedDate: string;
    lastUpdated?: string;
    readTime?: string;
    linkedAnime?: Array<{
      id: string;
      slug: string;
      title: string;
      year?: number;
    }>;
  };
}

const { post } = Astro.props;

// Format date nicely: e.g. "Sep 18, 2026"
const dateObj = new Date(post.publishedDate);
const formattedDate = !isNaN(dateObj.getTime())
  ? dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : post.publishedDate;
---

<article class="group relative flex flex-col h-full p-6 sm:p-7 rounded-2xl bg-white border border-slate-200/80 hover:border-slate-300 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
  {post.coverImage && (
    <div class="mb-5 -mx-6 -mt-6 sm:-mx-7 sm:-mt-7 overflow-hidden rounded-t-2xl aspect-[16/9] bg-slate-100 relative">
      <img
        src={post.coverImage}
        alt={post.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </div>
  )}

  <!-- Top Content Area -->
  <div class="space-y-3">
    <!-- Meta row: Date and Reading Time -->
    <div class="flex items-center gap-2 text-xs text-slate-400 font-normal">
      <time datetime={post.publishedDate}>{formattedDate}</time>
      {post.readTime && (
        <>
          <span class="text-slate-300" aria-hidden="true">·</span>
          <span>{post.readTime}</span>
        </>
      )}
    </div>

    <!-- Title -->
    <h2 class="font-heading text-lg sm:text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors line-clamp-2 leading-snug tracking-tight">
      <a href={`/blog/${post.slug}`} class="after:absolute after:inset-0 focus:outline-none">
        {post.title}
      </a>
    </h2>

    <!-- Excerpt -->
    <p class="text-sm text-slate-600 leading-relaxed font-normal line-clamp-3">
      {post.excerpt}
    </p>
  </div>

  <!-- Footer Area (Always pushed to bottom via mt-auto, no divider lines) -->
  <div class="mt-auto pt-6 space-y-3 relative z-10">
    <!-- Subtle Text Tag: Discusses -->
    {post.linkedAnime && post.linkedAnime.length > 0 && (
      <div class="text-xs sm:text-sm font-medium text-slate-400">
        <span>Discusses:</span>{' '}
        {post.linkedAnime.slice(0, 2).map((anime: any, idx: number) => (
          <a
            href={`/anime/${anime.slug}`}
            class="text-indigo-600 hover:text-indigo-700 hover:underline transition-colors"
          >
            {anime.title}{idx < Math.min(post.linkedAnime?.length || 0, 2) - 1 ? ', ' : ''}
          </a>
        ))}
        {post.linkedAnime.length > 2 && (
          <span class="text-slate-400"> +{post.linkedAnime.length - 2} more</span>
        )}
      </div>
    )}

    <!-- Read Article Action -->
    <div class="flex items-center pt-1">
      <a
        href={`/blog/${post.slug}`}
        data-astro-prefetch="hover"
        class="btn-read-article inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-50 hover:bg-indigo-600 active:bg-indigo-700 text-slate-700 hover:text-white border border-slate-200/90 hover:border-indigo-600 text-xs sm:text-sm font-bold shadow-2xs hover:shadow-xs transition-all duration-200 active:scale-[0.98] cursor-pointer group/btn"
      >
        <span class="btn-read-label">Read article</span>
        <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-0.5 transition-transform shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
