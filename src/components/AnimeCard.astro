---
// src/components/AnimeCard.astro
import HonestyBadge from './HonestyBadge.astro';
import { optimizeTmdbPoster } from '../lib/image-utils.js';

interface Props {
  anime: any;
  priority?: boolean;
}

const { anime, priority = false } = Astro.props;

const isWatched = anime.honestyStatus === 'watched';
const isZeroFiller = anime.fillerPercentage === 0;
const isMovie = anime.type === 'movie';

// Format status styling
const normalizedStatus = (anime.status || '').trim().toLowerCase();
let statusBadgeClass = 'text-slate-700 bg-slate-100 border-slate-200/80';
let displayStatus = null;

if (normalizedStatus === 'currently airing' || normalizedStatus === 'airing') {
  statusBadgeClass = 'text-emerald-700 bg-emerald-50 border-emerald-200/80';
  displayStatus = 'Currently Airing';
} else if (normalizedStatus === 'upcoming') {
  statusBadgeClass = 'text-sky-700 bg-sky-50 border-sky-200/80';
  displayStatus = 'Upcoming';
} else if (normalizedStatus === 'season finished') {
  statusBadgeClass = 'text-amber-700 bg-amber-50 border-amber-200/80';
  displayStatus = 'Season Finished';
} else if (normalizedStatus === 'completed' || normalizedStatus === 'finished') {
  statusBadgeClass = 'text-slate-700 bg-slate-100 border-slate-200/80';
  displayStatus = 'Completed';
} else if (normalizedStatus) {
  displayStatus = anime.status;
}

// Parse genres for mobile chips (up to 2 or 3)
const rawGenres = anime.genres;
const genreList = Array.isArray(rawGenres)
  ? rawGenres
  : typeof rawGenres === 'string'
    ? rawGenres.split(',').map((g) => g.trim()).filter(Boolean)
    : [];
const mobileGenres = genreList.slice(0, 3);

// Rating formatting: e.g. ★ 8.5, ★ 9, ★ 10
const rawRating = anime.personalRating ?? anime.personal_rating ?? anime.rating;
const numRating = (rawRating !== null && rawRating !== undefined && rawRating !== '') ? Number(rawRating) : NaN;
const hasRating = !isNaN(numRating) && numRating > 0;
const formattedRating = hasRating ? (numRating % 1 === 0 ? numRating.toFixed(0) : numRating.toFixed(1)) : null;
---

<article
  class="group relative flex flex-row md:flex-col gap-3 md:gap-0 p-3 sm:p-3.5 md:p-4 rounded-2xl bg-white border border-slate-200/80 hover:border-slate-300 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-1 h-full items-start md:items-stretch"
  data-vibe={anime.vibes ? anime.vibes.join(' ') : ''}
  data-status={anime.honestyStatus}
  data-filler={anime.fillerPercentage === 0 ? 'zero' : 'has-filler'}
  data-type={anime.type || 'series'}
  data-community={anime.communitySuggested ? 'true' : 'false'}
  data-title={anime.title.toLowerCase()}
>
  <!-- Poster Image Container with Attached Top-Edge Rating Tab -->
  <a
    href={`/anime/${anime.slug}`}
    class:list={[
      'relative w-24 sm:w-28 md:w-full aspect-[2/3] mb-0 md:mb-3.5 shrink-0 block group/poster focus:outline-hidden',
      formattedRating ? 'mt-1.5 md:mt-2' : ''
    ]}
    aria-label={`View ${anime.title} details`}
  >
    {formattedRating && (
      <div
        class="absolute left-2 bottom-full translate-y-[2px] z-10 inline-flex items-center gap-1 px-2 py-0.5 rounded-t-md rounded-b-none bg-slate-900/95 backdrop-blur-xs border border-b-0 border-white/20 text-white text-[10px] sm:text-[11px] font-bold leading-none shadow-xs pointer-events-none tracking-tight select-none"
        title={`Personal Rating: ${formattedRating} / 10`}
      >
        <span class="text-amber-400 text-[10px]">★</span>
        <span>{formattedRating}</span>
      </div>
    )}
    <div class="w-full h-full rounded-lg md:rounded-xl overflow-hidden bg-slate-100 border border-slate-200/80 shadow-2xs">
      <img
        src={optimizeTmdbPoster(anime.poster, 'w342')}
        alt={`${anime.title} poster`}
        width="300"
        height="450"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
        class="w-full h-full object-cover object-center group-hover/poster:scale-[1.03] transition-transform duration-300 ease-out"
      />
    </div>
  </a>

  <!-- Mobile Content Section (< md viewports) -->
  <div class="flex md:hidden flex-col justify-between flex-1 min-w-0 py-0.5">
    <div>
      <!-- Title -->
      <h3 class="text-base font-bold text-gray-900 dark:text-white group-hover:text-[#6366F1] transition-colors line-clamp-2 leading-snug font-heading tracking-tight">
        <a href={`/anime/${anime.slug}`} class="hover:underline">
          {anime.title}
        </a>
      </h3>

      <!-- Sub-meta Line (Year · episodes/runtime) -->
      <div class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400 font-medium mt-0.5">
        <span>{anime.year}</span>
        <span class="text-gray-300 dark:text-gray-600">·</span>
        <span>{isMovie ? (anime.runtime ? `${anime.runtime}m` : 'Movie') : `${anime.episodes} eps`}</span>
      </div>

      <!-- Multiple Genre Tag Chips (Mobile Only) -->
      {mobileGenres.length > 0 && (
        <div class="flex flex-wrap items-center gap-1.5 mt-1.5">
          {mobileGenres.map((genre: string) => (
            <span class="inline-flex text-[11px] px-2 py-0.5 rounded-md bg-gray-100 dark:bg-gray-800/80 text-gray-600 dark:text-gray-300 font-medium">
              {genre}
            </span>
          ))}
        </div>
      )}

      <!-- Status & Watch Badges -->
      <div class="flex flex-wrap items-center gap-1.5 mt-2">
        <HonestyBadge status={anime.honestyStatus} size="sm" compact={true} />

        {anime.communitySuggested && (
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border tracking-wide select-none bg-sky-50 text-sky-700 border-sky-200/80 flex items-center gap-1 shadow-2xs" title="Community Suggested">
            <span>💡</span>
            <span>Suggested</span>
          </span>
        )}

        {isMovie ? (
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border tracking-wide select-none bg-purple-50 text-purple-700 border-purple-200">
            Movie
          </span>
        ) : (
          <span
            class:list={[
              'text-[10px] font-bold px-2 py-0.5 rounded-full border tracking-wide select-none',
              isZeroFiller
                ? 'bg-[#EEF2FF] text-[#4F46E5] border-[#C7D2FE]'
                : 'bg-slate-100 text-slate-700 border-slate-200'
            ]}
          >
            {isZeroFiller ? '0% Filler' : `${anime.fillerPercentage}% Filler`}
          </span>
        )}

        {displayStatus && (
          <span class:list={['text-[10px] font-semibold px-2 py-0.5 rounded border', statusBadgeClass]}>
            {displayStatus}
          </span>
        )}
      </div>
    </div>

    <!-- Footer Action Link -->
    <div class="pt-2 border-t border-slate-100 dark:border-slate-800/80 mt-2 flex items-center justify-start">
      <a
        href={`/anime/${anime.slug}`}
        aria-label={`View watch order and filler guide for ${anime.title}`}
        class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline transition-colors"
      >
        View Guide →
      </a>
    </div>
  </div>

  <!-- Desktop / Tablet Content Section (md: viewports and up - Original Vertical Layout) -->
  <div class="hidden md:flex flex-1 flex-col justify-between space-y-3">
    <div class="space-y-2">
      <!-- Badges Row: Honesty Status & Format / Filler Percentage -->
      <div class="flex items-center justify-between gap-1.5 flex-wrap">
        <HonestyBadge status={anime.honestyStatus} size="sm" />

        <div class="flex items-center gap-1.5 flex-wrap">
          {anime.communitySuggested && (
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border tracking-wide select-none bg-sky-50 text-sky-700 border-sky-200/80 flex items-center gap-1 shadow-2xs" title="Community Suggested">
              <span>💡</span>
              <span>Community Suggested</span>
            </span>
          )}

          {isMovie ? (
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border tracking-wide select-none bg-purple-50 text-purple-700 border-purple-200">
              Movie
            </span>
          ) : (
            <span
              class:list={[
                'text-[10px] font-bold px-2.5 py-0.5 rounded-full border tracking-wide select-none',
                isZeroFiller
                  ? 'bg-[#EEF2FF] text-[#4F46E5] border-[#C7D2FE]'
                  : 'bg-slate-100 text-slate-700 border-slate-200'
              ]}
            >
              {isZeroFiller ? '0% Filler' : `${anime.fillerPercentage}% Filler`}
            </span>
          )}
        </div>
      </div>

      <!-- Title -->
      <div>
        <h3 class="text-base font-bold text-[#0F172A] group-hover:text-[#6366F1] transition-colors line-clamp-1 leading-snug font-heading tracking-tight">
          <a href={`/anime/${anime.slug}`} class="hover:underline">
            {anime.title}
          </a>
        </h3>
      </div>

      <!-- Metadata (Year, Episodes / Runtime, Genres) -->
      <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <span>{anime.year}</span>
        <span class="text-slate-300">•</span>
        <span>{isMovie ? (anime.runtime ? `${anime.runtime}m` : 'Movie') : `${anime.episodes} eps`}</span>
        {anime.genres && anime.genres.length > 0 && (
          <>
            <span class="text-slate-300">•</span>
            <span class="truncate">{anime.genres.slice(0, 2).join(', ')}</span>
          </>
        )}
      </div>
    </div>

    <!-- Watch order cue & Status -->
    <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs">
      <a
        href={`/anime/${anime.slug}`}
        aria-label={`View watch order and filler guide for ${anime.title}`}
        class="text-[11px] font-bold text-[#4F46E5] hover:text-[#4338CA] hover:underline transition-colors"
      >
        {isMovie ? 'Movie Details & Guide →' : 'Watch Order & Guide →'}
      </a>
      {displayStatus && (
        <span class:list={['text-[10px] font-semibold px-2 py-0.5 rounded border', statusBadgeClass]}>
          {displayStatus}
        </span>
      )}
    </div>
  </div>
</article>
