---
// src/components/AnimeCard.astro
import HonestyBadge from './HonestyBadge.astro';
import { theme } from '../config/theme.js';

const { anime } = Astro.props;

const isWatched = anime.honestyStatus === 'watched';
const isZeroFiller = anime.fillerPercentage === 0;
---

<article
  class="group relative flex flex-col rounded-2xl bg-white border border-slate-200/80 hover:border-slate-300 shadow-xs hover:shadow-md transition-all duration-300 hover:-translate-y-1 p-3.5 sm:p-4 h-full"
  data-vibe={anime.vibes ? anime.vibes.join(' ') : ''}
  data-status={anime.honestyStatus}
  data-filler={anime.fillerPercentage === 0 ? 'zero' : 'has-filler'}
  data-title={anime.title.toLowerCase()}
>
  <!-- Poster Image Container (Cleanly contained with defined boundary, NO badges/overlays over artwork) -->
  <a href={`/anime/${anime.slug}`} class="relative w-full aspect-[2/3] rounded-xl overflow-hidden bg-slate-100 border border-slate-200/80 shadow-2xs mb-3.5 shrink-0 block group/poster">
    <img
      src={anime.poster}
      alt={`${anime.title} poster`}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-center group-hover/poster:scale-[1.03] transition-transform duration-300 ease-out"
    />
  </a>

  <!-- Content / Info Section (All status info, badges, and metadata below artwork) -->
  <div class="flex-1 flex flex-col justify-between space-y-3">
    <div class="space-y-2">
      
      <!-- Badges Row: Watched/Watchlist & Filler Percentage -->
      <div class="flex items-center justify-between gap-1.5 flex-wrap">
        <HonestyBadge status={anime.honestyStatus} size="sm" />

        <span
          class:list={[
            'text-[10px] font-bold px-2.5 py-0.5 rounded-full border tracking-wide select-none',
            isZeroFiller
              ? 'bg-[#EEF2FF] text-[#4F46E5] border-[#C7D2FE]'
              : 'bg-slate-100 text-slate-700 border-slate-200'
          ]}
        >
          {isZeroFiller ? '0% Filler' : `${anime.fillerPercentage}% Filler`}
        </span>
      </div>

      <!-- Title -->
      <div>
        <h3 class="text-base font-bold text-[#0F172A] group-hover:text-[#6366F1] transition-colors line-clamp-1 leading-snug font-heading tracking-tight">
          <a href={`/anime/${anime.slug}`} class="hover:underline">
            {anime.title}
          </a>
        </h3>
      </div>

      <!-- Metadata (Year, Episodes, Genres) -->
      <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
        <span>{anime.year}</span>
        <span class="text-slate-300">•</span>
        <span>{anime.episodes} eps</span>
        <span class="text-slate-300">•</span>
        <span class="truncate">{anime.genres.slice(0, 2).join(', ')}</span>
      </div>

    </div>

    <!-- Watch order cue & Status -->
    <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs">
      <a
        href={`/anime/${anime.slug}`}
        class="text-[11px] font-bold text-[#4F46E5] hover:text-[#4338CA] hover:underline transition-colors"
      >
        Watch Order & Guide →
      </a>
      <span class="text-[10px] font-medium text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200/60">
        {anime.status}
      </span>
    </div>
  </div>
</article>
