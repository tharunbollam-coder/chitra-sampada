---
// src/components/anime/TabCharacters.astro
const { anime } = Astro.props;
const characters = anime.characters || [];
---

<div class="space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-5 border-b border-slate-100">
      <div>
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#0F172A]">
          Ranked Characters & Category Standouts
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-normal mt-1">
          Key character rankings categorized by writing depth, emotional resonance, and universe impact.
        </p>
      </div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200 shrink-0 self-start sm:self-auto">
        {characters.length} Ranked
      </span>
    </div>

    <!-- Ranked Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
      {characters.map((char) => (
        <div class="p-5 rounded-2xl bg-white hover:bg-slate-50/60 border border-slate-200/90 shadow-2xs transition-all duration-200 flex flex-col justify-between gap-3">
          
          <div class="space-y-2">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-xl bg-[#0F172A] text-white font-extrabold text-xs flex items-center justify-center shrink-0">
                  #{char.rank}
                </span>
                <div>
                  <h3 class="font-heading font-bold text-base sm:text-lg text-[#0F172A] leading-tight">
                    {char.name}
                  </h3>
                  {char.role && (
                    <p class="text-xs text-slate-500 font-medium">
                      {char.role}
                    </p>
                  )}
                </div>
              </div>

              <span class="text-[11px] font-bold px-2.5 py-1 rounded-lg bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] shrink-0">
                {char.category}
              </span>
            </div>

            {char.commentary && (
              <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed pt-1">
                {char.commentary}
              </p>
            )}
          </div>

        </div>
      ))}
    </div>
  </div>
</div>
