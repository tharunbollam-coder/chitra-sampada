---
// src/components/anime/TabUniverse.astro
interface Props {
  anime: any;
}

const { anime } = Astro.props;
const universe = Array.isArray(anime.universe) ? anime.universe : [];

const canonItems = universe.filter(item => item.section === 'canon');
const nonCanonItems = universe.filter(item => item.section === 'non_canon');

function getBadgeStyle(badge: string, isCanon: boolean) {
  const b = (badge || '').toLowerCase();
  if (b.includes('main')) {
    return 'bg-indigo-50 text-indigo-700 border-indigo-200/80';
  }
  if (b.includes('sequel') || b.includes('prequel')) {
    return 'bg-emerald-50 text-emerald-700 border-emerald-200/80';
  }
  if (b.includes('canon movie')) {
    return 'bg-teal-50 text-teal-700 border-teal-200/80';
  }
  if (b.includes('non-canon') || b.includes('movie')) {
    return 'bg-amber-50 text-amber-700 border-amber-200/80';
  }
  if (b.includes('spin-off') || b.includes('spinoff')) {
    return 'bg-purple-50 text-purple-700 border-purple-200/80';
  }
  if (b.includes('ova') || b.includes('special')) {
    return 'bg-rose-50 text-rose-700 border-rose-200/80';
  }
  return isCanon
    ? 'bg-indigo-50 text-indigo-700 border-indigo-200/80'
    : 'bg-slate-100 text-slate-700 border-slate-200/80';
}
---

<div class="space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs">
    <!-- Tab Main Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-5 border-b border-slate-100">
      <div>
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#0F172A]">
          Related & Universe Media
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-normal mt-1">
          Complete franchise directory for {anime.title}. Explore canonical storyline entries alongside standalone spin-offs, movies, and specials.
        </p>
      </div>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] shrink-0 self-start sm:self-auto shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1]"></span>
        {universe.length} {universe.length === 1 ? 'Media Entry' : 'Media Entries'}
      </span>
    </div>

    {universe.length === 0 ? (
      <div class="py-12 text-center space-y-3">
        <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 text-slate-400 flex items-center justify-center">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <h3 class="font-semibold text-slate-800 text-base">No Universe Media Listed Yet</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Additional franchise media and spin-offs for {anime.title} will appear here once cataloged.
        </p>
      </div>
    ) : (
      <div class="space-y-8 mt-6">
        <!-- SECTION 1: OFFICIAL CANON STORYLINE -->
        {canonItems.length > 0 && (
          <div class="space-y-4">
            <div class="flex items-center gap-2.5 pb-2 border-b border-slate-100">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-xs shadow-emerald-500/50"></span>
              <h3 class="font-heading font-bold text-base sm:text-lg text-[#0F172A]">
                Official Canon Storyline
              </h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200/70 ml-auto">
                {canonItems.length} {canonItems.length === 1 ? 'Title' : 'Titles'}
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500">
              The core narrative arc following the author's official manga and primary storyline.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
              {canonItems.map((item, idx) => (
                <div class="bg-slate-50/70 hover:bg-slate-50 border border-slate-200/90 rounded-2xl p-4 sm:p-5 flex flex-col justify-between gap-3.5 transition-all duration-200 shadow-2xs">
                  <div class="space-y-2">
                    <div class="flex items-start justify-between gap-2">
                      <div class="flex items-center gap-2 flex-1">
                        <span class="w-6 h-6 rounded-lg bg-emerald-100/80 text-emerald-800 text-xs font-bold flex items-center justify-center shrink-0">
                          {idx + 1}
                        </span>
                        <h4 class="font-heading font-bold text-slate-900 text-sm sm:text-base leading-snug">
                          {item.title}
                        </h4>
                      </div>
                      <span class:list={[
                        'text-[11px] font-bold px-2.5 py-0.5 rounded-full border shrink-0',
                        getBadgeStyle(item.badge, true)
                      ]}>
                        {item.badge}
                      </span>
                    </div>

                    {item.editorialNote && (
                      <div class="p-3 rounded-xl bg-white border border-slate-200/80 text-xs text-slate-600 leading-relaxed flex items-start gap-2 shadow-2xs">
                        <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>{item.editorialNote}</span>
                      </div>
                    )}
                  </div>

                  <div class="pt-2 border-t border-slate-200/70 flex items-center justify-between">
                    <span class="text-[11px] font-medium text-slate-400">Franchise Canon</span>
                    {item.linkSlug ? (
                      <a
                        href={`/anime/${item.linkSlug}`}
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-xs transition-colors"
                      >
                        <span>View Details</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </a>
                    ) : (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-200/70 text-slate-500 text-xs font-medium">
                        Unlisted on Platform
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- SECTION 2: NON-CANON, SPIN-OFFS & SPECIALS -->
        {nonCanonItems.length > 0 && (
          <div class="space-y-4 pt-2">
            <div class="flex items-center gap-2.5 pb-2 border-b border-slate-100">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shadow-xs shadow-amber-500/50"></span>
              <h3 class="font-heading font-bold text-base sm:text-lg text-[#0F172A]">
                Non-Canon, Spin-offs & Specials
              </h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200/70 ml-auto">
                {nonCanonItems.length} {nonCanonItems.length === 1 ? 'Title' : 'Titles'}
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-500">
              Standalone theatrical adventures, parody spin-offs, and original OVAs created outside of the main storyline continuity.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-1">
              {nonCanonItems.map((item, idx) => (
                <div class="bg-slate-50/70 hover:bg-slate-50 border border-slate-200/90 rounded-2xl p-4 sm:p-5 flex flex-col justify-between gap-3.5 transition-all duration-200 shadow-2xs">
                  <div class="space-y-2">
                    <div class="flex items-start justify-between gap-2">
                      <div class="flex items-center gap-2 flex-1">
                        <span class="w-6 h-6 rounded-lg bg-amber-100/80 text-amber-800 text-xs font-bold flex items-center justify-center shrink-0">
                          {idx + 1}
                        </span>
                        <h4 class="font-heading font-bold text-slate-900 text-sm sm:text-base leading-snug">
                          {item.title}
                        </h4>
                      </div>
                      <span class:list={[
                        'text-[11px] font-bold px-2.5 py-0.5 rounded-full border shrink-0',
                        getBadgeStyle(item.badge, false)
                      ]}>
                        {item.badge}
                      </span>
                    </div>

                    {item.editorialNote && (
                      <div class="p-3 rounded-xl bg-white border border-slate-200/80 text-xs text-slate-600 leading-relaxed flex items-start gap-2 shadow-2xs">
                        <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>{item.editorialNote}</span>
                      </div>
                    )}
                  </div>

                  <div class="pt-2 border-t border-slate-200/70 flex items-center justify-between">
                    <span class="text-[11px] font-medium text-slate-400">Standalone Media</span>
                    {item.linkSlug ? (
                      <a
                        href={`/anime/${item.linkSlug}`}
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs shadow-xs transition-colors"
                      >
                        <span>View Details</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </a>
                    ) : (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-200/70 text-slate-500 text-xs font-medium">
                        Unlisted on Platform
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</div>
