---
// src/components/anime/TabSource.astro
const { anime } = Astro.props;
const source = anime.source || {};
---

<div class="space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-5 border-b border-slate-100">
      <div>
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#0F172A]">
          Manga & Light Novel Source Guide
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-normal mt-1">
          Practical advice on where to continue reading in the original source, followed by publishing reference details.
        </p>
      </div>
      {source.adaptationStatus && (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200 shrink-0 self-start sm:self-auto">
          {source.adaptationStatus}
        </span>
      )}
    </div>

    <!-- 1. Personal Reading Guidance (Start reading here) -->
    <div class="p-5 sm:p-6 rounded-2xl bg-[#EEF2FF]/40 border border-[#C7D2FE]/70 shadow-2xs space-y-2.5">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-[#4F46E5] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span class="text-xs font-bold uppercase tracking-wider text-[#4F46E5]">Where to Pick Up the Story</span>
      </div>

      <p class="text-sm sm:text-base text-slate-800 font-medium leading-relaxed">
        {source.notes || 'Refer to the adaptation coverage details below to pick up where the anime leaves off in the original source material.'}
      </p>
    </div>

    <!-- 2. Source Material Reference Facts -->
    <div class="space-y-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">
        Source Material Reference
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Source Title</span>
          <span class="text-xs sm:text-sm font-bold text-slate-900 leading-snug truncate block mt-1">{source.title || 'N/A'}</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Format & Creator</span>
          <span class="text-xs sm:text-sm font-semibold text-slate-800 truncate block mt-1">{source.type || 'Manga'} • {source.author || 'N/A'}</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Total Volumes / Chapters</span>
          <span class="text-xs sm:text-sm font-semibold text-slate-800 truncate block mt-1">{source.volumes || 'N/A'}</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Publication Status</span>
          <span class="text-xs sm:text-sm font-semibold text-slate-800 truncate block mt-1">{source.publicationStatus || 'N/A'}</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 sm:col-span-2 lg:col-span-2">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Anime Adaptation Coverage</span>
          <span class="text-xs sm:text-sm font-semibold text-slate-800 block mt-1">{source.coverage || 'N/A'}</span>
        </div>
      </div>
    </div>
  </div>
</div>
