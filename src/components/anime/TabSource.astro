---
// src/components/anime/TabSource.astro
interface Props {
  anime: any;
}

const { anime } = Astro.props;
const source = anime?.source || {};

// Field extraction mapping cleanly to both object properties and database columns
const sourceTitle = source.title || source.source_title || anime?.source_title || '';
const authorCreator = source.author || source.author_creator || source.source_author || anime?.source_author || '';
const sourceType = source.type || source.source_type || anime?.source_type || 'Manga';
const publicationStatus = source.publicationStatus || source.publication_status || source.source_publication_status || anime?.source_publication_status || '';
const volumesChapters = source.volumes || source.volumes_chapters || source.source_volumes || anime?.source_volumes || '';
const animeAdaptationCoverage = source.coverage || source.anime_adaptation_coverage || source.source_coverage || anime?.source_coverage || '';
const readingRecommendation = source.notes || source.reading_recommendation || source.source_notes || anime?.source_notes || '';

const hasAnySourceInfo = Boolean(
  sourceTitle ||
  readingRecommendation ||
  animeAdaptationCoverage ||
  volumesChapters ||
  authorCreator
);

// Determine publication status indicator & badge styling
const normalizedStatus = (publicationStatus || '').trim().toLowerCase();
const isOngoing = normalizedStatus.includes('ongoing');
const isCompleted = normalizedStatus.includes('completed');

let statusDotColor = 'bg-slate-400';
let statusTextColor = 'text-slate-700';
let statusBadgeClass = 'bg-slate-100 text-slate-700 border-slate-200/80';

if (isOngoing) {
  statusDotColor = 'bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]';
  statusTextColor = 'text-emerald-700';
  statusBadgeClass = 'bg-emerald-50 text-emerald-700 border-emerald-200/80';
} else if (isCompleted) {
  statusDotColor = 'bg-sky-500 shadow-[0_0_8px_rgba(14,165,233,0.5)]';
  statusTextColor = 'text-sky-700';
  statusBadgeClass = 'bg-sky-50 text-sky-700 border-sky-200/80';
} else if (normalizedStatus.includes('hiatus')) {
  statusDotColor = 'bg-amber-500 shadow-[0_0_8px_rgba(245,158,11,0.5)]';
  statusTextColor = 'text-amber-700';
  statusBadgeClass = 'bg-amber-50 text-amber-700 border-amber-200/80';
}

// Beginner-friendly context headlines and explainers
const normalizedType = (sourceType || '').trim().toLowerCase();
let adaptationHeadline = 'Adapted from Manga';
let adaptationExplainer = 'Manga is a Japanese comic book or graphic novel, traditionally read from right to left.';

if (normalizedType.includes('manhwa') || normalizedType.includes('webtoon')) {
  adaptationHeadline = `Adapted from ${sourceType}`;
  adaptationExplainer = 'A Korean digital comic format originally produced in full color and read in a continuous vertical scroll.';
} else if (normalizedType.includes('light novel')) {
  adaptationHeadline = 'Adapted from Light Novel';
  adaptationExplainer = 'A Light Novel is a Japanese novella format featuring anime-style character illustrations and fast-paced narratives.';
} else if (normalizedType.includes('web novel')) {
  adaptationHeadline = 'Adapted from Web Novel';
  adaptationExplainer = 'A serialized digital novel originally published online on web fiction platforms before official book publication.';
} else if (normalizedType.includes('visual novel') || normalizedType.includes('game')) {
  adaptationHeadline = `Adapted from ${sourceType}`;
  adaptationExplainer = 'An interactive story or video game adapted into an animated television format.';
} else if (normalizedType.includes('original')) {
  adaptationHeadline = 'Original Anime Production';
  adaptationExplainer = 'This is an original anime production written specifically for the screen, not adapted from a pre-existing book or comic.';
} else if (sourceType && sourceType.trim().length > 0) {
  adaptationHeadline = `Adapted from ${sourceType}`;
  adaptationExplainer = `Original work and published source material for ${anime.title}.`;
}

const displaySourceTitle = sourceTitle || anime.title || 'Original Source';
---

{hasAnySourceInfo ? (
  <div class="space-y-6">
    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-6">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-slate-100">
        <div>
          <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#0F172A]">
            Manga & Light Novel Source Guide
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 font-normal mt-1">
            Everything you need to know about the original source material and where to continue the story.
          </p>
        </div>
        {sourceType && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] shrink-0 self-start sm:self-auto shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1]"></span>
            {sourceType} Guide
          </span>
        )}
      </div>

      <div class="space-y-6">
        <!-- 1. Beginner-Friendly Context Banner -->
        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
          <div class="flex items-start sm:items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-indigo-600 shadow-2xs shrink-0 mt-0.5 sm:mt-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div class="space-y-0.5">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-heading font-bold text-sm sm:text-base text-slate-900">
                  {adaptationHeadline}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed">
                {adaptationExplainer}
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Primary Focus: Where to Continue the Story (Hero Card) -->
        <div class="p-6 sm:p-7 rounded-2xl bg-gradient-to-br from-indigo-50/70 via-white to-slate-50/70 border border-indigo-100/90 shadow-2xs space-y-3.5">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <div class="inline-flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#6366F1]"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-[#4F46E5]">
                Reading Priority
              </span>
            </div>
            {publicationStatus && (
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold border shadow-2xs ${statusBadgeClass}`}>
                <span class={`w-1.5 h-1.5 rounded-full ${statusDotColor}`}></span>
                <span>{publicationStatus}</span>
              </span>
            )}
          </div>

          <div class="space-y-1">
            <h3 class="font-heading text-lg sm:text-xl font-bold text-[#0F172A] tracking-tight">
              Where to Continue the Story
            </h3>
          </div>

          <div class="pt-1">
            {readingRecommendation ? (
              <p class="text-base sm:text-lg text-slate-800 font-medium leading-relaxed">
                {readingRecommendation}
              </p>
            ) : (
              <p class="text-sm sm:text-base text-slate-600 font-normal leading-relaxed">
                To continue past the anime, pick up the source material following the current adaptation coverage.
              </p>
            )}
          </div>
        </div>

        <!-- 3. Key Details Grid (2 Columns on Desktop, 1 on Mobile) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Card 1: Original Work & Author -->
          <div class="p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 shadow-2xs flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                Original Work & Author
              </span>
              <div class="w-7 h-7 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-indigo-600 shadow-2xs shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
              </div>
            </div>
            <div class="space-y-1">
              <span class="text-base sm:text-lg font-bold text-slate-900 leading-snug block">
                {displaySourceTitle}
              </span>
              {authorCreator ? (
                <span class="text-xs sm:text-sm text-slate-600 font-medium block">
                  by {authorCreator}
                </span>
              ) : null}
            </div>
          </div>

          <!-- Card 2: Publication Status -->
          <div class="p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 shadow-2xs flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                Publication Status
              </span>
              <div class="w-7 h-7 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-indigo-600 shadow-2xs shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
            <div class="flex items-center gap-2">
              {publicationStatus ? (
                <>
                  <span class={`w-2.5 h-2.5 rounded-full ${statusDotColor} shrink-0`}></span>
                  <span class={`text-base sm:text-lg font-bold ${statusTextColor} leading-snug`}>
                    {publicationStatus}
                  </span>
                </>
              ) : (
                <span class="text-base sm:text-lg font-bold text-slate-400 leading-snug">—</span>
              )}
            </div>
          </div>

          <!-- Card 3: Total Releases -->
          <div class="p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 shadow-2xs flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                Total Releases
              </span>
              <div class="w-7 h-7 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-indigo-600 shadow-2xs shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
            </div>
            <div>
              <span class="text-base sm:text-lg font-bold text-slate-900 leading-snug block">
                {volumesChapters || '—'}
              </span>
            </div>
          </div>

          <!-- Card 4: Anime Adapted -->
          <div class="p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 shadow-2xs flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                Anime Adapted
              </span>
              <div class="w-7 h-7 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-indigo-600 shadow-2xs shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
            <div>
              <span class="text-base sm:text-lg font-bold text-slate-900 leading-snug block">
                {animeAdaptationCoverage || '—'}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
) : null}
