---
// src/components/anime/TabSource.astro
const { anime } = Astro.props;
const source = anime.source || {};
---

<div class="space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-5 border-b border-slate-100">
      <div>
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-slate-900">
          Source Material & Adaptation Progress
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 font-normal mt-1">
          Details on the original published work, volume counts, and where the anime picks up or finishes in relation to the source.
        </p>
      </div>
      {source.adaptationStatus && (
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200 shrink-0 self-start sm:self-auto">
          {source.adaptationStatus}
        </span>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mt-6">
      <!-- Left: Source Details Matrix -->
      <div class="md:col-span-5 space-y-4">
        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-3.5">
          <div>
            <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Source Title</span>
            <span class="text-base font-bold text-slate-900 leading-snug">{source.title}</span>
            {source.originalTitle && (
              <span class="block text-xs text-slate-500 font-normal">{source.originalTitle}</span>
            )}
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1 border-t border-slate-200/60">
            <div>
              <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Format</span>
              <span class="text-sm font-semibold text-slate-900">{source.type || 'Manga'}</span>
            </div>
            <div>
              <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Volumes / Chapters</span>
              <span class="text-sm font-semibold text-slate-900">{source.volumes || 'N/A'}</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-1 border-t border-slate-200/60">
            <div>
              <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Author / Creator</span>
              <span class="text-sm font-semibold text-slate-900">{source.author || 'N/A'}</span>
            </div>
            <div>
              <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Publication</span>
              <span class="text-sm font-semibold text-slate-900">{source.publicationStatus || 'N/A'}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Adaptation Coverage & Reading Guidance -->
      <div class="md:col-span-7 space-y-4">
        <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs space-y-3">
          <div class="flex items-center gap-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-red-600">Adaptation Coverage</span>
          </div>
          <p class="text-sm text-slate-700 font-normal leading-relaxed">
            {source.coverage || 'Adapted faithfully from the original source material.'}
          </p>

          {source.notes && (
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs sm:text-sm text-slate-600 font-normal leading-relaxed mt-2">
              <strong class="text-slate-900 font-semibold">Reading Tip:</strong> {source.notes}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</div>
