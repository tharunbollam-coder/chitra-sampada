---
// src/components/anime/TabFillerList.astro
const { anime } = Astro.props;
const fillerData = anime.fillerList || {};
const types = fillerData.types || [];

const mangaCanonCount = types.find((t) => t.type === 'Manga Canon')?.count || 0;
const animeCanonCount = types.find((t) => t.type === 'Anime Canon')?.count || 0;
const mixedCount = types.find((t) => t.type === 'Mixed Canon/Filler')?.count || 0;
const fillerCount = types.find((t) => t.type === 'Filler')?.count || 0;

const totalEpisodes = types.length > 0
  ? (mangaCanonCount + animeCanonCount + mixedCount + fillerCount)
  : (fillerData.totalEpisodes || anime.episodes || 0);

const canonEpisodes = types.length > 0
  ? (mangaCanonCount + animeCanonCount)
  : (fillerData.canonEpisodes || 0);

const fillerPercentage = totalEpisodes > 0
  ? Math.min(100, Math.round((fillerCount / totalEpisodes) * 100))
  : (fillerData.fillerPercentage ?? anime.fillerPercentage ?? 0);

const isZeroFiller = fillerPercentage === 0;

// Type configurations for headers, styling, and badges
const TYPE_CONFIG = {
  'Manga Canon': {
    badge: 'bg-emerald-100 text-emerald-900 border-emerald-300',
    container: 'bg-slate-50/70 border-slate-200 text-slate-800',
    dot: 'bg-emerald-500',
    label: 'Manga Canon',
    tagline: 'Directly adapts the manga story, no additions.'
  },
  'Anime Canon': {
    badge: 'bg-sky-100 text-sky-900 border-sky-300',
    container: 'bg-slate-50/70 border-slate-200 text-slate-800',
    dot: 'bg-sky-500',
    label: 'Anime Canon',
    tagline: 'Not from the manga, but still official/legitimate story content — usually written or approved by the original creator, not just filler padding.'
  },
  'Mixed Canon/Filler': {
    badge: 'bg-purple-100 text-purple-900 border-purple-300',
    container: 'bg-slate-50/70 border-slate-200 text-slate-800',
    dot: 'bg-purple-500',
    label: 'Mixed Canon / Filler',
    tagline: 'A single episode that blends real story content with anime-only padding added within that same episode.'
  },
  'Filler': {
    badge: 'bg-amber-100 text-amber-900 border-amber-300',
    container: 'bg-amber-50/40 border-amber-200/90 text-amber-950',
    dot: 'bg-amber-500',
    label: 'Filler Episodes (Skippable)',
    tagline: 'Entirely anime-original content unrelated to the manga story — fully skippable.'
  }
};
---

<div class="space-y-6">
  <!-- Filler Summary Banner -->
  <div class:list={[
    'rounded-2xl border p-6 sm:p-7 shadow-xs',
    isZeroFiller
      ? 'bg-[#EEF2FF]/50 border-[#C7D2FE]'
      : 'bg-white border-slate-200'
  ]}>
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-slate-200/80">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Filler Breakdown</span>
          <span class:list={[
            'text-[11px] font-bold px-2.5 py-0.5 rounded-full border',
            isZeroFiller
              ? 'bg-[#EEF2FF] text-[#4F46E5] border-[#C7D2FE]'
              : 'bg-slate-100 text-slate-800 border-slate-300'
          ]}>
            {isZeroFiller ? '0% Filler' : `${fillerPercentage}% Filler Content`}
          </span>
        </div>
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#0F172A]">
          Canon & Filler Episode Guide
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 font-normal mt-1.5 max-w-2xl leading-relaxed">
          <strong class="text-slate-900 font-semibold">Manga Canon</strong> directly adapts the manga story, no additions. <strong class="text-slate-900 font-semibold">Anime Canon</strong> is official story content written or approved by the creator (not in the manga). <strong class="text-slate-900 font-semibold">Mixed Canon/Filler</strong> refers to single episodes that blend real story content with anime-only padding within the same episode. <strong class="text-slate-900 font-semibold">Filler</strong> is entirely anime-original and fully skippable.
        </p>
      </div>

      <!-- Quick Metrics Matrix -->
      <div class="flex items-center gap-3 shrink-0 flex-wrap sm:flex-nowrap">
        <div class="px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[90px]">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-500">Total</span>
          <span class="text-base font-extrabold text-[#0F172A]">{totalEpisodes} eps</span>
        </div>
        <div class="px-4 py-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-center min-w-[90px]">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-emerald-700">Canon</span>
          <span class="text-base font-extrabold text-emerald-950">{canonEpisodes} eps</span>
        </div>
        {mixedCount > 0 && (
          <div class="px-4 py-2.5 rounded-xl bg-purple-50 border border-purple-200 text-center min-w-[90px]">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-purple-700">Mixed</span>
            <span class="text-base font-extrabold text-purple-950">{mixedCount} eps</span>
          </div>
        )}
        {!isZeroFiller && (
          <div class="px-4 py-2.5 rounded-xl bg-amber-50 border border-amber-200 text-center min-w-[90px]">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-amber-700">Filler</span>
            <span class="text-base font-extrabold text-amber-950">{fillerCount} eps</span>
          </div>
        )}
      </div>
    </div>

    <!-- Episode Sections per Active Category (Flowing Text Layout) -->
    <div class="mt-6 space-y-5">
      {types.map((entry) => {
        const conf = TYPE_CONFIG[entry.type] || {
          badge: 'bg-slate-100 text-slate-800 border-slate-300',
          container: 'bg-slate-50/70 border-slate-200 text-slate-800',
          dot: 'bg-slate-400',
          label: entry.type,
          tagline: ''
        };
        const isFillerType = entry.type === 'Filler';

        return (
          <div class:list={[
            'p-5 sm:p-6 rounded-2xl border transition-colors',
            isFillerType
              ? 'bg-amber-50/20 border-amber-200/90 shadow-xs'
              : 'bg-slate-50/40 border-slate-200/80'
          ]}>
            <!-- Section Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-3 border-b border-slate-200/70">
              <div class="flex items-center gap-2.5">
                <span class:list={['w-2.5 h-2.5 rounded-full shrink-0', conf.dot]}></span>
                <h3 class:list={[
                  'text-base font-bold font-heading',
                  isFillerType ? 'text-amber-950' : 'text-slate-900'
                ]}>
                  {conf.label}
                </h3>
                {conf.tagline && (
                  <span class="hidden md:inline text-xs text-slate-500 font-normal">
                    — {conf.tagline}
                  </span>
                )}
              </div>
              <div class="flex items-center gap-2">
                <span class:list={['text-xs font-bold px-2.5 py-0.5 rounded-full border', conf.badge]}>
                  {entry.count} {entry.count === 1 ? 'Episode' : 'Episodes'}
                </span>
              </div>
            </div>

            <!-- Flowing Episodes String -->
            <div class:list={[
              'p-4 rounded-xl border text-sm sm:text-base font-mono leading-relaxed break-words tracking-wide select-all shadow-2xs',
              isFillerType
                ? 'bg-amber-50/70 border-amber-200/90 text-amber-950 font-medium'
                : 'bg-white border-slate-200 text-slate-800'
            ]}>
              {entry.episodes}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>
