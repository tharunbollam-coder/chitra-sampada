---
// src/components/anime/HeroLetterBoxes.astro
---

<div class="w-full max-w-5xl mx-auto py-12 sm:py-20 flex flex-col items-center justify-center select-none overflow-hidden">
  <!-- 3D Perspective Stage -->
  <div
    id="hero-3d-stage"
    class="w-full flex items-center justify-center min-h-[90px] sm:min-h-[140px] px-2 sm:px-4"
    style="perspective: 1200px; perspective-origin: 50% 50%;"
  >
    <!-- Dynamic Letter Boxes Container -->
    <div
      id="hero-boxes-row"
      class="flex items-center justify-center flex-wrap sm:flex-nowrap gap-1 sm:gap-2.5 transition-all duration-300"
      style="transform-style: preserve-3d;"
    >
      <!-- Boxes dynamically created and manipulated via script -->
    </div>
  </div>
</div>

<style>
  .letter-box-3d {
    transform-style: preserve-3d;
    backface-visibility: visible;
    will-change: transform, opacity;
  }
</style>

<script>
  let heroIntervalId = null;
  let heroResizeHandler = null;

  function initHeroLetterBoxes() {
    // Clean up any existing loop or resize handler
    if (heroIntervalId) {
      clearInterval(heroIntervalId);
      heroIntervalId = null;
    }
    if (heroResizeHandler) {
      window.removeEventListener('resize', heroResizeHandler);
      heroResizeHandler = null;
    }

    const stage = document.getElementById('hero-3d-stage');
    const container = document.getElementById('hero-boxes-row');

    if (!container || !stage) return;

    const words = [
      "Watch Orders",
      "Filler Lists",
      "Character Rankings",
      "Trope Filters"
    ];

    let currentIndex = 0;
    let isAnimating = false;
    let currentBoxes = [];

    // Calculate responsive box size based on word length and container width
    function getBoxDimensions(text) {
      const containerWidth = Math.min(window.innerWidth - 32, 1024);
      const totalChars = text.length;
      
      // Calculate max width per box
      const gapSize = window.innerWidth < 640 ? 3 : 8;
      const totalGaps = (totalChars - 1) * gapSize;
      const availableWidth = containerWidth - totalGaps;
      
      const maxBoxSize = window.innerWidth < 640 ? 38 : 64;
      const minBoxSize = 16;
      
      const computedSize = Math.max(minBoxSize, Math.min(maxBoxSize, Math.floor(availableWidth / totalChars)));
      const fontSize = Math.max(10, Math.floor(computedSize * 0.52));

      return {
        boxSize: computedSize,
        fontSize: fontSize,
        gap: gapSize
      };
    }

    // Create a single 3D letter box element
    function createBoxElement(char, isSpace, dimensions) {
      const wrapper = document.createElement('div');
      wrapper.className = 'letter-box-3d relative flex items-center justify-center transition-all';
      
      if (isSpace) {
        // Space divider between words
        const spaceWidth = Math.max(6, Math.floor(dimensions.boxSize * 0.45));
        wrapper.style.width = spaceWidth + 'px';
        wrapper.style.height = dimensions.boxSize + 'px';
        wrapper.setAttribute('data-is-space', 'true');
        return wrapper;
      }

      wrapper.style.width = dimensions.boxSize + 'px';
      wrapper.style.height = dimensions.boxSize + 'px';
      wrapper.style.borderRadius = Math.max(4, Math.floor(dimensions.boxSize * 0.2)) + 'px';
      wrapper.style.border = '1.5px solid #0f172a';
      wrapper.style.backgroundColor = '#ffffff';
      wrapper.style.boxShadow = '0 2px 8px -1px rgba(15, 23, 42, 0.08)';

      const span = document.createElement('span');
      span.textContent = char;
      span.className = 'font-heading font-extrabold text-slate-900 leading-none select-none';
      span.style.fontSize = dimensions.fontSize + 'px';

      wrapper.appendChild(span);
      return wrapper;
    }

    // Render word into the container
    function renderWord(word, animateIn) {
      const dimensions = getBoxDimensions(word);
      container.style.gap = dimensions.gap + 'px';
      container.innerHTML = '';
      currentBoxes = [];

      for (let i = 0; i < word.length; i++) {
        const char = word[i];
        const isSpace = char === ' ';
        const box = createBoxElement(char, isSpace, dimensions);
        
        if (animateIn && !isSpace) {
          // Start rotated/scaled for assembly snap
          const rotX = (Math.random() - 0.5) * 60;
          const rotY = (Math.random() - 0.5) * 90;
          const transZ = 40 + Math.random() * 60;
          box.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg) translateZ(${transZ}px) scale(0.85)`;
          box.style.opacity = '0';
        }

        container.appendChild(box);
        currentBoxes.push({ element: box, isSpace: isSpace });
      }

      if (animateIn) {
        // Trigger assembly animation with slight stagger
        requestAnimationFrame(() => {
          currentBoxes.forEach((item, index) => {
            if (item.isSpace) return;
            setTimeout(() => {
              item.element.style.transition = 'transform 0.65s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.4s ease, box-shadow 0.4s ease';
              item.element.style.transform = 'rotateX(0deg) rotateY(0deg) rotateZ(0deg) translate3d(0, 0, 0) scale(1)';
              item.element.style.opacity = '1';
              item.element.style.boxShadow = '0 3px 10px -1px rgba(15, 23, 42, 0.1)';
            }, index * 25);
          });
        });
      }
    }

    // Tumble & Shuffle out transition
    function transitionToNextWord() {
      if (isAnimating) return;
      if (!document.body.contains(container)) {
        if (heroIntervalId) {
          clearInterval(heroIntervalId);
          heroIntervalId = null;
        }
        return;
      }
      isAnimating = true;

      const nextIndex = (currentIndex + 1) % words.length;
      const nextWord = words[nextIndex];

      // Phase 1: 3D Tumble & Separate
      currentBoxes.forEach((item, index) => {
        if (item.isSpace) return;
        
        const randomRotX = (Math.random() > 0.5 ? 1 : -1) * (120 + Math.random() * 180);
        const randomRotY = (Math.random() > 0.5 ? 1 : -1) * (120 + Math.random() * 180);
        const randomRotZ = (Math.random() - 0.5) * 90;
        const randomTransX = (Math.random() - 0.5) * 80;
        const randomTransY = (Math.random() - 0.5) * 60 - 20;
        const randomTransZ = -50 + Math.random() * 100;

        const delay = index * 20;

        setTimeout(() => {
          item.element.style.transition = 'transform 0.55s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.45s ease, box-shadow 0.45s ease';
          item.element.style.transform = `translate3d(${randomTransX}px, ${randomTransY}px, ${randomTransZ}px) rotateX(${randomRotX}deg) rotateY(${randomRotY}deg) rotateZ(${randomRotZ}deg) scale(0.7)`;
          item.element.style.opacity = '0';
          item.element.style.boxShadow = '0 20px 25px -5px rgba(0, 0, 0, 0.15)';
        }, delay);
      });

      // Phase 2: After boxes disperse, swap to next word and reassemble
      const totalOutDuration = currentBoxes.length * 20 + 450;

      setTimeout(() => {
        if (!document.body.contains(container)) return;
        currentIndex = nextIndex;
        renderWord(nextWord, true);

        // Allow animation to complete before next cycle
        const assemblyDuration = nextWord.length * 25 + 700;
        setTimeout(() => {
          isAnimating = false;
        }, assemblyDuration);

      }, totalOutDuration);
    }

    // Initial render
    renderWord(words[currentIndex], false);

    // Continuous loop: Pause between word completions
    heroIntervalId = setInterval(() => {
      if (!document.hidden && !isAnimating) {
        transitionToNextWord();
      }
    }, 3600);

    // Handle window resize dynamically to ensure zero overflow on mobile
    let resizeTimeout;
    heroResizeHandler = () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        if (!isAnimating && document.body.contains(container)) {
          renderWord(words[currentIndex], false);
        }
      }, 150);
    };
    window.addEventListener('resize', heroResizeHandler);
  }

  // Cleanup on View Transition page swap
  document.addEventListener('astro:before-swap', () => {
    if (heroIntervalId) {
      clearInterval(heroIntervalId);
      heroIntervalId = null;
    }
  });

  // Initial load
  initHeroLetterBoxes();

  // Re-run on every View Transitions navigation
  document.addEventListener('astro:page-load', initHeroLetterBoxes);
</script>
