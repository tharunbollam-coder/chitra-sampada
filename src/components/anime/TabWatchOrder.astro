---
// src/components/anime/TabWatchOrder.astro
import { marked } from 'marked';
import { getWatchOrderLeadSentence } from '../../lib/seo-utils.ts';

interface Props {
  anime: any;
}

const { anime } = Astro.props;

const franchiseAnime = Array.isArray(anime.franchiseAnime) ? anime.franchiseAnime : [];
const franchiseWatchOrderNote = (anime.franchiseWatchOrderNote || '').trim();
const hasFranchiseNote = franchiseWatchOrderNote.length > 0;

const watchOrderNote = (anime.watchOrderNote || '').trim();
const hasAnimeNote = watchOrderNote.length > 0;

function renderCleanMarkdown(md: string): string {
  if (!md) return '';
  const html = marked.parse(md, { breaks: true, gfm: true }) as string;
  // Strictly strip any <a> tags so links are never rendered inside the note
  let clean = html.replace(/<a\b[^>]*>(.*?)<\/a>/gi, '$1');

  // Cleanly format list items with line breaks so descriptions render beneath bold title line
  clean = clean.replace(/<li>([\s\S]*?)<\/li>/gi, (match, itemContent) => {
    if (/<br\s*\/?>/i.test(itemContent)) {
      const parts = itemContent.split(/<br\s*\/?>/i);
      const titlePart = parts[0].replace(/<\/?p>/gi, '').trim();
      const descPart = parts.slice(1).join('<br />').replace(/<\/?p>/gi, '').trim();
      return `<li><div class="font-bold text-slate-950">${titlePart}</div><div class="mt-1 text-slate-600 text-xs sm:text-sm font-normal leading-relaxed">${descPart}</div></li>`;
    }
    return match;
  });

  return clean;
}

const parsedFranchiseNote = hasFranchiseNote ? renderCleanMarkdown(franchiseWatchOrderNote) : '';
const parsedAnimeNote = hasAnimeNote ? renderCleanMarkdown(watchOrderNote) : '';

interface ItemMetaInfo {
  formatLabel: string;
  formatClass: string;
  countLabel: string;
}

function getItemMeta(item: any): ItemMetaInfo {
  const rawType = (item.type || '').toLowerCase();
  const isMovie = rawType.includes('movie') || rawType === 'film';
  const isSeries = rawType === 'series' || rawType.includes('tv');
  const isOvaOrSpecial = rawType.includes('ova') || rawType.includes('special') || rawType.includes('ona');

  let formatLabel = '';
  // Badge colors matching TabFillerList.astro aesthetic
  let formatClass = 'bg-amber-100 text-amber-900 border-amber-300';

  if (isMovie) {
    formatLabel = 'Movie';
    formatClass = 'bg-purple-100 text-purple-900 border-purple-300';
  } else if (isSeries) {
    formatLabel = 'TV Series';
    formatClass = 'bg-sky-100 text-sky-900 border-sky-300';
  } else if (item.type) {
    formatLabel = item.type;
    formatClass = isOvaOrSpecial
      ? 'bg-amber-100 text-amber-900 border-amber-300'
      : 'bg-slate-100 text-slate-800 border-slate-300';
  }

  let countLabel = '';
  if (isMovie) {
    if (item.runtime && Number(item.runtime) > 0) {
      const mins = parseInt(item.runtime, 10);
      const hours = Math.floor(mins / 60);
      const rem = mins % 60;
      countLabel = hours > 0 ? (rem > 0 ? `${hours}h ${rem}m` : `${hours}h`) : `${mins}m`;
    }
  } else {
    if (item.episodes && Number(item.episodes) > 0) {
      countLabel = `${item.episodes} ${Number(item.episodes) === 1 ? 'ep' : 'eps'}`;
    } else if (item.runtime && Number(item.runtime) > 0) {
      countLabel = `${item.runtime}m`;
    }
  }

  return { formatLabel, formatClass, countLabel };
}

const watchOrderLeadSentence = getWatchOrderLeadSentence(
  anime.title,
  hasFranchiseNote ? anime.franchiseName : null,
  watchOrderNote
);

const rawAnimeType = (anime.type || 'series').toLowerCase();
const isMovie = rawAnimeType.includes('movie') || rawAnimeType === 'film';
const isTVSeries = (rawAnimeType === 'series' || rawAnimeType.includes('tv')) && !isMovie;
---

<div class="space-y-6">
  <!-- Outer Card matching TabFillerList.astro -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-6">
    <!-- Header matching TabFillerList.astro -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-slate-200/80">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
            Watch Order Roadmap
          </span>
          {franchiseAnime.length > 0 && hasFranchiseNote && (
            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border bg-slate-100 text-slate-800 border-slate-300">
              {franchiseAnime.length} {franchiseAnime.length === 1 ? 'Franchise Title' : 'Franchise Titles'}
            </span>
          )}
        </div>
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#0F172A]">
          {anime.title} Watch Order
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 font-normal mt-1.5 max-w-2xl leading-relaxed">
          {watchOrderLeadSentence}
        </p>
      </div>
    </div>

    <!-- Static Filler Note Callout (TV Series only) -->
    {isTVSeries && (
      <div class="mb-5 rounded-xl bg-amber-50/90 border border-amber-200/90 px-4 py-3 text-sm text-amber-950 flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="leading-relaxed">
          <strong class="font-semibold text-amber-950">Filler Note:</strong> Episode ranges below show full broadcast totals and do not separate out filler episodes. To check if this series has skippable non-canon filler episodes, open the <strong class="font-semibold text-amber-950">Filler List</strong> tab.
        </p>
      </div>
    )}

    <!-- 1. FRANCHISE WATCH ORDER BLOCK (Full-width markdown text layout) -->
    {hasFranchiseNote && (
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-50/40 border border-slate-200/80 shadow-2xs space-y-5">
        <div>
          <!-- Header row: Icon and uppercase label together in a single row -->
          <div class="flex items-center gap-2.5 mb-3">
            <div class="w-7 h-7 rounded-lg bg-indigo-600/10 text-indigo-600 flex items-center justify-center shrink-0 border border-indigo-200/60">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-700 font-heading">
              Franchise Watch Order
            </span>
          </div>

          <!-- Note Body: 100% full width with clean list alignment -->
          <div
            class="franchise-watch-order-content w-full text-xs sm:text-sm text-slate-800 font-normal leading-relaxed [&_p]:mb-3 [&_p:last-child]:mb-0 [&_ol]:my-3 [&_ol]:pl-4 sm:[&_ol]:pl-5 [&_ol]:list-decimal [&_ol>li]:my-3.5 [&_ul]:my-3 [&_ul]:pl-4 sm:[&_ul]:pl-5 [&_ul]:list-disc [&_ul>li]:my-2 [&_strong]:text-slate-950 [&_strong]:font-bold"
            set:html={parsedFranchiseNote}
          />
        </div>

        <!-- Explore Franchise Guides: Interactive Link Buttons -->
        {franchiseAnime.length > 0 && (
          <div class="pt-4 border-t border-slate-200/80 space-y-3">
            <div class="space-y-0.5">
              <h3 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-900 font-heading">
                ANIME IN THIS WATCH ORDER
              </h3>
              <p class="text-xs text-slate-600 font-normal leading-relaxed">
                Tap any title to see its full details. The highlighted one is the anime you're viewing now.
              </p>
            </div>

            <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2 pt-0.5">
              {franchiseAnime.map((item: any) => {
                const isCurrent = item.isCurrent || item.id === anime.id || item.slug === anime.slug;
                const meta = getItemMeta(item);
                const linkUrl = `/anime/${item.slug}`;

                return isCurrent ? (
                  <div
                    class="w-full sm:w-auto inline-flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-[#EEF2FF]/70 border-2 border-[#818CF8] text-indigo-950 shadow-2xs cursor-default select-none transition-all"
                    aria-current="page"
                  >
                    <div class="min-w-0 flex-1 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2.5">
                      <div class="flex items-center gap-2 min-w-0">
                        <span class="w-2 h-2 rounded-full bg-indigo-600 shrink-0"></span>
                        <span class="font-bold text-indigo-950 text-xs sm:text-sm break-words">
                          {item.title}
                        </span>
                      </div>
                      <div class="flex items-center gap-1.5 shrink-0 pl-4 sm:pl-0 flex-wrap">
                        {meta.formatLabel && (
                          <span class:list={['text-[11px] font-bold px-2 py-0.5 rounded-full border shrink-0', meta.formatClass]}>
                            {meta.formatLabel}
                          </span>
                        )}
                        {meta.countLabel && (
                          <span class="text-[11px] font-medium px-2 py-0.5 rounded-full border bg-slate-100 text-slate-700 border-slate-300 shrink-0">
                            {meta.countLabel}
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                ) : (
                  <a
                    href={linkUrl}
                    class="group w-full sm:w-auto inline-flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white hover:bg-slate-50 border border-slate-200 hover:border-indigo-300 text-slate-800 hover:text-indigo-950 transition-all shadow-2xs hover:shadow-xs cursor-pointer"
                  >
                    <div class="min-w-0 flex-1 flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2.5">
                      <span class="font-medium text-slate-800 text-xs sm:text-sm break-words">
                        {item.title}
                      </span>
                      <div class="flex items-center gap-1.5 shrink-0 flex-wrap">
                        {meta.formatLabel && (
                          <span class:list={['text-[11px] font-bold px-2 py-0.5 rounded-full border shrink-0', meta.formatClass]}>
                            {meta.formatLabel}
                          </span>
                        )}
                        {meta.countLabel && (
                          <span class="text-[11px] font-medium px-2 py-0.5 rounded-full border bg-slate-100 text-slate-700 border-slate-300 shrink-0">
                            {meta.countLabel}
                          </span>
                        )}
                      </div>
                    </div>
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-indigo-600 group-hover:translate-x-0.5 transition-all shrink-0 self-center" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    )}

    <!-- 2. ANIME'S OWN WATCH ORDER NOTE (Full-width markdown text layout) -->
    {hasAnimeNote && (
      <div class="p-5 sm:p-6 rounded-2xl bg-indigo-50/40 border border-indigo-100 shadow-2xs">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="w-7 h-7 rounded-lg bg-indigo-600/10 text-indigo-600 flex items-center justify-center shrink-0 border border-indigo-200/60">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-700 font-heading">
            Viewing Guidance
          </span>
        </div>
        <div
          class="watch-order-guidance-content w-full text-xs sm:text-sm text-slate-700 font-normal leading-relaxed [&_p]:mb-3 [&_p:last-child]:mb-0 [&_ol]:my-2.5 [&_ol]:pl-4 sm:[&_ol]:pl-5 [&_ol]:list-decimal [&_ul]:my-2.5 [&_ul]:pl-4 sm:[&_ul]:pl-5 [&_ul]:list-disc [&_li]:my-1 [&_strong]:text-slate-900 [&_strong]:font-bold"
          set:html={parsedAnimeNote}
        />
      </div>
    )}
  </div>
</div>
