---
// src/components/anime/TabReview.astro
const { anime } = Astro.props;
const review = anime.review || {};

// Normalize paragraphs whether array, string, or legacy summary
let paragraphs = [];
if (Array.isArray(review.paragraphs) && review.paragraphs.length > 0) {
  paragraphs = review.paragraphs.filter((p) => typeof p === 'string' && p.trim().length > 0);
} else if (typeof review === 'string' && review.trim().length > 0) {
  paragraphs = [review.trim()];
} else if (review.summary && typeof review.summary === 'string' && review.summary.trim().length > 0) {
  paragraphs = [review.summary.trim()];
}

const isWatched = anime.honestyStatus === 'watched';
const score = anime.personalRating;
const hasFullReview = paragraphs.length > 0;
const showComingSoonNote = isWatched && score && !hasFullReview;
---

<div class="space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-6">
    
    <!-- Review Title Header -->
    <div class="pb-5 border-b border-slate-100">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#0F172A]">
          {review.heading || `My Honest Take on ${anime.title}`}
        </h2>
        {score && (
          <span class="text-sm sm:text-base font-medium text-slate-500">
            • <strong class="text-[#0F172A] font-bold">{score}</strong>/10
          </span>
        )}
      </div>
    </div>

    <!-- Review content: either full written review or friendly coming soon note -->
    {hasFullReview ? (
      <div class="space-y-4">
        {paragraphs.map((p) => (
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-normal">
            {p}
          </p>
        ))}
      </div>
    ) : showComingSoonNote ? (
      <div class="p-5 sm:p-6 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center gap-4 text-slate-700 shadow-2xs">
        <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center shrink-0 text-[#4F46E5] shadow-2xs">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-[#4F46E5] block">
            Written Review in Progress
          </span>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Every anime I've watched gets a rating right away — that's quick and honest. The full written review takes a bit more time, since I want to actually say something worth reading, not just fill space. It's coming, just not instantly — thanks for your patience.
          </p>
        </div>
      </div>
    ) : null}

  </div>
</div>
