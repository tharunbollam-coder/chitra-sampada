---
// src/components/anime/TabReview.astro
const { anime } = Astro.props;
const review = anime.review || {};

// Normalize paragraphs whether array, string, or legacy summary
let paragraphs = [];
if (Array.isArray(review.paragraphs) && review.paragraphs.length > 0) {
  paragraphs = review.paragraphs.filter((p) => typeof p === 'string' && p.trim().length > 0);
} else if (typeof review === 'string' && review.trim().length > 0) {
  paragraphs = [review.trim()];
} else if (review.summary && typeof review.summary === 'string' && review.summary.trim().length > 0) {
  paragraphs = [review.summary.trim()];
}

const isWatched = anime.honestyStatus === 'watched';
const score = anime.personalRating;
const hasContent = Boolean(
  (review.heading && review.heading.trim().length > 0) || paragraphs.length > 0
);

// Review type: 'quick' vs 'full' (defaults to 'full')
const isQuickTake = review.type === 'quick';
---

{hasContent ? (
  <div class="space-y-6">
    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-6">
      
      <!-- Review Title Header -->
      <div class="pb-5 border-b border-slate-100 space-y-3">
        <!-- Badge & Rating Row -->
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2.5 flex-wrap">
            {isQuickTake ? (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200/80 shadow-2xs">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                <span>Quick Take</span>
                <span class="text-[10px] text-amber-600/80 font-normal">• Initial Reaction</span>
              </span>
            ) : (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/80 shadow-2xs">
                <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1]"></span>
                <span>Full Editorial Take</span>
              </span>
            )}

            {score && (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-800 border border-slate-200 shadow-2xs">
                <span class="text-amber-500 font-bold">★</span>
                <span>{score} / 10</span>
                <span class="text-[10px] text-slate-500 font-normal">(Personal Rating)</span>
              </span>
            )}
          </div>
        </div>

        <!-- Heading style: Quick Take vs Full Editorial Heading -->
        <div>
          {isQuickTake ? (
            <div class="space-y-1">
              <h2 class="font-heading text-lg sm:text-xl font-bold text-[#0F172A] tracking-tight">
                {review.heading || `Quick Take: Initial Reaction to ${anime.title}`}
              </h2>
            </div>
          ) : (
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#0F172A] tracking-tight">
              {review.heading || `My Honest Take on ${anime.title}`}
            </h2>
          )}
        </div>

        <!-- Polite & Warm Personal Take Disclaimer Note -->
        <p class="text-xs sm:text-sm text-slate-500 font-normal leading-relaxed">
          This is my personal take — anime hits everyone differently, and that's completely fine.
        </p>
      </div>

      <!-- Review content paragraphs -->
      <div class="space-y-4">
        {paragraphs.map((p) => (
          <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-normal">
            {p}
          </p>
        ))}
      </div>

    </div>
  </div>
) : null}
