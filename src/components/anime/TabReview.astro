---
// src/components/anime/TabReview.astro
const { anime } = Astro.props;
const review = anime.review || {};

// Normalize paragraphs whether array, string, or legacy summary
let paragraphs = [];
if (Array.isArray(review.paragraphs) && review.paragraphs.length > 0) {
  paragraphs = review.paragraphs;
} else if (typeof review === 'string') {
  paragraphs = [review];
} else if (review.summary) {
  paragraphs = [review.summary];
}

const score = review.score || anime.personalRating;
---

<div class="space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-6">
    
    <!-- Simple, conversational header (no big boxed rating scorecard) -->
    <div class="pb-5 border-b border-slate-100">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-bold uppercase tracking-wider text-[#4F46E5]">Personal Take</span>
      </div>
      
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="font-heading text-xl sm:text-2xl font-bold text-[#0F172A]">
          {review.heading || `My Honest Take on ${anime.title}`}
        </h2>
        {score && (
          <span class="text-sm sm:text-base font-medium text-slate-500">
            • <strong class="text-[#0F172A] font-bold">{score}</strong>/10
          </span>
        )}
      </div>
    </div>

    <!-- Flowing conversational written paragraphs -->
    <div class="space-y-4">
      {paragraphs.map((p) => (
        <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-normal">
          {p}
        </p>
      ))}
    </div>

  </div>
</div>
