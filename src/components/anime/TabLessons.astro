---
// src/components/anime/TabLessons.astro
const { anime } = Astro.props;
const lessons = anime.lessons || {};
const paragraphs = Array.isArray(lessons.paragraphs)
  ? lessons.paragraphs
  : (typeof lessons === 'string' ? [lessons] : []);
---

<div class="space-y-6">
  <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-6">
    <div class="pb-5 border-b border-slate-100">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-bold uppercase tracking-wider text-red-600">Personal Reflections</span>
      </div>
      <h2 class="font-heading text-xl sm:text-2xl font-bold text-slate-900">
        What I Learned From {anime.title}
      </h2>
      {lessons.heading && (
        <p class="text-sm sm:text-base font-semibold text-slate-800 mt-2">
          {lessons.heading}
        </p>
      )}
    </div>

    <!-- Reflective First-Person Body -->
    <div class="space-y-4">
      {paragraphs.map((para) => (
        <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-normal">
          {para}
        </p>
      ))}
    </div>
  </div>
</div>
