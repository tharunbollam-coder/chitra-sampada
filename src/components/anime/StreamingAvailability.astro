---
// src/components/anime/StreamingAvailability.astro
interface Platform {
  id?: number | string;
  platformName: string;
  streamUrl?: string | null;
  logoUrl?: string | null;
  note?: string | null;
  displayOrder?: number;
  isActive?: boolean;
}

const { anime } = Astro.props;
const rawPlatforms: Platform[] = anime?.streamingPlatforms || [];
const platforms = rawPlatforms.filter((p) => p.isActive !== false && p.platformName && p.platformName.trim().length > 0);
const isVisible = platforms.length > 0 && anime?.sectionVisibility?.streaming !== false;
---

{isVisible && (
  <div class="p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs space-y-3">
    <!-- Header -->
    <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-slate-100">
      <div class="flex items-center gap-2 text-slate-900">
        <div class="w-7 h-7 rounded-lg bg-indigo-50 border border-indigo-100 text-[#4F46E5] flex items-center justify-center shrink-0 shadow-2xs">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h2 class="text-xs sm:text-sm font-bold font-heading text-[#0F172A] tracking-tight">
          Where to Watch
        </h2>
      </div>
      <span class="text-[11px] font-semibold text-slate-400 select-none">
        Streaming Availability
      </span>
    </div>

    <!-- Platform Cards / Badges Grid -->
    <div class="flex flex-wrap gap-2.5">
      {platforms.map((p) => {
        const hasUrl = Boolean(p.streamUrl && p.streamUrl.trim().length > 0);
        const hasLogo = Boolean(p.logoUrl && p.logoUrl.trim().length > 0);

        return hasUrl ? (
          <a
            href={p.streamUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-white hover:bg-indigo-50/30 border border-slate-200/90 hover:border-indigo-300 shadow-2xs hover:shadow-xs transition-all duration-200 cursor-pointer text-left"
            title={`Watch on ${p.platformName} (opens in new tab)`}
          >
            {hasLogo ? (
              <img
                src={p.logoUrl}
                alt=""
                class="w-5 h-5 object-contain rounded shrink-0"
                loading="lazy"
                onerror="this.style.display='none'"
              />
            ) : (
              <span class="w-5 h-5 rounded-md bg-indigo-50 text-[#4F46E5] flex items-center justify-center text-[10px] font-bold border border-indigo-100 shrink-0 group-hover:bg-indigo-100 transition-colors">
                ▶
              </span>
            )}
            <div class="flex flex-col min-w-0">
              <div class="flex items-center gap-1.5">
                <span class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-[#4F46E5] transition-colors leading-tight">
                  {p.platformName}
                </span>
                <svg class="w-3 h-3 text-slate-400 group-hover:text-[#4F46E5] transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
              {p.note && (
                <span class="text-[10px] sm:text-[11px] text-slate-500 font-medium leading-tight mt-0.5">
                  {p.note}
                </span>
              )}
            </div>
          </a>
        ) : (
          <div class="inline-flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-slate-50/80 border border-slate-200/80 shadow-2xs text-left select-none">
            {hasLogo ? (
              <img
                src={p.logoUrl}
                alt=""
                class="w-5 h-5 object-contain rounded shrink-0"
                loading="lazy"
                onerror="this.style.display='none'"
              />
            ) : (
              <span class="w-5 h-5 rounded-md bg-slate-200/70 text-slate-600 flex items-center justify-center text-[10px] font-bold shrink-0">
                ▶
              </span>
            )}
            <div class="flex flex-col min-w-0">
              <span class="text-xs sm:text-sm font-semibold text-slate-800 leading-tight">
                {p.platformName}
              </span>
              {p.note && (
                <span class="text-[10px] sm:text-[11px] text-slate-500 font-medium leading-tight mt-0.5">
                  {p.note}
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
)}
