---
// src/components/AnnouncementBanner.astro
interface Props {
  announcement?: {
    enabled?: boolean;
    title?: string;
    message?: string;
    linkUrl?: string;
    linkText?: string;
  } | null;
}

const { announcement } = Astro.props;
const isVisible = Boolean(announcement && announcement.enabled && announcement.message?.trim());
const title = announcement?.title?.trim() || '';
const message = announcement?.message?.trim() || '';
const linkUrl = announcement?.linkUrl?.trim() || '';
const linkText = announcement?.linkText?.trim() || 'Learn More';
---

{isVisible && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-4 pb-8 sm:pb-10" aria-label="Announcement">
    <div class="relative rounded-2xl bg-gradient-to-r from-[#EEF2FF] via-white to-[#EEF2FF]/60 border border-indigo-100 p-4 sm:p-5 shadow-xs transition hover:border-indigo-200">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-start gap-3.5 min-w-0">
          <div class="w-9 h-9 rounded-xl bg-indigo-600/10 text-[#4F46E5] flex items-center justify-center shrink-0 mt-0.5 sm:mt-0 shadow-2xs">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
            </svg>
          </div>
          <div class="min-w-0 space-y-1">
            {title && (
              <h3 class="font-heading text-sm sm:text-base font-bold text-[#0F172A] tracking-tight leading-snug">
                {title}
              </h3>
            )}
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              {message}
            </p>
          </div>
        </div>

        {linkUrl && (
          <div class="shrink-0 pl-12 sm:pl-0">
            <a
              href={linkUrl}
              target={linkUrl.startsWith('http') ? '_blank' : undefined}
              rel={linkUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#6366F1] hover:bg-[#4F46E5] text-white text-xs sm:text-sm font-semibold shadow-xs hover:shadow-indigo-500/20 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              <span>{linkText}</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </div>
  </section>
)}
