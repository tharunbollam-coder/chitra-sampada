---
// src/components/VibeCard.astro
const { vibe, href } = Astro.props;

// Light mode styling helpers
const vibeStyles = {
  purple: {
    badge: 'bg-purple-50 text-purple-800 border-purple-200',
    accent: 'text-purple-700',
    hoverBorder: 'hover:border-purple-300',
  },
  cyan: {
    badge: 'bg-cyan-50 text-cyan-800 border-cyan-200',
    accent: 'text-cyan-700',
    hoverBorder: 'hover:border-cyan-300',
  },
  indigo: {
    badge: 'bg-[#EEF2FF] text-[#4F46E5] border-[#C7D2FE] font-bold',
    accent: 'text-[#4F46E5]',
    hoverBorder: 'hover:border-[#6366F1]',
  },
  pink: {
    badge: 'bg-pink-50 text-pink-800 border-pink-200',
    accent: 'text-pink-700',
    hoverBorder: 'hover:border-pink-300',
  },
  amber: {
    badge: 'bg-amber-50 text-amber-800 border-amber-200',
    accent: 'text-amber-700',
    hoverBorder: 'hover:border-amber-300',
  },
  fuchsia: {
    badge: 'bg-fuchsia-50 text-fuchsia-800 border-fuchsia-200',
    accent: 'text-fuchsia-700',
    hoverBorder: 'hover:border-fuchsia-300',
  },
  emerald: {
    badge: 'bg-emerald-50 text-emerald-800 border-emerald-200',
    accent: 'text-emerald-700',
    hoverBorder: 'hover:border-emerald-300',
  },
  sky: {
    badge: 'bg-sky-50 text-sky-800 border-sky-200',
    accent: 'text-sky-700',
    hoverBorder: 'hover:border-sky-300',
  },
  rose: {
    badge: 'bg-rose-50 text-rose-800 border-rose-200',
    accent: 'text-rose-700',
    hoverBorder: 'hover:border-rose-300',
  },
  slate: {
    badge: 'bg-slate-100 text-slate-800 border-slate-200',
    accent: 'text-slate-700',
    hoverBorder: 'hover:border-slate-300',
  },
  'op-mc': {
    badge: 'bg-purple-50 text-purple-800 border-purple-200',
    accent: 'text-purple-700',
    hoverBorder: 'hover:border-purple-300',
  },
  'slow-burn-romance': {
    badge: 'bg-pink-50 text-pink-800 border-pink-200',
    accent: 'text-pink-700',
    hoverBorder: 'hover:border-pink-300',
  },
  'zero-filler': {
    badge: 'bg-[#EEF2FF] text-[#4F46E5] border-[#C7D2FE] font-bold',
    accent: 'text-[#4F46E5]',
    hoverBorder: 'hover:border-[#6366F1]',
  },
  'like-naruto': {
    badge: 'bg-amber-50 text-amber-800 border-amber-200',
    accent: 'text-amber-700',
    hoverBorder: 'hover:border-amber-300',
  },
  'hidden-gems': {
    badge: 'bg-cyan-50 text-cyan-800 border-cyan-200',
    accent: 'text-cyan-700',
    hoverBorder: 'hover:border-cyan-300',
  },
  'beginners': {
    badge: 'bg-fuchsia-50 text-fuchsia-800 border-fuchsia-200',
    accent: 'text-fuchsia-700',
    hoverBorder: 'hover:border-fuchsia-300',
  }
};

const themeKey = vibe.color_theme || vibe.colorTheme || vibe.id;
const style = vibeStyles[themeKey] || vibeStyles[vibe.id] || vibeStyles['indigo'];
const displayTitle = vibe.title || vibe.name;
const displayBadge = vibe.badge || vibe.group_label || vibe.groupLabel || 'CURATED';
const Component = href ? 'a' : 'button';
---

<Component
  href={href}
  type={href ? undefined : 'button'}
  data-filter-vibe={vibe.id}
  class:list={[
    'vibe-card-btn group text-left relative overflow-hidden rounded-2xl p-5 sm:p-6 transition-all duration-300 bg-white border border-slate-200/80 shadow-xs hover:shadow-md hover:-translate-y-1 cursor-pointer w-full flex flex-col justify-between h-full',
    style.hoverBorder
  ]}
>
  <div class="relative z-10 flex flex-col justify-between h-full space-y-4">
    
    <!-- Top Category Badge -->
    <div class="flex items-center">
      <span class:list={['text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border', style.badge]}>
        {displayBadge}
      </span>
    </div>

    <!-- Title & Subtitle Tagline (Clean, Fast to Scan) -->
    <div class="space-y-1">
      <h4 class="font-heading text-lg sm:text-xl font-bold text-slate-900 group-hover:text-slate-950 tracking-tight leading-snug">
        {displayTitle}
      </h4>
      <p class:list={['text-xs font-semibold tracking-wide', style.accent]}>
        {vibe.tagline}
      </p>
    </div>

    <!-- Bottom Action Cue -->
    <div class="pt-2 flex items-center justify-between text-xs font-semibold text-slate-500 group-hover:text-slate-900 transition-colors border-t border-slate-100">
      <span class="inline-flex items-center gap-1.5">
        <span>Explore collection</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-200 text-slate-400 group-hover:text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
      <span class="text-[10px] px-2 py-0.5 rounded-md bg-slate-100 border border-slate-200/80 text-slate-600 font-medium">
        Curated Picks
      </span>
    </div>

  </div>
</Component>
