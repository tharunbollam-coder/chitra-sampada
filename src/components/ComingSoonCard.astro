---
// src/components/ComingSoonCard.astro
const { title, category, description, features = [], gradient = 'from-slate-900 via-slate-900 to-[#0c121e]', icon = 'film' } = Astro.props;
---

<div class="relative group rounded-3xl p-7 sm:p-8 bg-[#0b0f19] border border-white/10 hover:border-white/20 transition-all duration-300 flex flex-col justify-between overflow-hidden">
  <!-- Subtle futuristic ambient background gradient -->
  <div class:list={['absolute inset-0 bg-gradient-to-br opacity-50 pointer-events-none group-hover:opacity-75 transition-opacity duration-500', gradient]}></div>
  <div class="absolute -top-12 -right-12 w-36 h-36 rounded-full bg-white/[0.03] blur-3xl pointer-events-none"></div>

  <div class="relative z-10 space-y-5">
    
    <!-- Header with Coming Soon Badge -->
    <div class="flex items-center justify-between gap-3">
      <span class="text-[11px] font-black tracking-widest uppercase px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300 backdrop-blur-md">
        {category}
      </span>
      <span class="inline-flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Coming Soon</span>
      </span>
    </div>

    <!-- Title & Icon -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <h3 class="text-2xl font-black text-white tracking-tight group-hover:text-slate-100 transition-colors">
          {title}
        </h3>
        <p class="text-sm text-slate-400 mt-2 leading-relaxed">
          {description}
        </p>
      </div>

      <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center shrink-0 text-slate-300 group-hover:text-white group-hover:scale-105 transition-all">
        {icon === 'film' && (
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
          </svg>
        )}
        {icon === 'tv' && (
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        )}
        {icon === 'globe' && (
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
        )}
      </div>
    </div>

    <!-- Planned Companion Features list -->
    <div class="space-y-2 pt-2 border-t border-white/5">
      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">
        Planned Companion Features:
      </div>
      <ul class="space-y-1.5 text-xs text-slate-300">
        {features.map((feature) => (
          <li class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-red-400 shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <div class="relative z-10 pt-6 mt-6 border-t border-white/10 flex items-center justify-between">
    <span class="text-xs font-semibold text-slate-400">
      Under editorial architecture
    </span>
    <span class="text-xs font-bold text-slate-400 group-hover:text-slate-300">
      Stay Tuned →
    </span>
  </div>
</div>
