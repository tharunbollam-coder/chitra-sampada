                <option value="Ongoing" selected={anime?.source?.publicationStatus === 'Ongoing'}>Ongoing</option>
                <option value="Completed" selected={anime?.source?.publicationStatus === 'Completed'}>Completed</option>
                <option value="Hiatus" selected={anime?.source?.publicationStatus === 'Hiatus'}>Hiatus</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="source-coverage">
                Anime Adaptation Coverage
              </label>
              <input
                type="text"
                id="source-coverage"
                value={anime?.source?.coverage || ''}
                placeholder="e.g. Adapts Chapters 1–60 (Vols 1–7)"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="source-notes">
              Reading Recommendation / Notes
            </label>
            <textarea
              id="source-notes"
              rows="2"
              placeholder="e.g. Start reading from Chapter 61 for content past season 1..."
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
            >{anime?.source?.notes || ''}</textarea>
          </div>

          <div class="pt-4 border-t border-slate-800 flex justify-end">
            <button
              type="submit"
              class="w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-sm transition cursor-pointer"
            >
              Save Source Guidance
            </button>
          </div>
        </form>
      </div>
    </div>


    <!-- ============================================================= -->
    <!-- SECTION 8: POWER SYSTEM -->
    <!-- ============================================================= -->
    <div class={`bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden transition dependent-section ${isNew ? 'opacity-50 pointer-events-none' : ''}`} id="section-power-container">
      <button
        type="button"
        class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-slate-850/50 transition cursor-pointer section-toggle"
        data-target="section-power-body"
      >
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-lg bg-indigo-600/20 text-indigo-400 font-bold text-xs flex items-center justify-center border border-indigo-500/30">
            8
          </span>
          <div>
            <h2 class="text-base font-semibold text-white font-heading">Power System / Lore Mechanics</h2>
            <p class="text-xs text-slate-400">Magic rules, visualization techniques, or combat hierarchy</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span id="power-badge" class="hidden text-xs px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/80 font-medium">Saved</span>
          <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200 section-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </button>

      <div id="section-power-body" class="px-6 pb-6 pt-2 border-t border-slate-800/80">
        <div id="power-feedback" class="hidden mb-5 p-3.5 rounded-xl text-xs sm:text-sm font-medium border"></div>

        <form id="form-power" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="power-name">
              Power System Name
            </label>
            <input
              type="text"
              id="power-name"
              value={anime?.powerSystem?.name || ''}
              placeholder="e.g. Visualization Magic & Mana Suppression"
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
            />
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
                Explanatory Paragraphs
              </label>
              <button
                type="button"
                id="btn-add-power-p"
                class="text-xs text-indigo-400 hover:text-indigo-300 font-medium flex items-center gap-1 cursor-pointer"
              >
                + Add Paragraph
              </button>
            </div>

            <div id="power-paragraphs-container" class="space-y-3">
              {(anime?.powerSystem?.paragraphs?.length ? anime.powerSystem.paragraphs : ['']).map((p, idx) => (
                <div class="flex items-start gap-2 power-paragraph-row">
                  <textarea
                    rows="3"
                    class="flex-1 px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 power-paragraph-input"
                    placeholder={`Power mechanic paragraph ${idx + 1}...`}
                  >{p}</textarea>
                  <button
                    type="button"
                    class="btn-remove-power-p p-2 text-slate-500 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition cursor-pointer"
                    title="Remove paragraph"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  </button>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-slate-800 flex justify-end">
            <button
              type="submit"
              class="w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-sm transition cursor-pointer"
            >
              Save Power System
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <!-- Client JavaScript for Interactivity, Dynamic Rows, Hydration, and Section Saves -->
  <script is:inline define:vars={{ initialAnime: anime, isNewRecord: isNew }}>
    let currentAnimeId = initialAnime?.id || null;

    // Helper: Show localized inline banner in section
    function setFeedback(feedbackEl, message, type = 'success') {
      if (!feedbackEl) return;
      feedbackEl.classList.remove('hidden', 'bg-emerald-950/80', 'border-emerald-700', 'text-emerald-300', 'bg-rose-950/80', 'border-rose-700', 'text-rose-300');
      if (type === 'success') {
        feedbackEl.classList.add('bg-emerald-950/80', 'border-emerald-700', 'text-emerald-300');
      } else {
        feedbackEl.classList.add('bg-rose-950/80', 'border-rose-700', 'text-rose-300');
      }
      feedbackEl.textContent = message;
      feedbackEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Toggle accordion logic
    document.querySelectorAll('.section-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const target = document.getElementById(targetId);
        const chevron = btn.querySelector('.section-chevron');
        if (target) {
          const isHidden = target.classList.contains('hidden');
          target.classList.toggle('hidden', !isHidden);
          if (chevron) {
            chevron.classList.toggle('rotate-180', !isHidden);
          }
        }
      });
    });

    // Auto-generate slug and ID from title if creating a new anime
    const titleInput = document.getElementById('core-title');
    const slugInput = document.getElementById('core-slug');
    const idInput = document.getElementById('core-id');

    if (titleInput && slugInput && idInput) {
      titleInput.addEventListener('input', () => {
        if (!currentAnimeId) {
          if (!slugInput.value || slugInput.dataset.touched !== 'true') {
            const clean = titleInput.value
              .toLowerCase()
              .replace(/['’]/g, '')
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-+|-+$/g, '');
            slugInput.value = clean;
            
            if (!idInput.value || idInput.dataset.touched !== 'true') {
              const shortId = clean.split('-')[0] || '';
              idInput.value = shortId;
            }
          }
        }
      });

      slugInput.addEventListener('input', () => { slugInput.dataset.touched = 'true'; });
      idInput.addEventListener('input', () => { idInput.dataset.touched = 'true'; });
    }

    // Dependent sections state: unlock if currentAnimeId is set
    function updateDependentSectionsState() {
      const isUnlocked = Boolean(currentAnimeId);
      const dependents = document.querySelectorAll('.dependent-section');
      dependents.forEach(sec => {
        if (!isUnlocked) {
          sec.classList.add('opacity-50', 'pointer-events-none');
        } else {
          sec.classList.remove('opacity-50', 'pointer-events-none');
        }
      });
    }

    // Helper: add a review paragraph row to Section 2
    function addReviewParagraph(content = '', index = 1) {
      const container = document.getElementById('review-paragraphs-container');
      const div = document.createElement('div');
      div.className = 'flex items-start gap-2 paragraph-row';
      div.innerHTML = `
        <textarea rows="3" class="flex-1 px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 review-paragraph-input" placeholder="Paragraph ${index}..."></textarea>
        <button type="button" class="btn-remove-p p-2 text-slate-500 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition cursor-pointer" title="Remove paragraph">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      `;
      const textarea = div.querySelector('textarea');
      textarea.value = content;
      div.querySelector('.btn-remove-p').addEventListener('click', () => div.remove());
      container.appendChild(div);
    }

    // Helper: add a power paragraph row to Section 8
    function addPowerParagraph(content = '', index = 1) {
      const container = document.getElementById('power-paragraphs-container');
      const div = document.createElement('div');
      div.className = 'flex items-start gap-2 power-paragraph-row';
      div.innerHTML = `
        <textarea rows="3" class="flex-1 px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 power-paragraph-input" placeholder="Power mechanic paragraph ${index}..."></textarea>
        <button type="button" class="btn-remove-power-p p-2 text-slate-500 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition cursor-pointer" title="Remove paragraph">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      `;
      const textarea = div.querySelector('textarea');
      textarea.value = content;
      div.querySelector('.btn-remove-power-p').addEventListener('click', () => div.remove());
      container.appendChild(div);
    }

    // Helper: count episodes from comma-separated ranges and numbers
    function countEpisodesFromRangeString(str) {
      if (!str || !str.trim()) return 0;
      const parts = str.split(',').map(s => s.trim()).filter(Boolean);
      let count = 0;
      for (const p of parts) {
        const rm = p.match(/^(\d+)\s*[-–—]\s*(\d+)$/);
        if (rm) {
          const start = parseInt(rm[1], 10);
          const end = parseInt(rm[2], 10);
          if (start <= end) {
            count += (end - start + 1);
          }
          continue;
        }
        const sm = p.match(/^(\d+)$/);
        if (sm) {
          count += 1;
        }
      }
      return count;
    }

    // Dynamic Live Stats Calculation for Section 5 Header
    function updateLiveFillerStats() {
      const mangaStr = document.getElementById('filler-manga-canon')?.value || '';
      const animeStr = document.getElementById('filler-anime-canon')?.value || '';
      const mixedStr = document.getElementById('filler-mixed')?.value || '';
      const fillerStr = document.getElementById('filler-filler')?.value || '';

      const countManga = countEpisodesFromRangeString(mangaStr);
      const countAnime = countEpisodesFromRangeString(animeStr);
      const countMixed = countEpisodesFromRangeString(mixedStr);
      const countFiller = countEpisodesFromRangeString(fillerStr);

      const total = countManga + countAnime + countMixed + countFiller;
      const canon = countManga + countAnime;
      const pct = total > 0 ? Math.round((countFiller / total) * 100) : 0;

      const totalEl = document.getElementById('admin-filler-total');
      const canonEl = document.getElementById('admin-filler-canon');
      const mixedEl = document.getElementById('admin-filler-mixed');
      const fillerEl = document.getElementById('admin-filler-count');
      const pctBadge = document.getElementById('admin-filler-pct-badge');
      const pctDisplay = document.getElementById('filler-pct-display');

      if (totalEl) totalEl.textContent = `${total} eps`;
      if (canonEl) canonEl.textContent = `${canon} eps`;
      if (mixedEl) mixedEl.textContent = `${countMixed} eps`;
      if (fillerEl) fillerEl.textContent = `${countFiller} eps`;
      if (pctBadge) pctBadge.textContent = `${pct}% Filler`;
      if (pctDisplay) {
        if (total > 0) {
          pctDisplay.textContent = `(${pct}% filler)`;
          pctDisplay.classList.remove('hidden');
        } else {
          pctDisplay.classList.add('hidden');
        }
      }
    }

    // Full Form Hydration Function: populates all fields, unlocks sections, sets Edit header
    function hydrateAnimeData(a) {
      if (!a) return;

      currentAnimeId = a.id;

      // 1. Update Heading and subtext for Edit mode
      const headingTitle = document.getElementById('heading-title-text');
      if (headingTitle) headingTitle.textContent = `Edit Anime: ${a.title}`;

      const idBadge = document.getElementById('heading-id-badge');
      if (idBadge) {
        idBadge.textContent = a.id;
        idBadge.classList.remove('hidden');
      }

      const subtext = document.getElementById('heading-subtext');
      if (subtext) subtext.textContent = '';

      const viewLink = document.getElementById('view-public-link');
      if (viewLink && a.slug) {
        viewLink.href = `/anime/${a.slug}`;
        viewLink.classList.remove('hidden');
      }

      // 2. Unlock all sections immediately
      updateDependentSectionsState();

      // 3. Populate Section 1: Core details
      const idEl = document.getElementById('core-id');
      if (idEl) {
        idEl.value = a.id;
        idEl.readOnly = true;
        idEl.classList.add('opacity-70', 'cursor-not-allowed');
      }

      const slugEl = document.getElementById('core-slug');
      if (slugEl) slugEl.value = a.slug || '';

      const titleEl = document.getElementById('core-title');
      if (titleEl) titleEl.value = a.title || '';

      const origEl = document.getElementById('core-original-title');
      if (origEl) origEl.value = a.originalTitle || '';

      const yearEl = document.getElementById('core-year');
      if (yearEl) yearEl.value = a.year || '';

      const epsEl = document.getElementById('core-episodes');
      if (epsEl) epsEl.value = a.episodes || '';

      const statusEl = document.getElementById('core-status');
      if (statusEl && a.status) statusEl.value = a.status;

      const honestyEl = document.getElementById('core-honesty');
      if (honestyEl && a.honestyStatus) honestyEl.value = a.honestyStatus;

      const ratingEl = document.getElementById('core-rating');
      if (ratingEl) ratingEl.value = (a.personalRating !== null && a.personalRating !== undefined) ? a.personalRating : '';

      const posterEl = document.getElementById('core-poster');
      if (posterEl) posterEl.value = a.poster || '';

      const backdropEl = document.getElementById('core-backdrop');
      if (backdropEl) backdropEl.value = a.backdrop || '';

      const synopsisEl = document.getElementById('core-synopsis');
      if (synopsisEl) synopsisEl.value = a.synopsis || '';

      const aliasesEl = document.getElementById('core-aliases');
      if (aliasesEl) aliasesEl.value = (a.aliases || []).join(', ');

      const trendingEl = document.getElementById('core-trending');
      if (trendingEl) trendingEl.checked = Boolean(a.trending);

      // Check genre checkboxes
      const genreSet = new Set(a.genres || []);
      const matchedGenres = new Set();
      document.querySelectorAll('#core-genres-container input[name="genres"]').forEach(cb => {
        if (genreSet.has(cb.value)) {
          cb.checked = true;
          matchedGenres.add(cb.value);
        } else {
          cb.checked = false;
        }
      });
      const customGenres = (a.genres || []).filter(g => !matchedGenres.has(g));
      const customGenreInput = document.getElementById('core-custom-genres');
      if (customGenreInput) customGenreInput.value = customGenres.join(', ');

      // Check vibe checkboxes
      const vibeSet = new Set(a.vibes || []);
      document.querySelectorAll('#core-vibes-container input[name="vibes"]').forEach(cb => {
        cb.checked = vibeSet.has(cb.value);
      });

      // 4. Populate Section 2: Personal Take / Review
      const revHeading = document.getElementById('review-heading');
      if (revHeading) revHeading.value = a.review?.heading || '';

      const revContainer = document.getElementById('review-paragraphs-container');
      if (revContainer) {
        revContainer.innerHTML = '';
        const paragraphs = a.review?.paragraphs?.length ? a.review.paragraphs : [''];
        paragraphs.forEach((p, idx) => {
          addReviewParagraph(p, idx + 1);
        });
      }

      // 5. Populate Section 3: Lessons
      const lessonHeading = document.getElementById('lesson-heading');
      if (lessonHeading) lessonHeading.value = a.lessons?.heading || '';

      const lessonTakeaway = document.getElementById('lesson-takeaway');
      if (lessonTakeaway) lessonTakeaway.value = a.lessons?.takeaway || '';

      // 6. Populate Section 4: Watch Order
      const woFranchise = document.getElementById('wo-franchise');
      if (woFranchise && a.franchiseId) woFranchise.value = a.franchiseId;

      const woStep = document.getElementById('wo-step');
      if (woStep) woStep.value = a.franchiseStepOrder || '';

      // 7. Populate Section 5: Filler Breakdown
      const fManga = document.getElementById('filler-manga-canon');
      if (fManga) fManga.value = a.fillerBreakdown?.mangaCanon || '';

      const fAnime = document.getElementById('filler-anime-canon');
      if (fAnime) fAnime.value = a.fillerBreakdown?.animeCanon || '';

      const fMixed = document.getElementById('filler-mixed');
      if (fMixed) fMixed.value = a.fillerBreakdown?.mixedCanon || '';

      const fFiller = document.getElementById('filler-filler');
      if (fFiller) fFiller.value = a.fillerBreakdown?.filler || '';

      updateLiveFillerStats();

      // 8. Populate Section 6: Characters
      const charsContainer = document.getElementById('chars-container');
      if (charsContainer) {
        charsContainer.innerHTML = '';
        (a.characters || []).forEach((c, idx) => {
          const div = document.createElement('div');
          div.className = 'p-3 bg-slate-950 border border-slate-800 rounded-xl space-y-2.5 character-row';
          div.innerHTML = `
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2 flex-1">
                <span class="w-6 h-6 rounded bg-slate-800 text-slate-400 text-xs flex items-center justify-center font-bold shrink-0 char-rank-badge">
                  ${c.rank || idx + 1}
                </span>
                <input type="text" value="${c.name || ''}" placeholder="Character Name" class="char-input-name flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-sm text-white font-medium" required />
              </div>
              <select class="char-input-category px-2.5 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white">
                <option value="Protagonist" ${c.category === 'Protagonist' ? 'selected' : ''}>Protagonist</option>
                <option value="Main" ${c.category === 'Main' ? 'selected' : ''}>Main</option>
                <option value="Supporting" ${c.category === 'Supporting' ? 'selected' : ''}>Supporting</option>
                <option value="Antagonist" ${c.category === 'Antagonist' ? 'selected' : ''}>Antagonist</option>
              </select>
              <button type="button" class="btn-remove-char text-slate-500 hover:text-rose-400 p-1 cursor-pointer" title="Remove character">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <input type="text" value="${c.role || ''}" placeholder="Role / Title (e.g. Elven Mage)" class="char-input-role px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200" />
              <input type="text" value="${c.commentary || ''}" placeholder="Short commentary or key trait" class="char-input-commentary px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200" />
            </div>
          `;
          div.querySelector('.btn-remove-char').addEventListener('click', () => {
            div.remove();
            updateCharacterRanks();
          });
          charsContainer.appendChild(div);
        });
      }

      // 9. Populate Section 7: Source guidance
      const srcTitle = document.getElementById('source-title');
      if (srcTitle) srcTitle.value = a.source?.title || '';

      const srcAuthor = document.getElementById('source-author');
      if (srcAuthor) srcAuthor.value = a.source?.author || '';

      const srcType = document.getElementById('source-type');
      if (srcType && a.source?.type) srcType.value = a.source.type;

      const srcVols = document.getElementById('source-volumes');
      if (srcVols) srcVols.value = a.source?.volumes || '';

      const srcPub = document.getElementById('source-pub-status');
      if (srcPub && a.source?.publicationStatus) srcPub.value = a.source.publicationStatus;

      const srcCov = document.getElementById('source-coverage');
      if (srcCov) srcCov.value = a.source?.coverage || '';

      const srcNotes = document.getElementById('source-notes');
      if (srcNotes) srcNotes.value = a.source?.notes || '';

      // 10. Populate Section 8: Power system
      const powerName = document.getElementById('power-name');
      if (powerName) powerName.value = a.powerSystem?.name || '';

      const powerContainer = document.getElementById('power-paragraphs-container');
      if (powerContainer) {
        powerContainer.innerHTML = '';
        const powerPars = a.powerSystem?.paragraphs?.length ? a.powerSystem.paragraphs : [''];
        powerPars.forEach((p, idx) => {
          addPowerParagraph(p, idx + 1);
        });
      }
    }

    // Check if initialAnime exists from SSR, or fetch from API if client loaded with ?id= or ?slug=
    const params = new URLSearchParams(window.location.search);
    const lookupParam = params.get('id') || params.get('slug');

    if (initialAnime) {
      hydrateAnimeData(initialAnime);
    } else if (lookupParam) {
      // Dynamic fetch from API
      fetch(`/api/admin/anime?id=${encodeURIComponent(lookupParam)}`)
        .then(res => res.json())
        .then(res => {
          if (res.success && res.data) {
            hydrateAnimeData(res.data);
          } else {
            console.warn('Could not find anime for lookup:', lookupParam);
          }
        })
        .catch(err => {
          console.error('Failed to fetch anime for editor hydration:', err);
        });
    } else {
      updateDependentSectionsState();
    }

    // -------------------------------------------------------------
    // 1. SAVE CORE
    // -------------------------------------------------------------
    const formCore = document.getElementById('form-core');
    const coreFeedback = document.getElementById('core-feedback');
    const coreBadge = document.getElementById('core-badge');

    formCore.addEventListener('submit', async (e) => {
      e.preventDefault();
      setFeedback(coreFeedback, 'Saving core information...', 'success');

      // Gather genres
      const checkedGenres = Array.from(formCore.querySelectorAll('input[name="genres"]:checked')).map(el => el.value);
      const customGenres = (document.getElementById('core-custom-genres').value || '')
        .split(',')
        .map(s => s.trim())
        .filter(Boolean);
      const allGenres = Array.from(new Set([...checkedGenres, ...customGenres]));

      // Gather vibes
      const checkedVibes = Array.from(formCore.querySelectorAll('input[name="vibes"]:checked')).map(el => el.value);

      // Aliases
      const aliases = (document.getElementById('core-aliases').value || '')
        .split(',')
        .map(s => s.trim())
        .filter(Boolean);

      const payload = {
        id: document.getElementById('core-id').value.trim(),
        slug: document.getElementById('core-slug').value.trim(),
        title: document.getElementById('core-title').value.trim(),
        originalTitle: document.getElementById('core-original-title').value.trim(),
        year: document.getElementById('core-year').value,
        episodes: document.getElementById('core-episodes').value,
        status: document.getElementById('core-status').value,
        honestyStatus: document.getElementById('core-honesty').value,
        personalRating: document.getElementById('core-rating').value,
        poster: document.getElementById('core-poster').value.trim(),
        backdrop: document.getElementById('core-backdrop').value.trim(),
        synopsis: document.getElementById('core-synopsis').value.trim(),
        trending: document.getElementById('core-trending').checked ? 1 : 0,
        aliases,
        genres: allGenres,
        vibes: checkedVibes
      };

      try {
        const res = await fetch('/api/admin/anime/core', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data.success) {
          currentAnimeId = payload.id;
          setFeedback(coreFeedback, '✓ Core details saved successfully! All sections are unlocked.', 'success');
          coreBadge.classList.remove('hidden');
          window.showAdminToast(`Saved core details for "${payload.title}"`, 'success');

          // Update header and unlock
          document.getElementById('heading-title-text').textContent = `Edit Anime: ${payload.title}`;
          const idBadge = document.getElementById('heading-id-badge');
          if (idBadge) {
            idBadge.textContent = payload.id;
            idBadge.classList.remove('hidden');
          }
          const subtext = document.getElementById('heading-subtext');
          if (subtext) subtext.textContent = '';
          const viewLink = document.getElementById('view-public-link');
          if (viewLink && payload.slug) {
            viewLink.href = `/anime/${payload.slug}`;
            viewLink.classList.remove('hidden');
          }

          updateDependentSectionsState();

          // Update URL without full reloading
          const newUrl = new URL(window.location);
          newUrl.searchParams.set('id', currentAnimeId);
          window.history.replaceState({}, '', newUrl);
        } else {
          setFeedback(coreFeedback, 'Error: ' + (data.error || 'Failed to save core details'), 'error');
          window.showAdminToast(data.error || 'Failed to save core details', 'error');
        }
      } catch (err) {
        setFeedback(coreFeedback, 'Network error: ' + err.message, 'error');
      }
    });

    // -------------------------------------------------------------
    // 2. SAVE REVIEW (MY TAKE)
    // -------------------------------------------------------------
    const formReview = document.getElementById('form-review');
    const reviewFeedback = document.getElementById('review-feedback');
    const reviewBadge = document.getElementById('review-badge');

    // Add paragraph handler
    document.getElementById('btn-add-review-p').addEventListener('click', () => {
      const container = document.getElementById('review-paragraphs-container');
      const count = container.children.length + 1;
      addReviewParagraph('', count);
    });

    // Remove paragraph delegate
    document.getElementById('review-paragraphs-container').addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-remove-p');
      if (btn) btn.closest('.paragraph-row').remove();
    });

    formReview.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAnimeId) {
        setFeedback(reviewFeedback, 'Please save Section 1 Core Details first.', 'error');
        return;
      }

      const heading = document.getElementById('review-heading').value.trim();
      const textareas = document.querySelectorAll('#review-paragraphs-container textarea');
      const paragraphs = Array.from(textareas).map(t => t.value.trim()).filter(Boolean);

      try {
        const res = await fetch('/api/admin/anime/review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ animeId: currentAnimeId, heading, paragraphs })
        });
        const data = await res.json();
        if (data.success) {
          setFeedback(reviewFeedback, '✓ Review / My Take saved successfully!', 'success');
          reviewBadge.classList.remove('hidden');
          window.showAdminToast('Review saved successfully', 'success');
        } else {
          setFeedback(reviewFeedback, 'Error: ' + data.error, 'error');
        }
      } catch (err) {
        setFeedback(reviewFeedback, 'Network error: ' + err.message, 'error');
      }
    });

    // -------------------------------------------------------------
    // 3. SAVE LESSONS
    // -------------------------------------------------------------
    const formLessons = document.getElementById('form-lessons');
    const lessonsFeedback = document.getElementById('lessons-feedback');
    const lessonsBadge = document.getElementById('lessons-badge');

    formLessons.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAnimeId) {
        setFeedback(lessonsFeedback, 'Please save Section 1 Core Details first.', 'error');
        return;
      }

      const heading = document.getElementById('lesson-heading').value.trim();
      const takeaway = document.getElementById('lesson-takeaway').value.trim();

      try {
        const res = await fetch('/api/admin/anime/lessons', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ animeId: currentAnimeId, heading, takeaway })
        });
        const data = await res.json();
        if (data.success) {
          setFeedback(lessonsFeedback, '✓ Lessons / Reflection saved successfully!', 'success');
          lessonsBadge.classList.remove('hidden');
          window.showAdminToast('Lessons saved successfully', 'success');
        } else {
          setFeedback(lessonsFeedback, 'Error: ' + data.error, 'error');
        }
      } catch (err) {
        setFeedback(lessonsFeedback, 'Network error: ' + err.message, 'error');
      }
    });

    // -------------------------------------------------------------
    // 4. SAVE WATCH ORDER
    // -------------------------------------------------------------
    const formWO = document.getElementById('form-watch-order');
    const woFeedback = document.getElementById('watch-order-feedback');
    const woBadge = document.getElementById('watch-order-badge');

    formWO.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAnimeId) {
        setFeedback(woFeedback, 'Please save Section 1 Core Details first.', 'error');
        return;
      }

      const franchiseId = document.getElementById('wo-franchise').value || null;
      const franchiseStepOrder = document.getElementById('wo-step').value || null;

      try {
        const res = await fetch('/api/admin/anime/watch-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ animeId: currentAnimeId, franchiseId, franchiseStepOrder })
        });
        const data = await res.json();
        if (data.success) {
          setFeedback(woFeedback, '✓ Franchise placement saved successfully!', 'success');
          woBadge.classList.remove('hidden');
          window.showAdminToast('Watch order link saved', 'success');
        } else {
          setFeedback(woFeedback, 'Error: ' + data.error, 'error');
        }
      } catch (err) {
        setFeedback(woFeedback, 'Network error: ' + err.message, 'error');
      }
    });

    // -------------------------------------------------------------
    // 5. SAVE FILLER RANGES
    // -------------------------------------------------------------
    const formFiller = document.getElementById('form-filler');
    const fillerFeedback = document.getElementById('filler-feedback');
    const fillerBadge = document.getElementById('filler-badge');

    // Light client-side validation
    function validateRangeInput(name, value) {
      if (!value || !value.trim()) return null;
      const parts = value.split(',').map(s => s.trim()).filter(Boolean);
      for (const p of parts) {
        const rm = p.match(/^(\d+)\s*[-–—]\s*(\d+)$/);
        if (rm) {
          const start = parseInt(rm[1], 10);
          const end = parseInt(rm[2], 10);
          if (start > end) {
            return `[${name}] Invalid range "${p}": start episode (${start}) cannot be greater than end episode (${end}).`;
          }
          continue;
        }
        if (/^\d+$/.test(p)) continue;
        return `[${name}] Invalid entry "${p}". Only episode numbers (e.g. "50") and ranges (e.g. "1-24") separated by commas are allowed.`;
      }
      return null;
    }

    formFiller.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAnimeId) {
        setFeedback(fillerFeedback, 'Please save Section 1 Core Details first.', 'error');
        return;
      }

      const mangaCanon = document.getElementById('filler-manga-canon').value.trim();
      const animeCanon = document.getElementById('filler-anime-canon').value.trim();
      const mixedCanon = document.getElementById('filler-mixed').value.trim();
      const filler = document.getElementById('filler-filler').value.trim();

      const errManga = validateRangeInput('Manga Canon', mangaCanon);
      if (errManga) { setFeedback(fillerFeedback, errManga, 'error'); return; }

      const errAnime = validateRangeInput('Anime Canon', animeCanon);
      if (errAnime) { setFeedback(fillerFeedback, errAnime, 'error'); return; }

      const errMixed = validateRangeInput('Mixed Canon/Filler', mixedCanon);
      if (errMixed) { setFeedback(fillerFeedback, errMixed, 'error'); return; }

      const errFiller = validateRangeInput('Filler', filler);
      if (errFiller) { setFeedback(fillerFeedback, errFiller, 'error'); return; }

      try {
        const res = await fetch('/api/admin/anime/filler-ranges', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            animeId: currentAnimeId,
            mangaCanon,
            animeCanon,
            mixedCanon,
            filler
          })
        });
        const data = await res.json();
        if (data.success) {
          updateLiveFillerStats();
          setFeedback(fillerFeedback, `✓ Episode breakdown saved! Total: ${data.totalEpisodes} eps (${data.canonEpisodes} canon, ${data.counts.filler} filler). Filler: ${data.fillerPercentage}%`, 'success');
          fillerBadge.classList.remove('hidden');
          window.showAdminToast(`Filler updated (${data.fillerPercentage}% filler)`, 'success');
        } else {
          setFeedback(fillerFeedback, 'Error: ' + data.error, 'error');
        }
      } catch (err) {
        setFeedback(fillerFeedback, 'Network error: ' + err.message, 'error');
      }
    });

    // Wire live input & change listeners to recalculate header stats in real-time
    ['filler-manga-canon', 'filler-anime-canon', 'filler-mixed', 'filler-filler'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('input', updateLiveFillerStats);
        el.addEventListener('change', updateLiveFillerStats);
      }
    });

    // -------------------------------------------------------------
    // 6. SAVE CHARACTERS
    // -------------------------------------------------------------
    const formChars = document.getElementById('form-chars');
    const charsFeedback = document.getElementById('chars-feedback');
    const charsBadge = document.getElementById('chars-badge');

    document.getElementById('btn-add-char-row').addEventListener('click', () => {
      const container = document.getElementById('chars-container');
      const nextRank = container.querySelectorAll('.character-row').length + 1;
      const div = document.createElement('div');
      div.className = 'p-3 bg-slate-950 border border-slate-800 rounded-xl space-y-2.5 character-row';
      div.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 flex-1">
            <span class="w-6 h-6 rounded bg-slate-800 text-slate-400 text-xs flex items-center justify-center font-bold shrink-0 char-rank-badge">
              ${nextRank}
            </span>
            <input type="text" placeholder="Character Name" class="char-input-name flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-sm text-white font-medium" required />
          </div>
          <select class="char-input-category px-2.5 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white">
            <option value="Main">Main</option>
            <option value="Protagonist">Protagonist</option>
            <option value="Supporting" selected>Supporting</option>
            <option value="Antagonist">Antagonist</option>
          </select>
          <button type="button" class="btn-remove-char text-slate-500 hover:text-rose-400 p-1 cursor-pointer" title="Remove character">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <input type="text" placeholder="Role / Title (e.g. Apprentice Mage)" class="char-input-role px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200" />
          <input type="text" placeholder="Short commentary or key trait" class="char-input-commentary px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200" />
        </div>
      `;
      div.querySelector('.btn-remove-char').addEventListener('click', () => {
        div.remove();
        updateCharacterRanks();
      });
      container.appendChild(div);
    });

    function updateCharacterRanks() {
      document.querySelectorAll('#chars-container .character-row').forEach((row, i) => {
        const badge = row.querySelector('.char-rank-badge');
        if (badge) badge.textContent = i + 1;
      });
    }

    document.getElementById('chars-container').addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-remove-char');
      if (btn) {
        btn.closest('.character-row').remove();
        updateCharacterRanks();
      }
    });

    formChars.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAnimeId) {
        setFeedback(charsFeedback, 'Please save Section 1 Core Details first.', 'error');
        return;
      }

      const rows = document.querySelectorAll('#chars-container .character-row');
      const characters = [];
      rows.forEach((row, idx) => {
        const name = row.querySelector('.char-input-name').value.trim();
        const category = row.querySelector('.char-input-category').value;
        const role = row.querySelector('.char-input-role').value.trim();
        const commentary = row.querySelector('.char-input-commentary').value.trim();
        if (name) {
          characters.push({ rank: idx + 1, name, category, role, commentary });
        }
      });

      try {
        const res = await fetch('/api/admin/anime/characters', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ animeId: currentAnimeId, characters })
        });
        const data = await res.json();
        if (data.success) {
          setFeedback(charsFeedback, '✓ Key characters saved successfully!', 'success');
          charsBadge.classList.remove('hidden');
          window.showAdminToast('Characters saved successfully', 'success');
        } else {
          setFeedback(charsFeedback, 'Error: ' + data.error, 'error');
        }
      } catch (err) {
        setFeedback(charsFeedback, 'Network error: ' + err.message, 'error');
      }
    });

    // -------------------------------------------------------------
    // 7. SAVE SOURCE GUIDANCE
    // -------------------------------------------------------------
    const formSource = document.getElementById('form-source');
    const sourceFeedback = document.getElementById('source-feedback');
    const sourceBadge = document.getElementById('source-badge');

    formSource.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAnimeId) {
        setFeedback(sourceFeedback, 'Please save Section 1 Core Details first.', 'error');
        return;
      }

      const source = {
        title: document.getElementById('source-title').value.trim(),
        author: document.getElementById('source-author').value.trim(),
        type: document.getElementById('source-type').value,
        volumes: document.getElementById('source-volumes').value.trim(),
        publicationStatus: document.getElementById('source-pub-status').value,
        coverage: document.getElementById('source-coverage').value.trim(),
        notes: document.getElementById('source-notes').value.trim()
      };

      try {
        const res = await fetch('/api/admin/anime/source', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ animeId: currentAnimeId, source })
        });
        const data = await res.json();
        if (data.success) {
          setFeedback(sourceFeedback, '✓ Source material guidance saved successfully!', 'success');
          sourceBadge.classList.remove('hidden');
          window.showAdminToast('Source guidance saved', 'success');
        } else {
          setFeedback(sourceFeedback, 'Error: ' + data.error, 'error');
        }
      } catch (err) {
        setFeedback(sourceFeedback, 'Network error: ' + err.message, 'error');
      }
    });

    // -------------------------------------------------------------
    // 8. SAVE POWER SYSTEM
    // -------------------------------------------------------------
    const formPower = document.getElementById('form-power');
    const powerFeedback = document.getElementById('power-feedback');
    const powerBadge = document.getElementById('power-badge');

    document.getElementById('btn-add-power-p').addEventListener('click', () => {
      const container = document.getElementById('power-paragraphs-container');
      const count = container.children.length + 1;
      addPowerParagraph('', count);
    });

    document.getElementById('power-paragraphs-container').addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-remove-power-p');
      if (btn) btn.closest('.power-paragraph-row').remove();
    });

    formPower.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentAnimeId) {
        setFeedback(powerFeedback, 'Please save Section 1 Core Details first.', 'error');
        return;
      }

      const name = document.getElementById('power-name').value.trim();
      const textareas = document.querySelectorAll('#power-paragraphs-container textarea');
      const paragraphs = Array.from(textareas).map(t => t.value.trim()).filter(Boolean);

      try {
        const res = await fetch('/api/admin/anime/power-system', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ animeId: currentAnimeId, name, paragraphs })
        });
        const data = await res.json();
        if (data.success) {
          setFeedback(powerFeedback, '✓ Power system details saved successfully!', 'success');
          powerBadge.classList.remove('hidden');
          window.showAdminToast('Power system saved successfully', 'success');
        } else {
          setFeedback(powerFeedback, 'Error: ' + data.error, 'error');
        }
      } catch (err) {
        setFeedback(powerFeedback, 'Network error: ' + err.message, 'error');
      }
    });
  </script>
</AdminLayout>
