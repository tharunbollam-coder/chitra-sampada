    async function executeSaveAll() {
      const formCore = document.getElementById('form-core');
      if (!formCore) return;

      const id = document.getElementById('core-id').value.trim();
      const slug = document.getElementById('core-slug').value.trim();
      const title = document.getElementById('core-title').value.trim();
      const year = document.getElementById('core-year').value;
      const typeVal = document.getElementById('core-type')?.value || 'series';
      const isMovie = typeVal === 'movie';
      const episodes = isMovie ? (document.getElementById('core-episodes')?.value || '1') : document.getElementById('core-episodes')?.value;
      const runtimeVal = document.getElementById('core-runtime')?.value;
      const movieCanonVal = document.getElementById('core-movie-canon')?.value;

      if (!id || !slug || !title || !year || (!isMovie && !episodes)) {
        alert('Please fill in all required fields in Section 1 (ID, Title, Slug, Year, Episodes) before saving.');
        const target = document.getElementById('section-core-body');
        if (target && target.classList.contains('hidden')) {
          target.classList.remove('hidden');
        }
        formCore.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      if (isMovie && (!runtimeVal || parseInt(runtimeVal, 10) <= 0)) {
        alert('Please enter a valid runtime in minutes for this movie in Section 1.');
        const target = document.getElementById('section-core-body');
        if (target && target.classList.contains('hidden')) {
          target.classList.remove('hidden');
        }
        document.getElementById('core-runtime')?.focus();
        return;
      }

      // 1. Gather Section 1 Core
      const checkedGenres = Array.from(formCore.querySelectorAll('input[name="genres"]:checked')).map(el => el.value);
      const customGenres = (document.getElementById('core-custom-genres').value || '')
        .split(',')
        .map(s => s.trim())
        .filter(Boolean);
      const allGenres = Array.from(new Set([...checkedGenres, ...customGenres]));
      const checkedVibes = Array.from(formCore.querySelectorAll('input[name="vibes"]:checked')).map(el => el.value);
      const aliases = (document.getElementById('core-aliases').value || '')
        .split(',')
        .map(s => s.trim())
        .filter(Boolean);

      const corePayload = {
        id,
        slug,
        title,
        originalTitle: document.getElementById('core-original-title').value.trim(),
        type: typeVal,
        runtime: isMovie && runtimeVal ? parseInt(runtimeVal, 10) : null,
        movieCanonType: isMovie ? movieCanonVal : null,
        year,
        episodes,
        status: document.getElementById('core-status').value,
        honestyStatus: document.getElementById('core-honesty').value,
        personalRating: document.getElementById('core-rating').value,
        poster: document.getElementById('core-poster').value.trim(),
        backdrop: document.getElementById('core-backdrop').value.trim(),
        synopsis: document.getElementById('core-synopsis').value.trim(),
        trending: document.getElementById('core-trending').checked ? 1 : 0,
        aliases,
        genres: allGenres,
        vibes: checkedVibes
      };

      // 2. Section 2 Review
      const reviewHeading = document.getElementById('review-heading')?.value.trim() || '';
      const reviewTextareas = document.querySelectorAll('#review-paragraphs-container textarea');
      const reviewParagraphs = Array.from(reviewTextareas).map(t => t.value.trim()).filter(Boolean);
      const reviewPayload = { heading: reviewHeading, paragraphs: reviewParagraphs };

      // 3. Section 3 Lessons
      const lessonHeading = document.getElementById('lesson-heading')?.value.trim() || '';
      const lessonTakeaway = document.getElementById('lesson-takeaway')?.value.trim() || '';
      const lessonsPayload = { heading: lessonHeading, takeaway: lessonTakeaway };

      // 4. Section 4 Watch Order
      const franchiseId = document.getElementById('wo-franchise')?.value || null;
      const franchiseStepOrder = document.getElementById('wo-step')?.value || null;
      const watchOrderPayload = { franchiseId, franchiseStepOrder };

      // 5. Section 5 Filler & Canon Breakdown (Skipped for movies)
      let fillerPayload = null;
      if (!isMovie) {
        const mangaCanon = document.getElementById('filler-manga-canon')?.value.trim() || '';
        const animeCanon = document.getElementById('filler-anime-canon')?.value.trim() || '';
