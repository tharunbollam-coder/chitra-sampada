              class="text-xs px-3 py-1.5 bg-indigo-600/20 text-indigo-300 border border-indigo-500/40 rounded-lg hover:bg-indigo-600/30 font-semibold flex items-center gap-1 shrink-0 cursor-pointer"
            >
              + Add Platform
            </button>
          </div>

          <div id="streaming-container" class="space-y-3">
            {(anime?.streamingPlatforms?.length ? anime.streamingPlatforms : []).map((p, i) => (
              <div class="p-3 bg-slate-950 border border-slate-800 rounded-xl space-y-2.5 streaming-row">
                <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2.5">
                  <div class="flex items-center gap-2 flex-1 min-w-[200px]">
                    <span class="w-6 h-6 rounded bg-slate-800 text-slate-400 text-xs flex items-center justify-center font-bold shrink-0 streaming-order-badge">
                      {p.displayOrder || i + 1}
                    </span>
                    <input
                      type="text"
                      value={p.platformName}
                      placeholder="Platform Name (e.g. Crunchyroll)"
                      class="streaming-input-name flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-sm text-white font-medium"
                      required
                    />
                  </div>
                  <div class="flex items-center gap-2 flex-1 sm:max-w-xs ml-auto sm:ml-0">
                    <input
                      type="url"
                      value={p.streamUrl || ''}
                      placeholder="Stream URL (optional)"
                      class="streaming-input-url w-full px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white"
                    />
                    <button
                      type="button"
                      class="btn-remove-streaming text-slate-500 hover:text-rose-400 p-1 cursor-pointer shrink-0"
                      title="Remove platform"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <input
                    type="url"
                    value={p.logoUrl || ''}
                    placeholder="Logo / Icon URL (optional)"
                    class="streaming-input-logo px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200"
                  />
                  <input
                    type="text"
                    value={p.note || ''}
                    placeholder="Availability Note (e.g. Hindi Dub, Subbed only)"
                    class="streaming-input-note px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200"
                  />
                </div>
              </div>
            ))}
          </div>

          <div class="pt-4 border-t border-slate-800 flex justify-end">
            <button
              type="submit"
              class="w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-sm transition cursor-pointer"
            >
              Save Streaming Platforms
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Bottom Static Save Bar -->
    <div class="mt-8 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <p class="text-sm font-semibold text-white">Done making edits?</p>
        <p class="text-xs text-slate-400 mt-0.5">All sections, dynamic items, and visibility toggles will be saved simultaneously.</p>
      </div>
      <button
        type="button"
        id="btn-save-all-bottom"
        class="btn-save-all w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 rounded-xl shadow-lg shadow-emerald-950/40 border border-emerald-500/40 transition cursor-pointer"
        title="Save all sections and visibility toggles simultaneously"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
        </svg>
        <span>Save All Changes</span>
      </button>
    </div>
  </div>

  <!-- ============================================================= -->
  <!-- MODAL: ANIME SLUG UNLOCK WARNING CONFIRMATION -->
  <!-- ============================================================= -->
  <div id="modal-anime-slug-warning" class="fixed inset-0 z-60 hidden overflow-y-auto bg-slate-950/85 backdrop-blur-sm p-4 flex items-center justify-center">
    <div class="relative w-full max-w-md bg-slate-900 border border-amber-500/60 rounded-2xl shadow-2xl p-6 text-left">
      <div class="flex items-center gap-3 text-amber-400 mb-3">
        <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h3 class="text-lg font-bold text-white font-heading">Change Public Anime Slug?</h3>
      </div>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        ⚠️ Warning: Changing this anime slug will alter all public URLs for this show (including the main page, watch order, filler list, and character guides). Any external bookmarks or search engine rankings will break. Are you sure you want to edit it?
      </p>

      <div class="flex justify-end gap-3 mt-6">
        <button
          type="button"
          id="btn-cancel-anime-slug-unlock"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs sm:text-sm font-medium transition cursor-pointer"
        >
          Keep Locked
        </button>
        <button
          type="button"
          id="btn-confirm-anime-slug-unlock"
          class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs sm:text-sm font-semibold transition cursor-pointer"
        >
          Yes, Unlock Slug
        </button>
      </div>
    </div>
  </div>

  <!-- Client JavaScript for Interactivity, Dynamic Rows, Hydration, and Section Saves -->
  <script is:inline define:vars={{ initialAnime: anime, isNewRecord: isNew, platformAnimeList }}>
    let currentAnimeId = initialAnime?.id || null;

    // Helper: Show localized inline banner in section
    function setFeedback(feedbackEl, message, type = 'success') {
      if (!feedbackEl) return;
      feedbackEl.classList.remove(
        'hidden',
        'bg-emerald-950/80', 'border-emerald-700', 'text-emerald-300',
        'bg-rose-950/80', 'border-rose-700', 'text-rose-300',
        'bg-amber-950/80', 'border-amber-700', 'text-amber-300'
      );
      if (type === 'success') {
        feedbackEl.classList.add('bg-emerald-950/80', 'border-emerald-700', 'text-emerald-300');
      } else if (type === 'warning') {
        feedbackEl.classList.add('bg-amber-950/80', 'border-amber-700', 'text-amber-300');
      } else {
        feedbackEl.classList.add('bg-rose-950/80', 'border-rose-700', 'text-rose-300');
      }
      feedbackEl.textContent = message;
      feedbackEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Toggle accordion logic
    document.querySelectorAll('.section-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (e.target.closest('.no-section-toggle')) return;
        const targetId = btn.getAttribute('data-target');
        const target = document.getElementById(targetId);
        const chevron = btn.querySelector('.section-chevron');
        if (target) {
          const isHidden = target.classList.contains('hidden');
          target.classList.toggle('hidden', !isHidden);
          if (chevron) {
            chevron.classList.toggle('rotate-180', !isHidden);
          }
        }
      });
    });

    // Visibility Toggles (Show/Hide on Public Page)
    document.querySelectorAll('.section-visibility-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', async (e) => {
        const input = e.target;
        const section = input.getAttribute('data-section');
        const labelContainer = input.closest('label');
        const labelText = labelContainer?.querySelector('.visibility-label');
        const track = labelContainer?.querySelector('.switch-track');
        const thumb = labelContainer?.querySelector('.switch-thumb');
        const isVisible = input.checked;

        // Visual update immediately
        if (labelText) labelText.textContent = isVisible ? 'Public: Show' : 'Public: Hide';
        if (track) {
          track.classList.toggle('bg-indigo-600', isVisible);
          track.classList.toggle('bg-slate-700', !isVisible);
        }
        if (thumb) {
          thumb.classList.toggle('translate-x-3.5', isVisible);
          thumb.classList.toggle('translate-x-0', !isVisible);
        }

        if (!currentAnimeId) {
          alert('Please save Section 1 (Core Details) first before updating section visibility.');
          input.checked = !isVisible;
          if (labelText) labelText.textContent = !isVisible ? 'Public: Show' : 'Public: Hide';
          if (track) {
            track.classList.toggle('bg-indigo-600', !isVisible);
            track.classList.toggle('bg-slate-700', isVisible);
          }
          if (thumb) {
            thumb.classList.toggle('translate-x-3.5', !isVisible);
            thumb.classList.toggle('translate-x-0', isVisible);
          }
          return;
        }

        try {
          const res = await fetch('/api/admin/anime/visibility', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              animeId: currentAnimeId,
              section,
              visible: isVisible
            })
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || 'Failed to update section visibility');
          }
        } catch (err) {
          console.error('Error updating section visibility:', err);
          alert('Could not update visibility: ' + err.message);
          // Revert visual and checkbox state
          input.checked = !isVisible;
          if (labelText) labelText.textContent = !isVisible ? 'Public: Show' : 'Public: Hide';
          if (track) {
            track.classList.toggle('bg-indigo-600', !isVisible);
            track.classList.toggle('bg-slate-700', isVisible);
          }
          if (thumb) {
            thumb.classList.toggle('translate-x-3.5', !isVisible);
            thumb.classList.toggle('translate-x-0', isVisible);
          }
        }
      });
    });

    // Auto-generate slug and ID from title if creating a new anime
    const titleInput = document.getElementById('core-title');
    const slugInput = document.getElementById('core-slug');
    const idInput = document.getElementById('core-id');

    if (titleInput && slugInput && idInput) {
      titleInput.addEventListener('input', () => {
        if (!currentAnimeId) {
          if (!slugInput.value || slugInput.dataset.touched !== 'true') {
            const clean = titleInput.value
              .toLowerCase()
              .replace(/['’]/g, '')
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-+|-+$/g, '');
            slugInput.value = clean;
            
            if (!idInput.value || idInput.dataset.touched !== 'true') {
              const shortId = clean.split('-')[0] || '';
              idInput.value = shortId;
            }
          }
        }
      });

      slugInput.addEventListener('input', () => { slugInput.dataset.touched = 'true'; });
      idInput.addEventListener('input', () => { idInput.dataset.touched = 'true'; });
    }

    // Slug lock / unlock logic (guardrail for existing anime records)
    let isAnimeSlugUnlocked = isNewRecord ? true : false;
    const btnUnlockAnimeSlug = document.getElementById('btn-unlock-anime-slug');
    const btnUnlockAnimeSlugLabel = document.getElementById('btn-unlock-anime-slug-label');
    const modalAnimeSlugWarning = document.getElementById('modal-anime-slug-warning');
    const btnCancelAnimeSlugUnlock = document.getElementById('btn-cancel-anime-slug-unlock');
    const btnConfirmAnimeSlugUnlock = document.getElementById('btn-confirm-anime-slug-unlock');

    function lockAnimeSlug() {
      if (!slugInput) return;
      isAnimeSlugUnlocked = false;
      slugInput.readOnly = true;
      slugInput.className = 'w-full px-3.5 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-sm font-mono text-slate-400 cursor-not-allowed focus:outline-none transition';
      if (btnUnlockAnimeSlugLabel) btnUnlockAnimeSlugLabel.textContent = 'Edit Slug';
      if (btnUnlockAnimeSlug) btnUnlockAnimeSlug.classList.remove('hidden');
    }

    function unlockAnimeSlug() {
      if (!slugInput) return;
      isAnimeSlugUnlocked = true;
      slugInput.readOnly = false;
      slugInput.className = 'w-full px-3.5 py-2.5 bg-slate-950 border border-amber-500 rounded-xl text-sm font-mono text-white focus:outline-none focus:border-amber-400 transition';
      if (btnUnlockAnimeSlugLabel) btnUnlockAnimeSlugLabel.textContent = 'Unlocked';
      if (btnUnlockAnimeSlug) btnUnlockAnimeSlug.classList.remove('hidden');
      slugInput.focus();
    }

    if (btnUnlockAnimeSlug) {
      btnUnlockAnimeSlug.addEventListener('click', () => {
        if (!isAnimeSlugUnlocked) {
          modalAnimeSlugWarning?.classList.remove('hidden');
        }
      });
    }

    btnCancelAnimeSlugUnlock?.addEventListener('click', () => {
      modalAnimeSlugWarning?.classList.add('hidden');
    });

    btnConfirmAnimeSlugUnlock?.addEventListener('click', () => {
      modalAnimeSlugWarning?.classList.add('hidden');
      unlockAnimeSlug();
    });

    modalAnimeSlugWarning?.addEventListener('click', (e) => {
      if (e.target === modalAnimeSlugWarning) {
        modalAnimeSlugWarning.classList.add('hidden');
      }
    });

    // Initialize slug lock state on page load
    if (currentAnimeId) {
      lockAnimeSlug();
    } else {
      if (btnUnlockAnimeSlug) btnUnlockAnimeSlug.classList.add('hidden');
    }

    // Dependent sections state: unlock if currentAnimeId is set
    function updateDependentSectionsState() {
      const isUnlocked = Boolean(currentAnimeId);
      const dependents = document.querySelectorAll('.dependent-section');
      dependents.forEach(sec => {
        if (!isUnlocked) {
          sec.classList.add('opacity-50', 'pointer-events-none');
        } else {
          sec.classList.remove('opacity-50', 'pointer-events-none');
        }
      });
    }

    // Helper: get and set source material type with custom format support
    function setSourceTypeValue(val) {
      const select = document.getElementById('source-type');
      const customInput = document.getElementById('source-type-custom');
      const customContainer = document.getElementById('source-type-custom-container');
      if (!select) return;

      const standardSourceTypes = ['Manga', 'Manhwa', 'Light Novel', 'Web Novel', 'Anime Original', 'Visual Novel / Game'];
      if (standardSourceTypes.includes(val)) {
        select.value = val;
        if (customContainer) customContainer.classList.add('hidden');
        if (customInput) customInput.value = '';
      } else if (val === 'Original') {
        select.value = 'Anime Original';
        if (customContainer) customContainer.classList.add('hidden');
        if (customInput) customInput.value = '';
      } else if (val === 'Visual Novel') {
        select.value = 'Visual Novel / Game';
        if (customContainer) customContainer.classList.add('hidden');
        if (customInput) customInput.value = '';
      } else if (val) {
        select.value = 'Custom';
        if (customContainer) customContainer.classList.remove('hidden');
        if (customInput) customInput.value = val;
      } else {
        select.value = 'Manga';
        if (customContainer) customContainer.classList.add('hidden');
        if (customInput) customInput.value = '';
      }
    }

    function getSourceTypeValue() {
      const select = document.getElementById('source-type');
      const customInput = document.getElementById('source-type-custom');
      if (!select) return 'Manga';
      if (select.value === 'Custom') {
        return customInput?.value?.trim() || 'Custom';
      }
      return select.value;
    }

    // Source type change listener for custom input visibility
    const sourceTypeSelect = document.getElementById('source-type');
    const sourceTypeCustomContainer = document.getElementById('source-type-custom-container');
    const sourceTypeCustomInput = document.getElementById('source-type-custom');
    if (sourceTypeSelect) {
      sourceTypeSelect.addEventListener('change', (e) => {
        if (e.target.value === 'Custom') {
          if (sourceTypeCustomContainer) sourceTypeCustomContainer.classList.remove('hidden');
          if (sourceTypeCustomInput) sourceTypeCustomInput.focus();
        } else {
          if (sourceTypeCustomContainer) sourceTypeCustomContainer.classList.add('hidden');
        }
      });
    }

    // Helper: update rank indicators for Universe Media
    function updateUniverseRanks() {
      document.querySelectorAll('#universe-container .universe-row').forEach((row, i) => {
        const badge = row.querySelector('.universe-order-badge');
        if (badge) badge.textContent = i + 1;
      });
    }

    // Helper: add a Related & Universe Media row to Section 9
    function addUniverseRow(u = {}, index = 1) {
      const container = document.getElementById('universe-container');
      if (!container) return;
      const div = document.createElement('div');
      div.className = 'p-3 bg-slate-950 border border-slate-800 rounded-xl space-y-2.5 universe-row';
      const sectionVal = u.section || 'canon';
      const badgeVal = u.badge || 'Main Series';
      const titleVal = u.title || '';
      const slugVal = u.linkSlug || '';
      const noteVal = u.editorialNote || '';

      div.innerHTML = `
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2 flex-1 min-w-[180px]">
            <span class="w-6 h-6 rounded bg-slate-800 text-slate-400 text-xs flex items-center justify-center font-bold shrink-0 universe-order-badge">
              ${u.itemOrder || index}
            </span>
            <input
              type="text"
              value="${titleVal}"
              placeholder="Title (e.g. Naruto: Shippuden)"
              class="universe-input-title flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-sm text-white font-medium"
              required
            />
          </div>
          <div class="flex items-center gap-2 shrink-0 ml-auto sm:ml-0">
            <select class="universe-input-section px-2.5 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white">
              <option value="canon" ${sectionVal === 'canon' ? 'selected' : ''}>Canon Storyline</option>
              <option value="non_canon" ${sectionVal === 'non_canon' ? 'selected' : ''}>Non-Canon / Spin-off</option>
            </select>
            <select class="universe-input-badge px-2.5 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white">
              <optgroup label="Canon Badges">
                <option value="Main Series" ${badgeVal === 'Main Series' ? 'selected' : ''}>Main Series</option>
                <option value="Canon Sequel" ${badgeVal === 'Canon Sequel' ? 'selected' : ''}>Canon Sequel</option>
                <option value="Canon Prequel" ${badgeVal === 'Canon Prequel' ? 'selected' : ''}>Canon Prequel</option>
                <option value="Canon Movie" ${badgeVal === 'Canon Movie' ? 'selected' : ''}>Canon Movie</option>
              </optgroup>
              <optgroup label="Non-Canon Badges">
                <option value="Non-Canon Movie" ${badgeVal === 'Non-Canon Movie' ? 'selected' : ''}>Non-Canon Movie</option>
                <option value="Spin-off" ${badgeVal === 'Spin-off' ? 'selected' : ''}>Spin-off</option>
                <option value="OVA / Special" ${badgeVal === 'OVA / Special' ? 'selected' : ''}>OVA / Special</option>
              </optgroup>
            </select>
            <button
              type="button"
              class="btn-remove-universe text-slate-500 hover:text-rose-400 p-1 cursor-pointer"
              title="Remove item"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <input
            type="text"
            value="${slugVal}"
            placeholder="Link Slug (e.g. naruto-shippuden) [Optional]"
            class="universe-input-slug sm:col-span-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200"
          />
          <input
            type="text"
            value="${noteVal}"
            placeholder="Editorial Note (e.g. Set between eps 311 & 312; Kishimoto concept) [Optional]"
            class="universe-input-note sm:col-span-2 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200"
          />
        </div>
      `;

      div.querySelector('.btn-remove-universe').addEventListener('click', () => {
        div.remove();
        updateUniverseRanks();
      });
      container.appendChild(div);
    }

    // Helper: update rank indicators for Recommendations
    function updateRecRanks() {
      document.querySelectorAll('#recs-container .rec-row').forEach((row, i) => {
        const badge = row.querySelector('.rec-order-badge');
        if (badge) badge.textContent = i + 1;
      });
    }

    // Helper: add a Shows Like This recommendation row to Section 10
    function addRecRow(r = {}, index = 1) {
      const container = document.getElementById('recs-container');
      if (!container) return;
      const div = document.createElement('div');
      div.className = 'p-3 bg-slate-950 border border-slate-800 rounded-xl space-y-2.5 rec-row';
      const targetIdVal = r.targetAnimeId || '';
      const badgeVal = r.categoryBadge || '';
      const noteVal = r.editorialNote || '';

      const options = (platformAnimeList || [])
        .filter(pa => pa.id !== currentAnimeId)
        .map(pa => `<option value="${pa.id}" ${pa.id === targetIdVal ? 'selected' : ''}>${pa.title} (${pa.id})</option>`)
        .join('');

      div.innerHTML = `
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2 flex-1 min-w-[200px]">
            <span class="w-6 h-6 rounded bg-slate-800 text-slate-400 text-xs flex items-center justify-center font-bold shrink-0 rec-order-badge">
              ${r.itemOrder || index}
            </span>
            <select class="rec-input-target flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-sm text-white font-medium" required>
              <option value="">-- Select Recommended Anime --</option>
              ${options}
            </select>
          </div>
          <div class="flex items-center gap-2 flex-1 sm:max-w-xs">
            <input
              type="text"
              value="${badgeVal}"
              placeholder="Category Badge (e.g. Similar Shonen Progression)"
              class="rec-input-badge w-full px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white"
              required
            />
            <button
              type="button"
              class="btn-remove-rec text-slate-500 hover:text-rose-400 p-1 cursor-pointer shrink-0"
              title="Remove recommendation"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        </div>

        <div>
          <textarea
            rows="2"
            placeholder="Why You Should Watch (editorial hook comparing dynamics, themes, or pacing)..."
            class="rec-input-note w-full px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500"
          >${noteVal}</textarea>
        </div>
