              class="sr-only section-visibility-checkbox"
              data-section="recommendations"
              checked={sectionVisibility.recommendations}
            />
            <div class:list={[
              'w-8 h-4.5 rounded-full transition-colors relative flex items-center p-0.5 switch-track',
              sectionVisibility.recommendations ? 'bg-indigo-600' : 'bg-slate-700'
            ]}>
              <div class:list={[
                'w-3.5 h-3.5 rounded-full bg-white transition-transform transform shadow-sm switch-thumb',
                sectionVisibility.recommendations ? 'translate-x-3.5' : 'translate-x-0'
              ]}></div>
            </div>
          </label>
          <span id="recs-badge" class="hidden text-xs px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/80 font-medium">Saved</span>
          <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200 section-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </button>

      <div id="section-recs-body" class="px-4 sm:px-6 pb-6 pt-2 border-t border-slate-800/80">
        <div id="recs-feedback" class="hidden mb-5 p-3.5 rounded-xl text-xs sm:text-sm font-medium border"></div>

        <form id="form-recs" class="space-y-4">
          <div class="flex items-center justify-between">
            <p class="text-xs text-slate-400">
              Pick other anime titles on the platform and explain why fans of this show will love them.
            </p>
            <button
              type="button"
              id="btn-add-rec-row"
              class="text-xs px-3 py-1.5 bg-indigo-600/20 text-indigo-300 border border-indigo-500/40 rounded-lg hover:bg-indigo-600/30 font-semibold flex items-center gap-1 shrink-0 cursor-pointer"
            >
              + Add Recommendation
            </button>
          </div>

          <div id="recs-container" class="space-y-3">
            {(anime?.recommendations?.length ? anime.recommendations : []).map((r, i) => (
              <div class="p-3 bg-slate-950 border border-slate-800 rounded-xl space-y-2.5 rec-row">
                <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2.5">
                  <div class="flex items-center gap-2 flex-1 min-w-[200px]">
                    <span class="w-6 h-6 rounded bg-slate-800 text-slate-400 text-xs flex items-center justify-center font-bold shrink-0 rec-order-badge">
                      {r.itemOrder || i + 1}
                    </span>
                    <select class="rec-input-target flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-sm text-white font-medium" required>
                      <option value="">-- Select Recommended Anime --</option>
                      {platformAnimeList.filter(pa => pa.id !== anime?.id).map(pa => (
                        <option value={pa.id} selected={pa.id === r.targetAnimeId}>
                          {pa.title} ({pa.id})
                        </option>
                      ))}
                    </select>
                  </div>
                  <div class="flex items-center gap-2 flex-1 sm:max-w-xs">
                    <input
                      type="text"
                      value={r.categoryBadge}
                      placeholder="Category Badge (e.g. Similar Shonen Progression)"
                      class="rec-input-badge w-full px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white"
                      required
                    />
                    <button
                      type="button"
                      class="btn-remove-rec text-slate-500 hover:text-rose-400 p-1 cursor-pointer shrink-0"
                      title="Remove recommendation"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </div>

                <div>
                  <textarea
                    rows="2"
                    placeholder="Why You Should Watch (editorial hook comparing dynamics, themes, or pacing)..."
                    class="rec-input-note w-full px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500"
                  >{r.editorialNote || ''}</textarea>
                </div>
              </div>
            ))}
          </div>

          <div class="pt-4 border-t border-slate-800 flex justify-end">
            <button
              type="submit"
              class="w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-sm transition cursor-pointer"
            >
              Save Recommendations
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Bottom Static Save Bar -->
    <div class="mt-8 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <p class="text-sm font-semibold text-white">Done making edits?</p>
        <p class="text-xs text-slate-400 mt-0.5">All sections, dynamic items, and visibility toggles will be saved simultaneously.</p>
      </div>
      <button
        type="button"
        id="btn-save-all-bottom"
        class="btn-save-all w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 rounded-xl shadow-lg shadow-emerald-950/40 border border-emerald-500/40 transition cursor-pointer"
        title="Save all sections and visibility toggles simultaneously"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
        </svg>
        <span>Save All Changes</span>
      </button>
    </div>
  </div>

  <!-- Client JavaScript for Interactivity, Dynamic Rows, Hydration, and Section Saves -->
  <script is:inline define:vars={{ initialAnime: anime, isNewRecord: isNew, platformAnimeList }}>
    let currentAnimeId = initialAnime?.id || null;

    // Helper: Show localized inline banner in section
    function setFeedback(feedbackEl, message, type = 'success') {
      if (!feedbackEl) return;
      feedbackEl.classList.remove(
        'hidden',
        'bg-emerald-950/80', 'border-emerald-700', 'text-emerald-300',
        'bg-rose-950/80', 'border-rose-700', 'text-rose-300',
        'bg-amber-950/80', 'border-amber-700', 'text-amber-300'
      );
      if (type === 'success') {
        feedbackEl.classList.add('bg-emerald-950/80', 'border-emerald-700', 'text-emerald-300');
      } else if (type === 'warning') {
        feedbackEl.classList.add('bg-amber-950/80', 'border-amber-700', 'text-amber-300');
      } else {
        feedbackEl.classList.add('bg-rose-950/80', 'border-rose-700', 'text-rose-300');
      }
      feedbackEl.textContent = message;
      feedbackEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Toggle accordion logic
    document.querySelectorAll('.section-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (e.target.closest('.no-section-toggle')) return;
        const targetId = btn.getAttribute('data-target');
        const target = document.getElementById(targetId);
        const chevron = btn.querySelector('.section-chevron');
        if (target) {
          const isHidden = target.classList.contains('hidden');
          target.classList.toggle('hidden', !isHidden);
          if (chevron) {
            chevron.classList.toggle('rotate-180', !isHidden);
          }
        }
      });
    });

    // Visibility Toggles (Show/Hide on Public Page)
    document.querySelectorAll('.section-visibility-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', async (e) => {
        const input = e.target;
        const section = input.getAttribute('data-section');
        const labelContainer = input.closest('label');
        const labelText = labelContainer?.querySelector('.visibility-label');
        const track = labelContainer?.querySelector('.switch-track');
        const thumb = labelContainer?.querySelector('.switch-thumb');
        const isVisible = input.checked;

        // Visual update immediately
        if (labelText) labelText.textContent = isVisible ? 'Public: Show' : 'Public: Hide';
        if (track) {
          track.classList.toggle('bg-indigo-600', isVisible);
          track.classList.toggle('bg-slate-700', !isVisible);
        }
        if (thumb) {
          thumb.classList.toggle('translate-x-3.5', isVisible);
          thumb.classList.toggle('translate-x-0', !isVisible);
        }

        if (!currentAnimeId) {
          alert('Please save Section 1 (Core Details) first before updating section visibility.');
          input.checked = !isVisible;
          if (labelText) labelText.textContent = !isVisible ? 'Public: Show' : 'Public: Hide';
          if (track) {
            track.classList.toggle('bg-indigo-600', !isVisible);
            track.classList.toggle('bg-slate-700', isVisible);
          }
          if (thumb) {
            thumb.classList.toggle('translate-x-3.5', !isVisible);
            thumb.classList.toggle('translate-x-0', isVisible);
          }
          return;
        }

        try {
          const res = await fetch('/api/admin/anime/visibility', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              animeId: currentAnimeId,
              section,
              visible: isVisible
            })
          });

          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || 'Failed to update section visibility');
          }
        } catch (err) {
          console.error('Error updating section visibility:', err);
          alert('Could not update visibility: ' + err.message);
          // Revert visual and checkbox state
          input.checked = !isVisible;
          if (labelText) labelText.textContent = !isVisible ? 'Public: Show' : 'Public: Hide';
          if (track) {
            track.classList.toggle('bg-indigo-600', !isVisible);
            track.classList.toggle('bg-slate-700', isVisible);
          }
          if (thumb) {
            thumb.classList.toggle('translate-x-3.5', !isVisible);
            thumb.classList.toggle('translate-x-0', isVisible);
          }
        }
      });
    });

    // Auto-generate slug and ID from title if creating a new anime
    const titleInput = document.getElementById('core-title');
    const slugInput = document.getElementById('core-slug');
    const idInput = document.getElementById('core-id');

    if (titleInput && slugInput && idInput) {
      titleInput.addEventListener('input', () => {
        if (!currentAnimeId) {
          if (!slugInput.value || slugInput.dataset.touched !== 'true') {
            const clean = titleInput.value
              .toLowerCase()
              .replace(/['’]/g, '')
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-+|-+$/g, '');
            slugInput.value = clean;
            
            if (!idInput.value || idInput.dataset.touched !== 'true') {
              const shortId = clean.split('-')[0] || '';
              idInput.value = shortId;
            }
          }
        }
      });

      slugInput.addEventListener('input', () => { slugInput.dataset.touched = 'true'; });
      idInput.addEventListener('input', () => { idInput.dataset.touched = 'true'; });
    }

    // Dependent sections state: unlock if currentAnimeId is set
    function updateDependentSectionsState() {
      const isUnlocked = Boolean(currentAnimeId);
      const dependents = document.querySelectorAll('.dependent-section');
      dependents.forEach(sec => {
        if (!isUnlocked) {
          sec.classList.add('opacity-50', 'pointer-events-none');
        } else {
          sec.classList.remove('opacity-50', 'pointer-events-none');
        }
      });
    }

    // Helper: add a review paragraph row to Section 2
    function addReviewParagraph(content = '', index = 1) {
      const container = document.getElementById('review-paragraphs-container');
      const div = document.createElement('div');
      div.className = 'flex items-start gap-2 paragraph-row';
      div.innerHTML = `
        <textarea rows="4" class="flex-1 px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 min-h-[130px] review-paragraph-input" placeholder="Paragraph ${index}..."></textarea>
        <button type="button" class="btn-remove-p p-2 text-slate-500 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition cursor-pointer" title="Remove paragraph">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      `;
      const textarea = div.querySelector('textarea');
      textarea.value = content;
      div.querySelector('.btn-remove-p').addEventListener('click', () => div.remove());
      container.appendChild(div);
    }

    // Helper: add a power paragraph row to Section 8
    function addPowerParagraph(content = '', index = 1) {
      const container = document.getElementById('power-paragraphs-container');
      const div = document.createElement('div');
      div.className = 'flex items-start gap-2 power-paragraph-row';
      div.innerHTML = `
        <textarea rows="4" class="flex-1 px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 min-h-[130px] power-paragraph-input" placeholder="Power mechanic paragraph ${index}..."></textarea>
        <button type="button" class="btn-remove-power-p p-2 text-slate-500 hover:text-rose-400 rounded-lg hover:bg-slate-800 transition cursor-pointer" title="Remove paragraph">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </button>
      `;
      const textarea = div.querySelector('textarea');
      textarea.value = content;
      div.querySelector('.btn-remove-power-p').addEventListener('click', () => div.remove());
      container.appendChild(div);
    }

    // Helper: update rank indicators for Universe Media
    function updateUniverseRanks() {
      document.querySelectorAll('#universe-container .universe-row').forEach((row, i) => {
        const badge = row.querySelector('.universe-order-badge');
        if (badge) badge.textContent = i + 1;
      });
    }

    // Helper: add a Related & Universe Media row to Section 9
    function addUniverseRow(u = {}, index = 1) {
      const container = document.getElementById('universe-container');
      if (!container) return;
      const div = document.createElement('div');
      div.className = 'p-3 bg-slate-950 border border-slate-800 rounded-xl space-y-2.5 universe-row';
      const sectionVal = u.section || 'canon';
      const badgeVal = u.badge || 'Main Series';
      const titleVal = u.title || '';
      const slugVal = u.linkSlug || '';
      const noteVal = u.editorialNote || '';

      div.innerHTML = `
        <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2 flex-1 min-w-[180px]">
            <span class="w-6 h-6 rounded bg-slate-800 text-slate-400 text-xs flex items-center justify-center font-bold shrink-0 universe-order-badge">
              ${u.itemOrder || index}
            </span>
            <input
              type="text"
              value="${titleVal}"
              placeholder="Title (e.g. Naruto: Shippuden)"
              class="universe-input-title flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-sm text-white font-medium"
              required
            />
          </div>
          <div class="flex items-center gap-2 shrink-0 ml-auto sm:ml-0">
            <select class="universe-input-section px-2.5 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white">
              <option value="canon" ${sectionVal === 'canon' ? 'selected' : ''}>Canon Storyline</option>
              <option value="non_canon" ${sectionVal === 'non_canon' ? 'selected' : ''}>Non-Canon / Spin-off</option>
            </select>
            <select class="universe-input-badge px-2.5 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white">
              <optgroup label="Canon Badges">
                <option value="Main Series" ${badgeVal === 'Main Series' ? 'selected' : ''}>Main Series</option>
                <option value="Canon Sequel" ${badgeVal === 'Canon Sequel' ? 'selected' : ''}>Canon Sequel</option>
                <option value="Canon Prequel" ${badgeVal === 'Canon Prequel' ? 'selected' : ''}>Canon Prequel</option>
                <option value="Canon Movie" ${badgeVal === 'Canon Movie' ? 'selected' : ''}>Canon Movie</option>
              </optgroup>
              <optgroup label="Non-Canon Badges">
                <option value="Non-Canon Movie" ${badgeVal === 'Non-Canon Movie' ? 'selected' : ''}>Non-Canon Movie</option>
                <option value="Spin-off" ${badgeVal === 'Spin-off' ? 'selected' : ''}>Spin-off</option>
                <option value="OVA / Special" ${badgeVal === 'OVA / Special' ? 'selected' : ''}>OVA / Special</option>
              </optgroup>
            </select>
            <button
              type="button"
              class="btn-remove-universe text-slate-500 hover:text-rose-400 p-1 cursor-pointer"
              title="Remove item"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <input
            type="text"
            value="${slugVal}"
            placeholder="Link Slug (e.g. naruto-shippuden) [Optional]"
            class="universe-input-slug sm:col-span-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200"
          />
          <input
            type="text"
            value="${noteVal}"
            placeholder="Editorial Note (e.g. Set between eps 311 & 312; Kishimoto concept) [Optional]"
