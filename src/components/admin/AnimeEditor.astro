    // Helper: count episodes from comma-separated ranges and numbers
    function countEpisodesFromRangeString(str) {
      if (!str || !str.trim()) return 0;
      const parts = str.split(',').map(s => s.trim()).filter(Boolean);
      let count = 0;
      for (const p of parts) {
        const rm = p.match(/^(\d+)\s*[-–—]\s*(\d+)$/);
        if (rm) {
          const start = parseInt(rm[1], 10);
          const end = parseInt(rm[2], 10);
          if (start <= end) {
            count += (end - start + 1);
          }
          continue;
        }
        const sm = p.match(/^(\d+)$/);
        if (sm) {
          count += 1;
        }
      }
      return count;
    }

    // Dynamic Live Stats Calculation for Section 5 Header
    function updateLiveFillerStats() {
      const mangaStr = document.getElementById('filler-manga-canon')?.value || '';
      const animeStr = document.getElementById('filler-anime-canon')?.value || '';
      const mixedStr = document.getElementById('filler-mixed')?.value || '';
      const fillerStr = document.getElementById('filler-filler')?.value || '';

      const countManga = countEpisodesFromRangeString(mangaStr);
      const countAnime = countEpisodesFromRangeString(animeStr);
      const countMixed = countEpisodesFromRangeString(mixedStr);
      const countFiller = countEpisodesFromRangeString(fillerStr);

      const total = countManga + countAnime + countMixed + countFiller;
      const canon = countManga + countAnime;
      const pct = total > 0 ? Math.round((countFiller / total) * 100) : 0;

      const totalEl = document.getElementById('admin-filler-total');
      const canonEl = document.getElementById('admin-filler-canon');
      const mixedEl = document.getElementById('admin-filler-mixed');
      const fillerEl = document.getElementById('admin-filler-count');
      const pctBadge = document.getElementById('admin-filler-pct-badge');
      const pctDisplay = document.getElementById('filler-pct-display');

      if (totalEl) totalEl.textContent = `${total} eps`;
      if (canonEl) canonEl.textContent = `${canon} eps`;
      if (mixedEl) mixedEl.textContent = `${countMixed} eps`;
      if (fillerEl) fillerEl.textContent = `${countFiller} eps`;
      if (pctBadge) pctBadge.textContent = `${pct}% Filler`;
      if (pctDisplay) {
        if (total > 0) {
          pctDisplay.textContent = `(${pct}% filler)`;
          pctDisplay.classList.remove('hidden');
        } else {
          pctDisplay.classList.add('hidden');
        }
      }
    }

    // Dynamic Media Type Mode UI Switcher (Series vs Movie)
    function updateMediaTypeUI() {
      const typeEl = document.getElementById('core-type');
      const isMovie = typeEl?.value === 'movie';

      const epsWrapper = document.getElementById('wrapper-core-episodes');
      const runtimeWrapper = document.getElementById('wrapper-core-runtime');
      const canonWrapper = document.getElementById('wrapper-core-movie-canon');
      const fillerContainer = document.getElementById('section-filler-container');
      const fillerCheckbox = document.querySelector('input.section-visibility-checkbox[data-section="fillerList"]');
      const labelContainer = fillerCheckbox?.closest('label');
      const labelText = labelContainer?.querySelector('.visibility-label');
      const track = labelContainer?.querySelector('.switch-track');
      const thumb = labelContainer?.querySelector('.switch-thumb');

      if (isMovie) {
        if (epsWrapper) epsWrapper.classList.add('hidden');
        if (runtimeWrapper) runtimeWrapper.classList.remove('hidden');
        if (canonWrapper) canonWrapper.classList.remove('hidden');
        if (fillerContainer) fillerContainer.classList.add('hidden');
        if (fillerCheckbox) {
          fillerCheckbox.checked = false;
          if (labelText) labelText.textContent = 'Public: Hide (Movie)';
          if (track) {
            track.classList.remove('bg-indigo-600');
            track.classList.add('bg-slate-700');
          }
          if (thumb) {
            thumb.classList.remove('translate-x-3.5');
            thumb.classList.add('translate-x-0');
          }
        }
        const epsInput = document.getElementById('core-episodes');
        if (epsInput && (!epsInput.value || epsInput.value === '0')) {
          epsInput.value = '1';
        }
      } else {
        if (epsWrapper) epsWrapper.classList.remove('hidden');
        if (runtimeWrapper) runtimeWrapper.classList.add('hidden');
        if (canonWrapper) canonWrapper.classList.add('hidden');
        if (fillerContainer) fillerContainer.classList.remove('hidden');
        if (fillerCheckbox) {
          const isVisible = fillerCheckbox.checked;
          if (labelText) labelText.textContent = isVisible ? 'Public: Show' : 'Public: Hide';
          if (track) {
            track.classList.toggle('bg-indigo-600', isVisible);
            track.classList.toggle('bg-slate-700', !isVisible);
          }
          if (thumb) {
            thumb.classList.toggle('translate-x-3.5', isVisible);
            thumb.classList.toggle('translate-x-0', !isVisible);
          }
        }
      }
    }

    document.getElementById('core-type')?.addEventListener('change', updateMediaTypeUI);

    // Full Form Hydration Function: populates all fields, unlocks sections, sets Edit header
