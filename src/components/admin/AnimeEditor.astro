      <div id="section-filler-body" class="px-4 sm:px-6 pb-6 pt-2 border-t border-slate-800/80">
        <div id="filler-feedback" class="hidden mb-5 p-3.5 rounded-xl text-xs sm:text-sm font-medium border"></div>

        <form id="form-filler" class="space-y-4">
