      try {
        const res = await fetch('/api/admin/anime/filler-ranges', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            animeId: currentAnimeId,
            mangaCanon,
            animeCanon,
            mixedCanon,
            filler,
            fillerNote
          })
