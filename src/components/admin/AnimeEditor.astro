      // 6. Section 6 Characters
      const charRows = document.querySelectorAll('#chars-container .character-row');
      const characters = [];
      charRows.forEach((row, idx) => {
        const name = row.querySelector('.char-input-name')?.value.trim();
        const category = row.querySelector('.char-input-category')?.value;
        const role = row.querySelector('.char-input-role')?.value.trim();
        const commentary = row.querySelector('.char-input-commentary')?.value.trim();
        if (name) {
          characters.push({ rank: idx + 1, name, category, role, commentary });
        }
      });

      // 7. Section 7 Source Guidance
      const sourcePayload = {
        title: document.getElementById('source-title')?.value.trim() || '',
        author: document.getElementById('source-author')?.value.trim() || '',
        type: document.getElementById('source-type')?.value || 'Manga',
        volumes: document.getElementById('source-volumes')?.value.trim() || '',
        publicationStatus: document.getElementById('source-pub-status')?.value || 'Ongoing',
        coverage: document.getElementById('source-coverage')?.value.trim() || '',
        notes: document.getElementById('source-notes')?.value.trim() || ''
      };

      // 8. Section 8 Power System
      const powerName = document.getElementById('power-name')?.value.trim() || '';
      const powerTextareas = document.querySelectorAll('#power-paragraphs-container textarea');
      const powerParagraphs = Array.from(powerTextareas).map(t => t.value.trim()).filter(Boolean);
      const powerPayload = { name: powerName, paragraphs: powerParagraphs };

      // 9. Section 9 Universe Media
      const universeRows = document.querySelectorAll('#universe-container .universe-row');
      const universe = [];
      universeRows.forEach((row, idx) => {
        const title = row.querySelector('.universe-input-title')?.value.trim();
        const section = row.querySelector('.universe-input-section')?.value;
        const badge = row.querySelector('.universe-input-badge')?.value;
        const linkSlug = row.querySelector('.universe-input-slug')?.value.trim() || null;
        const editorialNote = row.querySelector('.universe-input-note')?.value.trim() || null;
        if (title && badge) {
          universe.push({ itemOrder: idx + 1, title, section, badge, linkSlug, editorialNote });
        }
      });

      // 10. Section 10 Recommendations
      const recRows = document.querySelectorAll('#recs-container .rec-row');
      const recommendations = [];
      recRows.forEach((row, idx) => {
        const targetAnimeId = row.querySelector('.rec-input-target')?.value;
        const categoryBadge = row.querySelector('.rec-input-badge')?.value.trim();
        const editorialNote = row.querySelector('.rec-input-note')?.value.trim() || null;
        if (targetAnimeId && categoryBadge) {
          recommendations.push({ itemOrder: idx + 1, targetAnimeId, categoryBadge, editorialNote });
        }
      });

      // 11. Visibility Toggles
      const visibilityPayload = {};
      document.querySelectorAll('.section-visibility-checkbox').forEach((cb) => {
        const sec = cb.getAttribute('data-section');
        if (sec) visibilityPayload[sec] = cb.checked;
      });
      if (isMovie) {
        visibilityPayload.fillerList = false;
      }

      // Show loading UI on all save-all buttons
      const saveButtons = document.querySelectorAll('.btn-save-all');
      saveButtons.forEach(btn => {
        btn.disabled = true;
        btn.classList.add('opacity-75');
        btn.dataset.origHtml = btn.innerHTML;
        btn.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Saving All...</span>
        `;
      });

      try {
        const res = await fetch('/api/admin/anime/save-all', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            animeId: currentAnimeId || corePayload.id,
            core: corePayload,
            review: reviewPayload,
            lessons: lessonsPayload,
            watchOrder: watchOrderPayload,
            filler: fillerPayload,
            characters,
            source: sourcePayload,
            powerSystem: powerPayload,
            universe,
            recommendations,
            visibility: visibilityPayload
          })
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Failed to save all anime sections');
        }

        currentAnimeId = data.data?.animeId || corePayload.id;

        // Reveal all section badges
        [
          'core-badge', 'review-badge', 'lessons-badge', 'watch-order-badge',
          'filler-badge', 'chars-badge', 'source-badge', 'power-badge',
          'universe-badge', 'recs-badge'
        ].forEach(id => {
          const badge = document.getElementById(id);
          if (badge) badge.classList.remove('hidden');
        });

        // Update live stats if filler was processed
        updateLiveFillerStats();

        // Update header & public view link
        const titleText = document.getElementById('heading-title-text');
        if (titleText) titleText.textContent = `Edit Anime: ${corePayload.title}`;
        const idBadge = document.getElementById('heading-id-badge');
        if (idBadge) {
          idBadge.textContent = currentAnimeId;
          idBadge.classList.remove('hidden');
        }
        const viewPublicLink = document.getElementById('view-public-link');
        if (viewPublicLink) {
          viewPublicLink.href = `/anime/${corePayload.slug}`;
          viewPublicLink.classList.remove('hidden');
        }

        // Unlock dependent sections
        document.querySelectorAll('.dependent-section').forEach((sec) => {
          sec.classList.remove('opacity-50', 'pointer-events-none');
        });

        // Check if breakdown mismatch with core episodes
        const fillerResult = data.data?.fillerResult;
        const coreEps = parseInt(corePayload.episodes, 10);
        if (fillerResult && coreEps && !isNaN(coreEps) && fillerResult.totalEpisodes !== coreEps) {
          window.showAdminToast(`All saved with warning: Breakdown (${fillerResult.totalEpisodes} eps) ≠ Core (${coreEps} eps)`, 'warning');
        } else {
          window.showAdminToast('✓ All anime sections saved successfully!', 'success');
        }

        // Update browser URL if creating new record
        const currentUrl = new URL(window.location.href);
        if (!currentUrl.searchParams.has('id')) {
          currentUrl.searchParams.set('id', currentAnimeId);
          window.history.replaceState({}, '', currentUrl.toString());
        }

      } catch (err) {
        console.error('Error in saveAllAnime:', err);
        alert('Failed to save all changes: ' + err.message);
      } finally {
        saveButtons.forEach(btn => {
          btn.disabled = false;
          btn.classList.remove('opacity-75');
          if (btn.dataset.origHtml) btn.innerHTML = btn.dataset.origHtml;
        });
      }
    }

    document.querySelectorAll('.btn-save-all').forEach((btn) => {
      btn.addEventListener('click', executeSaveAll);
    });

    // Initialize media type UI state on initial page load
    updateMediaTypeUI();
  </script>
</AdminLayout>
