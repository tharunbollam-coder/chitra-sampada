---
// src/components/admin/AnimeEditor.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllFranchises, getAllAdminBlogPosts } from '../../lib/admin-db.js';
import { getDatabase, getAllAdminVibes } from '../../lib/d1.js';
import { vibes as fallbackVibes } from '../../data/vibes.js';

interface Props {
  initialAnime?: any;
}

const { initialAnime = null } = Astro.props;
const anime = initialAnime;
const isNew = !anime;
const pageTitle = isNew ? 'Add New Anime' : `Edit Anime: ${anime.title}`;

const franchises = await getAllFranchises(Astro.locals);
const adminBlogPosts = await getAllAdminBlogPosts(Astro.locals);
const dbVibes = await getAllAdminVibes(Astro.locals).catch(() => []);
const editorVibes = dbVibes.length > 0 ? dbVibes : fallbackVibes;
const db = await getDatabase(Astro.locals);
const existingGenreRows = await db.query('SELECT DISTINCT genre FROM anime_genres ORDER BY genre ASC');
const existingGenres = existingGenreRows.map(r => r.genre);
const platformAnimeList = await db.query('SELECT id, title, slug FROM anime ORDER BY title ASC');

const fillerBreakdown = anime?.fillerBreakdown || {};
const initCounts = fillerBreakdown.counts || { mangaCanon: 0, animeCanon: 0, mixedCanon: 0, filler: 0 };
const initTotal = fillerBreakdown.totalEpisodes ?? (initCounts.mangaCanon + initCounts.animeCanon + initCounts.mixedCanon + initCounts.filler);
const initCanon = fillerBreakdown.canonEpisodes ?? (initCounts.mangaCanon + initCounts.animeCanon);
const initMixed = initCounts.mixedCanon || 0;
const initFiller = initCounts.filler || 0;
const initPct = fillerBreakdown.fillerPercentage ?? (initTotal > 0 ? Math.round((initFiller / initTotal) * 100) : (anime?.fillerPercentage || 0));

const sectionVisibility = anime?.sectionVisibility || {
  review: true,
  lessons: true,
  watchOrder: true,
  fillerList: true,
  characters: true,
  source: true,
  powerSystem: true,
  universe: true,
  recommendations: true
};

const initialReviewText = anime?.review_paragraphs ?? (typeof anime?.review?.paragraphs === 'string' ? anime.review.paragraphs : (anime?.review?.text || ''));
const initialLessonsText = anime?.what_i_learned_paragraphs ?? anime?.lesson_takeaway ?? (typeof anime?.lessons?.takeaway === 'string' ? anime.lessons.takeaway : (anime?.lessons?.text || ''));
const initialPowerText = anime?.power_system_paragraphs ?? (typeof anime?.powerSystem?.paragraphs === 'string' ? anime.powerSystem.paragraphs : (anime?.powerSystem?.text || ''));

const rawSourceType = anime?.source?.type || 'Manga';
const standardSourceTypes = ['Manga', 'Manhwa', 'Light Novel', 'Web Novel', 'Anime Original', 'Visual Novel / Game'];
let initialSourceSelectValue = 'Manga';
let isCustomSource = false;
let customSourceValue = '';

if (standardSourceTypes.includes(rawSourceType)) {
  initialSourceSelectValue = rawSourceType;
} else if (rawSourceType === 'Original') {
  initialSourceSelectValue = 'Anime Original';
} else if (rawSourceType === 'Visual Novel') {
  initialSourceSelectValue = 'Visual Novel / Game';
} else if (rawSourceType) {
  initialSourceSelectValue = 'Custom';
  isCustomSource = true;
  customSourceValue = rawSourceType;
}
---

<AdminLayout title={pageTitle} activeSection="anime">
  <!-- Top Breadcrumb & Action Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div class="flex items-start sm:items-center gap-3">
      <a
        href="/admin"
        class="p-2 text-slate-400 hover:text-white bg-slate-900 border border-slate-800 rounded-xl hover:bg-slate-800 transition shrink-0"
        title="Back to Anime List"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <div>
        <h1 id="page-main-heading" class="text-xl sm:text-2xl font-bold font-heading text-white tracking-tight flex items-center gap-2">
          <span id="heading-title-text">{isNew ? 'Add New Anime' : `Edit Anime: ${anime.title}`}</span>
          <span
            id="heading-id-badge"
            class={`text-xs font-mono font-normal px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700 ${isNew ? 'hidden' : ''}`}
          >
            {anime?.id || ''}
          </span>
        </h1>
        <p id="heading-subtext" class="text-xs sm:text-sm text-slate-400 mt-0.5">
          {isNew ? 'Complete Section 1 first to create the record, then fill in any other sections.' : ''}
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
      <a
        id="view-public-link"
        href={anime ? `/anime/${anime.slug}` : '#'}
        target="_blank"
        rel="noopener noreferrer"
        class={`inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-slate-300 hover:text-white bg-slate-900 border border-slate-700/80 rounded-xl transition hover:bg-slate-800 ${isNew ? 'hidden' : ''}`}
      >
        <span>View Public Page</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- Universal Save All Changes Button (Top Bar) -->
      <button
        type="button"
        id="btn-save-all-top"
        class="btn-save-all inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 rounded-xl shadow-lg shadow-emerald-950/40 border border-emerald-500/40 transition cursor-pointer"
        title="Save all sections and visibility toggles simultaneously"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
        </svg>
        <span>Save All Changes</span>
      </button>
    </div>
  </div>

  <!-- Main Accordion Container -->
  <div class="mt-8 space-y-6">

    <!-- ============================================================= -->
    <!-- SECTION 1: CORE DETAILS -->
    <!-- ============================================================= -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden transition" id="section-core-container">
      <button
        type="button"
        class="w-full px-4 sm:px-6 py-3.5 sm:py-4 flex items-center justify-between text-left hover:bg-slate-850/50 transition cursor-pointer section-toggle"
        data-target="section-core-body"
      >
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 shrink-0 rounded-lg bg-indigo-600/20 text-indigo-400 font-bold text-xs flex items-center justify-center border border-indigo-500/30">
            1
          </span>
          <div>
            <h2 class="text-base font-semibold text-white font-heading">Core Information & Taxonomy</h2>
            <p class="text-xs text-slate-400">ID, title, slug, year, episodes, status, rating, genres & vibes</p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <span id="core-badge" class="hidden text-xs px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/80 font-medium">Saved</span>
          <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200 section-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </button>

      <div id="section-core-body" class="px-4 sm:px-6 pb-6 pt-2 border-t border-slate-800/80">
        <!-- Local Inline Feedback Banner -->
        <div id="core-feedback" class="hidden mb-5 p-3.5 rounded-xl text-xs sm:text-sm font-medium border"></div>

        <form id="form-core" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- ID -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-id">
                Internal ID <span class="text-rose-400">*</span>
              </label>
              <input
                type="text"
                id="core-id"
                name="id"
                value={anime?.id || ''}
                placeholder="e.g. frieren"
                required
                readonly={!isNew}
                class={`w-full px-3.5 py-2.5 bg-slate-950 border rounded-xl text-sm font-mono text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 ${
                  !isNew ? 'opacity-70 cursor-not-allowed border-slate-800' : 'border-slate-700/80 focus:border-indigo-500'
                }`}
              />
              <span class="text-[11px] text-slate-500 mt-1 block">Unique key used across database tables.</span>
            </div>

            <!-- Slug -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider" for="core-slug">
                  URL Slug <span class="text-rose-400">*</span>
                </label>
                <!-- Edit Slug Unlock Button -->
                <button
                  type="button"
                  id="btn-unlock-anime-slug"
                  class={`text-[11px] font-semibold text-amber-400 hover:text-amber-300 transition flex items-center gap-1 cursor-pointer ${isNew ? 'hidden' : ''}`}
                  title="Unlock and edit slug"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                  <span id="btn-unlock-anime-slug-label">Edit Slug</span>
                </button>
              </div>
              <input
                type="text"
                id="core-slug"
                name="slug"
                value={anime?.slug || ''}
                placeholder="e.g. frieren-beyond-journeys-end"
                required
                readonly={!isNew}
                class={`w-full px-3.5 py-2.5 bg-slate-950 border rounded-xl text-sm font-mono placeholder-slate-500 focus:outline-none transition ${
                  !isNew
                    ? 'border-slate-800 text-slate-400 cursor-not-allowed opacity-75'
                    : 'border-slate-700/80 text-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500'
                }`}
              />
              <span class="text-[11px] text-slate-500 mt-1 block" id="core-slug-help">Path on website: /anime/[slug]</span>
            </div>

            <!-- Title -->
            <div class="sm:col-span-2 lg:col-span-1">
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-title">
                English / Main Title <span class="text-rose-400">*</span>
              </label>
              <input
                type="text"
                id="core-title"
                name="title"
                value={anime?.title || ''}
                placeholder="e.g. Frieren: Beyond Journey's End"
                required
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
              />
            </div>

            <!-- Original Title -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-original-title">
                Japanese / Romaji Title
              </label>
              <input
                type="text"
                id="core-original-title"
                name="originalTitle"
                value={anime?.originalTitle || ''}
                placeholder="Sousou no Frieren"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
              />
            </div>

            <!-- Year -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-year">
                Release Year <span class="text-rose-400">*</span>
              </label>
              <input
                type="number"
                id="core-year"
                name="year"
                value={anime?.year || new Date().getFullYear()}
                min="1960"
                max="2099"
                required
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
              />
            </div>

            <!-- Media Format Type -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-type">
                Media Format <span class="text-rose-400">*</span>
              </label>
              <select
                id="core-type"
                name="type"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500 font-medium"
              >
                <option value="series" selected={anime?.type !== 'movie'}>TV Series</option>
                <option value="movie" selected={anime?.type === 'movie'}>Movie / Film</option>
              </select>
              <span class="text-[11px] text-slate-500 mt-1 block">TV Series vs Feature Film.</span>
            </div>

            <!-- Episodes (for TV Series) -->
            <div id="wrapper-core-episodes" class={anime?.type === 'movie' ? 'hidden' : ''}>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-episodes">
                Total Episodes <span class="text-rose-400">*</span>
              </label>
              <input
                type="number"
                id="core-episodes"
                name="episodes"
                value={anime?.episodes || 12}
                min="1"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
              />
              <span class="text-[11px] text-slate-500 mt-1 block">Total number of broadcast episodes.</span>
            </div>

            <!-- Movie Runtime (Minutes) -->
            <div id="wrapper-core-runtime" class={anime?.type === 'movie' ? '' : 'hidden'}>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-runtime">
                Runtime (Minutes) <span class="text-rose-400">*</span>
              </label>
              <input
                type="number"
                id="core-runtime"
                name="runtime"
                value={anime?.runtime || ''}
                min="1"
                max="600"
                placeholder="e.g. 107"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
              />
              <span class="text-[11px] text-slate-500 mt-1 block">Movie duration in minutes (e.g. 107 = 1h 47m).</span>
            </div>

            <!-- Movie Canon Status -->
            <div id="wrapper-core-movie-canon" class={anime?.type === 'movie' ? '' : 'hidden'}>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-movie-canon">
                Movie Canon Status
              </label>
              <select
                id="core-movie-canon"
                name="movieCanonType"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
              >
                <option value="Canon" selected={anime?.movieCanonType === 'Canon'}>★ Canon Storyline</option>
                <option value="Non-Canon Spinoff" selected={anime?.movieCanonType === 'Non-Canon Spinoff'}>Theatrical / Non-Canon Spinoff</option>
                <option value="Standalone Film" selected={anime?.movieCanonType === 'Standalone Film'}>Standalone Film</option>
              </select>
              <span class="text-[11px] text-slate-500 mt-1 block">Storyline canon standing.</span>
            </div>

            <!-- Status -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-status">
                Air Status
              </label>
              <select
                id="core-status"
                name="status"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
              >
                <option value="" selected={!anime?.status}>Not Specified (Optional)</option>
                <option value="Currently Airing" selected={anime?.status === 'Currently Airing'}>Currently Airing</option>
                <option value="Upcoming" selected={anime?.status === 'Upcoming'}>Upcoming</option>
                <option value="Season Finished" selected={anime?.status === 'Season Finished'}>Season Finished</option>
                <option value="Completed" selected={anime?.status === 'Completed' || anime?.status === 'Finished'}>Completed</option>
              </select>
            </div>

            <!-- Honesty Status -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-honesty">
                Honesty / Review Status
              </label>
              <select
                id="core-honesty"
                name="honestyStatus"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
              >
                <option value="watched" selected={anime?.honestyStatus === 'watched'}>Watched (Full review active)</option>
                <option value="plan_to_watch" selected={anime?.honestyStatus === 'plan_to_watch' || anime?.honestyStatus === 'watchlist'}>Plan to Watch</option>
                <option value="dropped" selected={anime?.honestyStatus === 'dropped'}>Dropped</option>
              </select>
            </div>

            <!-- Personal Rating -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-rating">
                Personal Rating (0.0 – 10.0)
              </label>
              <input
                type="number"
                step="0.1"
                min="0"
                max="10"
                id="core-rating"
                name="personalRating"
                value={anime?.personalRating ?? ''}
                placeholder="e.g. 9.5"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
              />
            </div>

            <!-- Age Rating / Minimum Age -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-age-rating">
                Age Rating / Minimum Age
              </label>
              <input
                type="number"
                min="0"
                max="18"
                id="core-age-rating"
                name="ageRating"
                value={anime?.ageRating ?? ''}
                placeholder="e.g. 13 (or 0 for General)"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
              />
              <span class="text-[11px] text-slate-500 mt-1 block">
                Enter minimum recommended age (0 for General, 13 for 13+, 16 for 16+, 18 for 18+).
              </span>
            </div>
          </div>

          <!-- Poster & Backdrop URLs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-poster">
                Poster Image URL
              </label>
              <input
                type="url"
                id="core-poster"
                name="poster"
                value={anime?.poster || ''}
                placeholder="https://..."
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-backdrop">
                Backdrop Image URL
              </label>
              <input
                type="url"
                id="core-backdrop"
                name="backdrop"
                value={anime?.backdrop || ''}
                placeholder="https://..."
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
              />
            </div>
          </div>

          <!-- Synopsis -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-synopsis">
              Synopsis
            </label>
            <textarea
              id="core-synopsis"
              name="synopsis"
              rows="4"
              placeholder="Short premise of the series..."
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 min-h-[130px]"
            >{anime?.synopsis || ''}</textarea>
          </div>

          <!-- Aliases -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="core-aliases">
              Alternative Titles / Aliases (Comma separated)
            </label>
            <input
              type="text"
              id="core-aliases"
              name="aliases"
              value={anime?.aliases?.join(', ') || ''}
              placeholder="Sousou no Frieren, Frieren: Remnants of the Departed"
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
            />
          </div>

          <!-- Genres (Checkboxes + custom input) -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Genres
            </label>
            <div class="flex flex-wrap gap-2 mb-2" id="core-genres-container">
              {['Adventure', 'Fantasy', 'Action', 'Drama', 'Comedy', 'Romance', 'Mystery', 'Sci-Fi', 'Slice of Life', 'Supernatural', 'Thriller'].map(genre => (
                <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-950 border border-slate-800 rounded-lg text-xs font-medium cursor-pointer hover:border-slate-700 transition">
                  <input
                    type="checkbox"
                    name="genres"
                    value={genre}
                    checked={anime?.genres?.includes(genre)}
                    class="rounded text-indigo-600 focus:ring-indigo-500 bg-slate-900 border-slate-700"
                  />
                  <span>{genre}</span>
                </label>
              ))}
            </div>
            <input
              type="text"
              id="core-custom-genres"
              placeholder="Additional genres (comma separated if not in list above)..."
              class="w-full px-3.5 py-2 bg-slate-950 border border-slate-700/80 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
            />
          </div>

          <!-- Vibes Selection -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Discovery Vibes
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2" id="core-vibes-container">
              {editorVibes.map(v => (
                <label class="flex items-start gap-2.5 p-2.5 bg-slate-950 border border-slate-800 rounded-xl text-xs cursor-pointer hover:border-slate-700 transition">
                  <input
                    type="checkbox"
                    name="vibes"
                    value={v.id}
                    checked={anime?.vibes?.includes(v.id)}
