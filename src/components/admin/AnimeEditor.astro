        const data = await res.json();
        if (data.success) {
          updateLiveFillerStats();
          fillerBadge.classList.remove('hidden');

          const coreEpsInput = document.getElementById('core-episodes');
          const coreEpisodes = coreEpsInput ? parseInt(coreEpsInput.value, 10) : null;
          const hasMismatch = coreEpisodes !== null && !isNaN(coreEpisodes) && coreEpisodes > 0 && data.totalEpisodes !== coreEpisodes;

          if (hasMismatch) {
            setFeedback(
              fillerFeedback,
              `⚠ Episode breakdown saved with warning: Calculated breakdown total (${data.totalEpisodes} eps) does not match Total Episodes in Section 1 Core Info (${coreEpisodes} eps). Please check which one is correct.`,
              'warning'
            );
            window.showAdminToast(`Saved with warning: Breakdown total (${data.totalEpisodes} eps) ≠ Core episodes (${coreEpisodes} eps)`, 'warning');
          } else {
            setFeedback(
              fillerFeedback,
              `✓ Episode breakdown saved! Total: ${data.totalEpisodes} eps (${data.canonEpisodes} canon, ${data.counts.filler} filler). Filler: ${data.fillerPercentage}%`,
              'success'
            );
            window.showAdminToast(`Filler updated (${data.fillerPercentage}% filler)`, 'success');
          }
        } else {
          setFeedback(fillerFeedback, 'Error: ' + data.error, 'error');
        }
      } catch (err) {
        setFeedback(fillerFeedback, 'Network error: ' + err.message, 'error');
