                    <select class="universe-input-section px-2.5 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white">
                      <option value="canon" selected={u.section === 'canon'}>Canon Storyline</option>
                      <option value="non_canon" selected={u.section === 'non_canon'}>Non-Canon / Spin-off</option>
                    </select>
                    <select class="universe-input-badge px-2.5 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white">
