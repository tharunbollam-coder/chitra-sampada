      e.preventDefault();
      if (!currentAnimeId) {
        setFeedback(streamingFeedback, 'Please save Section 1 Core Details first.', 'error');
        return;
      }

      const rows = document.querySelectorAll('#streaming-container .streaming-row');
      const platforms = [];
      rows.forEach((row, idx) => {
        const platformName = row.querySelector('.streaming-input-name')?.value.trim();
        const streamUrl = row.querySelector('.streaming-input-url')?.value.trim() || null;
        const logoUrl = row.querySelector('.streaming-input-logo')?.value.trim() || null;
        const note = row.querySelector('.streaming-input-note')?.value.trim() || null;
        if (platformName) {
          platforms.push({ displayOrder: idx + 1, platformName, streamUrl, logoUrl, note, isActive: true });
        }
      });

      try {
        const res = await fetch('/api/admin/anime/streaming', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ animeId: currentAnimeId, platforms })
        });
        const data = await res.json();
        if (data.success) {
          setFeedback(streamingFeedback, '✓ Streaming platforms saved successfully!', 'success');
          streamingBadge?.classList.remove('hidden');
          window.showAdminToast('Streaming platforms saved successfully', 'success');
        } else {
          setFeedback(streamingFeedback, 'Error: ' + data.error, 'error');
        }
      } catch (err) {
        setFeedback(streamingFeedback, 'Network error: ' + err.message, 'error');
      }
    });

    // -------------------------------------------------------------
    // UNIVERSAL SAVE ALL (All Sections 1-10 + Visibility Toggles)
    // -------------------------------------------------------------
    async function executeSaveAll() {
      const formCore = document.getElementById('form-core');
      if (!formCore) return;

      const id = document.getElementById('core-id').value.trim();
      const slug = document.getElementById('core-slug').value.trim();
      const title = document.getElementById('core-title').value.trim();
      const year = document.getElementById('core-year').value;
      const typeVal = document.getElementById('core-type')?.value || 'series';
      const isMovie = typeVal === 'movie';
      const episodes = isMovie ? (document.getElementById('core-episodes')?.value || '1') : document.getElementById('core-episodes')?.value;
      const runtimeVal = document.getElementById('core-runtime')?.value;
      const movieCanonVal = document.getElementById('core-movie-canon')?.value;

      if (!id || !slug || !title || !year || (!isMovie && !episodes)) {
        alert('Please fill in all required fields in Section 1 (ID, Title, Slug, Year, Episodes) before saving.');
        const target = document.getElementById('section-core-body');
        if (target && target.classList.contains('hidden')) {
          target.classList.remove('hidden');
        }
        formCore.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      if (isMovie && (!runtimeVal || parseInt(runtimeVal, 10) <= 0)) {
        alert('Please enter a valid runtime in minutes for this movie in Section 1.');
        const target = document.getElementById('section-core-body');
        if (target && target.classList.contains('hidden')) {
          target.classList.remove('hidden');
        }
        document.getElementById('core-runtime')?.focus();
        return;
      }

      const slugRegex = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
      if (!slugRegex.test(slug)) {
        alert('Invalid slug format in Section 1. Use lowercase letters, numbers, and hyphens (e.g. "frieren-beyond-journeys-end").');
        const target = document.getElementById('section-core-body');
        if (target && target.classList.contains('hidden')) {
          target.classList.remove('hidden');
        }
        document.getElementById('core-slug')?.focus();
        return;
      }

      // 1. Gather Section 1 Core
      const checkedGenres = Array.from(formCore.querySelectorAll('input[name="genres"]:checked')).map(el => el.value);
      const customGenres = (document.getElementById('core-custom-genres').value || '')
        .split(',')
        .map(s => s.trim())
        .filter(Boolean);
      const allGenres = Array.from(new Set([...checkedGenres, ...customGenres]));
      const checkedVibes = Array.from(formCore.querySelectorAll('input[name="vibes"]:checked')).map(el => el.value);
      const aliases = (document.getElementById('core-aliases').value || '')
        .split(',')
        .map(s => s.trim())
        .filter(Boolean);

      const corePayload = {
        id,
        slug,
        title,
        originalTitle: document.getElementById('core-original-title').value.trim(),
        type: typeVal,
        runtime: isMovie && runtimeVal ? parseInt(runtimeVal, 10) : null,
        movieCanonType: isMovie ? movieCanonVal : null,
        year,
        episodes,
        status: document.getElementById('core-status').value,
        honestyStatus: document.getElementById('core-honesty').value,
        personalRating: document.getElementById('core-rating').value,
        ageRating: document.getElementById('core-age-rating')?.value,
        poster: document.getElementById('core-poster').value.trim(),
        backdrop: document.getElementById('core-backdrop').value.trim(),
        synopsis: document.getElementById('core-synopsis').value.trim(),
        trending: document.getElementById('core-trending').checked ? 1 : 0,
        communitySuggested: document.getElementById('core-community-suggested')?.checked ? 1 : 0,
        aliases,
        genres: allGenres,
        vibes: checkedVibes
      };

      // 2. Section 2 Review
      const reviewHeading = document.getElementById('review-heading')?.value.trim() || '';
      const reviewText = document.getElementById('review-text')?.value.trim() || '';
      const reviewType = document.querySelector('input[name="review-type"]:checked')?.value || 'full';
      const reviewSpoilerLevel = document.querySelector('input[name="review-spoiler-level"]:checked')?.value || 'none';
      const reviewPayload = { heading: reviewHeading, text: reviewText, paragraphs: reviewText, review_paragraphs: reviewText, type: reviewType, spoilerLevel: reviewSpoilerLevel };

      // 3. Section 3 Lessons
      const lessonTakeaway = document.getElementById('lesson-takeaway')?.value.trim() || '';
      const lessonsPayload = { takeaway: lessonTakeaway, lesson_takeaway: lessonTakeaway, what_i_learned_paragraphs: lessonTakeaway };

      // 4. Section 4 Watch Order
      const franchiseId = document.getElementById('wo-franchise')?.value || null;
      const franchiseStepOrder = document.getElementById('wo-step')?.value || null;
      const watchOrderNote = document.getElementById('wo-note')?.value.trim() || null;
      const watchOrderPayload = { franchiseId, franchiseStepOrder, watchOrderNote };

      // 5. Section 5 Filler & Canon Breakdown
      const fillerNote = document.getElementById('filler-note')?.value.trim() || null;
      let fillerPayload = { fillerNote };
      if (!isMovie) {
        const mangaCanon = document.getElementById('filler-manga-canon')?.value.trim() || '';
        const animeCanon = document.getElementById('filler-anime-canon')?.value.trim() || '';
        const mixedCanon = document.getElementById('filler-mixed')?.value.trim() || '';
        const filler = document.getElementById('filler-filler')?.value.trim() || '';

        const errManga = validateRangeInput('Manga Canon', mangaCanon);
        if (errManga) { alert('Section 5 Filler error: ' + errManga); return; }
        const errAnime = validateRangeInput('Anime Canon', animeCanon);
        if (errAnime) { alert('Section 5 Filler error: ' + errAnime); return; }
        const errMixed = validateRangeInput('Mixed Canon/Filler', mixedCanon);
        if (errMixed) { alert('Section 5 Filler error: ' + errMixed); return; }
        const errFiller = validateRangeInput('Filler', filler);
        if (errFiller) { alert('Section 5 Filler error: ' + errFiller); return; }

        fillerPayload = { mangaCanon, animeCanon, mixedCanon, filler, fillerNote };
      }

      // 6. Section 6 Characters
      const relatedPostSlug = document.getElementById('chars-related-post')?.value.trim() || null;
      const charRows = document.querySelectorAll('#chars-container .character-row');
      const characters = [];
      charRows.forEach((row, idx) => {
        const name = row.querySelector('.char-input-name')?.value.trim();
        const category = row.querySelector('.char-input-category')?.value;
        const role = row.querySelector('.char-input-role')?.value.trim();
        const commentary = row.querySelector('.char-input-commentary')?.value.trim();
        if (name) {
          characters.push({ rank: idx + 1, name, category, role, commentary });
        }
      });

      // 7. Section 7 Source Guidance
      const sourcePayload = {
        title: document.getElementById('source-title')?.value.trim() || '',
        author: document.getElementById('source-author')?.value.trim() || '',
        type: getSourceTypeValue(),
        volumes: document.getElementById('source-volumes')?.value.trim() || '',
        publicationStatus: document.getElementById('source-pub-status')?.value || 'Ongoing',
        coverage: document.getElementById('source-coverage')?.value.trim() || '',
        notes: document.getElementById('source-notes')?.value.trim() || ''
      };

      // 8. Section 8 Power System
      const powerName = document.getElementById('power-name')?.value.trim() || '';
      const powerText = document.getElementById('power-text')?.value.trim() || '';
      const powerPayload = { name: powerName, text: powerText, paragraphs: powerText, power_system_paragraphs: powerText };

      // 9. Section 9 Universe Media
      const universeRows = document.querySelectorAll('#universe-container .universe-row');
      const universe = [];
      universeRows.forEach((row, idx) => {
        const title = row.querySelector('.universe-input-title')?.value.trim();
        const section = row.querySelector('.universe-input-section')?.value;
        const badge = row.querySelector('.universe-input-badge')?.value;
        const linkSlug = row.querySelector('.universe-input-slug')?.value.trim() || null;
        const editorialNote = row.querySelector('.universe-input-note')?.value.trim() || null;
        if (title && badge) {
          universe.push({ itemOrder: idx + 1, title, section, badge, linkSlug, editorialNote });
        }
      });

      // 10. Section 10 Recommendations
      const recRows = document.querySelectorAll('#recs-container .rec-row');
      const recommendations = [];
      recRows.forEach((row, idx) => {
        const targetAnimeId = row.querySelector('.rec-input-target')?.value;
        const categoryBadge = row.querySelector('.rec-input-badge')?.value.trim();
        const editorialNote = row.querySelector('.rec-input-note')?.value.trim() || null;
        if (targetAnimeId && categoryBadge) {
          recommendations.push({ itemOrder: idx + 1, targetAnimeId, categoryBadge, editorialNote });
        }
      });

      // 11. Section 11 Streaming Platforms
      const streamingRows = document.querySelectorAll('#streaming-container .streaming-row');
      const streamingPlatforms = [];
      streamingRows.forEach((row, idx) => {
        const platformName = row.querySelector('.streaming-input-name')?.value.trim();
        const streamUrl = row.querySelector('.streaming-input-url')?.value.trim() || null;
        const logoUrl = row.querySelector('.streaming-input-logo')?.value.trim() || null;
        const note = row.querySelector('.streaming-input-note')?.value.trim() || null;
        if (platformName) {
          streamingPlatforms.push({ displayOrder: idx + 1, platformName, streamUrl, logoUrl, note, isActive: true });
        }
      });

      // 12. Visibility Toggles
      const visibilityPayload = {};
      document.querySelectorAll('.section-visibility-checkbox').forEach((cb) => {
        const sec = cb.getAttribute('data-section');
        if (sec) visibilityPayload[sec] = cb.checked;
      });
      if (isMovie && !fillerPayload?.fillerNote) {
        visibilityPayload.fillerList = false;
      }

      // Show loading UI on all save-all buttons
      const saveButtons = document.querySelectorAll('.btn-save-all');
      saveButtons.forEach(btn => {
        btn.disabled = true;
        btn.classList.add('opacity-75');
        btn.dataset.origHtml = btn.innerHTML;
        btn.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Saving All...</span>
        `;
      });

      try {
        const res = await fetch('/api/admin/anime/save-all', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            animeId: currentAnimeId || corePayload.id,
            core: corePayload,
            review: reviewPayload,
            lessons: lessonsPayload,
            watchOrder: watchOrderPayload,
            filler: fillerPayload,
            characters: {
              characters,
              relatedPostSlug
            },
            source: sourcePayload,
            powerSystem: powerPayload,
            universe,
            recommendations,
            streaming: streamingPlatforms,
            visibility: visibilityPayload
          })
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Failed to save all anime sections');
        }

        currentAnimeId = data.data?.animeId || corePayload.id;
        lockAnimeSlug();
        const idEl = document.getElementById('core-id');
        if (idEl) {
          idEl.readOnly = true;
          idEl.classList.add('opacity-70', 'cursor-not-allowed');
        }

        // Reveal all section badges
        [
          'core-badge', 'review-badge', 'lessons-badge', 'watch-order-badge',
          'filler-badge', 'chars-badge', 'source-badge', 'power-badge',
          'universe-badge', 'recs-badge', 'streaming-badge'
        ].forEach(id => {
          const badge = document.getElementById(id);
          if (badge) badge.classList.remove('hidden');
        });

        // Update live stats if filler was processed
        updateLiveFillerStats();

        // Update header & public view link
        const titleText = document.getElementById('heading-title-text');
        if (titleText) titleText.textContent = `Edit Anime: ${corePayload.title}`;
        const idBadge = document.getElementById('heading-id-badge');
        if (idBadge) {
          idBadge.textContent = currentAnimeId;
          idBadge.classList.remove('hidden');
        }
        const viewPublicLink = document.getElementById('view-public-link');
        if (viewPublicLink) {
          viewPublicLink.href = `/anime/${corePayload.slug}`;
          viewPublicLink.classList.remove('hidden');
        }

        // Unlock dependent sections
        document.querySelectorAll('.dependent-section').forEach((sec) => {
          sec.classList.remove('opacity-50', 'pointer-events-none');
        });

        // Check if breakdown mismatch with core episodes
        const fillerResult = data.data?.fillerResult;
        const coreEps = parseInt(corePayload.episodes, 10);
        if (fillerResult && coreEps && !isNaN(coreEps) && fillerResult.totalEpisodes !== coreEps) {
          window.showAdminToast(`All saved with warning: Breakdown (${fillerResult.totalEpisodes} eps) ≠ Core (${coreEps} eps)`, 'warning');
        } else {
          window.showAdminToast('✓ All anime sections saved successfully!', 'success');
        }

        // Update browser URL if creating new record
        const currentUrl = new URL(window.location.href);
        if (!currentUrl.searchParams.has('id')) {
          currentUrl.searchParams.set('id', currentAnimeId);
          window.history.replaceState({}, '', currentUrl.toString());
        }

      } catch (err) {
        console.error('Error in saveAllAnime:', err);
        alert('Failed to save all changes: ' + err.message);
      } finally {
        saveButtons.forEach(btn => {
          btn.disabled = false;
          btn.classList.remove('opacity-75');
          if (btn.dataset.origHtml) btn.innerHTML = btn.dataset.origHtml;
        });
      }
    }

    document.querySelectorAll('.btn-save-all').forEach((btn) => {
      btn.addEventListener('click', executeSaveAll);
    });

    // Initialize media type UI state on initial page load
    updateMediaTypeUI();
  </script>
</AdminLayout>
