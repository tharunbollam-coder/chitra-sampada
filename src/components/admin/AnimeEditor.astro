            <textarea
              id="filler-note"
              name="fillerNote"
              rows="3"
              placeholder="e.g. Canonical movie set between episodes 20 and 21, or standalone filler guidance..."
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
            >{anime?.fillerNote || ''}</textarea>
            <p class="text-xs text-slate-400 mt-1">Editorial overview or movie canon guidance. For movies or series without episode ranges, this note alone can form the Filler List tab.</p>
          </div>

          <!-- Summary Header Stats Bar (Derived directly from 4 category counts) -->
          <div class="p-4 bg-slate-950 border border-slate-800 rounded-xl flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3 sm:gap-4 flex-wrap">
              <!-- Total Episodes -->
              <div class="px-3.5 py-2 rounded-lg bg-slate-900 border border-slate-800 text-center min-w-[85px]">
                <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400">Total</span>
                <span id="admin-filler-total" class="text-sm font-extrabold text-white">{initTotal} eps</span>
              </div>

              <!-- Canon Episodes -->
              <div class="px-3.5 py-2 rounded-lg bg-emerald-950/40 border border-emerald-800/60 text-center min-w-[85px]">
                <span class="block text-[10px] font-bold uppercase tracking-wider text-emerald-400">Canon</span>
                <span id="admin-filler-canon" class="text-sm font-extrabold text-emerald-300">{initCanon} eps</span>
              </div>

              <!-- Mixed Episodes -->
              <div class="px-3.5 py-2 rounded-lg bg-purple-950/40 border border-purple-800/60 text-center min-w-[85px]">
                <span class="block text-[10px] font-bold uppercase tracking-wider text-purple-400">Mixed</span>
                <span id="admin-filler-mixed" class="text-sm font-extrabold text-purple-300">{initMixed} eps</span>
              </div>

              <!-- Filler Episodes -->
              <div class="px-3.5 py-2 rounded-lg bg-amber-950/40 border border-amber-800/60 text-center min-w-[85px]">
                <span class="block text-[10px] font-bold uppercase tracking-wider text-amber-400">Filler</span>
                <span id="admin-filler-count" class="text-sm font-extrabold text-amber-300">{initFiller} eps</span>
              </div>
            </div>

            <!-- Filler Percentage Badge -->
            <div class="flex items-center gap-2">
              <span class="text-xs text-slate-400 font-medium">Calculated Filler:</span>
              <span
                id="admin-filler-pct-badge"
                class="text-xs font-bold font-mono px-3 py-1.5 rounded-lg border bg-amber-500/10 text-amber-400 border-amber-500/30"
              >
                {initPct}% Filler
              </span>
            </div>
          </div>

          <p class="text-xs text-slate-400">
            Type or paste a comma-separated list of ranges and single episode numbers directly into each category below (e.g. <code class="text-indigo-300 font-mono">1-44, 48-49, 52-53, 100, 103-130</code>). All four types are always available.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- 1. Manga Canon -->
            <div class="p-4 bg-slate-950 border border-slate-800 rounded-xl space-y-1.5">
              <div class="flex items-center justify-between">
                <label class="block text-xs font-bold text-slate-200 uppercase tracking-wider" for="filler-manga-canon">
                  Manga Canon
                </label>
                <span class="text-[11px] text-emerald-400 font-medium">Adapts Manga Story (No Additions)</span>
              </div>
              <textarea
                id="filler-manga-canon"
                name="mangaCanon"
                rows="3"
                placeholder="e.g. 1-135, 220"
                class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-sm font-mono text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 min-h-[85px]"
              >{anime?.fillerBreakdown?.mangaCanon || ''}</textarea>
            </div>

            <!-- 2. Anime Canon -->
            <div class="p-4 bg-slate-950 border border-slate-800 rounded-xl space-y-1.5">
              <div class="flex items-center justify-between">
                <label class="block text-xs font-bold text-slate-200 uppercase tracking-wider" for="filler-anime-canon">
                  Anime Canon
                </label>
                <span class="text-[11px] text-sky-400 font-medium">Official Story by Creator (Not in Manga)</span>
              </div>
              <textarea
                id="filler-anime-canon"
                name="animeCanon"
                rows="3"
                placeholder="e.g. 1-66, 141-151"
                class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-sm font-mono text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 min-h-[85px]"
              >{anime?.fillerBreakdown?.animeCanon || ''}</textarea>
            </div>

            <!-- 3. Mixed Canon/Filler -->
            <div class="p-4 bg-slate-950 border border-slate-800 rounded-xl space-y-1.5">
              <div class="flex items-center justify-between">
                <label class="block text-xs font-bold text-slate-200 uppercase tracking-wider" for="filler-mixed">
                  Mixed Canon/Filler
                </label>
                <span class="text-[11px] text-purple-400 font-medium">Single Episode Blending Story + Padding</span>
              </div>
              <textarea
                id="filler-mixed"
                name="mixedCanon"
                rows="3"
                placeholder="e.g. 9, 14-18"
                class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-sm font-mono text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 min-h-[85px]"
              >{anime?.fillerBreakdown?.mixedCanon || ''}</textarea>
            </div>

            <!-- 4. Filler -->
            <div class="p-4 bg-slate-950 border border-slate-800 rounded-xl space-y-1.5">
              <div class="flex items-center justify-between">
                <label class="block text-xs font-bold text-amber-300 uppercase tracking-wider" for="filler-filler">
                  Filler (Skippable)
                </label>
                <span class="text-[11px] text-amber-400 font-medium">Anime-Original Content (Fully Skippable)</span>
              </div>
              <textarea
                id="filler-filler"
                name="filler"
                rows="3"
                placeholder="e.g. 136-219"
                class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700/80 rounded-xl text-sm font-mono text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 min-h-[85px]"
              >{anime?.fillerBreakdown?.filler || ''}</textarea>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-800 flex justify-end">
            <button
              type="submit"
              class="w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-sm transition cursor-pointer"
            >
              Save Episode Breakdown & Recalculate
            </button>
          </div>
        </form>
      </div>
    </div>


    <!-- ============================================================= -->
    <!-- SECTION 6: KEY CHARACTERS -->
    <!-- ============================================================= -->
    <div class={`bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden transition dependent-section ${isNew ? 'opacity-50 pointer-events-none' : ''}`} id="section-chars-container">
      <button
