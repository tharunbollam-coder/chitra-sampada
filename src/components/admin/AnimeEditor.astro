          <div id="chars-container" class="space-y-3">
            {(anime?.characters?.length ? anime.characters : []).map((c, i) => (
              <div class="p-3 sm:p-3.5 bg-slate-950 border border-slate-800 rounded-xl space-y-2.5 character-row">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                  <div class="flex items-center gap-2 flex-1 min-w-0">
                    <span class="w-6 h-6 rounded bg-slate-800 text-slate-400 text-xs flex items-center justify-center font-bold shrink-0 char-rank-badge">
                      {c.rank || i + 1}
                    </span>
                    <input
                      type="text"
                      value={c.name}
                      placeholder="Character Name"
                      class="char-input-name flex-1 min-w-0 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-sm text-white font-medium"
                      required
                    />
                    <button
                      type="button"
                      class="sm:hidden btn-remove-char p-1.5 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg shrink-0 cursor-pointer transition"
                      title="Remove character"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                  </div>
                  <div class="flex items-center gap-2 shrink-0">
                    <select class="char-input-category w-full sm:w-auto px-2.5 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-white">
                      <option value="Protagonist" selected={c.category === 'Protagonist'}>Protagonist</option>
                      <option value="Main" selected={c.category === 'Main'}>Main</option>
                      <option value="Supporting" selected={c.category === 'Supporting'}>Supporting</option>
                      <option value="Antagonist" selected={c.category === 'Antagonist'}>Antagonist</option>
                    </select>
                    <button
                      type="button"
                      class="hidden sm:inline-flex btn-remove-char text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg p-1.5 cursor-pointer transition shrink-0"
                      title="Remove character"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <input
                    type="text"
                    value={c.role || ''}
                    placeholder="Role / Title (e.g. Elven Mage)"
                    class="char-input-role px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200"
                  />
                  <input
                    type="text"
                    value={c.commentary || ''}
                    placeholder="Short commentary or key trait"
                    class="char-input-commentary px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-xs text-slate-200"
                  />
                </div>
              </div>
            ))}
