                    </span>
                    <input
                      type="text"
                      value={u.title}
                      placeholder="Title (e.g. Naruto: Shippuden)"
                      class="universe-input-title flex-1 px-3 py-1.5 bg-slate-900 border border-slate-700/80 rounded-lg text-sm text-white font-medium"
