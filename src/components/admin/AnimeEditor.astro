        if (errAnime) { alert('Section 5 Filler error: ' + errAnime); return; }
        const errMixed = validateRangeInput('Mixed Canon/Filler', mixedCanon);
        if (errMixed) { alert('Section 5 Filler error: ' + errMixed); return; }
        const errFiller = validateRangeInput('Filler', filler);
        if (errFiller) { alert('Section 5 Filler error: ' + errFiller); return; }

        fillerPayload = { mangaCanon, animeCanon, mixedCanon, filler };
