              data-section="characters"
              checked={sectionVisibility.characters}
            />
            <div class:list={[
              'w-8 h-4.5 rounded-full transition-colors relative flex items-center p-0.5 switch-track',
              sectionVisibility.characters ? 'bg-indigo-600' : 'bg-slate-700'
            ]}>
              <div class:list={[
                'w-3.5 h-3.5 rounded-full bg-white transition-transform transform shadow-sm switch-thumb',
                sectionVisibility.characters ? 'translate-x-3.5' : 'translate-x-0'
              ]}></div>
            </div>
          </label>
          <span id="chars-badge" class="hidden text-xs px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/80 font-medium">Saved</span>
          <svg class="w-5 h-5 text-slate-400 transform transition-transform duration-200 section-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </button>

      <div id="section-chars-body" class="px-4 sm:px-6 pb-6 pt-2 border-t border-slate-800/80">
