---
// src/components/Header.astro
import { siteConfig } from '../config/site.js';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#07090e]/85 border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between gap-4">
    
    <!-- Logo & Brand Identity -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-500 via-rose-600 to-amber-500 p-0.5 shadow-lg shadow-red-500/20 group-hover:shadow-red-500/40 transition-all duration-300">
        <div class="w-full h-full bg-[#0b0f19] rounded-[10px] flex items-center justify-center">
          <span class="text-white font-extrabold text-xl tracking-tighter group-hover:scale-110 transition-transform">
            CS
          </span>
        </div>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-lg sm:text-xl font-black tracking-tight text-white group-hover:text-red-400 transition-colors">
            {siteConfig.name}
          </span>
          <span class="text-[10px] uppercase font-bold tracking-widest px-1.5 py-0.5 rounded bg-white/10 text-slate-300 border border-white/10">
            Hub
          </span>
        </div>
        <p class="text-[11px] text-slate-400 font-medium tracking-tight hidden sm:block">
          The Honest Watch Companion
        </p>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1.5 lg:gap-2">
      {siteConfig.navLinks.map((link) => {
        const isAnime = link.name === 'Anime';
        const isAbout = link.name === 'About';
        const isActive = (isAnime && currentPath.startsWith('/anime')) || (isAbout && currentPath.startsWith('/about'));
        const isLive = link.status === 'live';

        return (
          <a
            href={link.href}
            class:list={[
              'relative px-3.5 py-2 rounded-lg text-sm font-semibold flex items-center gap-2 transition-all duration-200',
              isActive
                ? 'bg-red-500/15 text-red-400 border border-red-500/30'
                : isLive
                  ? 'text-slate-200 hover:text-white hover:bg-white/5'
                  : 'text-slate-400 hover:text-slate-300 hover:bg-white/5 cursor-not-allowed opacity-80'
            ]}
          >
            <span>{link.name}</span>
            {link.badge && (
              <span
                class:list={[
                  'text-[10px] font-extrabold uppercase px-1.5 py-0.5 rounded tracking-wider',
                  link.status === 'live'
                    ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/40'
                    : 'bg-white/10 text-slate-400 border border-white/10 text-[9px]'
                ]}
              >
                {link.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <a
        href="/anime"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 shadow-lg shadow-red-600/30 hover:shadow-red-600/50 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Explore Anime</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Toggle mobile menu"
        class="md:hidden p-2 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:text-white hover:bg-white/10 transition-colors"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/10 bg-[#0b0f19] px-4 py-4 space-y-2">
    <div class="text-xs font-bold uppercase tracking-widest text-slate-400 px-2 pt-1 pb-2">
      Menu
    </div>
    {siteConfig.navLinks.map((link) => (
      <a
        href={link.href}
        class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-200 hover:bg-white/5"
      >
        <div class="flex items-center gap-2">
          <span>{link.name}</span>
          <span class="text-xs text-slate-500 font-normal">({link.description})</span>
        </div>
        {link.badge && (
          <span
            class:list={[
              'text-[10px] font-extrabold uppercase px-2 py-0.5 rounded tracking-wider',
              link.status === 'live'
                ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                : 'bg-white/10 text-slate-400'
            ]}
          >
            {link.badge}
          </span>
        )}
      </a>
    ))}
    <div class="pt-3 border-t border-white/10">
      <a
        href="/anime"
        class="w-full flex items-center justify-center gap-2 py-2.5 rounded-lg text-sm font-bold text-white bg-gradient-to-r from-red-600 to-rose-600"
      >
        Launch Anime Hub
      </a>
    </div>
  </div>
</header>

<script>
  // Setup mobile menu toggle
  function setupMobileNav() {
    const btn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.onclick = () => {
        menu.classList.toggle('hidden');
      };
    }
  }

  setupMobileNav();
  document.addEventListener('astro:page-load', setupMobileNav);
</script>
