---
// src/components/HonestyBadge.astro
const { status = 'watched', size = 'md', showNote = false, customNote = '' } = Astro.props;

const isWatched = status === 'watched';
---

<div
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full font-semibold tracking-wide transition-all duration-200 select-none shadow-sm backdrop-blur-md',
    size === 'sm' && 'px-2.5 py-1 text-[11px]',
    size === 'md' && 'px-3 py-1.5 text-xs',
    size === 'lg' && 'px-4 py-2 text-sm',
    isWatched
      ? 'bg-emerald-950/90 text-emerald-300 border border-emerald-500/50 shadow-emerald-950/50 glow-emerald'
      : 'bg-amber-950/90 text-amber-300 border border-amber-500/50 shadow-amber-950/50 glow-amber'
  ]}
  title={isWatched ? "I've personally watched this" : "On my watchlist to watch next"}
>
  {/* Status indicator dot */}
  <span class="relative flex h-2 w-2">
    <span
      class:list={[
        'relative inline-flex rounded-full h-2 w-2',
        isWatched ? 'bg-emerald-400' : 'bg-amber-400'
      ]}
    ></span>
  </span>

  {/* Icon */}
  {isWatched ? (
    <svg class="w-3.5 h-3.5 shrink-0 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
    </svg>
  ) : (
    <svg class="w-3.5 h-3.5 shrink-0 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
      <path d="M10 2a.75.75 0 01.75.75v5.59l3.35 1.93a.75.75 0 11-.75 1.3l-3.75-2.16A.75.75 0 019 8.65V2.75A.75.75 0 0110 2z" />
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm0-1.5a6.5 6.5 0 100-13 6.5 6.5 0 000 13z" clip-rule="evenodd" />
    </svg>
  )}

  <span class="font-bold tracking-wide">
    {isWatched ? 'Watched' : 'On Watchlist'}
  </span>

  {showNote && customNote && (
    <span class="hidden sm:inline-block text-[11px] font-normal opacity-90 pl-1 border-l border-white/20">
      {customNote}
    </span>
  )}
</div>
