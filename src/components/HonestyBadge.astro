---
// src/components/HonestyBadge.astro
import { theme } from '../config/theme.js';

const { status = 'watched', size = 'md', showNote = false, customNote = '' } = Astro.props;

const isWatched = status === 'watched';
const isWatchlist = status === 'watchlist';
const isReference = status === 'reference';

const badgeTitle = isWatched
  ? "I've personally watched this"
  : isWatchlist
    ? "On my watchlist to watch next"
    : "Compiled reference guide (not personally watched)";

const badgeLabel = isWatched
  ? "I've Watched This"
  : isWatchlist
    ? "On My Watchlist"
    : "Reference Guide";
---

<div
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full font-semibold tracking-wide transition-all duration-200 select-none shadow-2xs',
    size === 'sm' && 'px-2.5 py-0.5 text-[11px]',
    size === 'md' && 'px-3 py-1 text-xs',
    size === 'lg' && 'px-4 py-1.5 text-sm font-semibold',
    isWatched && 'bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE]',
    isWatchlist && 'bg-slate-100 text-slate-700 border border-slate-200',
    isReference && 'bg-emerald-50 text-emerald-800 border border-emerald-200'
  ]}
  title={badgeTitle}
>
  {/* Status indicator dot */}
  <span class="relative flex h-1.5 w-1.5 shrink-0">
    <span
      class:list={[
        'relative inline-flex rounded-full h-1.5 w-1.5',
        isWatched && 'bg-[#6366F1]',
        isWatchlist && 'bg-slate-400',
        isReference && 'bg-emerald-500'
      ]}
    ></span>
  </span>

  {/* Icon */}
  {isWatched && (
    <svg class="w-3 h-3 shrink-0 text-[#4F46E5]" viewBox="0 0 20 20" fill="currentColor">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
    </svg>
  )}
  {isWatchlist && (
    <svg class="w-3 h-3 shrink-0 text-slate-500" viewBox="0 0 20 20" fill="currentColor">
      <path d="M10 2a.75.75 0 01.75.75v5.59l3.35 1.93a.75.75 0 11-.75 1.3l-3.75-2.16A.75.75 0 019 8.65V2.75A.75.75 0 0110 2z" />
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm0-1.5a6.5 6.5 0 100-13 6.5 6.5 0 000 13z" clip-rule="evenodd" />
    </svg>
  )}
  {isReference && (
    <svg class="w-3 h-3 shrink-0 text-emerald-700" viewBox="0 0 20 20" fill="currentColor">
      <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z" />
    </svg>
  )}

  <span class="font-semibold tracking-normal">
    {badgeLabel}
  </span>

  {showNote && customNote && (
    <span class="hidden sm:inline-block text-[11px] font-normal opacity-90 pl-1 border-l border-slate-300">
      {customNote}
    </span>
  )}
</div>
