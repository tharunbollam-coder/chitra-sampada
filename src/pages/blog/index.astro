---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getAllBlogPosts } from '../../lib/d1.js';
import { siteConfig } from '../../config/site.js';

export const prerender = false;

const posts = await getAllBlogPosts(Astro.locals);

Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate, s-maxage=86400');

const pageTitle = 'Anime Articles, Guides & Editorial Breakdowns';
const pageDescription = 'Read honest anime articles, pacing breakdowns, watch order essays, and companion guides written with transparent, no-fluff editorial insight.';

const siteOrigin = (siteConfig.siteUrl || (Astro.site ? Astro.site.origin : 'https://chitrasampada.com')).replace(/\/+$/, '');
const canonicalUrl = `${siteOrigin}/blog`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${siteOrigin}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": canonicalUrl
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-10">
    
    <!-- Breadcrumb & Header -->
    <header class="space-y-4 border-b border-slate-200/90 pb-8">
      <nav class="flex items-center gap-2 text-xs text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#4F46E5] font-bold">Blog</span>
      </nav>

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#4F46E5]">
            <span class="w-2 h-2 rounded-full bg-[#6366F1]"></span>
            <span>Editorial & Guides</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-[#0F172A] tracking-tight leading-tight font-heading">
            Articles & Insights
          </h1>
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal pt-1">
            Honest commentary, filler breakdowns, and companion essays on anime storytelling and watch pacing.
          </p>
        </div>

        <div class="text-xs text-slate-500 font-medium shrink-0 bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200/80 self-start sm:self-auto">
          {posts.length} {posts.length === 1 ? 'Article' : 'Articles'} Published
        </div>
      </div>
    </header>

    <!-- Dedicated Real-time Blog Search Bar -->
    {posts.length > 0 && (
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="relative flex-1 max-w-md">
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            id="blog-search-input"
            placeholder="Search articles by title, topic, or anime..."
            class="w-full pl-10 pr-9 py-2.5 rounded-xl bg-white border border-slate-200 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 shadow-2xs transition"
            autocomplete="off"
          />
          <button
            type="button"
            id="btn-blog-search-clear"
            class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 hover:text-slate-600 p-0.5 cursor-pointer"
            title="Clear search"
          >
            ✕
          </button>
        </div>

        <div id="blog-search-count" class="text-xs font-medium text-slate-500 shrink-0">
          Showing <span id="count-number" class="font-bold text-slate-700">{posts.length}</span> of {posts.length} {posts.length === 1 ? 'article' : 'articles'}
        </div>
      </div>
    )}

    <!-- Blog Posts Grid -->
    {posts.length > 0 ? (
      <>
        <div id="blog-posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
          {posts.map((post: any) => {
            const linkedTitles = (post.linkedAnime || []).map((a: any) => a.title).join(' ');
            const searchData = `${post.title} ${post.excerpt || ''} ${linkedTitles}`.toLowerCase();
            return (
              <div class="blog-card-item h-full" data-search={searchData}>
                <BlogPostCard post={post} />
              </div>
            );
          })}
        </div>

        <!-- No Matching Filter Results -->
        <div id="blog-empty-search" class="hidden p-12 text-center rounded-3xl bg-white border border-slate-200 space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 mx-auto flex items-center justify-center text-xl font-bold">
            🔍
          </div>
          <p class="text-base font-semibold text-slate-800">
            No articles found matching <span id="blog-query-echo" class="text-indigo-600 font-bold"></span>
          </p>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">
            Try a different keyword or anime title, or clear the search to browse all articles.
          </p>
          <div class="pt-2">
            <button
              type="button"
              id="btn-blog-reset-filter"
              class="px-4 py-2 text-xs font-semibold text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-xl transition cursor-pointer"
            >
              Clear Search
            </button>
          </div>
        </div>
      </>
    ) : (
      <div class="p-12 text-center rounded-3xl bg-white border border-slate-200 space-y-3">
        <p class="text-base font-semibold text-slate-700">No articles published yet.</p>
        <p class="text-xs text-slate-500">Editorial articles, watch guides, and commentary will be published here.</p>
      </div>
    )}

  </div>

  <script>
    function setupBlogSearch() {
      const input = document.getElementById('blog-search-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('btn-blog-search-clear');
      const resetBtn = document.getElementById('btn-blog-reset-filter');
      const countNumber = document.getElementById('count-number');
      const emptyState = document.getElementById('blog-empty-search');
      const queryEcho = document.getElementById('blog-query-echo');
      const grid = document.getElementById('blog-posts-grid');
      const cards = Array.from(document.querySelectorAll<HTMLElement>('.blog-card-item'));

      if (!input || cards.length === 0) return;

      function filterPosts() {
        if (!input) return;
        const q = input.value.trim().toLowerCase();
        const tokens = q.split(/\s+/).filter(Boolean);

        if (clearBtn) clearBtn.classList.toggle('hidden', !q);

        let visibleCount = 0;
        cards.forEach((card) => {
          const text = card.getAttribute('data-search') || '';
          const matches = tokens.every(tok => text.includes(tok));
          if (matches) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countNumber) countNumber.textContent = String(visibleCount);

        if (visibleCount === 0) {
          if (grid) grid.classList.add('hidden');
          if (emptyState) emptyState.classList.remove('hidden');
          if (queryEcho) queryEcho.textContent = `"${input.value.trim()}"`;
        } else {
          if (grid) grid.classList.remove('hidden');
          if (emptyState) emptyState.classList.add('hidden');
        }
      }

      input.addEventListener('input', filterPosts);

      function clearSearch() {
        if (!input) return;
        input.value = '';
        filterPosts();
        input.focus();
      }

      if (clearBtn) clearBtn.addEventListener('click', clearSearch);
      if (resetBtn) resetBtn.addEventListener('click', clearSearch);
    }

    document.addEventListener('astro:page-load', setupBlogSearch);
    if (document.readyState !== 'loading') {
      setupBlogSearch();
    }
  </script>
</BaseLayout>
