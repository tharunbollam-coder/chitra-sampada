---
// src/pages/blog/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPostBySlug } from '../../lib/d1.js';
import { siteConfig } from '../../config/site.js';
import { marked } from 'marked';
import { buildBlogPostMetadata } from '../../lib/seo-utils.ts';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return new Response('Blog post not found', { status: 404 });
}
const post = await getBlogPostBySlug(slug, { includeDrafts: false }, Astro.locals);

if (!post) {
  return new Response('Blog post not found', { status: 404 });
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate, s-maxage=86400');

// Compile markdown into clean HTML
const rawHtml = await marked.parse(post.content);

// Transform Key Takeaways section into a clean, scannable editorial summary box
const renderedHtml = (typeof rawHtml === 'string' ? rawHtml : '').replace(
  /<h[23][^>]*>\s*Key\s+takeaways\s*<\/h[23]>\s*<ul>([\s\S]*?)<\/ul>/i,
  (_match: string, listContent: string) => `
    <section class="key-takeaways-box" aria-label="Key Takeaways">
      <div class="flex items-center gap-2 text-indigo-900 font-bold font-heading text-lg sm:text-xl mb-3 tracking-tight">
        <svg class="w-5 h-5 text-indigo-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Key Takeaways</span>
      </div>
      <ul>
        ${listContent}
      </ul>
    </section>
  `
);

// Format date in clean editorial style
const pubDateObj = new Date(post.publishedDate);
const formattedPubDate = !isNaN(pubDateObj.getTime())
  ? pubDateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : post.publishedDate;

const { pageTitle, pageDescription } = buildBlogPostMetadata(post);

const siteOrigin = (siteConfig.siteUrl || (Astro.site ? Astro.site.origin : 'https://chitrasampada.com')).replace(/\/+$/, '');
const canonicalUrl = `${siteOrigin}/blog/${post.slug}`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": `${siteOrigin}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": `${siteOrigin}/blog`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.title,
      "item": canonicalUrl
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": pageDescription,
  ...(post.coverImage ? { "image": post.coverImage } : {}),
  "datePublished": post.publishedDate,
  "dateModified": post.lastUpdated || post.publishedDate,
  "author": {
    "@type": "Person",
    "name": "Chitra Sampada Editorial",
    "url": `${siteOrigin}/about`
  },
  "publisher": {
    "@type": "Organization",
    "name": "Chitra Sampada",
    "url": siteOrigin,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteOrigin}/cs.webp`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} ogType="article" ogImage={post.coverImage || undefined}>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>
  <main class="min-h-screen py-10 sm:py-14 lg:py-16">
    <div class="max-w-[68ch] mx-auto px-5 sm:px-6">
      
      <!-- Minimalist Navigation Back Link -->
      <nav class="mb-8 sm:mb-10">
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-slate-900 transition-colors group"
        >
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>All Articles</span>
        </a>
      </nav>

      <!-- Dedicated Header Container (Title, Excerpt, Metadata, Tags) with Generous Whitespace Transition -->
      <header class="space-y-4 sm:space-y-5 mb-8 sm:mb-10">
        
        <!-- Main Title -->
        <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-bold text-slate-900 tracking-tight leading-[1.18] sm:leading-[1.15] font-heading">
          {post.title}
        </h1>

        <!-- Lead Excerpt -->
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed font-normal">
          {post.excerpt}
        </p>

        <!-- Streamlined Metadata Row (Date & Read Time ONLY) -->
        <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-400 font-normal pt-1">
          <time datetime={post.publishedDate} class="text-slate-500">
            {formattedPubDate}
          </time>
          {post.readTime && (
            <>
              <span class="text-slate-300" aria-hidden="true">·</span>
              <span class="text-slate-500">{post.readTime}</span>
            </>
          )}
        </div>

        <!-- Subtle Tags: Discussed in this post (Lightweight inline text links) -->
        {post.linkedAnime && post.linkedAnime.length > 0 && (
          <p class="text-xs text-slate-400 font-normal pt-1">
            <span>Discussed in this post:</span>{' '}
            {post.linkedAnime.map((anime: any, idx: number) => (
              <>
                <a
                  href={`/anime/${anime.slug}`}
                  class="text-slate-600 hover:text-indigo-600 underline underline-offset-2 decoration-slate-300 hover:decoration-indigo-600 transition-colors font-medium"
                >
                  {anime.title} ({anime.year})
                </a>
                {idx < post.linkedAnime.length - 1 ? <span class="text-slate-300 mx-1">·</span> : null}
              </>
            ))}
          </p>
        )}

        {post.coverImage && (
          <div class="pt-3">
            <div class="rounded-2xl overflow-hidden aspect-[16/9] bg-slate-100 border border-slate-200/80 shadow-xs">
              <img
                src={post.coverImage}
                alt={post.title}
                loading="eager"
                decoding="async"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        )}

      </header>

      <!-- Dedicated Article Container (Main Blog Content) -->
      <article class="chitra-markdown">
        <Fragment set:html={renderedHtml} />
      </article>

      <!-- Editorial Article Conclusion / Next Steps Block -->
      <footer class="my-12 pt-10 border-t border-slate-200/80">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Back to Articles Button/Card -->
          <a
            href="/blog"
            data-astro-prefetch="hover"
            class="group flex items-center gap-3.5 p-4 sm:p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-slate-300 hover:bg-slate-50/60 shadow-2xs hover:shadow-xs transition-all duration-200 active:scale-[0.98]"
          >
            <div class="w-10 h-10 rounded-xl bg-slate-100 group-hover:bg-slate-200/80 text-slate-600 group-hover:text-slate-900 flex items-center justify-center shrink-0 transition-colors">
              <svg class="w-5 h-5 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
            </div>
            <div class="min-w-0">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">Blog Archive</span>
              <span class="block text-sm sm:text-base font-semibold text-slate-800 group-hover:text-slate-950 transition-colors truncate">
                Back to all articles
              </span>
            </div>
          </a>

          <!-- Explore Anime Catalog Button/Card -->
          <a
            href="/anime"
            data-astro-prefetch="hover"
            class="group flex items-center justify-between sm:justify-end flex-row-reverse sm:flex-row gap-3.5 p-4 sm:p-5 rounded-2xl bg-white border border-indigo-100 hover:border-indigo-200 hover:bg-indigo-50/40 shadow-2xs hover:shadow-xs transition-all duration-200 active:scale-[0.98]"
          >
            <div class="min-w-0 sm:text-right">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-indigo-500">Guides & Orders</span>
              <span class="block text-sm sm:text-base font-semibold text-indigo-700 group-hover:text-indigo-800 transition-colors truncate">
                Explore anime catalog
              </span>
            </div>
            <div class="w-10 h-10 rounded-xl bg-indigo-50 group-hover:bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0 transition-colors">
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        </div>
      </footer>

    </div>
  </main>
</BaseLayout>
