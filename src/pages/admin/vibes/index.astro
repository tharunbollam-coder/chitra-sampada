---
// src/pages/admin/vibes/index.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAllAdminVibes } from '../../../lib/d1.js';

const vibes = await getAllAdminVibes(Astro.locals);

const totalVibes = vibes.length;
const activeCount = vibes.filter(v => v.isActive).length;
const hiddenCount = vibes.filter(v => !v.isActive).length;

const colorThemes = [
  { value: 'purple', label: 'Purple (Hype & Magic)', bg: 'bg-purple-900/40 text-purple-300 border-purple-700/60' },
  { value: 'cyan', label: 'Cyan (Mysterious & Hidden)', bg: 'bg-cyan-900/40 text-cyan-300 border-cyan-700/60' },
  { value: 'indigo', label: 'Indigo (Pure Story & Canon)', bg: 'bg-indigo-900/40 text-indigo-300 border-indigo-700/60' },
  { value: 'pink', label: 'Pink (Romance & Feels)', bg: 'bg-pink-900/40 text-pink-300 border-pink-700/60' },
  { value: 'amber', label: 'Amber (Classic & Spirit)', bg: 'bg-amber-900/40 text-amber-300 border-amber-700/60' },
  { value: 'fuchsia', label: 'Fuchsia (Gateway & Vibrant)', bg: 'bg-fuchsia-900/40 text-fuchsia-300 border-fuchsia-700/60' },
  { value: 'emerald', label: 'Emerald (Adventure & Nature)', bg: 'bg-emerald-900/40 text-emerald-300 border-emerald-700/60' },
  { value: 'sky', label: 'Sky Blue (Chill & Slice of Life)', bg: 'bg-sky-900/40 text-sky-300 border-sky-700/60' },
  { value: 'rose', label: 'Rose (Dark & Dramatic)', bg: 'bg-rose-900/40 text-rose-300 border-rose-700/60' },
  { value: 'slate', label: 'Slate (Grounded & Neutral)', bg: 'bg-slate-800 text-slate-300 border-slate-700' }
];

function getThemePill(theme) {
  const match = colorThemes.find(c => c.value === theme);
  return match || colorThemes[2]; // fallback to indigo
}
---

<AdminLayout title="Vibes & Tropes" activeSection="vibes">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold font-heading text-white tracking-tight">Vibes & Tropes</h1>
      <p class="text-sm text-slate-400 mt-1">
        Curate mood-based discovery tags, tropes, and landing pages with custom SEO copy.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5">
      <button
        type="button"
        id="btn-open-create-vibe"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-sm transition cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>New Vibe</span>
      </button>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4 my-6">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Vibes</div>
      <div class="text-2xl font-bold text-white mt-1" id="stat-total-vibes">{totalVibes}</div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Active on Site</div>
      <div class="text-2xl font-bold text-emerald-400 mt-1" id="stat-active-vibes">{activeCount}</div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 col-span-2 sm:col-span-1">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Hidden Collections</div>
      <div class="text-2xl font-bold text-amber-400 mt-1" id="stat-hidden-vibes">{hiddenCount}</div>
    </div>
  </div>

  <!-- Notice Banner explaining visibility and slug guardrails -->
  <div class="p-4 bg-slate-900/70 border border-slate-800 rounded-2xl flex items-start gap-3.5 text-xs text-slate-400 leading-relaxed mb-6">
    <span class="text-indigo-400 text-base mt-0.5 shrink-0">ℹ️</span>
    <div>
      <p class="font-semibold text-slate-300">Vibe System Guidelines:</p>
      <ul class="list-disc list-inside space-y-1 mt-1 text-slate-400">
        <li><strong>Homepage Display:</strong> An active vibe card appears in public "Browse by Vibe" only if it has at least one published anime assigned to it.</li>
        <li><strong>Hidden Vibes:</strong> Hiding a vibe removes its card from the public browse section, but its direct URL continues working for assigned anime.</li>
        <li><strong>URL Slugs:</strong> Slugs are protected with a confirmation lock to prevent accidental URL breaks and broken backlinks.</li>
      </ul>
    </div>
  </div>

  <!-- Vibes List Grid / Table -->
  <div class="space-y-4" id="vibes-list-container">
    {vibes.length === 0 ? (
      <div class="p-12 text-center bg-slate-900 border border-slate-800 rounded-2xl text-slate-400 text-sm">
        No vibes found. Click "+ New Vibe" above to create your first collection!
      </div>
    ) : (
      vibes.map((v) => {
        const themeInfo = getThemePill(v.colorTheme);
        return (
          <div
            class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 flex flex-col md:flex-row md:items-center justify-between gap-4 transition hover:border-slate-700 vibe-item-card"
            data-id={v.id}
            data-slug={v.slug}
            data-active={v.isActive ? 'true' : 'false'}
            data-raw={JSON.stringify(v)}
          >
            <!-- Left Info -->
            <div class="flex-1 min-w-0 space-y-2">
              <div class="flex items-center gap-2.5 flex-wrap">
                <!-- Group Badge -->
                {v.groupLabel && (
                  <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md border ${themeInfo.bg}`}>
                    {v.groupLabel}
                  </span>
                )}

                <!-- Title & Hidden indicator -->
                <h3 class="text-base sm:text-lg font-bold font-heading text-white flex items-center gap-2">
                  <span>{v.name}</span>
                  {!v.isActive && (
                    <span class="text-[11px] px-2 py-0.5 rounded bg-amber-950/70 border border-amber-800/60 text-amber-300 font-medium font-sans">
                      Hidden
                    </span>
                  )}
                </h3>
              </div>

              <!-- Tagline -->
              {v.tagline && (
                <p class="text-xs text-slate-300">{v.tagline}</p>
              )}

              <!-- Sub-meta: slug, theme, anime count -->
              <div class="flex items-center gap-3 text-xs text-slate-400 flex-wrap pt-1">
                <span class="inline-flex items-center gap-1 font-mono text-slate-400 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">
                  <span class="text-slate-500">/anime/tag/</span>
                  <span class="text-indigo-400 font-semibold">{v.slug}</span>
                </span>

                <span class="flex items-center gap-1.5">
                  <span class="text-slate-500">•</span>
                  <span>Assigned:</span>
                  <span class={`font-semibold ${v.animeCount > 0 ? 'text-indigo-400' : 'text-slate-400'}`}>
                    {v.animeCount} {v.animeCount === 1 ? 'anime' : 'anime'}
                  </span>
                </span>

                <span class="flex items-center gap-1.5">
                  <span class="text-slate-500">•</span>
                  <span>Theme:</span>
                  <span class="capitalize text-slate-300">{v.colorTheme}</span>
                </span>
              </div>
            </div>

            <!-- Right Actions -->
            <div class="flex items-center gap-2 shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-slate-800">
              <!-- Public View Link -->
              <a
                href={`/anime/tag/${v.slug}`}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition"
                title="View public tag page"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>

              <!-- Toggle Visibility Button -->
              <button
                type="button"
                class="btn-toggle-vibe-active px-3 py-2 text-xs font-semibold rounded-xl border transition flex items-center gap-1.5 cursor-pointer"
                data-id={v.id}
                data-active={v.isActive ? 'true' : 'false'}
              >
                {v.isActive ? (
                  <span class="inline-flex items-center gap-1 text-slate-300 hover:text-amber-300">
                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <span>Hide</span>
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 text-slate-300 hover:text-emerald-300">
                    <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                    </svg>
                    <span>Show</span>
                  </span>
                )}
              </button>

              <!-- Edit Vibe Button -->
              <button
                type="button"
                class="btn-edit-vibe inline-flex items-center gap-1.5 px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold rounded-xl shadow-sm transition cursor-pointer"
                data-id={v.id}
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                <span>Edit</span>
              </button>
            </div>
          </div>
        );
      })
    )}
  </div>

  <!-- ============================================================= -->
  <!-- MODAL: CREATE NEW VIBE -->
  <!-- ============================================================= -->
  <div id="modal-create-vibe" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-950/80 backdrop-blur-sm p-4 sm:p-6 flex items-center justify-center">
    <div class="relative w-full max-w-2xl bg-slate-900 border border-indigo-500/50 rounded-2xl shadow-2xl p-5 sm:p-6 my-8 text-left">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800">
        <h2 class="text-lg sm:text-xl font-bold font-heading text-white">Create New Vibe</h2>
        <button type="button" class="btn-close-modal text-slate-400 hover:text-white p-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form id="form-create-vibe" class="space-y-4 pt-4">
        <!-- Name & Slug -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="create-v-name">
              Display Name <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="create-v-name"
              placeholder="e.g. Overpowered Main Character"
              required
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="create-v-slug">
              URL Slug <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="create-v-slug"
              placeholder="e.g. overpowered-mc"
              required
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm font-mono text-white focus:outline-none focus:border-indigo-500"
            />
            <p class="text-[11px] text-slate-500 mt-1">Used in URL: /anime/tag/[slug]</p>
          </div>
        </div>

        <!-- Tagline & Group Badge -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="create-v-tagline">
              Tagline (Short Subtitle)
            </label>
            <input
              type="text"
              id="create-v-tagline"
              placeholder="e.g. Instant dominance & hype"
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="create-v-group">
              Group Label / Badge
            </label>
            <input
              type="text"
              id="create-v-group"
              placeholder="e.g. HYPE & ACTION, CRITIC PICK"
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
            />
          </div>
        </div>

        <!-- Color Theme & Active State -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="create-v-color">
              Color Accent Theme
            </label>
            <select
              id="create-v-color"
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
            >
              {colorThemes.map(c => (
                <option value={c.value}>{c.label}</option>
              ))}
            </select>
          </div>
          <div class="pt-3">
            <label class="flex items-center gap-2.5 cursor-pointer">
              <input
                type="checkbox"
                id="create-v-active"
                checked
                class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 bg-slate-950 border-slate-700"
              />
              <span class="text-sm font-medium text-slate-200">Active (Visible on public site)</span>
            </label>
          </div>
        </div>

        <!-- SEO Intro -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="create-v-seo-intro">
            SEO Intro Paragraph
          </label>
          <textarea
            id="create-v-seo-intro"
            rows="3"
            placeholder="Lead paragraph displayed on the top of the /anime/tag/[slug] landing page..."
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
          ></textarea>
        </div>

        <!-- Meta Description -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="create-v-meta-desc">
            Meta Description
          </label>
          <textarea
            id="create-v-meta-desc"
            rows="2"
            placeholder="Search engine meta description snippet..."
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
          ></textarea>
        </div>

        <!-- Submit buttons -->
        <div class="flex justify-end gap-3 pt-4 border-t border-slate-800">
          <button
            type="button"
            class="btn-close-modal px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm font-medium transition cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="btn-submit-create"
            class="px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-sm font-semibold transition cursor-pointer"
          >
            Create Vibe
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================= -->
  <!-- MODAL: EDIT VIBE (WITH LOCKED SLUG GUARDRAIL) -->
  <!-- ============================================================= -->
  <div id="modal-edit-vibe" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-950/80 backdrop-blur-sm p-4 sm:p-6 flex items-center justify-center">
    <div class="relative w-full max-w-2xl bg-slate-900 border border-indigo-500/50 rounded-2xl shadow-2xl p-5 sm:p-6 my-8 text-left">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800">
        <div>
          <h2 class="text-lg sm:text-xl font-bold font-heading text-white">Edit Vibe</h2>
          <p class="text-xs text-slate-400 mt-0.5" id="edit-modal-subtitle">Update vibe details and metadata</p>
        </div>
        <button type="button" class="btn-close-modal text-slate-400 hover:text-white p-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form id="form-edit-vibe" class="space-y-4 pt-4">
        <input type="hidden" id="edit-v-id" />

        <!-- Name & Slug with Lock -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="edit-v-name">
              Display Name <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="edit-v-name"
              required
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
            />
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider" for="edit-v-slug">
                URL Slug <span class="text-rose-400">*</span>
              </label>
              <!-- Edit Slug Unlock Button -->
              <button
                type="button"
                id="btn-unlock-slug"
                class="text-[11px] font-semibold text-amber-400 hover:text-amber-300 transition flex items-center gap-1 cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span id="btn-unlock-slug-label">Edit Slug</span>
              </button>
            </div>
            <div class="relative">
              <input
                type="text"
                id="edit-v-slug"
                readonly
                required
                class="w-full px-3.5 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-sm font-mono text-slate-400 cursor-not-allowed focus:outline-none transition"
              />
            </div>
            <p class="text-[11px] text-slate-500 mt-1" id="slug-help-text">Slug is locked to prevent broken URL bookmarks and external backlinks.</p>
          </div>
        </div>

        <!-- Tagline & Group Badge -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="edit-v-tagline">
              Tagline (Short Subtitle)
            </label>
            <input
              type="text"
              id="edit-v-tagline"
              placeholder="e.g. Instant dominance & hype"
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="edit-v-group">
              Group Label / Badge
            </label>
            <input
              type="text"
              id="edit-v-group"
              placeholder="e.g. HYPE & ACTION, CRITIC PICK"
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
            />
          </div>
        </div>

        <!-- Color Theme & Active State -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="edit-v-color">
              Color Accent Theme
            </label>
            <select
              id="edit-v-color"
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
            >
              {colorThemes.map(c => (
                <option value={c.value}>{c.label}</option>
              ))}
            </select>
          </div>
          <div class="pt-3">
            <label class="flex items-center gap-2.5 cursor-pointer">
              <input
                type="checkbox"
                id="edit-v-active"
                class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 bg-slate-950 border-slate-700"
              />
              <span class="text-sm font-medium text-slate-200">Active (Visible on public site)</span>
            </label>
          </div>
        </div>

        <!-- SEO Intro -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="edit-v-seo-intro">
            SEO Intro Paragraph
          </label>
          <textarea
            id="edit-v-seo-intro"
            rows="3"
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
          ></textarea>
        </div>

        <!-- Meta Description -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="edit-v-meta-desc">
            Meta Description
          </label>
          <textarea
            id="edit-v-meta-desc"
            rows="2"
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
          ></textarea>
        </div>

        <!-- Submit buttons (Strictly NO Delete Button!) -->
        <div class="flex justify-end gap-3 pt-4 border-t border-slate-800">
          <button
            type="button"
            class="btn-close-modal px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm font-medium transition cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="btn-submit-edit"
            class="px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-sm font-semibold transition cursor-pointer"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ============================================================= -->
  <!-- MODAL: SLUG UNLOCK WARNING CONFIRMATION -->
  <!-- ============================================================= -->
  <div id="modal-slug-warning" class="fixed inset-0 z-60 hidden overflow-y-auto bg-slate-950/85 backdrop-blur-sm p-4 flex items-center justify-center">
    <div class="relative w-full max-w-md bg-slate-900 border border-amber-500/60 rounded-2xl shadow-2xl p-6 text-left">
      <div class="flex items-center gap-3 text-amber-400 mb-3">
        <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h3 class="text-lg font-bold text-white font-heading">Change Public URL Slug?</h3>
      </div>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        Changing this slug will alter the public URL path (<code class="font-mono text-amber-300">/anime/tag/[slug]</code>). Any existing bookmarks, backlinks, or search indexes pointing to the old URL will return a <strong class="text-rose-400">404 Not Found</strong>.
      </p>
      <p class="text-xs text-slate-400 mt-2">
        Are you sure you want to unlock and modify this slug?
      </p>

      <div class="flex justify-end gap-3 mt-6">
        <button
          type="button"
          id="btn-cancel-slug-unlock"
          class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs sm:text-sm font-medium transition cursor-pointer"
        >
          Keep Locked
        </button>
        <button
          type="button"
          id="btn-confirm-slug-unlock"
          class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs sm:text-sm font-semibold transition cursor-pointer"
        >
          Yes, Unlock Slug
        </button>
      </div>
    </div>
  </div>

</AdminLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Modal elements
    const modalCreate = document.getElementById('modal-create-vibe');
    const modalEdit = document.getElementById('modal-edit-vibe');
    const modalSlugWarning = document.getElementById('modal-slug-warning');

    // Forms
    const formCreate = document.getElementById('form-create-vibe');
    const formEdit = document.getElementById('form-edit-vibe');

    // Inputs
    const createName = document.getElementById('create-v-name');
    const createSlug = document.getElementById('create-v-slug');
    const editSlug = document.getElementById('edit-v-slug');
    const btnUnlockSlug = document.getElementById('btn-unlock-slug');
    const btnUnlockSlugLabel = document.getElementById('btn-unlock-slug-label');

    // Helper: auto-generate kebab slug
    function slugify(text) {
      return text
        .toString()
        .toLowerCase()
        .trim()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
    }

    // Auto-generate slug while typing name in create modal
    let createSlugManuallyEdited = false;
    createSlug.addEventListener('input', () => {
      createSlugManuallyEdited = Boolean(createSlug.value.trim());
    });
    createName.addEventListener('input', () => {
      if (!createSlugManuallyEdited) {
        createSlug.value = slugify(createName.value);
      }
    });

    // Open Create Modal
    document.getElementById('btn-open-create-vibe')?.addEventListener('click', () => {
      formCreate.reset();
      createSlugManuallyEdited = false;
      modalCreate.classList.remove('hidden');
      createName.focus();
    });

    // Close Modals
    document.querySelectorAll('.btn-close-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        modalCreate.classList.add('hidden');
        modalEdit.classList.add('hidden');
      });
    });

    // Close modals on background click
    [modalCreate, modalEdit].forEach(modal => {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
    });

    // Slug lock / unlock logic for Edit Modal
    let isSlugUnlocked = false;

    function lockEditSlug() {
      isSlugUnlocked = false;
      editSlug.readOnly = true;
      editSlug.className = 'w-full px-3.5 py-2.5 bg-slate-950/60 border border-slate-800 rounded-xl text-sm font-mono text-slate-400 cursor-not-allowed focus:outline-none transition';
      btnUnlockSlugLabel.textContent = 'Edit Slug';
    }

    function unlockEditSlug() {
      isSlugUnlocked = true;
      editSlug.readOnly = false;
      editSlug.className = 'w-full px-3.5 py-2.5 bg-slate-950 border border-amber-500 rounded-xl text-sm font-mono text-white focus:outline-none focus:border-amber-400 transition';
      btnUnlockSlugLabel.textContent = 'Unlocked';
      editSlug.focus();
    }

    btnUnlockSlug?.addEventListener('click', () => {
      if (!isSlugUnlocked) {
        modalSlugWarning.classList.remove('hidden');
      }
    });

    document.getElementById('btn-cancel-slug-unlock')?.addEventListener('click', () => {
      modalSlugWarning.classList.add('hidden');
    });

    document.getElementById('btn-confirm-slug-unlock')?.addEventListener('click', () => {
      modalSlugWarning.classList.add('hidden');
      unlockEditSlug();
    });

    // Open Edit Modal with vibe data
    document.querySelectorAll('.btn-edit-vibe').forEach(btn => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.vibe-item-card');
        if (!card) return;
        const rawData = card.getAttribute('data-raw');
        if (!rawData) return;

        try {
          const v = JSON.parse(rawData);
          document.getElementById('edit-v-id').value = v.id || '';
          document.getElementById('edit-v-name').value = v.name || v.title || '';
          document.getElementById('edit-v-slug').value = v.slug || '';
          document.getElementById('edit-v-tagline').value = v.tagline || '';
          document.getElementById('edit-v-group').value = v.groupLabel || v.group_label || '';
          document.getElementById('edit-v-color').value = v.colorTheme || v.color_theme || 'indigo';
          document.getElementById('edit-v-active').checked = Boolean(v.isActive);
          document.getElementById('edit-v-seo-intro').value = v.seoIntro || v.intro || '';
          document.getElementById('edit-v-meta-desc').value = v.metaDescription || '';

          lockEditSlug();
          modalEdit.classList.remove('hidden');
        } catch (err) {
          console.error('Failed to parse vibe data:', err);
        }
      });
    });

    // Handle Create Vibe Form Submit
    formCreate?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('btn-submit-create');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving...';

      const payload = {
        name: createName.value.trim(),
        slug: createSlug.value.trim(),
        tagline: document.getElementById('create-v-tagline').value.trim(),
        groupLabel: document.getElementById('create-v-group').value.trim(),
        colorTheme: document.getElementById('create-v-color').value,
        isActive: document.getElementById('create-v-active').checked,
        seoIntro: document.getElementById('create-v-seo-intro').value.trim(),
        metaDescription: document.getElementById('create-v-meta-desc').value.trim()
      };

      try {
        const res = await fetch('/api/admin/vibes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Failed to save vibe');
        }

        window.showAdminToast?.('Vibe created successfully!', 'success');
        setTimeout(() => window.location.reload(), 400);
      } catch (err) {
        window.showAdminToast?.(err.message || 'Error saving vibe', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create Vibe';
      }
    });

    // Handle Edit Vibe Form Submit
    formEdit?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('btn-submit-edit');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Saving...';

      const payload = {
        id: document.getElementById('edit-v-id').value.trim(),
        name: document.getElementById('edit-v-name').value.trim(),
        slug: document.getElementById('edit-v-slug').value.trim(),
        tagline: document.getElementById('edit-v-tagline').value.trim(),
        groupLabel: document.getElementById('edit-v-group').value.trim(),
        colorTheme: document.getElementById('edit-v-color').value,
        isActive: document.getElementById('edit-v-active').checked,
        seoIntro: document.getElementById('edit-v-seo-intro').value.trim(),
        metaDescription: document.getElementById('edit-v-meta-desc').value.trim()
      };

      try {
        const res = await fetch('/api/admin/vibes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Failed to save vibe');
        }

        window.showAdminToast?.('Vibe updated successfully!', 'success');
        setTimeout(() => window.location.reload(), 400);
      } catch (err) {
        window.showAdminToast?.(err.message || 'Error updating vibe', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Save Changes';
      }
    });

    // Handle Toggle Visibility Button on Cards
    document.querySelectorAll('.btn-toggle-vibe-active').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const currentActive = btn.getAttribute('data-active') === 'true';
        const newActive = !currentActive;

        btn.disabled = true;

        try {
          const res = await fetch('/api/admin/vibes', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, isActive: newActive })
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || 'Failed to toggle visibility');
          }

          window.showAdminToast?.(newActive ? 'Vibe is now Active' : 'Vibe is now Hidden', 'success');
          setTimeout(() => window.location.reload(), 300);
        } catch (err) {
          window.showAdminToast?.(err.message || 'Failed to toggle visibility', 'error');
          btn.disabled = false;
        }
      });
    });
  });
</script>
