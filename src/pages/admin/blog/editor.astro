---
// src/pages/admin/blog/editor.astro
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminBlogPostById } from '../../../lib/admin-db.js';
import { getCompactAnimeList } from '../../../lib/d1.js';

const url = new URL(Astro.request.url);
const postId = url.searchParams.get('id');

const [post, animeList] = await Promise.all([
  postId ? getAdminBlogPostById(postId, Astro.locals) : Promise.resolve(null),
  getCompactAnimeList(Astro.locals)
]);

const isNew = !post;
const todayStr = new Date().toISOString().split('T')[0];
const linkedAnimeIds = post ? post.linkedAnime.map((a: any) => a.id) : [];
---

<AdminLayout title={isNew ? 'Write New Blog Post' : `Edit Post: ${post.title}`} activeSection="blog">
  <!-- Header / Breadcrumb -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div class="flex items-start sm:items-center gap-3">
      <a
        href="/admin/blog"
        class="p-2 text-slate-400 hover:text-white bg-slate-900 border border-slate-800 rounded-xl hover:bg-slate-800 transition shrink-0"
        title="Back to Blog List"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <div>
        <h1 class="text-xl sm:text-2xl font-bold font-heading text-white tracking-tight">
          {isNew ? 'Write New Blog Post' : `Edit: ${post.title}`}
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-0.5">
          {isNew ? 'Draft a new essay or editorial guide.' : `Post ID: ${post.id}`}
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
      {!isNew && (
        <a
          href={`/blog/${post.slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-slate-300 hover:text-white bg-slate-900 border border-slate-700/80 rounded-xl transition hover:bg-slate-800"
        >
          <span>View Live Post</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
      <button
        type="button"
        id="btn-save-blog-top"
        class="inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 rounded-xl shadow-lg shadow-emerald-950/40 border border-emerald-500/40 transition cursor-pointer"
        title="Save blog post"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
        </svg>
        <span>Save Post</span>
      </button>
    </div>
  </div>

  <!-- Editor Container -->
  <div class="mt-8">
    <form id="form-blog" class="space-y-6">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-6 space-y-5">
        <!-- Top metadata grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Post ID -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="blog-id">
              Post ID <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="blog-id"
              value={post?.id || ''}
              placeholder="e.g. why-frieren-redefines-fantasy"
              required
              readonly={!isNew}
              class={`w-full px-3.5 py-2.5 bg-slate-950 border rounded-xl text-sm font-mono text-white focus:outline-none focus:ring-1 focus:ring-indigo-500 ${
                !isNew ? 'opacity-70 cursor-not-allowed border-slate-800' : 'border-slate-700/80 focus:border-indigo-500'
              }`}
            />
            <p id="blog-id-error" class="text-xs text-rose-400 mt-1.5 hidden"></p>
          </div>

          <!-- Slug -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="blog-slug">
              URL Slug <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="blog-slug"
              value={post?.slug || ''}
              placeholder="why-frieren-redefines-fantasy"
              required
              class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm font-mono text-white focus:outline-none focus:border-indigo-500"
            />
            <p id="blog-slug-error" class="text-xs text-rose-400 mt-1.5 hidden"></p>
          </div>

          <!-- Status & Date -->
          <div class="grid grid-cols-2 gap-3 sm:col-span-2 lg:col-span-1">
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="blog-status">
                Status
              </label>
              <select
                id="blog-status"
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white focus:outline-none focus:border-indigo-500"
              >
                <option value="published" selected={post?.status === 'published' || isNew}>Published</option>
                <option value="draft" selected={post?.status === 'draft'}>Draft</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="blog-date">
                Date
              </label>
              <input
                type="date"
                id="blog-date"
                value={post?.publishedDate || todayStr}
                required
                class="w-full px-3 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-xs text-white focus:outline-none focus:border-indigo-500"
              />
            </div>
          </div>
        </div>

        <!-- Title -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="blog-title">
            Article Title <span class="text-rose-400">*</span>
          </label>
          <input
            type="text"
            id="blog-title"
            value={post?.title || ''}
            placeholder="e.g. Why Frieren Redefines the Fantasy Journey"
            required
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700/80 rounded-xl text-base font-semibold text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
          />
        </div>

        <!-- Excerpt -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="blog-excerpt">
            Excerpt / Summary (Subheading)
          </label>
          <textarea
            id="blog-excerpt"
            rows="3"
            placeholder="Brief teaser or editorial summary shown on listing cards..."
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 min-h-[100px]"
          >{post?.excerpt || ''}</textarea>
        </div>

        <!-- Optional Cover Image URL -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5" for="blog-cover-image">
            Cover Image URL (Optional)
          </label>
          <div class="flex flex-col sm:flex-row items-start gap-4">
            <div class="flex-1 w-full">
              <input
                type="url"
                id="blog-cover-image"
                value={post?.coverImage || ''}
                placeholder="https://... or /images/..."
                class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
              />
              <p class="text-xs text-slate-400 mt-1.5">
                Leave blank for a clean text-first layout. If provided, displays as a banner on the article and card preview.
              </p>
            </div>
            <div
              id="cover-image-preview-container"
              class={`w-36 h-20 rounded-xl overflow-hidden bg-slate-950 border border-slate-800 shrink-0 flex items-center justify-center ${
                post?.coverImage ? '' : 'hidden'
              }`}
            >
              <img
                id="cover-image-preview"
                src={post?.coverImage || ''}
                alt="Cover preview"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Linked Anime -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Discusses / Linked Anime Series
          </label>
          <div class="flex flex-wrap gap-2 max-h-36 overflow-y-auto p-3 bg-slate-950 border border-slate-800 rounded-xl">
            {animeList.map((a: any) => (
              <label class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-900 border border-slate-800 rounded-lg text-xs font-medium cursor-pointer hover:border-slate-700 transition">
                <input
                  type="checkbox"
                  name="linkedAnime"
                  value={a.id}
                  checked={linkedAnimeIds.includes(a.id)}
                  class="rounded text-indigo-600 focus:ring-indigo-500 bg-slate-950 border-slate-700"
                />
                <span class="text-slate-300">{a.title}</span>
              </label>
            ))}
            {animeList.length === 0 && (
              <span class="text-xs text-slate-500">No anime in catalog yet.</span>
            )}
          </div>
        </div>

        <!-- Markdown Content -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider" for="blog-content">
              Content (Markdown) <span class="text-rose-400">*</span>
            </label>
            <div class="text-xs text-slate-400 font-mono flex items-center gap-3">
              <span id="word-count-badge">0 words</span>
              <span>&bull;</span>
              <span id="read-time-badge" class="text-indigo-400">1 min read</span>
            </div>
          </div>
          <textarea
            id="blog-content"
            rows="16"
            placeholder="Write your article in Markdown here... Use ## for H2 headings, ### for H3, lists, blockquotes, etc."
            required
            class="w-full px-4 py-3 bg-slate-950 border border-slate-700/80 rounded-xl text-sm font-mono text-slate-100 placeholder-slate-500 focus:outline-none focus:border-indigo-500 leading-relaxed min-h-[280px]"
          >{post?.content || ''}</textarea>
        </div>

        <!-- Save Button -->
        <div class="pt-4 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3">
          <p class="text-xs text-slate-400 text-center sm:text-left">Ensure title, slug, and markdown content are completed before saving.</p>
          <button
            type="submit"
            id="btn-save-blog-bottom"
            class="w-full sm:w-auto px-8 py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-emerald-950/40 border border-emerald-500/40 transition flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Save Blog Post</span>
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Client Script for Live Word Count & Save Logic -->
  <script is:inline define:vars={{ isNewPost: isNew }}>
    const titleInput = document.getElementById('blog-title');
    const slugInput = document.getElementById('blog-slug');
    const idInput = document.getElementById('blog-id');
    const contentInput = document.getElementById('blog-content');
    const coverImageInput = document.getElementById('blog-cover-image');
    const coverPreviewContainer = document.getElementById('cover-image-preview-container');
    const coverPreviewImg = document.getElementById('cover-image-preview');
    const wordBadge = document.getElementById('word-count-badge');
    const readBadge = document.getElementById('read-time-badge');
    const form = document.getElementById('form-blog');
    const btnSaveTop = document.getElementById('btn-save-blog-top');

    if (btnSaveTop && form) {
      btnSaveTop.addEventListener('click', () => {
        form.requestSubmit();
      });
    }

    const idErrorEl = document.getElementById('blog-id-error');
    const slugErrorEl = document.getElementById('blog-slug-error');

    const SLUG_REGEX = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

    function validateSlugField(inputEl, errorEl, fieldLabel = 'Value', isRequired = true) {
      if (!inputEl) return true;
      const trimmed = inputEl.value.trim().toLowerCase();
      inputEl.value = trimmed;

      if (!trimmed) {
        if (isRequired) {
          if (errorEl) {
            errorEl.textContent = `${fieldLabel} is required.`;
            errorEl.classList.remove('hidden');
          }
          inputEl.classList.add('border-rose-500', 'focus:border-rose-500');
          inputEl.classList.remove('border-slate-700/80');
          return false;
        } else {
          if (errorEl) errorEl.classList.add('hidden');
          inputEl.classList.remove('border-rose-500', 'focus:border-rose-500');
          inputEl.classList.add('border-slate-700/80');
          return true;
        }
      }

      let errorMsg = null;
      if (trimmed.startsWith('-') || trimmed.endsWith('-')) {
        errorMsg = `${fieldLabel} cannot start or end with a hyphen.`;
      } else if (trimmed.includes('--')) {
        errorMsg = `${fieldLabel} cannot contain consecutive hyphens.`;
      } else if (/[^a-z0-9-]/.test(trimmed)) {
        errorMsg = `${fieldLabel} can only contain lowercase letters, numbers, and single hyphens (no spaces or special characters).`;
      } else if (!SLUG_REGEX.test(trimmed)) {
        errorMsg = `${fieldLabel} must only contain lowercase letters, numbers, and single hyphens.`;
      }

      if (errorMsg) {
        if (errorEl) {
          errorEl.textContent = errorMsg;
          errorEl.classList.remove('hidden');
        }
        inputEl.classList.add('border-rose-500', 'focus:border-rose-500');
        inputEl.classList.remove('border-slate-700/80');
        return false;
      }

      if (errorEl) errorEl.classList.add('hidden');
      inputEl.classList.remove('border-rose-500', 'focus:border-rose-500');
      inputEl.classList.add('border-slate-700/80');
      return true;
    }

    function bindSlugInputEvents(inputEl, errorEl, fieldLabel = 'Value', isRequired = true) {
      if (!inputEl) return;
      inputEl.addEventListener('input', () => {
        const start = inputEl.selectionStart;
        const end = inputEl.selectionEnd;
        const lower = inputEl.value.toLowerCase();
        if (inputEl.value !== lower) {
          inputEl.value = lower;
          if (start !== null && end !== null) {
            inputEl.setSelectionRange(start, end);
          }
        }
        if (errorEl && !errorEl.classList.contains('hidden')) {
          validateSlugField(inputEl, errorEl, fieldLabel, isRequired);
        }
      });

      inputEl.addEventListener('paste', () => {
        setTimeout(() => {
          inputEl.value = inputEl.value.trim().toLowerCase();
          validateSlugField(inputEl, errorEl, fieldLabel, isRequired);
        }, 0);
      });

      inputEl.addEventListener('blur', () => {
        validateSlugField(inputEl, errorEl, fieldLabel, isRequired);
      });
    }

    bindSlugInputEvents(idInput, idErrorEl, 'Post ID', true);
    bindSlugInputEvents(slugInput, slugErrorEl, 'URL Slug', true);

    // Auto-generate slug from title for new posts
    if (isNewPost && titleInput && slugInput && idInput) {
      titleInput.addEventListener('input', () => {
        if (!slugInput.dataset.touched) {
          const clean = titleInput.value
            .toLowerCase()
            .replace(/['’]/g, '')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
          slugInput.value = clean;
          if (!idInput.dataset.touched) {
            idInput.value = clean;
          }
        }
      });
      slugInput.addEventListener('input', () => { slugInput.dataset.touched = 'true'; });
      idInput.addEventListener('input', () => { idInput.dataset.touched = 'true'; });
    }

    // Live word count & reading time calculation
    function updateMetrics() {
      const text = contentInput.value.trim();
      const words = text ? text.split(/\s+/).length : 0;
      const readMinutes = Math.max(1, Math.ceil(words / 200));
      wordBadge.textContent = `${words} words`;
      readBadge.textContent = `${readMinutes} min read`;
    }

    contentInput.addEventListener('input', updateMetrics);
    updateMetrics(); // Initial call

    // Live cover image preview
    if (coverImageInput && coverPreviewContainer && coverPreviewImg) {
      const updateCoverPreview = () => {
        const val = coverImageInput.value.trim();
        if (val) {
          coverPreviewImg.src = val;
          coverPreviewContainer.classList.remove('hidden');
        } else {
          coverPreviewContainer.classList.add('hidden');
          coverPreviewImg.removeAttribute('src');
        }
      };
      coverImageInput.addEventListener('input', updateCoverPreview);
      coverImageInput.addEventListener('change', updateCoverPreview);
      coverPreviewImg.addEventListener('error', () => {
        coverPreviewContainer.classList.add('hidden');
      });
    }

    // Save handler
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const isIdValid = validateSlugField(idInput, idErrorEl, 'Post ID', true);
      const isSlugValid = validateSlugField(slugInput, slugErrorEl, 'URL Slug', true);
      if (!isIdValid || !isSlugValid) {
        if (!isIdValid && idInput) idInput.focus();
        else if (!isSlugValid && slugInput) slugInput.focus();
        window.showAdminToast?.('Please resolve Post ID or Slug errors before saving.', 'error');
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]');
      const origSubmitHtml = submitBtn ? submitBtn.innerHTML : '';
      const origTopHtml = btnSaveTop ? btnSaveTop.innerHTML : '';

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<svg class="animate-spin w-4 h-4 text-white inline-block mr-1.5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Saving...</span>`;
      }
      if (btnSaveTop) {
        btnSaveTop.disabled = true;
        btnSaveTop.innerHTML = `<svg class="animate-spin w-4 h-4 text-white inline-block mr-1.5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Saving...</span>`;
      }

      const checkedAnime = Array.from(document.querySelectorAll('input[name="linkedAnime"]:checked')).map(el => el.value);

      const payload = {
        id: idInput.value.trim(),
        slug: slugInput.value.trim(),
        title: titleInput.value.trim(),
        excerpt: document.getElementById('blog-excerpt').value.trim(),
        coverImage: coverImageInput ? coverImageInput.value.trim() : null,
        content: contentInput.value.trim(),
        publishedDate: document.getElementById('blog-date').value,
        status: document.getElementById('blog-status').value,
        linkedAnimeIds: checkedAnime
      };

      let saveSuccess = false;

      try {
        const res = await fetch('/api/admin/blog', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data.success) {
          saveSuccess = true;
          window.showAdminToast(`Saved blog post "${payload.title}"`, 'success');

          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<span>Saved ✓</span>`;
            setTimeout(() => {
              if (submitBtn) submitBtn.innerHTML = origSubmitHtml;
            }, 2500);
          }
          if (btnSaveTop) {
            btnSaveTop.disabled = false;
            btnSaveTop.innerHTML = `<span>Saved ✓</span>`;
            setTimeout(() => {
              if (btnSaveTop) btnSaveTop.innerHTML = origTopHtml;
            }, 2500);
          }

          if (isNewPost) {
            const newUrl = new URL(window.location);
            newUrl.searchParams.set('id', payload.id);
            window.history.replaceState({}, '', newUrl);
          }
        } else {
          window.showAdminToast(data.error || 'Failed to save blog post', 'error');
        }
      } catch (err) {
        window.showAdminToast('Network error: ' + err.message, 'error');
      } finally {
        if (!saveSuccess) {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = origSubmitHtml;
          }
          if (btnSaveTop) {
            btnSaveTop.disabled = false;
            btnSaveTop.innerHTML = origTopHtml;
          }
        }
      }
    });
  </script>
</AdminLayout>
