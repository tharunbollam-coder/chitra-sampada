---
// src/pages/admin/index.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllAnime } from '../../lib/d1.js';

// Load anime list dynamically
const animeList = await getAllAnime(Astro.locals);

const totalAnime = animeList.length;
const totalWatched = animeList.filter(a => a.honestyStatus === 'watched').length;
const totalTrending = animeList.filter(a => a.trending).length;
---

<AdminLayout title="Anime Catalog" activeSection="anime">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold font-heading text-white tracking-tight">Anime Catalog</h1>
      <p class="text-sm text-slate-400 mt-1">Manage all anime records, reviews, filler lists, and characters.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5">
      <a
        href="/admin/anime/editor"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-sm transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Add New Anime</span>
      </a>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4 my-6">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Entries</div>
      <div class="text-2xl font-bold text-white mt-1">{totalAnime}</div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Watched Reviews</div>
      <div class="text-2xl font-bold text-emerald-400 mt-1">{totalWatched}</div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 col-span-2 sm:col-span-1">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Spotlight / Trending</div>
      <div class="text-2xl font-bold text-indigo-400 mt-1">{totalTrending}</div>
    </div>
  </div>

  <!-- Search and Filter Bar -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-6">
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="text"
        id="anime-search"
        placeholder="Filter anime by title, ID, or slug..."
        class="w-full pl-10 pr-4 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
      />
    </div>
  </div>

  <!-- Anime Table / Card Container -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[640px] text-left text-sm text-slate-300 divide-y divide-slate-800">
        <thead class="bg-slate-950/60 text-xs font-semibold text-slate-400 uppercase tracking-wider">
          <tr>
            <th scope="col" class="py-3.5 px-4 sm:px-6">Title & ID</th>
            <th scope="col" class="py-3.5 px-4 hidden sm:table-cell">Year & Eps</th>
            <th scope="col" class="py-3.5 px-4">Status & Honesty</th>
            <th scope="col" class="py-3.5 px-4 hidden md:table-cell">Rating</th>
            <th scope="col" class="py-3.5 px-4 hidden lg:table-cell">Updated</th>
            <th scope="col" class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="anime-tbody" class="divide-y divide-slate-800/80 font-normal">
          {animeList.map(anime => (
            <tr class="hover:bg-slate-800/40 transition anime-row" data-search={`${anime.title} ${anime.id} ${anime.slug}`.toLowerCase()}>
              <td class="py-4 px-4 sm:px-6">
                <div class="font-semibold text-white text-base leading-snug">
                  {anime.title}
                </div>
                <div class="flex items-center gap-2 mt-1 text-xs text-slate-400 font-mono">
                  <span>id: {anime.id}</span>
                  <span>&bull;</span>
                  <span>/{anime.slug}</span>
                </div>
              </td>
              <td class="py-4 px-4 hidden sm:table-cell text-slate-300">
                <div>{anime.year}</div>
                <div class="text-xs text-slate-400">{anime.episodes} eps {anime.fillerPercentage > 0 ? `(${anime.fillerPercentage}% filler)` : ''}</div>
              </td>
              <td class="py-4 px-4">
                <div class="flex flex-wrap gap-1.5 items-center">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
                    {anime.status}
                  </span>
                  <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border ${
                    anime.honestyStatus === 'watched' ? 'bg-emerald-950/60 text-emerald-400 border-emerald-800/60' :
                    anime.honestyStatus === 'dropped' ? 'bg-rose-950/60 text-rose-400 border-rose-800/60' :
                    'bg-amber-950/60 text-amber-400 border-amber-800/60'
                  }`}>
                    {anime.honestyStatus}
                  </span>
                </div>
              </td>
              <td class="py-4 px-4 hidden md:table-cell">
                {anime.personalRating !== null && anime.personalRating !== undefined ? (
                  <span class="font-semibold text-amber-400">★ {anime.personalRating}/10</span>
                ) : (
                  <span class="text-slate-500">—</span>
                )}
              </td>
              <td class="py-4 px-4 hidden lg:table-cell text-xs text-slate-400">
                {anime.lastUpdated || '—'}
              </td>
              <td class="py-4 px-4 text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-2">
                  <a
                    href={`/anime/${anime.slug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="View live page"
                    class="p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  <a
                    href={`/admin/anime/editor?id=${anime.id}`}
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-800 hover:bg-indigo-600 text-slate-200 hover:text-white text-xs font-semibold rounded-lg border border-slate-700 hover:border-indigo-500 transition"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    <span>Edit</span>
                  </a>
                  <button
                    type="button"
                    data-delete-id={anime.id}
                    data-title={anime.title}
                    class="btn-delete-anime p-2 text-slate-400 hover:text-rose-400 hover:bg-rose-950/30 rounded-lg transition"
                    title="Delete anime"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
          {animeList.length === 0 && (
            <tr>
              <td colspan="6" class="py-12 text-center text-slate-400">
                No anime records found in the database.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div id="no-filter-results" class="hidden py-12 text-center text-slate-400">
      No anime entries match your search query.
    </div>
  </div>

  <!-- Client search and delete logic -->
  <script is:inline>
    // Real-time title & slug search filter
    const searchInput = document.getElementById('anime-search');
    const rows = document.querySelectorAll('.anime-row');
    const noResults = document.getElementById('no-filter-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        let visibleCount = 0;

        rows.forEach((row) => {
          const text = row.getAttribute('data-search') || '';
          if (!query || text.includes(query)) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.classList.toggle('hidden', visibleCount > 0);
        }
      });
    }

    // Delete handler
    document.querySelectorAll('.btn-delete-anime').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-delete-id');
        const title = btn.getAttribute('data-title') || id;

        if (!confirm(`Are you sure you want to permanently delete "${title}" (${id}) and all its characters, filler ranges, and reviews?`)) {
          return;
        }

        try {
          const res = await fetch('/api/admin/anime', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          const data = await res.json();
          if (data.success) {
            window.showAdminToast(data.message || `Deleted "${title}"`, 'success');
            // Remove row from table
            const row = btn.closest('tr');
            if (row) row.remove();
          } else {
            window.showAdminToast(data.error || 'Failed to delete anime', 'error');
          }
        } catch (err) {
          window.showAdminToast('Network error while deleting: ' + err.message, 'error');
        }
      });
    });
  </script>
</AdminLayout>
