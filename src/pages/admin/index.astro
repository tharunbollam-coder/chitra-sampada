---
// src/pages/admin/index.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllAnime, getSiteSetting } from '../../lib/d1.js';
import { getAnimeCompleteness } from '../../lib/completeness.ts';

interface AnimeRecord {
  id: string;
  slug: string;
  title: string;
  type?: string;
  year?: string | number;
  episodes?: string | number;
  runtime?: number | null;
  status?: string;
  honestyStatus?: string;
  personalRating?: number | string | null;
  addedDate?: string;
  lastUpdated?: string;
  trending?: boolean | number;
  hasFillerData?: boolean;
  fillerPercentage?: number | null;
  [key: string]: any;
}

// Load anime list and settings concurrently
const [animeListResult, currentQuoteResult] = await Promise.all([
  getAllAnime(Astro.locals),
  getSiteSetting('thought_of_the_week', 'Plant a tree if you get the chance — future you will thank present you.', Astro.locals)
]);
const animeListRaw: AnimeRecord[] = (animeListResult as AnimeRecord[]) || [];
const currentQuote: string = (currentQuoteResult as string) || '';

// Default sort: most recently added anime at the top (latest addedDate / created_at)
const animeListSorted: AnimeRecord[] = [...animeListRaw].sort((a, b) => {
  const dateA = a.addedDate || a.created_at || '';
  const dateB = b.addedDate || b.created_at || '';
  if (dateA && dateB) return dateB.localeCompare(dateA);
  if (dateA) return -1;
  if (dateB) return 1;
  return 0;
});

// Compute live completeness for all anime
const animeList: (AnimeRecord & { completeness: any })[] = animeListSorted.map((a: AnimeRecord) => ({
  ...a,
  completeness: getAnimeCompleteness(a)
}));

const totalAnime: number = animeList.length;
const totalWatched: number = animeList.filter((a: any) => a.honestyStatus === 'watched').length;
const totalTrending: number = animeList.filter((a: any) => Boolean(a.trending)).length;
const completeCoreCount: number = animeList.filter((a: any) => a.completeness.isComplete).length;

// Missing core frequency analysis for summary line
const missingFrequency: Record<string, number> = {};
for (const a of animeList) {
  for (const m of a.completeness.missingCoreSections) {
    missingFrequency[m.shortLabel] = (missingFrequency[m.shortLabel] || 0) + 1;
  }
}
const sortedMissing = Object.entries(missingFrequency).sort((a, b) => b[1] - a[1]);
const mostMissingText = sortedMissing.length > 0
  ? `Most often missing: ${sortedMissing.slice(0, 2).map(([lbl, cnt]) => `${lbl} (${cnt})`).join(', ')}.`
  : 'All titles have complete core details!';
---

<AdminLayout title="Anime Catalog" activeSection="anime">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold font-heading text-white tracking-tight">Anime Catalog</h1>
      <p class="text-sm text-slate-400 mt-1">Manage all anime records, reviews, filler lists, and characters.</p>
    </div>
    <div class="flex items-center gap-2.5">
      <a
        href="/admin/anime/editor"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-sm transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Add New Anime</span>
      </a>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4 my-6">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Entries</div>
      <div class="text-2xl font-bold text-white mt-1">{totalAnime}</div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Watched Reviews</div>
      <div class="text-2xl font-bold text-emerald-400 mt-1">{totalWatched}</div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 col-span-2 sm:col-span-1">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Spotlight / Trending</div>
      <div class="text-2xl font-bold text-indigo-400 mt-1">{totalTrending}</div>
    </div>
  </div>

  <!-- Homepage Thought for the Week Editor Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 mb-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800/80 mb-3.5">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-emerald-950/60 text-emerald-400 font-bold text-xs flex items-center justify-center border border-emerald-800/50">
          ✨
        </span>
        <div>
          <h2 class="text-sm font-semibold text-white font-heading">Homepage Thought for the Week</h2>
          <p class="text-xs text-slate-400">Dynamic reflection quote shown to visitors on the homepage.</p>
        </div>
      </div>
      <div class="flex items-center gap-2 self-end sm:self-auto">
        <span id="quote-saved-badge" class="hidden text-xs px-2.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/80 font-medium">Saved</span>
        <button
          type="button"
          id="btn-save-quote"
          class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white text-xs font-semibold rounded-xl shadow-sm transition cursor-pointer flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Update Quote</span>
        </button>
      </div>
    </div>
    <div>
      <input
        type="text"
        id="quote-input"
        value={currentQuote}
        placeholder="Enter positive thought for the week..."
        class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
      />
    </div>
  </div>

  <!-- Cloudflare Edge Cache Management Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 mb-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800/80 mb-3.5">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-sky-950/60 text-sky-400 font-bold text-xs flex items-center justify-center border border-sky-800/50">
          ⚡
        </span>
        <div>
          <h2 class="text-sm font-semibold text-white font-heading">Cloudflare Edge Cache Purge</h2>
          <p class="text-xs text-slate-400">Instantly purge edge-cached pages across Cloudflare's global CDN network.</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span id="cache-purge-badge" class="hidden text-xs px-2.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/80 font-medium">Cache Purged</span>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
      <button
        type="button"
        class="btn-manual-purge px-3.5 py-2 bg-slate-950 hover:bg-slate-800 active:bg-slate-900 text-slate-200 hover:text-white text-xs font-semibold rounded-xl border border-slate-700/80 transition cursor-pointer flex items-center gap-2 shadow-sm"
        data-target="homepage"
      >
        <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <span>Purge Homepage</span>
      </button>

      <button
        type="button"
        class="btn-manual-purge px-3.5 py-2 bg-slate-950 hover:bg-slate-800 active:bg-slate-900 text-slate-200 hover:text-white text-xs font-semibold rounded-xl border border-slate-700/80 transition cursor-pointer flex items-center gap-2 shadow-sm"
        data-target="watch-orders"
      >
        <svg class="w-3.5 h-3.5 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        <span>Purge Watch Orders</span>
      </button>

      <button
        type="button"
        class="btn-manual-purge px-3.5 py-2 bg-rose-950/40 hover:bg-rose-900/50 active:bg-rose-950 text-rose-300 hover:text-rose-100 text-xs font-semibold rounded-xl border border-rose-800/60 transition cursor-pointer flex items-center gap-2 shadow-sm"
        data-target="all"
      >
        <svg class="w-3.5 h-3.5 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <span>Purge Full Site Cache</span>
      </button>
    </div>
  </div>

  <!-- Completeness Summary Banner -->
  <div class="bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs text-slate-300 shadow-sm">
    <div class="flex items-center gap-2.5">
      <span class="w-6 h-6 rounded-lg bg-indigo-950/70 text-indigo-400 font-bold flex items-center justify-center border border-indigo-800/60 shrink-0">
        ✓
      </span>
      <div>
        <span class="font-medium text-slate-200">
          <strong class="text-white font-bold">{completeCoreCount} of {totalAnime}</strong> anime have all core sections done.
        </span>
        <span class="text-slate-400 ml-1">
          {mostMissingText}
        </span>
      </div>
    </div>
  </div>

  <!-- Search and Sort Filter Bar -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-3.5 sm:p-4 mb-6 shadow-sm">
    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 min-w-0">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="anime-search"
          placeholder="Filter anime by title, ID, or slug..."
          class="w-full pl-10 pr-4 py-2 sm:py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 text-xs sm:text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
        />
      </div>

      <!-- Filters & Sort Group -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 shrink-0">
        <!-- Completeness Filter -->
        <div class="flex items-center gap-1.5 shrink-0">
          <label for="anime-filter-completeness" class="text-xs font-semibold text-slate-400 uppercase tracking-wider shrink-0">
            Completeness:
          </label>
          <select
            id="anime-filter-completeness"
            class="px-2.5 py-2 sm:py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-xs sm:text-sm font-medium text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition cursor-pointer"
          >
            <option value="all" selected>All</option>
            <option value="incomplete">Incomplete</option>
            <option value="complete">Complete</option>
          </select>
        </div>

        <!-- Missing Section Filter -->
        <div class="flex items-center gap-1.5 shrink-0">
          <label for="anime-filter-missing" class="text-xs font-semibold text-slate-400 uppercase tracking-wider shrink-0">
            Missing:
          </label>
          <select
            id="anime-filter-missing"
            class="px-2.5 py-2 sm:py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-xs sm:text-sm font-medium text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition cursor-pointer"
          >
            <option value="any" selected>Any</option>
            <optgroup label="Core Sections">
              <option value="core">Core Info</option>
              <option value="review">My Take</option>
              <option value="watchOrder">Watch Order</option>
              <option value="fillerList">Filler & Canon</option>
              <option value="characters">Key Characters</option>
              <option value="source">Source Material</option>
            </optgroup>
            <optgroup label="Optional extras (add if available)">
              <option value="lessons">What I Learned</option>
              <option value="powerSystem">Power System</option>
              <option value="universe">Related & Universe</option>
              <option value="recommendations">Shows Like This</option>
            </optgroup>
          </select>
        </div>

        <!-- Quick Sort Filter -->
        <div class="flex items-center gap-1.5 shrink-0">
          <label for="anime-sort" class="text-xs font-semibold text-slate-400 uppercase tracking-wider shrink-0 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12" />
            </svg>
            <span>Sort:</span>
          </label>
          <select
            id="anime-sort"
            class="px-2.5 py-2 sm:py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-xs sm:text-sm font-medium text-white focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition cursor-pointer"
          >
            <option value="recent-added" selected>Recently Added</option>
            <option value="recent-updated">Recently Updated</option>
            <option value="least-complete">Least Complete First</option>
            <option value="title-az">Title (A–Z)</option>
            <option value="highest-rated">Highest Rated</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Anime Table / Card Container -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full min-w-full sm:min-w-[780px] text-left text-sm text-slate-300 divide-y divide-slate-800">
        <thead class="bg-slate-950/60 text-xs font-semibold text-slate-400 uppercase tracking-wider">
          <tr>
            <th scope="col" class="py-3.5 px-4 sm:px-6">Title & ID</th>
            <th scope="col" class="py-3.5 px-4 hidden sm:table-cell">Year & Eps</th>
            <th scope="col" class="py-3.5 px-4">Status & Honesty</th>
            <th scope="col" class="py-3.5 px-4 hidden md:table-cell">Added</th>
            <th scope="col" class="py-3.5 px-4 hidden lg:table-cell">Updated</th>
            <th scope="col" class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="anime-tbody" class="divide-y divide-slate-800/80 font-normal">
          {animeList.map((anime: any) => (
            <tr
              class="hover:bg-slate-800/40 transition anime-row"
              data-search={`${anime.title} ${anime.id} ${anime.slug}`.toLowerCase()}
              data-title={anime.title?.toLowerCase() || ''}
              data-added={anime.addedDate || anime.created_at || ''}
              data-updated={anime.lastUpdated || ''}
              data-rating={anime.personalRating !== null && anime.personalRating !== undefined ? anime.personalRating : -1}
              data-complete={anime.completeness.isComplete ? 'complete' : 'incomplete'}
              data-percent={anime.completeness.corePercentage}
              data-core-done={anime.completeness.coreDone}
              data-missing-ids={anime.completeness.missingCoreSections.map((s: any) => s.id).join(' ')}
              data-optional-missing-ids={anime.completeness.missingOptionalSections.map((s: any) => s.id).join(' ')}
            >
              <td class="py-4 px-4 sm:px-6">
                <!-- Completion Percentage Badge -->
                <div class="mb-1.5 flex items-center gap-1.5">
                  <span
                    class={`inline-flex items-center text-[10px] font-mono font-semibold px-2 py-0.5 rounded border ${
                      anime.completeness.statusColor === 'green' ? 'bg-emerald-950/60 text-emerald-400 border-emerald-800/60' :
                      anime.completeness.statusColor === 'amber' ? 'bg-amber-950/60 text-amber-300 border-amber-800/60' :
                      'bg-rose-950/60 text-rose-300 border-rose-800/60'
                    }`}
                    title={`${anime.completeness.coreDone} of ${anime.completeness.coreTotal} core sections done (${anime.completeness.extrasDone} of 4 optional extras)`}
                  >
                    {anime.completeness.corePercentage}% complete
                  </span>
                </div>

                <div class="font-semibold text-white text-base leading-snug flex flex-wrap items-center gap-2">
                  <span>{anime.title}</span>
                  {anime.type === 'movie' && (
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-950/80 text-purple-300 border border-purple-800/80 shrink-0">
                      Movie
                    </span>
                  )}
                  {anime.personalRating !== null && anime.personalRating !== undefined && anime.personalRating !== '' ? (
                    <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-950/70 text-amber-300 border border-amber-700/60 shrink-0 shadow-xs" title={`Rating: ${anime.personalRating}/10`}>
                      <span class="text-amber-400">★</span> {anime.personalRating}
                    </span>
                  ) : null}
                </div>
                <div class="flex items-center gap-2 mt-1 text-xs text-slate-400 font-mono">
                  <span>id: {anime.id}</span>
                  <span>&bull;</span>
                  <span>/{anime.slug}</span>
                </div>
              </td>
              <td class="py-4 px-4 hidden sm:table-cell text-slate-300">
                <div>{anime.year}</div>
                <div class="text-xs text-slate-400">
                  {anime.type === 'movie'
                    ? `Movie ${anime.runtime ? `(${anime.runtime}m)` : ''}`
                    : `${anime.episodes} eps ${anime.hasFillerData && typeof anime.fillerPercentage === 'number' ? `(${anime.fillerPercentage}% filler)` : ''}`}
                </div>
              </td>
              <td class="py-4 px-4">
                <div class="flex flex-wrap gap-1.5 items-center">
                  {anime.status && anime.status.trim() !== '' && (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
                      {anime.status}
                    </span>
                  )}
                  {anime.honestyStatus && anime.honestyStatus.trim() !== '' && (
                    <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border ${
                      anime.honestyStatus === 'watched' ? 'bg-emerald-950/60 text-emerald-400 border-emerald-800/60' :
                      anime.honestyStatus === 'dropped' ? 'bg-rose-950/60 text-rose-400 border-rose-800/60' :
                      'bg-amber-950/60 text-amber-400 border-amber-800/60'
                    }`}>
                      {anime.honestyStatus}
                    </span>
                  )}
                </div>
              </td>

              <td class="py-4 px-4 hidden md:table-cell text-xs text-slate-400 whitespace-nowrap">
                {anime.addedDate || '—'}
              </td>
              <td class="py-4 px-4 hidden lg:table-cell text-xs text-slate-400 whitespace-nowrap">
                {anime.lastUpdated || '—'}
              </td>
              <td class="py-4 px-4 text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-2">
                  <a
                    href={`/anime/${anime.slug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="View live page"
                    class="p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  <a
                    href={`/admin/anime/editor?id=${anime.id}`}
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-800 hover:bg-indigo-600 text-slate-200 hover:text-white text-xs font-semibold rounded-lg border border-slate-700 hover:border-indigo-500 transition"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    <span>Edit</span>
                  </a>
                  <button
                    type="button"
                    data-delete-id={anime.id}
                    data-title={anime.title}
                    class="btn-delete-anime p-2 text-slate-400 hover:text-rose-400 hover:bg-rose-950/30 rounded-lg transition"
                    title="Delete anime"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
          {animeList.length === 0 && (
            <tr>
              <td colspan="6" class="py-12 text-center text-slate-400">
                No anime records found in the database.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div id="no-filter-results" class="hidden py-12 text-center text-slate-400">
      No anime entries match your search query.
    </div>
  </div>

  <!-- Client search, sort, and delete logic -->
  <script is:inline>
    // Real-time title & slug search filter and dropdown sorting
    const searchInput = document.getElementById('anime-search');
    const sortSelect = document.getElementById('anime-sort');
    const completenessFilter = document.getElementById('anime-filter-completeness');
    const missingFilter = document.getElementById('anime-filter-missing');
    const tbody = document.getElementById('anime-tbody');
    const noResults = document.getElementById('no-filter-results');

    function filterRows() {
      const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
      const compVal = completenessFilter ? completenessFilter.value : 'all';
      const missVal = missingFilter ? missingFilter.value : 'any';

      let visibleCount = 0;
      const allRows = document.querySelectorAll('.anime-row');

      allRows.forEach((row) => {
        const text = row.getAttribute('data-search') || '';
        const rowComplete = row.getAttribute('data-complete') || '';
        const missingCoreIds = (row.getAttribute('data-missing-ids') || '').split(' ').filter(Boolean);
        const missingOptionalIds = (row.getAttribute('data-optional-missing-ids') || '').split(' ').filter(Boolean);

        // Query search match
        const matchesQuery = !query || text.includes(query);

        // Completeness filter match
        let matchesComp = true;
        if (compVal === 'complete') {
          matchesComp = rowComplete === 'complete';
        } else if (compVal === 'incomplete') {
          matchesComp = rowComplete === 'incomplete';
        }

        // Missing section filter match
        let matchesMissing = true;
        if (missVal !== 'any') {
          matchesMissing = missingCoreIds.includes(missVal) || missingOptionalIds.includes(missVal);
        }

        if (matchesQuery && matchesComp && matchesMissing) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    function applySort(sortKey) {
      if (!tbody) return;
      const rowsArray = Array.from(tbody.querySelectorAll('.anime-row'));

      rowsArray.sort((a, b) => {
        if (sortKey === 'recent-added') {
          const dateA = a.getAttribute('data-added') || '';
          const dateB = b.getAttribute('data-added') || '';
          if (dateA && dateB) return dateB.localeCompare(dateA);
          return dateA ? -1 : (dateB ? 1 : 0);
        } else if (sortKey === 'recent-updated') {
          const dateA = a.getAttribute('data-updated') || '';
          const dateB = b.getAttribute('data-updated') || '';
          if (dateA && dateB) return dateB.localeCompare(dateA);
          return dateA ? -1 : (dateB ? 1 : 0);
        } else if (sortKey === 'least-complete') {
          const pA = parseInt(a.getAttribute('data-percent') || '0', 10);
          const pB = parseInt(b.getAttribute('data-percent') || '0', 10);
          if (pA !== pB) return pA - pB;
          const cA = parseInt(a.getAttribute('data-core-done') || '0', 10);
          const cB = parseInt(b.getAttribute('data-core-done') || '0', 10);
          if (cA !== cB) return cA - cB;
          const titleA = a.getAttribute('data-title') || '';
          const titleB = b.getAttribute('data-title') || '';
          return titleA.localeCompare(titleB);
        } else if (sortKey === 'title-az') {
          const titleA = a.getAttribute('data-title') || '';
          const titleB = b.getAttribute('data-title') || '';
          return titleA.localeCompare(titleB);
        } else if (sortKey === 'highest-rated') {
          const rateA = parseFloat(a.getAttribute('data-rating') || '-1');
          const rateB = parseFloat(b.getAttribute('data-rating') || '-1');
          return rateB - rateA;
        }
        return 0;
      });

      rowsArray.forEach(row => tbody.appendChild(row));
    }

    if (searchInput) searchInput.addEventListener('input', filterRows);
    if (completenessFilter) completenessFilter.addEventListener('change', filterRows);
    if (missingFilter) missingFilter.addEventListener('change', filterRows);
    if (sortSelect) {
      sortSelect.addEventListener('change', (e) => {
        applySort(e.target.value);
        filterRows();
      });
    }

    // Delete handler
    document.querySelectorAll('.btn-delete-anime').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-delete-id');
        const title = btn.getAttribute('data-title') || id;

        if (!confirm(`Are you sure you want to permanently delete "${title}" (${id}) and all its characters, filler ranges, and reviews?`)) {
          return;
        }

        try {
          const res = await fetch('/api/admin/anime', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          const data = await res.json();
          if (data.success) {
            window.showAdminToast(data.message || `Deleted "${title}"`, 'success');
            // Remove row from table
            const row = btn.closest('tr');
            if (row) row.remove();
            filterRows();
          } else {
            window.showAdminToast(data.error || 'Failed to delete anime', 'error');
          }
        } catch (err) {
          window.showAdminToast('Network error while deleting: ' + err.message, 'error');
        }
      });
    });

    // Save Thought of the Week Quote
    document.getElementById('btn-save-quote')?.addEventListener('click', async () => {
      const input = document.getElementById('quote-input');
      const badge = document.getElementById('quote-saved-badge');
      const btn = document.getElementById('btn-save-quote');
      const val = input ? input.value.trim() : '';

      if (!val) {
        alert('Please enter a quote message before saving.');
        return;
      }

      const origHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<svg class="animate-spin w-3.5 h-3.5 text-white inline-block mr-1" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Updating...</span>`;
      }
      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: 'thought_of_the_week', value: val })
        });
        const data = await res.json();
        if (data.success) {
          if (badge) {
            badge.classList.remove('hidden');
            setTimeout(() => badge.classList.add('hidden'), 3000);
          }
          if (window.showAdminToast) {
            window.showAdminToast('Thought for the Week updated successfully', 'success');
          }
        } else {
          alert('Failed to update quote: ' + (data.error || 'Unknown error'));
        }
      } catch (err) {
        alert('Error updating quote: ' + err.message);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origHtml;
        }
      }
    });

    // Handle Manual Cloudflare Edge Cache Purge
    document.querySelectorAll('.btn-manual-purge').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const target = btn.getAttribute('data-target') || 'all';
        const targetLabel = target === 'homepage' ? 'Homepage' : target === 'watch-orders' ? 'Watch Orders' : 'Full Site';

        if (target === 'all' && !confirm('Are you sure you want to purge the entire Cloudflare edge cache for the whole site? This will force edge servers worldwide to re-fetch all pages on the next visit.')) {
          return;
        }

        const origHtml = btn.innerHTML;
        btn.disabled = true;
        btn.classList.add('opacity-75', 'cursor-not-allowed');
        btn.innerHTML = `<svg class="animate-spin w-3.5 h-3.5 text-current inline-block mr-1.5 -mt-0.5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Purging...</span>`;

        try {
          const res = await fetch('/api/admin/purge-cache', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ target })
          });

          const data = await res.json();
          if (res.ok && data.success) {
            window.showAdminToast(data.message || `${targetLabel} edge cache purged successfully!`, 'success');
            const badge = document.getElementById('cache-purge-badge');
            if (badge) {
              badge.classList.remove('hidden');
              setTimeout(() => badge.classList.add('hidden'), 3500);
            }
          } else {
            window.showAdminToast(data.error || `Failed to purge ${targetLabel} cache`, 'error');
          }
        } catch (err) {
          window.showAdminToast('Network error while purging cache: ' + err.message, 'error');
        } finally {
          btn.disabled = false;
          btn.classList.remove('opacity-75', 'cursor-not-allowed');
          btn.innerHTML = origHtml;
        }
      });
    });
  </script>
</AdminLayout>
