---
// src/pages/admin/index.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllAnime, getSiteSetting } from '../../lib/d1.js';

// Load anime list dynamically
const animeList = await getAllAnime(Astro.locals);
const currentQuote = await getSiteSetting('thought_of_the_week', 'Plant a tree if you get the chance — future you will thank present you.', Astro.locals);

const totalAnime = animeList.length;
const totalWatched = animeList.filter(a => a.honestyStatus === 'watched').length;
const totalTrending = animeList.filter(a => a.trending).length;
---

<AdminLayout title="Anime Catalog" activeSection="anime">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold font-heading text-white tracking-tight">Anime Catalog</h1>
      <p class="text-sm text-slate-400 mt-1">Manage all anime records, reviews, filler lists, and characters.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2.5">
      <!-- Purge Cache Dropdown -->
      <div class="relative inline-block text-left" id="purge-cache-dropdown-container">
        <button
          type="button"
          id="btn-purge-cache-menu"
          class="inline-flex items-center justify-center gap-2 px-3.5 py-2.5 bg-slate-800 hover:bg-slate-700 active:bg-slate-900 text-slate-200 hover:text-white text-sm font-semibold rounded-xl border border-slate-700/80 shadow-sm transition cursor-pointer"
          title="Purge Cloudflare Edge Cache"
        >
          <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Purge Cache</span>
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="menu-purge-cache"
          class="hidden absolute right-0 mt-2 w-56 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl py-1.5 z-50 text-xs focus:outline-none"
        >
          <div class="px-3 py-2 border-b border-slate-800/80">
            <p class="font-semibold text-white">Edge Cache Actions</p>
            <p class="text-[11px] text-slate-400 mt-0.5">Purge CDN cached pages</p>
          </div>
          <button
            type="button"
            class="btn-manual-purge w-full text-left px-3.5 py-2 text-slate-300 hover:text-white hover:bg-slate-800/80 transition flex items-center gap-2 cursor-pointer"
            data-target="homepage"
          >
            <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span>Purge Homepage (/)</span>
          </button>
          <button
            type="button"
            class="btn-manual-purge w-full text-left px-3.5 py-2 text-slate-300 hover:text-white hover:bg-slate-800/80 transition flex items-center gap-2 cursor-pointer"
            data-target="watch-orders"
          >
            <svg class="w-3.5 h-3.5 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            <span>Purge Watch Orders</span>
          </button>
          <div class="my-1 border-t border-slate-800/80"></div>
          <button
            type="button"
            class="btn-manual-purge w-full text-left px-3.5 py-2 text-rose-400 hover:text-rose-300 hover:bg-rose-950/30 transition flex items-center gap-2 cursor-pointer"
            data-target="all"
          >
            <svg class="w-3.5 h-3.5 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <span>Purge Full Site Cache</span>
          </button>
        </div>
      </div>

      <a
        href="/admin/anime/editor"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-xl shadow-sm transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Add New Anime</span>
      </a>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4 my-6">
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Total Entries</div>
      <div class="text-2xl font-bold text-white mt-1">{totalAnime}</div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Watched Reviews</div>
      <div class="text-2xl font-bold text-emerald-400 mt-1">{totalWatched}</div>
    </div>
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 col-span-2 sm:col-span-1">
      <div class="text-xs font-medium text-slate-400 uppercase tracking-wider">Spotlight / Trending</div>
      <div class="text-2xl font-bold text-indigo-400 mt-1">{totalTrending}</div>
    </div>
  </div>

  <!-- Homepage Thought for the Week Editor Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 mb-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800/80 mb-3.5">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-emerald-950/60 text-emerald-400 font-bold text-xs flex items-center justify-center border border-emerald-800/50">
          ✨
        </span>
        <div>
          <h2 class="text-sm font-semibold text-white font-heading">Homepage Thought for the Week</h2>
          <p class="text-xs text-slate-400">Dynamic reflection quote shown to visitors on the homepage.</p>
        </div>
      </div>
      <div class="flex items-center gap-2 self-end sm:self-auto">
        <span id="quote-saved-badge" class="hidden text-xs px-2.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/80 font-medium">Saved</span>
        <button
          type="button"
          id="btn-save-quote"
          class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white text-xs font-semibold rounded-xl shadow-sm transition cursor-pointer flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Update Quote</span>
        </button>
      </div>
    </div>
    <div>
      <input
        type="text"
        id="quote-input"
        value={currentQuote}
        placeholder="Enter positive thought for the week..."
        class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
      />
    </div>
  </div>

  <!-- Cloudflare Edge Cache Management Card -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 mb-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800/80 mb-3.5">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-sky-950/60 text-sky-400 font-bold text-xs flex items-center justify-center border border-sky-800/50">
          ⚡
        </span>
        <div>
          <h2 class="text-sm font-semibold text-white font-heading">Cloudflare Edge Cache Purge</h2>
          <p class="text-xs text-slate-400">Instantly purge edge-cached pages across Cloudflare's global CDN network.</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span id="cache-purge-badge" class="hidden text-xs px-2.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/80 font-medium">Cache Purged</span>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
      <button
        type="button"
        class="btn-manual-purge px-3.5 py-2 bg-slate-950 hover:bg-slate-800 active:bg-slate-900 text-slate-200 hover:text-white text-xs font-semibold rounded-xl border border-slate-700/80 transition cursor-pointer flex items-center gap-2 shadow-sm"
        data-target="homepage"
      >
        <svg class="w-3.5 h-3.5 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <span>Purge Homepage</span>
      </button>

      <button
        type="button"
        class="btn-manual-purge px-3.5 py-2 bg-slate-950 hover:bg-slate-800 active:bg-slate-900 text-slate-200 hover:text-white text-xs font-semibold rounded-xl border border-slate-700/80 transition cursor-pointer flex items-center gap-2 shadow-sm"
        data-target="watch-orders"
      >
        <svg class="w-3.5 h-3.5 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        <span>Purge Watch Orders</span>
      </button>

      <button
        type="button"
        class="btn-manual-purge px-3.5 py-2 bg-rose-950/40 hover:bg-rose-900/50 active:bg-rose-950 text-rose-300 hover:text-rose-100 text-xs font-semibold rounded-xl border border-rose-800/60 transition cursor-pointer flex items-center gap-2 shadow-sm"
        data-target="all"
      >
        <svg class="w-3.5 h-3.5 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <span>Purge Full Site Cache</span>
      </button>
    </div>
  </div>

  <!-- Search and Filter Bar -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-6">
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="text"
        id="anime-search"
        placeholder="Filter anime by title, ID, or slug..."
        class="w-full pl-10 pr-4 py-2.5 bg-slate-950 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition"
      />
    </div>
  </div>

  <!-- Anime Table / Card Container -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[640px] text-left text-sm text-slate-300 divide-y divide-slate-800">
        <thead class="bg-slate-950/60 text-xs font-semibold text-slate-400 uppercase tracking-wider">
          <tr>
            <th scope="col" class="py-3.5 px-4 sm:px-6">Title & ID</th>
            <th scope="col" class="py-3.5 px-4 hidden sm:table-cell">Year & Eps</th>
            <th scope="col" class="py-3.5 px-4">Status & Honesty</th>
            <th scope="col" class="py-3.5 px-4 hidden md:table-cell">Rating</th>
            <th scope="col" class="py-3.5 px-4 hidden lg:table-cell">Updated</th>
            <th scope="col" class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="anime-tbody" class="divide-y divide-slate-800/80 font-normal">
          {animeList.map(anime => (
            <tr class="hover:bg-slate-800/40 transition anime-row" data-search={`${anime.title} ${anime.id} ${anime.slug}`.toLowerCase()}>
              <td class="py-4 px-4 sm:px-6">
                <div class="font-semibold text-white text-base leading-snug flex items-center gap-2">
                  <span>{anime.title}</span>
                  {anime.type === 'movie' && (
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-950/80 text-purple-300 border border-purple-800/80">
                      Movie
                    </span>
                  )}
                </div>
                <div class="flex items-center gap-2 mt-1 text-xs text-slate-400 font-mono">
                  <span>id: {anime.id}</span>
                  <span>&bull;</span>
                  <span>/{anime.slug}</span>
                </div>
              </td>
              <td class="py-4 px-4 hidden sm:table-cell text-slate-300">
                <div>{anime.year}</div>
                <div class="text-xs text-slate-400">
                  {anime.type === 'movie'
                    ? `Movie ${anime.runtime ? `(${anime.runtime}m)` : ''}`
                    : `${anime.episodes} eps ${anime.fillerPercentage > 0 ? `(${anime.fillerPercentage}% filler)` : ''}`}
                </div>
              </td>
              <td class="py-4 px-4">
                <div class="flex flex-wrap gap-1.5 items-center">
                  {anime.status && anime.status.trim() !== '' && (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
                      {anime.status}
                    </span>
                  )}
                  {anime.honestyStatus && anime.honestyStatus.trim() !== '' && (
                    <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border ${
                      anime.honestyStatus === 'watched' ? 'bg-emerald-950/60 text-emerald-400 border-emerald-800/60' :
                      anime.honestyStatus === 'dropped' ? 'bg-rose-950/60 text-rose-400 border-rose-800/60' :
                      'bg-amber-950/60 text-amber-400 border-amber-800/60'
                    }`}>
                      {anime.honestyStatus}
                    </span>
                  )}
                </div>
              </td>
              <td class="py-4 px-4 hidden md:table-cell">
                {anime.personalRating !== null && anime.personalRating !== undefined ? (
                  <span class="font-semibold text-amber-400">★ {anime.personalRating}/10</span>
                ) : (
                  <span class="text-slate-500">—</span>
                )}
              </td>
              <td class="py-4 px-4 hidden lg:table-cell text-xs text-slate-400">
                {anime.lastUpdated || '—'}
              </td>
              <td class="py-4 px-4 text-right whitespace-nowrap">
                <div class="flex items-center justify-end gap-2">
                  <a
                    href={`/anime/${anime.slug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="View live page"
                    class="p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-lg transition"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  <a
                    href={`/admin/anime/editor?id=${anime.id}`}
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-800 hover:bg-indigo-600 text-slate-200 hover:text-white text-xs font-semibold rounded-lg border border-slate-700 hover:border-indigo-500 transition"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    <span>Edit</span>
                  </a>
                  <button
                    type="button"
                    data-delete-id={anime.id}
                    data-title={anime.title}
                    class="btn-delete-anime p-2 text-slate-400 hover:text-rose-400 hover:bg-rose-950/30 rounded-lg transition"
                    title="Delete anime"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
          {animeList.length === 0 && (
            <tr>
              <td colspan="6" class="py-12 text-center text-slate-400">
                No anime records found in the database.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>

    <div id="no-filter-results" class="hidden py-12 text-center text-slate-400">
      No anime entries match your search query.
    </div>
  </div>

  <!-- Client search and delete logic -->
  <script is:inline>
    // Real-time title & slug search filter
    const searchInput = document.getElementById('anime-search');
    const rows = document.querySelectorAll('.anime-row');
    const noResults = document.getElementById('no-filter-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase();
        let visibleCount = 0;

        rows.forEach((row) => {
          const text = row.getAttribute('data-search') || '';
          if (!query || text.includes(query)) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.classList.toggle('hidden', visibleCount > 0);
        }
      });
    }

    // Delete handler
    document.querySelectorAll('.btn-delete-anime').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-delete-id');
        const title = btn.getAttribute('data-title') || id;

        if (!confirm(`Are you sure you want to permanently delete "${title}" (${id}) and all its characters, filler ranges, and reviews?`)) {
          return;
        }

        try {
          const res = await fetch('/api/admin/anime', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          const data = await res.json();
          if (data.success) {
            window.showAdminToast(data.message || `Deleted "${title}"`, 'success');
            // Remove row from table
            const row = btn.closest('tr');
            if (row) row.remove();
          } else {
            window.showAdminToast(data.error || 'Failed to delete anime', 'error');
          }
        } catch (err) {
          window.showAdminToast('Network error while deleting: ' + err.message, 'error');
        }
      });
    });

    // Save Thought of the Week Quote
    document.getElementById('btn-save-quote')?.addEventListener('click', async () => {
      const input = document.getElementById('quote-input');
      const badge = document.getElementById('quote-saved-badge');
      const btn = document.getElementById('btn-save-quote');
      const val = input ? input.value.trim() : '';

      if (!val) {
        alert('Please enter a quote message before saving.');
        return;
      }

      const origHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `<svg class="animate-spin w-3.5 h-3.5 text-white inline-block mr-1" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Updating...</span>`;
      }
      try {
        const res = await fetch('/api/admin/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ key: 'thought_of_the_week', value: val })
        });
        const data = await res.json();
        if (data.success) {
          if (badge) {
            badge.classList.remove('hidden');
            setTimeout(() => badge.classList.add('hidden'), 3000);
          }
          if (window.showAdminToast) {
            window.showAdminToast('Thought for the Week updated successfully', 'success');
          }
        } else {
          alert('Failed to update quote: ' + (data.error || 'Unknown error'));
        }
      } catch (err) {
        alert('Error updating quote: ' + err.message);
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origHtml;
        }
      }
    });

    // Toggle Purge Cache Dropdown
    const btnPurgeMenu = document.getElementById('btn-purge-cache-menu');
    const menuPurge = document.getElementById('menu-purge-cache');
    btnPurgeMenu?.addEventListener('click', (e) => {
      e.stopPropagation();
      menuPurge?.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      const container = document.getElementById('purge-cache-dropdown-container');
      if (container && !container.contains(e.target)) {
        menuPurge?.classList.add('hidden');
      }
    });

    // Handle Manual Cloudflare Edge Cache Purge
    document.querySelectorAll('.btn-manual-purge').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const target = btn.getAttribute('data-target') || 'all';
        const targetLabel = target === 'homepage' ? 'Homepage' : target === 'watch-orders' ? 'Watch Orders' : 'Full Site';

        if (target === 'all' && !confirm('Are you sure you want to purge the entire Cloudflare edge cache for the whole site? This will force edge servers worldwide to re-fetch all pages on the next visit.')) {
          return;
        }

        const origHtml = btn.innerHTML;
        btn.disabled = true;
        btn.classList.add('opacity-75', 'cursor-not-allowed');
        btn.innerHTML = `<svg class="animate-spin w-3.5 h-3.5 text-current inline-block mr-1.5 -mt-0.5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Purging...</span>`;

        try {
          const res = await fetch('/api/admin/purge-cache', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ target })
          });

          const data = await res.json();
          if (res.ok && data.success) {
            window.showAdminToast(data.message || `${targetLabel} edge cache purged successfully!`, 'success');
            const badge = document.getElementById('cache-purge-badge');
            if (badge) {
              badge.classList.remove('hidden');
              setTimeout(() => badge.classList.add('hidden'), 3500);
            }
          } else {
            window.showAdminToast(data.error || `Failed to purge ${targetLabel} cache`, 'error');
          }
        } catch (err) {
          window.showAdminToast('Network error while purging cache: ' + err.message, 'error');
        } finally {
          btn.disabled = false;
          btn.classList.remove('opacity-75', 'cursor-not-allowed');
          btn.innerHTML = origHtml;
          menuPurge?.classList.add('hidden');
        }
      });
    });
  </script>
</AdminLayout>
