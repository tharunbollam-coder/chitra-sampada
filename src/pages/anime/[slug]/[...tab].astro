---
// src/pages/anime/[slug]/[...tab].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HonestyBadge from '../../../components/HonestyBadge.astro';
import TabWatchOrder from '../../../components/anime/TabWatchOrder.astro';
import TabFillerList from '../../../components/anime/TabFillerList.astro';
import TabCharacters from '../../../components/anime/TabCharacters.astro';
import TabSource from '../../../components/anime/TabSource.astro';
import TabPowerSystem from '../../../components/anime/TabPowerSystem.astro';
import TabReview from '../../../components/anime/TabReview.astro';
import TabLessons from '../../../components/anime/TabLessons.astro';
import TabUniverse from '../../../components/anime/TabUniverse.astro';
import TabRecommendations from '../../../components/anime/TabRecommendations.astro';
import StreamingAvailability from '../../../components/anime/StreamingAvailability.astro';
import RelatedBlogPosts from '../../../components/RelatedBlogPosts.astro';
import { getAllAnime, getAvailableTabs, getDefaultTabKey, optimizeTmdbPoster } from '../../../lib/d1.js';
import { siteConfig } from '../../../config/site.js';

const { slug, tab } = Astro.params;

// Query D1 directly on each request so newly added anime entries appear immediately
const animeList = await getAllAnime(Astro.locals);
const anime = animeList.find(
  (a: any) => a.slug === slug || a.id === slug || (a.aliases && a.aliases.includes(slug))
);

if (!anime) {
  return new Response('Anime Not Found', { status: 404 });
}

const availableTabs = getAvailableTabs(anime);
const defaultTabKey = getDefaultTabKey(anime, availableTabs) || 'watch-order';

// If a specific tab is requested in the URL path, ensure it exists in availableTabs
if (tab && !availableTabs.some((t: any) => t.key === tab)) {
  return Astro.redirect(`/anime/${anime.slug}`, 302);
}

const activeTabKey = tab || defaultTabKey;

const isZeroFiller = anime.fillerPercentage === 0;
const isMovie = anime.type === 'movie';
const isAiring = (anime.status || '').toLowerCase().includes('airing');
const isUpcoming = (anime.status || '').toLowerCase().includes('upcoming');
const yearLabel = isAiring ? 'Since' : (isUpcoming ? 'Premieres' : 'Premiered');
const hasAgeRating = anime.ageRating !== null && anime.ageRating !== undefined && anime.ageRating !== '';
const ageRatingDisplay = hasAgeRating
  ? (Number(anime.ageRating) === 0 ? 'General' : `${anime.ageRating}+`)
  : null;

function formatRuntime(runtimeMinutes: any) {
  if (!runtimeMinutes || isNaN(runtimeMinutes)) return 'Feature Film';
  const mins = parseInt(runtimeMinutes, 10);
  if (mins < 60) return `${mins}m`;
  const hours = Math.floor(mins / 60);
  const remainingMins = mins % 60;
  return remainingMins > 0 ? `${hours}h ${remainingMins}m` : `${hours}h`;
}
const activeTab = availableTabs.find((t: any) => t.key === activeTabKey) || availableTabs[0];

function getAirStatusDetails(status: any) {
  const s = (status || '').trim();
  if (!s) return null;
  const lower = s.toLowerCase();

  if (lower === 'currently airing' || lower === 'airing') {
    return {
      label: 'Currently Airing',
      badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200/80',
      dotClass: 'bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]',
      explanation: 'New episodes are currently broadcasting or releasing.'
    };
  }

  if (lower === 'upcoming') {
    return {
      label: 'Upcoming',
      badgeClass: 'bg-sky-50 text-sky-700 border-sky-200/80',
      dotClass: 'bg-sky-500 shadow-[0_0_8px_rgba(14,165,233,0.5)]',
      explanation: 'Announced or scheduled for release — not yet broadcasting.'
    };
  }

  if (lower === 'season finished') {
    return {
      label: 'Season Finished',
      badgeClass: 'bg-amber-50 text-amber-700 border-amber-200/80',
      dotClass: 'bg-amber-500 shadow-[0_0_8px_rgba(245,158,11,0.5)]',
      explanation: 'Current season has concluded — more content or future seasons expected.'
    };
  }

  // Completed or legacy Finished
  if (lower === 'completed' || lower === 'finished') {
    return {
      label: 'Completed',
      badgeClass: 'bg-slate-100 text-slate-700 border-slate-200/80',
      dotClass: 'bg-slate-500',
      explanation: 'This story has fully wrapped up — no further seasons planned.'
    };
  }

  return {
    label: s,
    badgeClass: 'bg-slate-100 text-slate-700 border-slate-200/80',
    dotClass: 'bg-slate-400',
    explanation: ''
  };
}

const airStatusInfo = getAirStatusDetails(anime.status);
const isQuickReview = activeTab?.key === 'review' && anime.review?.type === 'quick';

const isWatched = anime.honestyStatus === 'watched';
const rawLesson = anime.what_i_learned_paragraphs || anime.lesson_takeaway || (typeof anime.lessons === 'string' ? anime.lessons : (anime.lessons?.takeaway || (typeof anime.lessons?.paragraphs === 'string' ? anime.lessons.paragraphs : null)));
const lessonText = isWatched && rawLesson
  ? (rawLesson.split(/\n\s*\n/)[0]?.trim() || rawLesson.trim())
  : null;

// Dynamic Title & Description based on active tab
const tabTitleMap = {
  'watch-order': 'Watch Order & Franchise Sequence',
  'filler-list': 'Filler List & Canon Breakdown',
  'characters': 'Ranked Characters',
  'source': 'Manga & Light Novel Source Guide',
  'power-system': 'Power System & Lore',
  'review': isQuickReview ? 'Quick Take: Initial Reaction' : 'My Honest Take & Review',
  'lessons': 'What I Learned (Reflections)',
  'universe': 'Related & Universe Media',
  'recommendations': 'Shows Like This (Recommendations)'
};

const tabDescMap = {
  'watch-order': `Chronological watch order and movie timeline for ${anime.title}. Streamlined sequence without confusion or unnecessary spin-offs.`,
  'filler-list': `Complete filler episode list and canon breakdown for ${anime.title}. Accurate percentage and curated episodes to skip.`,
  'characters': `Key characters and ranked character commentary for ${anime.title}. Detailed roles and personality dynamics.`,
  'source': `Manga and light novel source material guide for ${anime.title}. Chapter adaptation coverage and where to start reading.`,
  'power-system': `In-depth power system breakdown, combat mechanics, and worldbuilding lore for ${anime.title}.`,
  'review': `Honest, spoiler-free personal review and rating for ${anime.title}. Real viewer perspective without promotional hype.`,
  'lessons': `Key takeaways and philosophical reflections learned from watching ${anime.title}.`,
  'universe': `Complete franchise media directory for ${anime.title}. Official canon storylines, movies, spin-offs, and specials.`,
  'recommendations': `Curated anime recommendations for fans of ${anime.title}. Similar themes, combat systems, and captivating stories.`
};

const currentTabLabel = (activeTab?.key && (tabTitleMap as Record<string, string>)[activeTab.key]) || 'Honest Guide';
const pageTitle = `${anime.title} — ${currentTabLabel}`;
const pageDescription = (activeTab?.key && (tabDescMap as Record<string, string>)[activeTab.key]) || `Complete guide for ${anime.title}. ${currentTabLabel} with honest, no-fluff viewer insights.`;

const siteOrigin = (siteConfig.siteUrl || (Astro.site ? Astro.site.origin : 'https://chitrasampada.com')).replace(/\/+$/, '');
const canonicalPath = tab ? `/anime/${anime.slug}/${tab}` : `/anime/${anime.slug}`;
const canonicalUrl = `${siteOrigin}${canonicalPath}`;

// Structured Data Schemas
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": `${siteOrigin}/`
  },
  {
    "@type": "ListItem",
    "position": 2,
    "name": "Anime Section",
    "item": `${siteOrigin}/anime`
  },
  {
    "@type": "ListItem",
    "position": 3,
    "name": anime.title,
    "item": `${siteOrigin}/anime/${anime.slug}`
  }
];

if (tab && activeTab) {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 4,
    "name": activeTab.label,
    "item": `${siteOrigin}/anime/${anime.slug}/${activeTab.key}`
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

const reviewBodyText = anime.review_paragraphs || (typeof anime.review?.paragraphs === 'string' ? anime.review.paragraphs : (anime.review?.text || '')) || anime.review?.heading || (anime.synopsis ? `${anime.title}: ${anime.synopsis}` : `${anime.title} guide`);

let entitySchema;
if (anime.honestyStatus === 'watched' && anime.personalRating !== undefined && anime.personalRating !== null) {
  entitySchema = {
    "@context": "https://schema.org",
    "@type": "Review",
    "itemReviewed": {
      "@type": "TVSeries",
      "name": anime.title,
      ...(anime.originalTitle ? { "alternateName": anime.originalTitle } : {}),
      ...(anime.poster ? { "image": anime.poster } : {}),
      ...(anime.synopsis ? { "description": anime.synopsis } : {}),
      ...(anime.year ? { "startDate": String(anime.year) } : {}),
      ...(anime.episodes ? { "numberOfEpisodes": anime.episodes } : {})
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": anime.personalRating,
      "bestRating": "10",
      "worstRating": "1"
    },
    "author": {
      "@type": "Person",
      "name": "Chitra Sampada Editorial",
      "url": `${siteOrigin}/about`
    },
    "publisher": {
      "@type": "Organization",
      "name": "Chitra Sampada",
      "url": siteOrigin
    },
    "reviewBody": reviewBodyText
  };
} else {
  entitySchema = {
    "@context": "https://schema.org",
    "@type": "TVSeries",
    "name": anime.title,
    ...(anime.originalTitle ? { "alternateName": anime.originalTitle } : {}),
    ...(anime.poster ? { "image": anime.poster } : {}),
    ...(anime.synopsis ? { "description": anime.synopsis } : {}),
    ...(anime.year ? { "startDate": String(anime.year) } : {}),
    ...(anime.episodes ? { "numberOfEpisodes": anime.episodes } : {})
  };
}
---

<BaseLayout title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl}>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(entitySchema)} />
  </Fragment>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">

    <nav class="flex items-center justify-between gap-3 border-b border-slate-200 pb-4 min-w-0" aria-label="Breadcrumb">
      <!-- Full breadcrumbs on desktop/tablet (sm+); condensed on mobile -->
      <div class="flex items-center gap-1.5 sm:gap-2 text-xs text-slate-500 min-w-0 flex-1">
        <!-- Desktop/Tablet full trail -->
        <span class="hidden sm:inline-flex items-center gap-1.5 shrink-0">
          <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
          <span>/</span>
          <a href="/anime" class="hover:text-slate-900 transition-colors">Anime Section</a>
          <span>/</span>
        </span>

        <!-- Current page item (Always visible and clean on both mobile & desktop) -->
        <span class="text-slate-700 font-semibold truncate max-w-[140px] xs:max-w-[180px] sm:max-w-sm shrink-1" title={anime.title}>
          {anime.title}
        </span>

        {activeTab && (
          <span class="inline-flex items-center gap-1.5 shrink-0">
            <span>/</span>
            <span id="breadcrumb-current-tab" class="text-[#4F46E5] font-bold whitespace-nowrap">{activeTab.label}</span>
          </span>
        )}
      </div>

      <!-- Context-aware dynamic back button: shortened to 'Back' on mobile, full label on desktop -->
      <a
        href="/anime"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-[#4F46E5] transition-colors shrink-0"
        data-back-link
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m7 7h18" />
        </svg>
        <span class="back-link-text">
          <span class="sm:hidden">Back</span>
          <span class="hidden sm:inline">Back to Anime Section</span>
        </span>
      </a>
    </nav>

    <!-- 2. SHARED TOP SECTION (Fixed across all sub-pages/tabs) -->
    <section class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        
        <!-- Framed Poster Artwork -->
        <div class="md:col-span-4 max-w-[280px] mx-auto md:mx-0 w-full">
          <div class="relative aspect-[2/3] rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/90 shadow-sm">
            <img
              src={optimizeTmdbPoster(anime.poster, 'w500')}
              alt={`${anime.title} poster`}
              width="280"
              height="420"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>

        <!-- Title, Badges & Metadata -->
        <div class="md:col-span-8 space-y-5">
          
          <!-- Status, Filler & Optional Personal Rating Badges Row -->
          <div class="flex items-center gap-2 flex-wrap">
            <HonestyBadge status={anime.honestyStatus} size="md" />

            <!-- Air Status Badge with Embedded Guidance Popover -->
            {airStatusInfo?.label && (
              <div class="relative inline-flex items-center">
                {airStatusInfo.explanation ? (
                  <button
                    type="button"
                    id="air-status-info-btn"
                    aria-label={`${airStatusInfo.label} guidance`}
                    aria-expanded="false"
                    aria-controls="air-status-popover"
                    class:list={[
                      'text-xs font-semibold px-3 py-1 rounded-full border tracking-wide select-none flex items-center gap-1.5 shadow-2xs cursor-pointer transition-all touch-manipulation',
                      airStatusInfo.badgeClass
                    ]}
                  >
                    <span class:list={['w-1.5 h-1.5 rounded-full', airStatusInfo.dotClass]}></span>
                    <span>{airStatusInfo.label}</span>
                    <span class="ml-0.5 opacity-70 hover:opacity-100 transition-opacity flex items-center">
                      <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  </button>
                ) : (
                  <span class:list={['text-xs font-semibold px-3 py-1 rounded-full border tracking-wide select-none flex items-center gap-1.5 shadow-2xs', airStatusInfo.badgeClass]}>
                    <span class:list={['w-1.5 h-1.5 rounded-full', airStatusInfo.dotClass]}></span>
                    <span>{airStatusInfo.label}</span>
                  </span>
                )}

                <!-- Air Status Popover / Tooltip -->
                {airStatusInfo.explanation && (
                  <div
                    id="air-status-popover"
                    role="tooltip"
                    class="hidden absolute top-full mt-2 z-50 w-[280px] sm:w-[290px] p-3.5 sm:p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl text-left"
                  >
                    <div class="flex items-start justify-between gap-2 mb-2">
                      <div class="flex items-center gap-1.5 text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100">
                        <span class:list={['w-2 h-2 rounded-full', airStatusInfo.dotClass]}></span>
                        <span>{airStatusInfo.label}</span>
                      </div>
                      <button
                        type="button"
                        id="close-air-status-popover"
                        aria-label="Close guidance"
                        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 -mr-1 -mt-1 text-sm leading-none rounded-lg cursor-pointer transition-colors"
                      >
                        ✕
                      </button>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 font-normal leading-relaxed">
                      {airStatusInfo.explanation}
                    </p>
                  </div>
                )}
              </div>
            )}

            {isMovie ? (
              <span class="text-xs font-bold px-3 py-1 rounded-full border tracking-wide select-none bg-purple-50 text-purple-700 border-purple-200 flex items-center gap-1.5 shadow-2xs">
                <span>🎬</span>
                <span>{anime.movieCanonType ? (anime.movieCanonType === 'Canon' ? '★ Canon Storyline' : anime.movieCanonType) : 'Feature Film'}</span>
              </span>
            ) : (
              <span
                class:list={[
                  'text-xs font-bold px-3 py-1 rounded-full border tracking-wide select-none',
                  isZeroFiller
                    ? 'bg-[#EEF2FF] text-[#4F46E5] border-[#C7D2FE]'
                    : 'bg-slate-100 text-slate-700 border-slate-200'
                ]}
              >
                {isZeroFiller ? '0% Filler (Pure Canon)' : `${anime.fillerPercentage}% Filler Content`}
              </span>
            )}

            <!-- Community Suggested Badge -->
            {anime.communitySuggested && (
              <span class="text-xs font-semibold px-3 py-1 rounded-full border tracking-wide select-none bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 border-sky-200/80 dark:border-sky-800/60 flex items-center gap-1.5 shadow-2xs">
                <span>💡</span>
                <span>Community Suggested</span>
              </span>
            )}

            <!-- Personal Rating Badge (Only rendered if watched and personalRating exists) -->
            {anime.honestyStatus === 'watched' && anime.personalRating && (
              <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-800 border border-slate-200 flex items-center gap-1.5 shadow-2xs">
                <span class="text-amber-500 font-bold">★</span>
                <span>{anime.personalRating} / 10</span>
                <span class="text-[10px] text-slate-500 font-medium">(My Rating)</span>
              </span>
            )}

            <!-- Episode Count / Runtime Quick-Fact -->
            {(isMovie ? (anime.runtime ? formatRuntime(anime.runtime) : null) : (anime.episodes ? `${anime.episodes} episodes` : null)) && (
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200 flex items-center gap-1.5 shadow-2xs">
                <span class="font-bold text-slate-800">{isMovie ? formatRuntime(anime.runtime) : anime.episodes}</span>
                <span class="text-slate-500 font-normal">{isMovie ? '' : 'episodes'}</span>
              </span>
            )}

            <!-- Premiered / Debut Year Badge -->
            {anime.year && (
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200 flex items-center gap-1.5 shadow-2xs">
                <span class="text-slate-400 font-normal">{yearLabel}</span>
                <span class="font-bold text-slate-800">{anime.year}</span>
              </span>
            )}

            <!-- Age Rating Badge with Guidance Popover -->
            {hasAgeRating && (
              <div class="relative inline-flex items-center">
                <button
                  type="button"
                  id="age-rating-info-btn"
                  aria-label="Age Ratings & Guidance info"
                  aria-expanded="false"
                  aria-controls="age-rating-popover"
                  class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200/80 text-slate-800 border border-slate-200 flex items-center gap-1.5 shadow-2xs cursor-pointer transition-colors touch-manipulation"
                >
                  <span class="text-slate-400 font-normal">Age</span>
                  <span class="font-bold text-slate-800">{ageRatingDisplay}</span>
                  <span class="ml-0.5 text-slate-400 hover:text-indigo-600 transition-colors flex items-center">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                  </span>
                </button>

                <!-- Popover / Tooltip -->
                <div
                  id="age-rating-popover"
                  role="tooltip"
                  class="hidden absolute top-full mt-2 z-50 w-[280px] sm:w-[290px] p-3.5 sm:p-4 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl text-left"
                >
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <div class="flex items-center gap-1.5 text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100">
                      <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
                      <span>Age Ratings & Guidance</span>
                    </div>
                    <button
                      type="button"
                      id="close-age-popover"
                      aria-label="Close guidance"
                      class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 -mr-1 -mt-1 text-sm leading-none rounded-lg cursor-pointer transition-colors"
                    >
                      ✕
                    </button>
                  </div>
                  <div class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
                    <p>
                      Age recommendations on Chitra Sampada reflect content maturity including violence, themes, language, and intensity.
                    </p>
                    <p>
                      These ratings serve as an advisory guide to help viewers make informed viewing decisions. Viewer discretion is always advised.
                    </p>
                  </div>
                </div>
              </div>
            )}
          </div>

          <!-- Titles Block -->
          <div>
            <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[#0F172A] tracking-tight font-heading leading-tight">
              {anime.title}
            </h1>
          </div>

          <!-- Quick Synopsis -->
          {anime.synopsis && (
            <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-normal max-w-3xl">
              {anime.synopsis}
            </p>
          )}

          <!-- Genres Metadata Block -->
          {anime.genres && anime.genres.length > 0 && (
            <div class="space-y-1.5 pt-1">
              <span class="block text-[11px] font-semibold tracking-wider uppercase text-slate-500 select-none">
                Genres
              </span>
              <div class="flex flex-wrap gap-1.5">
                {anime.genres.map((genre: any) => (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-slate-100/90 text-slate-700 border border-slate-200/60 select-none hover:bg-slate-200/70 transition-colors">
                    {genre}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Explicit Date Stamps (Anime Real-World Release vs Site Publishing Dates) -->
          {(anime.addedDate || anime.lastUpdated) && (
            <div class="flex items-center gap-2.5 sm:gap-4 text-xs text-slate-500 flex-wrap pt-1 border-t border-slate-200/70">
              {anime.addedDate && (
                <div class="flex items-center gap-1.5">
                  <span class="text-slate-400 font-medium">Added to Site:</span>
                  <span class="font-semibold text-slate-700">{anime.addedDate}</span>
                </div>
              )}
              {anime.lastUpdated && (
                <>
                  {anime.addedDate && <span class="text-slate-300 hidden sm:inline">•</span>}
                  <div class="flex items-center gap-1.5">
                    <span class="text-slate-400 font-medium">Last Updated:</span>
                    <span class="font-semibold text-slate-700">{anime.lastUpdated}</span>
                  </div>
                </>
              )}
            </div>
          )}

          <!-- Optional Compact "What I Learned" Highlighted Quote Callout -->
          {lessonText && anime.sectionVisibility?.lessons !== false && (
            <div class="p-4 sm:p-4.5 rounded-2xl bg-[#EEF2FF]/40 border border-[#C7D2FE]/70 shadow-2xs space-y-2 mt-3">
              <div class="flex items-center gap-2 text-[#4F46E5]">
                <svg class="w-4 h-4 shrink-0 text-[#4F46E5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
                <span class="text-[11px] font-extrabold uppercase tracking-wider text-[#4F46E5]">What I Learned</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-normal italic">
                “{lessonText}”
              </p>
            </div>
          )}

          <!-- Where to Watch / Streaming Availability -->
          <StreamingAvailability anime={anime} />

        </div>

      </div>
    </section>

    <!-- 3. SECONDARY HORIZONTAL TAB NAVIGATION (STICKY / FULL WIDTH) -->
    <section class="sticky top-18 z-40 bg-white/95 backdrop-blur-md border-y border-slate-200 py-3 -mx-4 sm:-mx-6 lg:-mx-8 px-4 sm:px-6 lg:px-8 shadow-2xs">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        
        <!-- Tab Navigation Links -->
        <div class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar py-0.5" id="anime-tabs-nav">
          {availableTabs.map((tab) => {
            const isActive = tab.key === activeTab?.key;
            const tabUrl = `/anime/${anime.slug}/${tab.key}`;

            return (
              <a
                href={tabUrl}
                data-tab-link={tab.key}
                class:list={[
                  'anime-tab-link px-3.5 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold whitespace-nowrap transition-all duration-150 shrink-0 select-none flex items-center gap-1.5 cursor-pointer',
                  isActive
                    ? 'active-tab bg-[#6366F1] text-white shadow-sm shadow-indigo-500/20'
                    : 'inactive-tab bg-white hover:bg-slate-100 text-slate-600 hover:text-slate-900 border border-slate-200/80'
                ]}
              >
                <span>{tab.label}</span>
                {tab.count !== undefined && (
                  <span class:list={[
                    'tab-counter text-[10px] font-bold px-1.5 py-0.2 rounded-full',
                    isActive ? 'bg-[#4338CA] text-white' : 'bg-slate-100 text-slate-500'
                  ]}>
                    {tab.count}
                  </span>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 4. DYNAMIC BOTTOM SECTION (All available tabs rendered, in-place toggle with 0 scroll jump) -->
    <main class="min-h-[250px] relative">
      <div class="tab-panels">
        {availableTabs.map((t) => (
          <div
            id={`panel-${t.key}`}
            class:list={[
              'tab-panel transition-opacity duration-150',
              t.key === activeTab?.key ? 'block' : 'hidden'
            ]}
            data-panel={t.key}
            role="tabpanel"
          >
            {t.key === 'watch-order' && <TabWatchOrder anime={anime} />}
            {t.key === 'filler-list' && <TabFillerList anime={anime} />}
            {t.key === 'characters' && <TabCharacters anime={anime} />}
            {t.key === 'source' && <TabSource anime={anime} />}
            {t.key === 'power-system' && <TabPowerSystem anime={anime} />}
            {t.key === 'review' && <TabReview anime={anime} />}
            {t.key === 'lessons' && <TabLessons anime={anime} />}
            {t.key === 'universe' && <TabUniverse anime={anime} />}
            {t.key === 'recommendations' && <TabRecommendations anime={anime} />}
          </div>
        ))}
      </div>

      <!-- Related Blog Posts / Articles discussing this anime -->
      <RelatedBlogPosts animeId={anime.id} animeTitle={anime.title} />
    </main>

    <!-- 5. END-OF-PAGE BUTTON (Back to Anime Home + Explore Full Catalog) -->
    <footer class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-slate-500 font-normal text-center sm:text-left">
        Finished reading this section? Explore other anime titles and watch orders.
      </p>

      <div class="flex items-center gap-3 flex-wrap justify-center">
        <!-- Back to Anime Home Button -->
        <a
          href="/anime"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-[#6366F1] hover:bg-[#4F46E5] text-white font-bold text-sm shadow-md shadow-indigo-500/20 hover:shadow-indigo-500/30 hover:-translate-y-0.5 transition-all duration-200"
          data-back-link
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span class="back-link-text">Back to Anime Section</span>
        </a>

        <!-- Companion Full Catalog Link -->
        <a
          href="/anime/catalog"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-white hover:bg-slate-50 text-slate-800 font-semibold text-sm border border-slate-200 shadow-xs hover:-translate-y-0.5 transition-all duration-200"
        >
          <span>Explore Full Catalog →</span>
        </a>
      </div>
    </footer>

  </div>

  <!-- Client-side Tab In-Place Switching & Dynamic Context-Aware Back Navigation -->
  <script>
    // @ts-nocheck
    function setupAnimeDetailInteractions() {
      // 1. DYNAMIC CONTEXT-AWARE BACK NAVIGATION
      const backButtons = document.querySelectorAll('[data-back-link]');
      let sourcePage = null;
      try {
        sourcePage = sessionStorage.getItem('chitra_source_page');
      } catch (e) {}

      let sourcePath = '';
      if (sourcePage) {
        try {
          sourcePath = new URL(sourcePage, window.location.origin).pathname.replace(/\/$/, '') || '/';
        } catch (e) {
          sourcePath = sourcePage.split('?')[0].replace(/\/$/, '') || '/';
        }
      }

      backButtons.forEach(function (button) {
        const textSpan = button.querySelector('.back-link-text');
        const isHeaderNav = button.closest('nav') !== null;

        function setBackText(fullText) {
          if (!textSpan) return;
          if (isHeaderNav) {
            textSpan.innerHTML = '<span class="sm:hidden">Back</span><span class="hidden sm:inline">' + fullText + '</span>';
          } else {
            textSpan.textContent = fullText;
          }
        }

        if (sourcePath === '/anime/catalog') {
          setBackText('Back to Full Catalog');
          button.setAttribute('href', sourcePage || '/anime/catalog');
        } else if (sourcePath.startsWith('/anime/tag/')) {
          setBackText('Back to Vibe Filter');
          button.setAttribute('href', sourcePage);
        } else if (sourcePath === '/anime') {
          setBackText('Back to Anime Section');
          button.setAttribute('href', '/anime');
        } else if (sourcePath === '/') {
          setBackText('Back to Home');
          button.setAttribute('href', '/');
        } else {
          setBackText('Back to Anime Section');
          button.setAttribute('href', '/anime');
        }

        button.onclick = function (e) {
          if (sourcePage && window.history.length > 1) {
            e.preventDefault();
            window.history.back();
          }
        };
      });

      // 2. IN-PLACE TAB SWITCHING (PRESERVES SCROLL POSITION WITHOUT RELOAD)
      const tabLinks = document.querySelectorAll('[data-tab-link]');
      const panels = document.querySelectorAll('[data-panel]');
      const breadcrumbTab = document.getElementById('breadcrumb-current-tab');
      if (!tabLinks.length || !panels.length) return;

      const tabTitleMap = {
        'watch-order': 'Watch Order',
        'filler-list': 'Filler List',
        'characters': 'Characters',
        'source': 'Manga & Light Novel',
        'power-system': 'Power System',
        'review': 'My Take',
        'lessons': 'What I Learned',
        'universe': 'Related & Universe',
        'recommendations': 'Shows Like This'
      };

      function activateTab(tabKey, updateHistory, newHref) {
        if (!tabKey) return;
        const currentScrollY = window.scrollY;

        // Update Tab Buttons styling
        tabLinks.forEach(function (link) {
          const isMatch = link.getAttribute('data-tab-link') === tabKey;
          const counter = link.querySelector('.tab-counter');

          if (isMatch) {
            link.classList.remove('inactive-tab', 'bg-white', 'hover:bg-slate-100', 'text-slate-600', 'hover:text-slate-900', 'border', 'border-slate-200/80');
            link.classList.add('active-tab', 'bg-[#6366F1]', 'text-white', 'shadow-sm', 'shadow-indigo-500/20');
            if (counter) {
              counter.classList.remove('bg-slate-100', 'text-slate-500');
              counter.classList.add('bg-[#4338CA]', 'text-white');
            }
          } else {
            link.classList.remove('active-tab', 'bg-[#6366F1]', 'text-white', 'shadow-sm', 'shadow-indigo-500/20');
            link.classList.add('inactive-tab', 'bg-white', 'hover:bg-slate-100', 'text-slate-600', 'hover:text-slate-900', 'border', 'border-slate-200/80');
            if (counter) {
              counter.classList.remove('bg-[#4338CA]', 'text-white');
              counter.classList.add('bg-slate-100', 'text-slate-500');
            }
          }
        });

        // Toggle Tab Panels in place
        panels.forEach(function (panel) {
          const isMatch = panel.getAttribute('data-panel') === tabKey;
          if (isMatch) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.remove('block');
            panel.classList.add('hidden');
          }
        });

        // Update Breadcrumb label
        if (breadcrumbTab && tabTitleMap[tabKey]) {
          breadcrumbTab.textContent = tabTitleMap[tabKey];
        }

        // Update browser URL history with replaceState to keep history stack clean and preserve Astro router state
        if (updateHistory && newHref) {
          try {
            const currentState = window.history.state || {};
            window.history.replaceState(currentState, '', newHref);
          } catch (e) {
            window.history.replaceState(null, '', newHref);
          }
        }

        // Strictly preserve scroll position
        window.scrollTo({ top: currentScrollY, behavior: 'instant' });
      }

      tabLinks.forEach(function (link) {
        link.onclick = function (e) {
          e.preventDefault();
          const tabKey = link.getAttribute('data-tab-link');
          const targetHref = link.getAttribute('href');
          activateTab(tabKey, true, targetHref);
        };
      });

      // Handle browser back/forward within tabbed URLs
      window.addEventListener('popstate', function () {
        const pathParts = window.location.pathname.replace(/\/$/, '').split('/');
        const lastPart = pathParts[pathParts.length - 1];
        if (document.querySelector('[data-panel="' + lastPart + '"]')) {
          activateTab(lastPart, false);
        }
      });

      // -------------------------------------------------------------
      // Dynamic Guidance Popovers (Air Status & Age Rating)
      // -------------------------------------------------------------
      let currentOpenPopover = null;

      function closeAllPopovers() {
        if (currentOpenPopover) {
          currentOpenPopover.close();
          currentOpenPopover = null;
        }
      }

      function setupPopover(btn, popover, closeBtn) {
        if (!btn || !popover) return;

        function updatePosition() {
          const btnRect = btn.getBoundingClientRect();
          const padding = 16;
          const cardWidth = Math.min(290, window.innerWidth - (padding * 2));
          popover.style.width = cardWidth + 'px';

          // Clamp left position so the floating card stays strictly within viewport margins
          const maxLeft = window.innerWidth - cardWidth - padding;
          const minLeft = padding;
          const clampedLeft = Math.max(minLeft, Math.min(btnRect.left, maxLeft));
          const offsetX = clampedLeft - btnRect.left;

          popover.style.left = offsetX + 'px';
          popover.style.right = 'auto';
        }

        function open() {
          if (currentOpenPopover && currentOpenPopover.popover === popover) return;

          // Close any other open popover first
          closeAllPopovers();

          // Calculate bounds-safe position
          updatePosition();

          // Reveal card
          popover.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');

          currentOpenPopover = { btn, popover, close };
        }

        function close() {
          popover.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          if (currentOpenPopover && currentOpenPopover.popover === popover) {
            currentOpenPopover = null;
          }
        }

        function toggle(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          if (!popover.classList.contains('hidden')) {
            close();
          } else {
            open();
          }
        }

        // Toggle on badge button click
        btn.addEventListener('click', toggle);

        // Immediate close on '✕' button click
        if (closeBtn) {
          closeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            close();
          });
        }

        // Prevent clicks inside the popover from bubbling up to document
        popover.addEventListener('click', function (e) {
          e.stopPropagation();
        });
      }

      // Close popover when clicking anywhere outside on the page
      document.addEventListener('click', function (e) {
        if (currentOpenPopover) {
          if (!currentOpenPopover.btn.contains(e.target) && !currentOpenPopover.popover.contains(e.target)) {
            closeAllPopovers();
          }
        }
      });

      // Close popover on Escape key
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeAllPopovers();
        }
      });

      // Close on window resize / orientation change to prevent stale positions
      window.addEventListener('resize', function () {
        closeAllPopovers();
      });

      // Cleanup on Astro ViewTransitions navigation
      document.addEventListener('astro:before-swap', function () {
        closeAllPopovers();
      });

      // Initialize Air Status Popover
      setupPopover(
        document.getElementById('air-status-info-btn'),
        document.getElementById('air-status-popover'),
        document.getElementById('close-air-status-popover')
      );

      // Initialize Age Rating Popover
      setupPopover(
        document.getElementById('age-rating-info-btn'),
        document.getElementById('age-rating-popover'),
        document.getElementById('close-age-popover')
      );
    }

    // Attach to Astro ViewTransitions lifecycle event
    document.addEventListener('astro:page-load', setupAnimeDetailInteractions);
  </script>
</BaseLayout>
