---
// src/pages/anime/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimeCard from '../../components/AnimeCard.astro';
import HonestyBadge from '../../components/HonestyBadge.astro';
import VibeCard from '../../components/VibeCard.astro';
import { animeList } from '../../data/anime.js';
import { vibes } from '../../data/vibes.js';
import { siteConfig } from '../../config/site.js';

// Trending anime for the horizontal showcase row
const trendingAnime = animeList.filter((a) => a.trending);

// Metrics
const watchedCount = animeList.filter((a) => a.honestyStatus === 'watched').length;
const watchlistCount = animeList.filter((a) => a.honestyStatus === 'watchlist').length;
const zeroFillerCount = animeList.filter((a) => a.fillerPercentage === 0).length;
---

<BaseLayout
  title={`Anime Section — Filler-Free Guides & Discovery`}
  description="Explore honest anime recommendations, filler-free watch orders, and verified editor reviews without hype or spoilers."
>
  <!-- WELCOMING SECTION HEADER -->
  <section class="relative pt-8 pb-12 sm:pt-14 sm:pb-16 overflow-hidden border-b border-white/10 bg-gradient-to-b from-[#0e1322]/80 to-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb & Status -->
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-4">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-red-400 font-bold">Anime Section</span>
        <span class="text-[10px] uppercase font-black px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 ml-2">
          Flagship Live
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8 space-y-4">
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
            The Anime Discovery Hub
          </h1>
          <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
            Every title vetted with an <strong class="text-white">Honesty Badge</strong>, exact filler metrics, and real watch orders. No paid hype. No spoiler traps.
          </p>
        </div>

        <!-- Quick Stats Banner -->
        <div class="lg:col-span-4 flex flex-wrap lg:flex-col gap-2.5">
          <div class="flex-1 flex items-center justify-between p-3 rounded-xl bg-emerald-950/40 border border-emerald-500/30 backdrop-blur-sm">
            <span class="text-xs font-semibold text-emerald-300">Editor Watched & Vetted</span>
            <span class="text-sm font-black text-emerald-400">{watchedCount} titles</span>
          </div>
          <div class="flex-1 flex items-center justify-between p-3 rounded-xl bg-amber-950/40 border border-amber-500/30 backdrop-blur-sm">
            <span class="text-xs font-semibold text-amber-300">In Queue on Watchlist</span>
            <span class="text-sm font-black text-amber-400">{watchlistCount} titles</span>
          </div>
          <div class="flex-1 flex items-center justify-between p-3 rounded-xl bg-slate-900/60 border border-white/10 backdrop-blur-sm">
            <span class="text-xs font-semibold text-slate-300">Zero-Filler Stories</span>
            <span class="text-sm font-black text-white">{zeroFillerCount} titles</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 1. TRENDING / RECENTLY ADDED ROW -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-6">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
          <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">
            Trending & Recently Added
          </h2>
        </div>
        <p class="text-xs text-slate-400 mt-0.5">
          What the community is watching right now, complete with transparent editor status.
        </p>
      </div>

      <!-- Quick status legend -->
      <div class="hidden sm:flex items-center gap-3">
        <HonestyBadge status="watched" size="sm" />
        <HonestyBadge status="watchlist" size="sm" />
      </div>
    </div>

    <!-- Scrollable Showcase Row -->
    <div class="flex gap-5 overflow-x-auto pb-6 pt-2 custom-scrollbar snap-x snap-mandatory">
      {trendingAnime.map((anime) => (
        <div class="w-[260px] sm:w-[280px] shrink-0 snap-start">
          <AnimeCard anime={anime} />
        </div>
      ))}
    </div>
  </section>

  <!-- 2. STANDOUT "BROWSE BY VIBE" SECTION -->
  <section id="vibes" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-white/10">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-black uppercase tracking-widest text-red-400">
          Discovery by Mood
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mt-1">
          Browse by Vibe
        </h2>
        <p class="text-sm text-slate-300 mt-1 max-w-xl">
          Forget generic genres. Choose how you want to feel right now — click any card to filter the catalog instantly.
        </p>
      </div>

      <button
        type="button"
        id="reset-vibes-btn"
        class="hidden text-xs font-bold text-slate-300 hover:text-white px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 border border-white/10 transition-colors"
      >
        ✕ Reset Vibe Filter
      </button>
    </div>

    <!-- 6 Interactive Clickable Vibe Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {vibes.map((vibe) => (
        <VibeCard vibe={vibe} />
      ))}
    </div>
  </section>

  <!-- 3. FULL BROWSABLE GRID OF ALL ANIME IN CATALOG -->
  <section id="catalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/10">
    
    <!-- Catalog Header & Live Interactive Filters -->
    <div class="space-y-6 mb-10">
      
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Full Anime Catalog
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            Showing <span id="visible-count" class="font-bold text-white">{animeList.length}</span> titles
            <span id="active-vibe-pill" class="hidden ml-2 px-2 py-0.5 rounded-full bg-red-500/20 text-red-400 border border-red-500/30 text-[11px] font-bold"></span>
          </p>
        </div>

        <!-- Search Bar -->
        <div class="relative w-full md:w-80">
          <input
            type="text"
            id="search-input"
            placeholder="Search anime by title..."
            class="w-full px-4 py-2.5 pl-10 rounded-xl bg-[#0b0f19] border border-white/10 focus:border-red-500 focus:outline-none text-sm text-white placeholder:text-slate-500 transition-colors"
          />
          <svg class="w-4 h-4 text-slate-500 absolute left-3.5 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Filter Tabs -->
      <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-white/5" id="filter-tabs">
        <button
          type="button"
          data-filter="all"
          class="filter-tab-btn active px-3.5 py-1.5 rounded-lg text-xs font-bold tracking-wide transition-all bg-red-600 text-white shadow-md shadow-red-600/30"
        >
          All Titles ({animeList.length})
        </button>

        <button
          type="button"
          data-filter="watched"
          class="filter-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-bold tracking-wide transition-all bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Watched & Vetted ({watchedCount})</span>
        </button>

        <button
          type="button"
          data-filter="watchlist"
          class="filter-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-bold tracking-wide transition-all bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span>On Watchlist ({watchlistCount})</span>
        </button>

        <button
          type="button"
          data-filter="zero"
          class="filter-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-bold tracking-wide transition-all bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
          <span>Zero Filler ({zeroFillerCount})</span>
        </button>
      </div>

    </div>

    <!-- The Grid of All Anime Cards -->
    <div id="anime-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {animeList.map((anime) => (
        <AnimeCard anime={anime} />
      ))}
    </div>

    <!-- Empty State Message when no cards match -->
    <div id="empty-state" class="hidden text-center py-20 bg-white/[0.02] rounded-3xl border border-white/10 p-8">
      <div class="w-16 h-16 rounded-full bg-white/5 border border-white/10 flex items-center justify-center mx-auto mb-4 text-slate-400">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-white mb-1">No anime found matching your filter</h3>
      <p class="text-xs text-slate-400 max-w-sm mx-auto mb-5">
        Try resetting the search or selecting another vibe or status tab.
      </p>
      <button
        type="button"
        id="clear-filters-btn"
        class="px-4 py-2 rounded-xl bg-red-600 text-white text-xs font-bold hover:bg-red-500 transition-colors"
      >
        Clear All Filters
      </button>
    </div>

  </section>
</BaseLayout>

<script>
  // Pure JavaScript Client Filter & Vibe Connector
  function setupAnimeCatalog() {
    const cards = Array.from(document.querySelectorAll('#anime-grid > article'));
    const tabBtns = Array.from(document.querySelectorAll('.filter-tab-btn'));
    const vibeCards = Array.from(document.querySelectorAll('.vibe-card-btn'));
    const searchInput = document.getElementById('search-input');
    const visibleCount = document.getElementById('visible-count');
    const emptyState = document.getElementById('empty-state');
    const clearFiltersBtn = document.getElementById('clear-filters-btn');
    const activeVibePill = document.getElementById('active-vibe-pill');
    const resetVibesBtn = document.getElementById('reset-vibes-btn');

    let currentFilter = 'all';
    let currentVibe = null;
    let searchQuery = '';

    function filterCards() {
      let count = 0;

      cards.forEach((card) => {
        const cardStatus = card.getAttribute('data-status');
        const cardFiller = card.getAttribute('data-filler');
        const cardVibes = (card.getAttribute('data-vibe') || '').split(' ');
        const cardTitle = card.getAttribute('data-title') || '';

        // Status / Tab filter match
        let matchesTab = true;
        if (currentFilter === 'watched') matchesTab = (cardStatus === 'watched');
        if (currentFilter === 'watchlist') matchesTab = (cardStatus === 'watchlist');
        if (currentFilter === 'zero') matchesTab = (cardFiller === 'zero');

        // Vibe match
        let matchesVibe = true;
        if (currentVibe) {
          matchesVibe = cardVibes.includes(currentVibe);
        }

        // Search match
        let matchesSearch = true;
        if (searchQuery.trim()) {
          matchesSearch = cardTitle.includes(searchQuery.toLowerCase().trim());
        }

        if (matchesTab && matchesVibe && matchesSearch) {
          card.classList.remove('hidden');
          count++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCount) {
        visibleCount.textContent = count;
      }

      if (emptyState) {
        if (count === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      // Update vibe UI indicator
      if (activeVibePill) {
        if (currentVibe) {
          activeVibePill.classList.remove('hidden');
          activeVibePill.textContent = `Vibe: ${currentVibe.replace('-', ' ')} ✕`;
          if (resetVibesBtn) resetVibesBtn.classList.remove('hidden');
        } else {
          activeVibePill.classList.add('hidden');
          if (resetVibesBtn) resetVibesBtn.classList.add('hidden');
        }
      }
    }

    // Tab buttons click handler
    tabBtns.forEach((btn) => {
      btn.onclick = () => {
        tabBtns.forEach((b) => {
          b.classList.remove('bg-red-600', 'text-white', 'shadow-md', 'shadow-red-600/30');
          b.classList.add('bg-white/5', 'text-slate-300');
        });
        btn.classList.remove('bg-white/5', 'text-slate-300');
        btn.classList.add('bg-red-600', 'text-white', 'shadow-md', 'shadow-red-600/30');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        filterCards();
      };
    });

    // Vibe cards click handler
    vibeCards.forEach((btn) => {
      btn.onclick = () => {
        const vibeId = btn.getAttribute('data-filter-vibe');
        if (currentVibe === vibeId) {
          currentVibe = null;
        } else {
          currentVibe = vibeId;
        }

        filterCards();

        // Smooth scroll down to the catalog grid
        const catalogEl = document.getElementById('catalog');
        if (catalogEl) {
          catalogEl.scrollIntoView({ behavior: 'smooth' });
        }
      };
    });

    // Click active vibe pill to clear
    if (activeVibePill) {
      activeVibePill.onclick = () => {
        currentVibe = null;
        filterCards();
      };
    }

    if (resetVibesBtn) {
      resetVibesBtn.onclick = () => {
        currentVibe = null;
        filterCards();
      };
    }

    // Search input handler
    if (searchInput) {
      searchInput.oninput = (e) => {
        searchQuery = e.target.value;
        filterCards();
      };
    }

    // Clear filters button
    if (clearFiltersBtn) {
      clearFiltersBtn.onclick = () => {
        currentFilter = 'all';
        currentVibe = null;
        searchQuery = '';
        if (searchInput) searchInput.value = '';

        tabBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.add('bg-red-600', 'text-white');
            b.classList.remove('bg-white/5', 'text-slate-300');
          } else {
            b.classList.remove('bg-red-600', 'text-white');
            b.classList.add('bg-white/5', 'text-slate-300');
          }
        });

        filterCards();
      };
    }
  }

  setupAnimeCatalog();
  document.addEventListener('astro:page-load', setupAnimeCatalog);
</script>
