---
// src/pages/anime/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimeCard from '../../components/AnimeCard.astro';
import VibeCard from '../../components/VibeCard.astro';
import { animeList } from '../../data/anime.js';
import { vibes } from '../../data/vibes.js';
import { siteConfig } from '../../config/site.js';

// Featured selection for the static grid (top 4 titles to reduce mobile scroll fatigue)
const featuredAnime = animeList.filter((a) => a.trending).slice(0, 4);
---

<BaseLayout
  title={`Anime Section — Filler-Free Guides & Discovery`}
  description="Explore honest anime recommendations, filler-free watch orders, and verified editor reviews without hype or spoilers."
>
  <!-- 1. IMPROVED HERO SECTION -->
  <section class="relative pt-10 pb-14 sm:pt-16 sm:pb-20 overflow-hidden border-b border-slate-200 bg-gradient-to-b from-slate-100/70 via-white to-transparent">
    <!-- Ambient top glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[260px] bg-red-500/5 blur-[120px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb & Status Indicator -->
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-6">
        <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
        <span>/</span>
        <span class="text-red-600 font-semibold">Anime Section</span>
        <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 ml-2">
          Flagship Live
        </span>
      </div>

      <!-- Main Headline & Narrative -->
      <div class="max-w-3xl space-y-5">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-[1.15] font-heading">
          The Anime List
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          What I've personally watched and what is next on my watchlist, with simple watch orders and filler guides so you know what you're getting into.
        </p>

        <!-- Simple single-line counter replacing the old 3 stat boxes -->
        <div class="pt-1 flex flex-wrap items-center gap-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-700 shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>
            <span>{animeList.length} anime listed and counting</span>
          </div>
        </div>

        <!-- Hero Actions -->
        <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
          <a
            href="/anime/catalog"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-red-600 hover:bg-red-500 text-white font-bold text-sm shadow-md shadow-red-600/25 hover:shadow-red-600/40 hover:-translate-y-0.5 transition-all duration-200"
          >
            <span>Browse Full Catalog</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="#vibes"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 font-semibold text-sm border border-slate-200 shadow-xs hover:-translate-y-0.5 transition-all duration-200"
          >
            <span>Browse by Vibe ↓</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- 2. RECENTLY ADDED & FEATURED (CLEAN STATIC GRID REPLACING HORIZONTAL SCROLL) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.8)] animate-pulse"></span>
          <h2 class="font-heading text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
            Trending & Recently Added
          </h2>
        </div>
        <p class="text-xs text-slate-500 mt-1 font-normal">
          A look at some of the latest additions with verified watch orders and filler guides.
        </p>
      </div>

      <a
        href="/anime/catalog"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-red-600 hover:text-red-700 transition-colors"
      >
        <span>View all {animeList.length} titles in catalog →</span>
      </a>
    </div>

    <!-- Static Grid of Anime Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-7">
      {featuredAnime.map((anime) => (
        <AnimeCard anime={anime} />
      ))}
    </div>
  </section>

  <!-- 3. STANDOUT "BROWSE BY VIBE" SECTION -->
  <section id="vibes" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-wider text-red-600">
          Discovery by Mood
        </span>
        <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">
          Browse by Vibe
        </h2>
        <p class="text-sm text-slate-600 mt-1 max-w-xl font-normal leading-relaxed">
          Forget generic genres. Choose how you want to feel right now — click any vibe card to open filtered picks in the catalog.
        </p>
      </div>
    </div>

    <!-- 6 Interactive Clickable Vibe Cards linking to dedicated /anime/tag/[slug] pages -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {vibes.map((vibe) => (
        <VibeCard vibe={vibe} href={`/anime/tag/${vibe.slug}`} />
      ))}
    </div>
  </section>

  <!-- 4. DEDICATED FULL CATALOG PROMO CTA (REPLACING EMBEDDED CATALOG GRID ON HOMEPAGE) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="p-8 sm:p-12 rounded-3xl bg-white border border-slate-200 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="space-y-3 max-w-2xl">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
          Complete Directory
        </span>
        <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Explore the Full Anime Catalog
        </h3>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
          Search by title, filter by what I've finished vs. queued next, or find 100% zero-filler series. All with verified chronological watch orders.
        </p>
      </div>

      <div class="shrink-0 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
        <a
          href="/anime/catalog"
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl bg-red-600 hover:bg-red-500 text-white text-sm font-bold shadow-md shadow-red-600/25 hover:shadow-red-600/40 hover:-translate-y-0.5 transition-all duration-200 text-center"
        >
          <span>Open Full Catalog ({animeList.length})</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
