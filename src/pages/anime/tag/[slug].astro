---
// src/pages/anime/tag/[slug].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnimeCard from '../../../components/AnimeCard.astro';
import { getAllAnime } from '../../../lib/d1.js';
import { vibes } from '../../../data/vibes.js';
import { theme } from '../../../config/theme.js';

export function getStaticPaths() {
  return vibes.map((vibe) => ({
    params: { slug: vibe.slug },
    props: { vibe }
  }));
}

const { vibe } = Astro.props;

const animeList = getAllAnime();

// Filter matching anime for this vibe
const matchingAnime = animeList.filter((a) => a.vibes && a.vibes.includes(vibe.id));

// Sub-metrics
const watchedCount = matchingAnime.filter((a) => a.honestyStatus === 'watched').length;
const watchlistCount = matchingAnime.filter((a) => a.honestyStatus === 'watchlist').length;
const zeroFillerCount = matchingAnime.filter((a) => a.fillerPercentage === 0).length;

// Other vibes for quick browsing
const otherVibes = vibes.filter((v) => v.slug !== vibe.slug);
---

<BaseLayout
  title={vibe.pageTitle}
  description={vibe.metaDescription}
>
  <!-- 1. HERO & VIBE INTRO HEADER -->
  <section class="relative pt-8 pb-10 sm:pt-12 sm:pb-12 border-b border-slate-200 bg-gradient-to-b from-slate-100/80 to-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- Breadcrumb & Back Navigation -->
      <nav class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs text-slate-500 flex-wrap">
          <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
          <span>/</span>
          <a href="/anime" class="hover:text-slate-900 transition-colors">Anime Section</a>
          <span>/</span>
          <span class="text-[#4F46E5] font-bold">{vibe.title}</span>
        </div>

        <a
          href="/anime"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-[#4F46E5] transition-colors shrink-0"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m7 7h18" />
          </svg>
          <span>Back to Anime Section</span>
        </a>
      </nav>

      <!-- Vibe Category Badge, H1 Heading & Rich Intro Paragraph -->
      <div class="max-w-3xl space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-extrabold uppercase tracking-wider px-3 py-1 rounded-full bg-[#EEF2FF] text-[#4F46E5] border border-[#C7D2FE] shadow-2xs">
            {vibe.badge}
          </span>
          <span class="text-xs font-semibold text-slate-500">
            • Curated Trope Guide
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0F172A] tracking-tight font-heading leading-tight">
          {vibe.h1}
        </h1>

        <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-normal pt-1">
          {vibe.intro}
        </p>
      </div>

      <!-- Live Search & Status Filter Row -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-4 border-t border-slate-200/80">
        
        <!-- Live Count Indicator -->
        <p class="text-xs sm:text-sm text-slate-600 font-normal">
          Showing <span id="visible-count" class="font-bold text-slate-900">{matchingAnime.length}</span> of {matchingAnime.length} curated titles
        </p>

        <!-- Live Search Input -->
        <div class="relative w-full md:w-72">
          <input
            type="text"
            id="search-input"
            placeholder="Search within this vibe..."
            class="w-full px-4 py-2.5 pl-9 rounded-full bg-white border border-slate-200 focus:border-[#6366F1] focus:ring-2 focus:ring-[#6366F1]/25 focus:outline-none text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 transition-all shadow-xs"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

      </div>

      <!-- Filter Tabs (Status: All, Watched, Watchlist, Zero Filler) -->
      <div class="flex flex-wrap items-center gap-2 pt-2" id="filter-tabs">
        <button
          type="button"
          data-filter="all"
          class="filter-tab-btn active px-4 py-1.5 rounded-full text-xs font-bold tracking-wide transition-all bg-[#6366F1] text-white shadow-sm shadow-indigo-500/20"
        >
          All ({matchingAnime.length})
        </button>

        <button
          type="button"
          data-filter="watched"
          class="filter-tab-btn px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 flex items-center gap-1.5 shadow-2xs"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1]"></span>
          <span>I've Watched This ({watchedCount})</span>
        </button>

        <button
          type="button"
          data-filter="watchlist"
          class="filter-tab-btn px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 flex items-center gap-1.5 shadow-2xs"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
          <span>On My Watchlist ({watchlistCount})</span>
        </button>

        <button
          type="button"
          data-filter="zero"
          class="filter-tab-btn px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 flex items-center gap-1.5 shadow-2xs"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1]"></span>
          <span>Zero Filler ({zeroFillerCount})</span>
        </button>
      </div>

    </div>
  </section>

  <!-- 2. FILTERED CARD GRID -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div id="anime-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 sm:gap-7">
      {matchingAnime.map((anime) => (
        <AnimeCard anime={anime} />
      ))}
    </div>

    <!-- Empty State Message -->
    <div id="empty-state" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 shadow-xs">
      <div class="w-14 h-14 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center mx-auto mb-3 text-slate-400">
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-[#0F172A] mb-1 font-heading">No anime found in this vibe matching your filter</h3>
      <p class="text-xs text-slate-500 max-w-sm mx-auto mb-4 font-normal">
        Try resetting your search query or selecting another status filter tab.
      </p>
      <button
        type="button"
        id="clear-filters-btn"
        class="px-4 py-2 rounded-xl bg-[#6366F1] hover:bg-[#4F46E5] text-white text-xs font-bold transition-all shadow-md shadow-indigo-500/20"
      >
        Clear Search & Filters
      </button>
    </div>
  </section>

  <!-- 3. EXPLORE OTHER VIBES PILL NAVIGATION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-t border-slate-200">
    <div class="space-y-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">
        Explore Other Anime Vibes & Tropes
      </h3>

      <div class="flex items-center gap-2.5 overflow-x-auto no-scrollbar py-1">
        {otherVibes.map((other) => (
          <a
            href={`/anime/tag/${other.slug}`}
            class="px-4 py-2 rounded-xl bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200/90 text-xs font-semibold whitespace-nowrap shadow-2xs hover:shadow-xs transition-all shrink-0 flex items-center gap-1.5"
          >
            <span>{other.title}</span>
            <span class="text-slate-400">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. END-OF-PAGE BUTTONS -->
  <footer class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-xs sm:text-sm text-slate-500 font-normal text-center sm:text-left">
      Looking for the complete list of all genres and categories?
    </p>

    <div class="flex items-center gap-3 flex-wrap justify-center">
      <a
        href="/anime"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs sm:text-sm border border-slate-200 shadow-xs transition-all"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Anime Section Home</span>
      </a>

      <a
        href="/anime/catalog"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-[#6366F1] hover:bg-[#4F46E5] text-white font-bold text-xs sm:text-sm shadow-md shadow-indigo-500/20 transition-all"
      >
        <span>Open Full Catalog ({animeList.length}) →</span>
      </a>
    </div>
  </footer>
</BaseLayout>

<script>
  function setupVibeFiltering() {
    const grid = document.getElementById('anime-grid');
    if (!grid) return;

    const cards = Array.from(document.querySelectorAll('#anime-grid > article'));
    const tabBtns = Array.from(document.querySelectorAll('.filter-tab-btn'));
    const searchInput = document.getElementById('search-input');
    const visibleCount = document.getElementById('visible-count');
    const emptyState = document.getElementById('empty-state');
    const clearFiltersBtn = document.getElementById('clear-filters-btn');

    let currentFilter = 'all';
    let searchQuery = '';

    function updateTabButtonUI() {
      tabBtns.forEach((btn) => {
        const filterVal = btn.getAttribute('data-filter');
        if (filterVal === currentFilter) {
          btn.classList.add('bg-[#6366F1]', 'text-white', 'shadow-sm', 'shadow-indigo-500/20');
          btn.classList.remove('bg-white', 'text-slate-700');
        } else {
          btn.classList.remove('bg-[#6366F1]', 'text-white', 'shadow-sm', 'shadow-indigo-500/20');
          btn.classList.add('bg-white', 'text-slate-700');
        }
      });
    }

    function filterCards() {
      let count = 0;

      cards.forEach((card) => {
        const cardStatus = card.getAttribute('data-status');
        const cardFiller = card.getAttribute('data-filler');
        const cardTitle = card.getAttribute('data-title') || '';

        // Status filter
        let matchesTab = true;
        if (currentFilter === 'watched') matchesTab = (cardStatus === 'watched');
        if (currentFilter === 'watchlist') matchesTab = (cardStatus === 'watchlist');
        if (currentFilter === 'zero') matchesTab = (cardFiller === 'zero');

        // Search match
        let matchesSearch = true;
        if (searchQuery.trim()) {
          matchesSearch = cardTitle.includes(searchQuery.toLowerCase().trim());
        }

        if (matchesTab && matchesSearch) {
          card.classList.remove('hidden');
          count++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCount) {
        visibleCount.textContent = count;
      }

      if (emptyState) {
        if (count === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    tabBtns.forEach((btn) => {
      btn.onclick = () => {
        currentFilter = btn.getAttribute('data-filter') || 'all';
        updateTabButtonUI();
        filterCards();
      };
    });

    if (searchInput) {
      searchInput.oninput = (e) => {
        searchQuery = e.target.value;
        filterCards();
      };
    }

    if (clearFiltersBtn) {
      clearFiltersBtn.onclick = () => {
        currentFilter = 'all';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        updateTabButtonUI();
        filterCards();
      };
    }
  }

  setupVibeFiltering();
  document.addEventListener('astro:page-load', setupVibeFiltering);
</script>
