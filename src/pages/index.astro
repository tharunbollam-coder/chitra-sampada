---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimeCard from '../components/AnimeCard.astro';
import ComingSoonCard from '../components/ComingSoonCard.astro';
import HonestyBadge from '../components/HonestyBadge.astro';
import { animeList } from '../data/anime.js';
import { siteConfig } from '../config/site.js';

// Top trending or vetted titles for the homepage spotlight
const spotlightAnime = animeList.filter((a) => a.trending).slice(0, 4);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <!-- HERO SECTION -->
  <section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden">
    <!-- Ambient glowing backdrop -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[450px] bg-gradient-to-tr from-red-600/15 via-rose-600/10 to-amber-500/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      
      <!-- Value Proposition Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold uppercase tracking-widest text-slate-300 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        <span>The Honest Entertainment Companion</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white max-w-4xl mx-auto leading-[1.1]">
        Filler-free watch orders. <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-rose-400 to-amber-400">
          Nothing sugar-coated.
        </span>
      </h1>

      <!-- Subtitle Tagline -->
      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-medium leading-relaxed">
        {siteConfig.tagline} Not another cluttered database — an honest, deeply useful companion before and while you watch.
      </p>

      <!-- Primary Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a
          href="/anime"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-red-600 via-rose-600 to-red-600 hover:from-red-500 hover:to-rose-500 text-white font-extrabold text-base tracking-wide shadow-xl shadow-red-600/25 hover:shadow-red-600/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-3 group"
        >
          <span>Explore Live Anime Section</span>
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="#roadmap"
          class="w-full sm:w-auto px-7 py-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-slate-200 font-bold text-base transition-all duration-200 flex items-center justify-center gap-2"
        >
          <span>See Future Verticals</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>

      <!-- Trust Pillars Badges -->
      <div class="pt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-4xl mx-auto text-left">
        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5 backdrop-blur-sm">
          <div class="flex items-center gap-2 text-emerald-400 font-bold text-xs uppercase tracking-wider mb-1">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span>Honesty Badges</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Clear distinction between what we have personally watched vs what is queued on our watchlist.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5 backdrop-blur-sm">
          <div class="flex items-center gap-2 text-red-400 font-bold text-xs uppercase tracking-wider mb-1">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524l8.367 8.368zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd" />
            </svg>
            <span>Zero Filler Waste</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Exact filler percentages and verified skip lists so you never waste hours on non-canon filler.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5 backdrop-blur-sm">
          <div class="flex items-center gap-2 text-amber-400 font-bold text-xs uppercase tracking-wider mb-1">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span>Vibe Discovery</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed">
            Curated by actual watching moods like "Overpowered MC" or "Slow Burn Romance", not dry filters.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- FLAGSHIP SECTION: ANIME (LIVE HERO FOCUS) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-red-950/60 via-[#0d1220] to-[#0b0f19] border border-red-500/30 p-8 sm:p-12 shadow-2xl">
      <!-- Ambient decorative glow -->
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-black uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span>Flagship Section • Now Live</span>
          </div>

          <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
            The Anime Discovery Hub is here.
          </h2>

          <p class="text-base text-slate-300 leading-relaxed">
            Dive into our live anime catalog featuring verified watch orders, zero-filler roadmaps, and honest editor verdicts. Stop guessing what to watch next or whether an arc is canon.
          </p>

          <div class="flex flex-wrap items-center gap-4 text-xs text-slate-300">
            <div class="flex items-center gap-2 bg-white/5 px-3 py-1.5 rounded-lg border border-white/10">
              <span class="font-bold text-red-400">12+</span>
              <span>Hand-curated series</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 px-3 py-1.5 rounded-lg border border-white/10">
              <span class="font-bold text-emerald-400">100%</span>
              <span>Canon verification</span>
            </div>
            <div class="flex items-center gap-2 bg-white/5 px-3 py-1.5 rounded-lg border border-white/10">
              <span class="font-bold text-amber-400">6</span>
              <span>Distinct discovery vibes</span>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="/anime"
              class="inline-flex items-center gap-3 px-6 py-3.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold text-sm shadow-lg shadow-red-600/30 hover:scale-[1.02] transition-all duration-200"
            >
              <span>Launch Anime Section</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Visual Teaser Cards inside Hero Banner -->
        <div class="lg:col-span-5 grid grid-cols-2 gap-4">
          {spotlightAnime.slice(0, 2).map((item) => (
            <div class="relative rounded-2xl overflow-hidden border border-white/10 bg-slate-900 shadow-xl group">
              <img
                src={item.poster}
                alt={item.title}
                class="w-full aspect-[2/3] object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-3">
                <HonestyBadge status={item.honestyStatus} size="sm" />
                <h4 class="text-xs font-bold text-white mt-1 line-clamp-1">{item.title}</h4>
                <p class="text-[10px] text-slate-300 mt-0.5">{item.fillerStatus}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- TRENDING SPOTLIGHT FROM THE LIVE ANIME HUB -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="text-xs font-black uppercase tracking-widest text-red-400 mb-1">
          From the Flagship Hub
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          Trending & Editor-Vetted Anime
        </h2>
      </div>

      <a
        href="/anime"
        class="inline-flex items-center gap-1.5 text-sm font-bold text-red-400 hover:text-red-300 transition-colors"
      >
        <span>View Full Catalog & Vibes</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {spotlightAnime.map((anime) => (
        <AnimeCard anime={anime} />
      ))}
    </div>
  </section>

  <!-- THE ENTERTAINMENT HUB ROADMAP (MOVIES, TV, WEB SERIES) -->
  <section id="roadmap" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 border-t border-white/10">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="text-xs font-black uppercase tracking-widest px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300">
        Expanding Universe
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        A Complete Entertainment Hub Under One Roof
      </h2>
      <p class="text-base text-slate-300 leading-relaxed">
        {siteConfig.name} is built to grow into the single most trustworthy watch companion for all entertainment. Here is what is currently in active editorial development:
      </p>
    </div>

    <!-- 3 Coming Soon Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <ComingSoonCard
        category="Cinema & Film"
        title="Movies Hub"
        icon="film"
        gradient="from-blue-950/40 via-slate-900 to-[#0b0f19]"
        description="Franchise chronological roadmaps, cinematic canon breakdowns, and honest runtime vs payoff advice."
        features={[
          "Chronological & release universe orders",
          "Post-credits scene honest indicators",
          "Director's Cut vs Theatrical comparisons",
          "Zero-spoiler premise ratings"
        ]}
      />

      <ComingSoonCard
        category="Television"
        title="TV Shows"
        icon="tv"
        gradient="from-amber-950/40 via-slate-900 to-[#0b0f19]"
        description="Season-by-season honesty meters. Know exactly which seasons are masterpieces and when a show starts falling off."
        features={[
          "Season-by-season quality ratings",
          "'Where to stop' guides for dragged-out shows",
          "Skip-the-filler episode roadmaps",
          "Season finale cliffhanger warnings"
        ]}
      />

      <ComingSoonCard
        category="Digital Streaming"
        title="Web Series"
        icon="globe"
        gradient="from-emerald-950/40 via-slate-900 to-[#0b0f19]"
        description="Curated deep dives into streaming originals across global platforms, highlighting genuine masterpieces."
        features={[
          "Platform-agnostic binge ratings",
          "Pacing and episode drag breakdowns",
          "Hidden indie web-series spotlights",
          "Spoiler-safe mid-season recaps"
        ]}
      />

    </div>
  </section>

  <!-- HONESTY MANIFESTO / WHY WE EXIST -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="p-8 sm:p-12 rounded-3xl bg-[#090d17] border border-white/10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-5 space-y-4">
          <div class="text-xs font-black uppercase tracking-widest text-red-400">
            Our Standard
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Why entertainment discovery is broken — and how we fix it.
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Most sites are either automated databases scraping user scores or marketing blogs paid to hype whatever just released. We believe viewers deserve radical honesty.
          </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/5">
            <h4 class="text-sm font-bold text-red-400 mb-2">Ordinary Wikis & DBs</h4>
            <ul class="text-xs text-slate-400 space-y-2">
              <li>• Endless cluttered lists with zero editorial context</li>
              <li>• Unregulated fan ratings manipulated by review-bombing</li>
              <li>• Spoiler traps disguised as character synopsis pages</li>
              <li>• No distinction whether the writer ever watched it</li>
            </ul>
          </div>

          <div class="p-5 rounded-2xl bg-red-950/30 border border-red-500/30 shadow-lg shadow-red-950/30">
            <h4 class="text-sm font-bold text-white mb-2">{siteConfig.name} Companion</h4>
            <ul class="text-xs text-slate-300 space-y-2">
              <li>• Verified "Watched" vs "Watchlist" honesty badges</li>
              <li>• Calculated filler percentages and direct skip guides</li>
              <li>• Curated discovery by real vibes, not generic genres</li>
              <li>• Direct chronological watch order roadmaps</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
