---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimeCard from '../components/AnimeCard.astro';
import ComingSoonCard from '../components/ComingSoonCard.astro';
import HonestyBadge from '../components/HonestyBadge.astro';
import { animeList } from '../data/anime.js';
import { siteConfig } from '../config/site.js';

// Top titles for the homepage spotlight
const spotlightAnime = animeList.filter((a) => a.trending).slice(0, 4);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <!-- HERO SECTION -->
  <section class="relative pt-16 pb-20 sm:pt-24 sm:pb-32 overflow-hidden">
    <!-- Ambient Depth: Multi-layer Glows & Faint Grid Pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff06_1px,transparent_1px),linear-gradient(to_bottom,#ffffff06_1px,transparent_1px)] bg-[size:36px_36px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_35%,#000_60%,transparent_100%)] pointer-events-none -z-10"></div>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[650px] sm:w-[900px] h-[380px] bg-gradient-to-tr from-red-600/15 via-rose-600/12 to-amber-500/10 blur-[140px] rounded-full pointer-events-none -z-10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[200px] bg-red-500/10 blur-[90px] rounded-full pointer-events-none -z-10"></div>

    <!-- Subtle Faint Floating Poster Accents (Left & Right desktop depth) -->
    <div class="hidden lg:block absolute left-8 xl:left-16 top-28 w-44 rounded-2xl overflow-hidden border border-white/5 opacity-25 -rotate-6 pointer-events-none -z-10 shadow-2xl shadow-black/80">
      <img src="https://image.tmdb.org/t/p/w780/dqZENchTd7lp5zht7BdlqM7RBhD.jpg" alt="" class="w-full aspect-[2/3] object-cover blur-[1px]" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-transparent to-transparent"></div>
    </div>
    <div class="hidden lg:block absolute right-8 xl:right-16 top-28 w-44 rounded-2xl overflow-hidden border border-white/5 opacity-25 rotate-6 pointer-events-none -z-10 shadow-2xl shadow-black/80">
      <img src="https://image.tmdb.org/t/p/w780/geCRueV3ElhRTr0xtJuPxJ8HGQH.jpg" alt="" class="w-full aspect-[2/3] object-cover blur-[1px]" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#07090e] via-transparent to-transparent"></div>
    </div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Top Badge Pill with Breathing Room -->
      <div class="mb-6 sm:mb-8 inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.04] hover:bg-white/[0.07] border border-white/10 text-xs font-semibold text-slate-300 backdrop-blur-xl shadow-inner transition-colors">
        <span class="w-1.5 h-1.5 rounded-full bg-red-400 shadow-[0_0_8px_rgba(248,113,113,0.8)]"></span>
        <span>A personal watch companion</span>
      </div>

      <!-- Main Headline & Emotional Core with Refined Rhythm -->
      <div class="space-y-3 sm:space-y-4 mb-8 sm:mb-10">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.15]">
          Finding what to watch next takes too long. <br class="hidden sm:inline" />
          <span class="block mt-2 sm:mt-3 text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-rose-300 to-amber-300 drop-shadow-[0_2px_20px_rgba(244,63,94,0.25)]">
            And nobody explains filler or watch order up front.
          </span>
        </h1>
      </div>

      <!-- Distinguishable Body Elements -->
      <div class="space-y-5 sm:space-y-6 max-w-2xl mx-auto mb-10 sm:mb-12">
        <!-- Lead personal narrative -->
        <p class="text-base sm:text-xl text-slate-200 font-normal leading-relaxed">
          I love anime, movies, and series. When I started watching anime, I didn't even know what "filler" was, or that there was a correct order to watch when movies and seasons are mixed together. 
        </p>

        <!-- Product definition framed in subtle glass highlight -->
        <div class="p-4 sm:p-5 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md shadow-xl shadow-black/20">
          <p class="text-sm sm:text-base text-slate-300 font-normal leading-relaxed">
            This isn't an encyclopedia trying to list every show that exists. It’s simply my own list of what I’ve personally watched and what I plan to watch next, clearly labeled so you know the context before you hit play.
          </p>
        </div>
      </div>

      <!-- Polished, Premium Actions with Tactile Shadows & Glow -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-1 mb-16 sm:mb-20">
        <a
          href="/anime"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-red-600 via-rose-600 to-red-600 hover:from-red-500 hover:via-rose-500 hover:to-red-500 text-white font-extrabold text-sm tracking-wide shadow-xl shadow-red-600/30 hover:shadow-red-600/50 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 border-t border-white/25 flex items-center justify-center gap-2.5 group"
        >
          <span>Browse Anime List</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="/about"
          class="w-full sm:w-auto px-7 py-4 rounded-2xl bg-white/[0.04] hover:bg-white/[0.09] border border-white/15 hover:border-white/30 text-slate-200 hover:text-white font-semibold text-sm shadow-lg shadow-black/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center justify-center gap-2 backdrop-blur-md"
        >
          <span>Read the Story Behind This</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-200 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- 3 Core Principles with Elevated Surface Styling -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left">
        <div class="p-5 rounded-2xl bg-white/[0.025] hover:bg-white/[0.045] border border-white/8 hover:border-white/15 transition-all duration-300 backdrop-blur-sm group">
          <div class="flex items-center gap-2 text-emerald-400 font-semibold text-xs uppercase tracking-wide mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]"></span>
            <span>Watched vs Watchlist</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed group-hover:text-slate-300 transition-colors">
            Every title is clearly labeled so you always know whether I’ve actually watched it or if it’s queued up next.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white/[0.025] hover:bg-white/[0.045] border border-white/8 hover:border-white/15 transition-all duration-300 backdrop-blur-sm group">
          <div class="flex items-center gap-2 text-red-400 font-semibold text-xs uppercase tracking-wide mb-2">
            <span class="w-2 h-2 rounded-full bg-red-400 shadow-[0_0_8px_rgba(248,113,113,0.6)]"></span>
            <span>Watch Orders & Filler</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed group-hover:text-slate-300 transition-colors">
            Clear info on what's canon, what's filler, and in what sequence to watch series with multiple seasons and films.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white/[0.025] hover:bg-white/[0.045] border border-white/8 hover:border-white/15 transition-all duration-300 backdrop-blur-sm group">
          <div class="flex items-center gap-2 text-amber-400 font-semibold text-xs uppercase tracking-wide mb-2">
            <span class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.6)]"></span>
            <span>Community Suggestions</span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed group-hover:text-slate-300 transition-colors">
            If you recommend a show and it gets added, it’s clearly marked as a community suggestion, never claimed as mine.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- LIVE SECTION: ANIME -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-red-950/40 via-[#0d1220] to-[#0b0f19] border border-white/10 p-8 sm:p-12">
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-semibold">
            <span>First Section Live</span>
          </div>

          <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight leading-tight">
            Starting with Anime.
          </h2>

          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Anime is where the confusion was biggest for me, so it’s where this project starts. You’ll find simple watch orders, filler percentages, and clear badges showing what I’ve finished versus what I'm about to start.
          </p>

          <div class="pt-2">
            <a
              href="/anime"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-red-600 hover:bg-red-500 text-white font-semibold text-sm transition-all duration-200"
            >
              <span>Explore the Anime Section</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Visual Preview of a couple titles -->
        <div class="lg:col-span-5 grid grid-cols-2 gap-4">
          {spotlightAnime.slice(0, 2).map((item) => (
            <div class="relative rounded-2xl overflow-hidden border border-white/10 bg-slate-900 group">
              <img
                src={item.poster}
                alt={item.title}
                class="w-full aspect-[2/3] object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex flex-col justify-end p-3">
                <HonestyBadge status={item.honestyStatus} size="sm" />
                <h4 class="text-xs font-bold text-white mt-1.5 line-clamp-1">{item.title}</h4>
                <p class="text-[10px] text-slate-400 mt-0.5">{item.episodes} episodes</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- RECENTLY ADDED TITLES -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">
          Recently Watched & Queued
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          A look at some shows currently on my screen or next on the list.
        </p>
      </div>

      <a
        href="/anime"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-400 hover:text-red-300 transition-colors"
      >
        <span>View full list</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {spotlightAnime.map((anime) => (
        <AnimeCard anime={anime} />
      ))}
    </div>
  </section>

  <!-- FUTURE SECTIONS: MOVIES, TV, WEB SERIES -->
  <section id="roadmap" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-white/10">
    <div class="max-w-2xl mb-12 space-y-2">
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">
        Coming Later
      </span>
      <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
        Movies, TV Shows, and Web Series
      </h2>
      <p class="text-sm text-slate-300 leading-relaxed">
        I watch plenty of movies and live-action series too. Once the anime section is running smoothly, I'll be adding those sections with the same simple setup: what I've watched, what's on my watchlist, and chronological watch orders.
      </p>
    </div>

    <!-- 3 Coming Soon Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <ComingSoonCard
        category="Movies"
        title="Movies"
        icon="film"
        gradient="from-blue-950/30 via-slate-900 to-[#0b0f19]"
        description="Franchise chronological orders and personal watchlists for films with complex universes."
        features={[
          "Chronological & release universe orders",
          "Stand-alone vs connected franchise guides",
          "Personal watched vs watchlist tags"
        ]}
      />

      <ComingSoonCard
        category="Television"
        title="TV Shows"
        icon="tv"
        gradient="from-amber-950/30 via-slate-900 to-[#0b0f19]"
        description="Personal lists and notes for live-action shows across seasons, without marketing fluff."
        features={[
          "Season-by-season tracking",
          "Where a show concludes well",
          "Simple watched & watchlist tags"
        ]}
      />

      <ComingSoonCard
        category="Streaming"
        title="Web Series"
        icon="globe"
        gradient="from-emerald-950/30 via-slate-900 to-[#0b0f19]"
        description="Short-form and streaming series I've enjoyed or have saved to watch on weekend binges."
        features={[
          "Platform tracking",
          "Quick premise notes",
          "Personal watched & watchlist tags"
        ]}
      />

    </div>
  </section>

  <!-- COMMUNITY SUGGESTIONS CALLOUT -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="p-7 sm:p-10 rounded-3xl bg-[#090d17] border border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-xl">
        <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
          Want to suggest something I should watch?
        </h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          I want this list to grow with recommendations from real people. If you think an anime, movie, or series belongs here, send it over. If it gets added, it will be clearly marked as a user suggestion so everyone knows who recommended it.
        </p>
      </div>

      <a
        href="/about#suggestions"
        class="shrink-0 px-6 py-3 rounded-xl bg-white/10 hover:bg-white/15 text-white text-sm font-semibold border border-white/10 transition-colors"
      >
        How Suggestions Work →
      </a>
    </div>
  </section>
</BaseLayout>
