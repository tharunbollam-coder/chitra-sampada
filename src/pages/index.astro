---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimeCard from '../components/AnimeCard.astro';
import ComingSoonCard from '../components/ComingSoonCard.astro';
import HonestyBadge from '../components/HonestyBadge.astro';
import PositivityNote from '../components/PositivityNote.astro';
import { getAllAnime } from '../lib/d1.js';
import { siteConfig } from '../config/site.js';

const animeList = await getAllAnime();

// Top titles for the homepage spotlight
const spotlightAnime = animeList.filter((a) => a.trending).slice(0, 4);
---

<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <!-- HERO SECTION -->
  <section class="relative pt-16 pb-20 sm:pt-24 sm:pb-32 overflow-hidden">
    <!-- Ambient Depth: Faint Light Grid Pattern & Soft Glow -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#00000006_1px,transparent_1px),linear-gradient(to_bottom,#00000006_1px,transparent_1px)] bg-[size:36px_36px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_35%,#000_60%,transparent_100%)] pointer-events-none -z-10"></div>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[650px] sm:w-[900px] h-[380px] bg-[#6366F1]/6 blur-[140px] rounded-full pointer-events-none -z-10"></div>

    <!-- Subtle Faint Floating Poster Accents (Left & Right desktop depth) -->
    <div class="hidden lg:block absolute left-8 xl:left-16 top-28 w-44 rounded-2xl overflow-hidden border border-slate-200/80 opacity-40 -rotate-6 pointer-events-none -z-10 shadow-lg bg-white p-1">
      <img src="https://image.tmdb.org/t/p/w780/dqZENchTd7lp5zht7BdlqM7RBhD.jpg" alt="" class="w-full aspect-[2/3] object-cover rounded-xl" />
    </div>
    <div class="hidden lg:block absolute right-8 xl:right-16 top-28 w-44 rounded-2xl overflow-hidden border border-slate-200/80 opacity-40 rotate-6 pointer-events-none -z-10 shadow-lg bg-white p-1">
      <img src="https://image.tmdb.org/t/p/w780/geCRueV3ElhRTr0xtJuPxJ8HGQH.jpg" alt="" class="w-full aspect-[2/3] object-cover rounded-xl" />
    </div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Top Badge Pill with Breathing Room -->
      <div class="mb-6 sm:mb-8 inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white border border-slate-200 text-xs font-semibold text-slate-700 shadow-xs transition-colors">
        <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1] shadow-[0_0_8px_rgba(99,102,241,0.6)]"></span>
        <span>A personal watch companion</span>
      </div>

      <!-- Main Headline & Emotional Core with Solid Theme Accent Emphasis -->
      <div class="space-y-3 sm:space-y-4 mb-8 sm:mb-10">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#0F172A] leading-[1.15] font-heading">
          Finding what to watch takes too long. <br class="hidden sm:inline" />
          <span class="block mt-2 sm:mt-3 text-[#6366F1]">
            And nobody gives you the clear context to decide for yourself.
          </span>
        </h1>
      </div>

      <!-- Distinguishable Body Elements -->
      <div class="max-w-2xl mx-auto mb-10 sm:mb-12">
        <!-- Lead personal narrative -->
        <p class="text-base sm:text-xl text-[#334155] font-normal leading-relaxed">
          I love anime, movies, and series. But when I got into anime, nobody explained what "filler" was, or how to navigate confusing watch orders across movies and seasons. This site provides clear, carefully researched guides and honest context for viewers so you can decide what to watch in your own way.
        </p>
      </div>

      <!-- Polished, Premium Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-1 mb-16 sm:mb-20">
        <a
          href="/anime"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-[#6366F1] hover:bg-[#4F46E5] text-white font-bold text-sm tracking-wide shadow-md shadow-indigo-500/20 hover:shadow-indigo-500/30 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center justify-center gap-2.5 group"
        >
          <span>Browse Anime Catalog</span>
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a
          href="/about"
          class="w-full sm:w-auto px-7 py-4 rounded-2xl bg-white hover:bg-slate-50 border border-slate-200 hover:border-slate-300 text-slate-700 hover:text-slate-900 font-semibold text-sm shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center justify-center gap-2"
        >
          <span>Read How This Works</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- 3 Core Principles with Elevated Surface Styling -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left">
        <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:shadow-md transition-all duration-300 group">
          <div class="flex items-center gap-2 text-[#4F46E5] font-bold text-xs uppercase tracking-wide mb-2">
            <span class="w-2 h-2 rounded-full bg-[#6366F1]"></span>
            <span>Three Honest Categories</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-normal">
            Every title is transparently labeled as Personally Watched, On My Watchlist, or a compiled Reference Guide.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:shadow-md transition-all duration-300 group">
          <div class="flex items-center gap-2 text-slate-800 font-bold text-xs uppercase tracking-wide mb-2">
            <span class="w-2 h-2 rounded-full bg-[#6366F1]"></span>
            <span>Watch Orders & Filler</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-normal">
            Clear breakdowns of canon vs. filler episodes and chronological sequences for complex multi-season series.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:shadow-md transition-all duration-300 group">
          <div class="flex items-center gap-2 text-slate-800 font-semibold text-xs uppercase tracking-wide mb-2">
            <span class="w-2 h-2 rounded-full bg-slate-400"></span>
            <span>Community Suggestions</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed font-normal">
            If you suggest a show or submit a correction, it’s always clearly credited to contributors, never claimed as mine.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- LIVE SECTION: ANIME -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="relative rounded-3xl overflow-hidden bg-[#EEF2FF]/40 border border-slate-200 p-8 sm:p-12 shadow-xs">
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EEF2FF] border border-[#C7D2FE] text-[#4F46E5] text-xs font-bold shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[#6366F1]"></span>
            <span>First Section Live</span>
          </div>

          <h2 class="font-heading text-2xl sm:text-4xl font-extrabold text-[#0F172A] tracking-tight leading-tight">
            Starting with Anime.
          </h2>

          <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
            Anime is where the confusion was biggest for me, so it’s where this project starts. You’ll find carefully researched watch orders, filler percentages, and clear badges distinguishing watched titles, queued watchlist shows, and compiled reference guides.
          </p>

          <div class="pt-2">
            <a
              href="/anime"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-[#6366F1] hover:bg-[#4F46E5] text-white font-bold text-sm shadow-md shadow-indigo-500/20 hover:shadow-indigo-500/30 hover:-translate-y-0.5 transition-all duration-200"
            >
              <span>Explore the Anime Section</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Visual Preview of a couple titles -->
        <div class="lg:col-span-5 grid grid-cols-2 gap-4">
          {spotlightAnime.slice(0, 2).map((item) => (
            <div class="relative rounded-2xl overflow-hidden border border-slate-200 bg-white p-3 shadow-xs group">
              <div class="relative aspect-[2/3] rounded-xl overflow-hidden bg-slate-100 border border-slate-200/80 mb-2.5">
                <img
                  src={item.poster}
                  alt={item.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="space-y-1">
                <HonestyBadge status={item.honestyStatus} size="sm" />
                <h4 class="font-heading text-xs font-bold text-[#0F172A] mt-1 line-clamp-1">{item.title}</h4>
                <p class="text-[10px] text-slate-500 font-medium">{item.episodes} episodes</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- RECENTLY ADDED TITLES -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="font-heading text-xl sm:text-2xl font-extrabold text-[#0F172A] tracking-tight">
          Recently Watched & Queued
        </h2>
        <p class="text-xs text-slate-500 mt-1 font-normal">
          A look at some shows currently on my screen or next on the list.
        </p>
      </div>

      <a
        href="/anime"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-[#4F46E5] hover:text-[#4338CA] transition-colors"
      >
        <span>View full list</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-7">
      {spotlightAnime.map((anime) => (
        <AnimeCard anime={anime} />
      ))}
    </div>
  </section>

  <!-- FUTURE SECTIONS: MOVIES, TV, WEB SERIES -->
  <section id="roadmap" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200">
    <div class="max-w-2xl mb-12 space-y-2">
      <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
        Coming Later
      </span>
      <h2 class="font-heading text-2xl sm:text-3xl font-extrabold text-[#0F172A] tracking-tight">
        Movies, TV Shows, and Web Series
      </h2>
      <p class="text-sm text-slate-600 leading-relaxed font-normal">
        I watch plenty of movies and live-action series too. Once the anime section is running smoothly, I'll be adding those sections with the same honest approach: clear three-category status tags, chronological watch orders, and no-fluff viewer context.
      </p>
    </div>

    <!-- 3 Coming Soon Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7">
      
      <ComingSoonCard
        category="Movies"
        title="Movies"
        icon="film"
        description="Franchise chronological orders and personal watchlists for films with complex universes."
        features={[
          "Chronological & release universe orders",
          "Stand-alone vs connected franchise guides",
          "Honest three-category status tags"
        ]}
      />

      <ComingSoonCard
        category="Television"
        title="TV Shows"
        icon="tv"
        description="Personal lists and notes for live-action shows across seasons, without marketing fluff."
        features={[
          "Season-by-season tracking",
          "Where a show concludes well",
          "Honest three-category status tags"
        ]}
      />

      <ComingSoonCard
        category="Streaming"
        title="Web Series"
        icon="globe"
        description="Short-form and streaming series I've enjoyed or have saved to watch on weekend binges."
        features={[
          "Platform tracking",
          "Quick premise notes",
          "Honest three-category status tags"
        ]}
      />

    </div>
  </section>

  <!-- COMMUNITY SUGGESTIONS CALLOUT -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="p-7 sm:p-10 rounded-3xl bg-white border border-slate-200 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-xl">
        <h3 class="font-heading text-xl sm:text-2xl font-extrabold text-[#0F172A] tracking-tight">
          Want to suggest something I should watch?
        </h3>
        <p class="text-sm text-slate-600 leading-relaxed font-normal">
          I want this list to grow with suggestions from real people. If you think an anime, movie, or series belongs here, send it over. If it gets added, it will be clearly marked as a user suggestion so everyone knows who suggested it.
        </p>
      </div>

      <a
        href="/about#suggestions"
        class="shrink-0 px-6 py-3.5 rounded-2xl bg-slate-100 hover:bg-slate-200/80 text-slate-800 text-sm font-semibold border border-slate-200 transition-all duration-200"
      >
        How Suggestions Work →
      </a>
    </div>
  </section>

  <!-- ROTATING POSITIVITY & REFLECTION NOTE -->
  <PositivityNote />
</BaseLayout>
