---
// src/layouts/BaseLayout.astro
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import WellnessNote from '../components/WellnessNote.astro';
import { siteConfig } from '../config/site.js';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  showWellnessNote?: boolean;
  includeBrandSuffix?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  ogImage = '/cs.webp',
  canonicalUrl: propCanonicalUrl,
  showWellnessNote,
  includeBrandSuffix = false,
  ogType = 'website'
} = Astro.props;

// Determine clean page title without redundant site name suffix
let pageTitle: string;
if (!title || title === siteConfig.name) {
  pageTitle = `${siteConfig.name} — ${siteConfig.subTagline}`;
} else if (includeBrandSuffix && !title.includes(siteConfig.name)) {
  pageTitle = `${title} | ${siteConfig.name}`;
} else {
  pageTitle = title;
}

const siteOrigin = siteConfig.siteUrl || (Astro.site ? Astro.site.origin : 'https://chitrasampada.com');
const cleanPathname = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const isHomepage = showWellnessNote !== undefined ? showWellnessNote : (cleanPathname === '' || cleanPathname === '/');
const canonicalUrl = propCanonicalUrl || new URL(cleanPathname, siteOrigin).href;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteOrigin).href;

---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#F8FAFC] text-slate-900">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Fonts: Plus Jakarta Sans (Headings) & Inter (Body & UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- TMDB Poster CDN Preconnection for faster LCP image delivery -->
    <link rel="dns-prefetch" href="https://image.tmdb.org" />
    <link rel="preconnect" href="https://image.tmdb.org" crossorigin />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImage} />

    <!-- Structured Data Slot (JSON-LD) -->
    <slot name="structured-data" />

    <!-- Astro View Transitions for smooth page switching without clunky reloads -->
    <ClientRouter />
  </head>

  <body class="min-h-screen flex flex-col antialiased bg-[#F8FAFC] text-[#334155]">
    <!-- Subtle ambient top glow for light mode -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[300px] bg-[#6366F1]/5 blur-[140px] pointer-events-none -z-10"></div>
    
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    {isHomepage && <WellnessNote />}

    <Footer />

    <CookieConsent />

    <!-- Global Navigation Context & Scroll Position Restoration -->
    <script>
      // @ts-nocheck
      (function () {
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'auto';
        }

        function getCleanPath() {
          return window.location.pathname.replace(/\/$/, '') || '/';
        }

        function isListingPage(path) {
          return path === '/' || path === '/anime' || path === '/anime/catalog' || path.startsWith('/anime/tag/');
        }

        function recordListingState() {
          const path = getCleanPath();
          if (isListingPage(path)) {
            try {
              sessionStorage.setItem('chitra_source_page', window.location.pathname + window.location.search);
              sessionStorage.setItem('chitra_scroll_' + path, window.scrollY.toString());
            } catch (e) {}
          }
        }

        function restoreListingScroll() {
          const path = getCleanPath();
          if (isListingPage(path)) {
            try {
              const key = 'chitra_scroll_' + path;
              const savedY = sessionStorage.getItem(key);
              if (savedY !== null) {
                const top = parseInt(savedY, 10);
                if (!isNaN(top) && top > 0) {
                  requestAnimationFrame(function () {
                    if (window.scrollY === 0) {
                      window.scrollTo({ top: top, behavior: 'instant' });
                    }
                  });
                }
              }
            } catch (e) {}
          }
        }

        // Disable smooth scroll on history traversal so native scroll restoration runs instantly
        document.addEventListener('astro:before-swap', function (event) {
          if ('scrollRestoration' in history) {
            history.scrollRestoration = 'auto';
          }
          if (event.navigationType === 'traverse') {
            event.newDocument.documentElement.style.scrollBehavior = 'auto';
          }
        });

        // Record scroll position on navigation transitions or page leave without continuous main thread thrashing
        document.addEventListener('astro:before-preparation', recordListingState);
        window.addEventListener('pagehide', recordListingState);
        document.addEventListener('astro:page-load', restoreListingScroll);
      })();
    </script>
  </body>
</html>
