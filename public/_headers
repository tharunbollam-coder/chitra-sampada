# Cloudflare Edge Headers for Static Assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/cs.webp
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate

/favicon-*.png
  Cache-Control: public, max-age=86400, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

/android-chrome-*.png
  Cache-Control: public, max-age=86400, must-revalidate

/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate
